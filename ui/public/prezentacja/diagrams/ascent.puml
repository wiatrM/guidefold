@startuml
!pragma layout smetana
skinparam backgroundColor #152324
skinparam defaultFontName SansSerif
skinparam defaultFontSize 18
skinparam defaultFontColor #EDF4F3
skinparam shadowing false
skinparam roundCorner 18
skinparam ArrowColor #66D9C8
skinparam ArrowFontColor #B5D6D0
skinparam ArrowFontSize 15
skinparam rectangleBackgroundColor #203B38
skinparam rectangleBorderColor #68BCAD
skinparam componentBackgroundColor #203B38
skinparam componentBorderColor #68BCAD
skinparam databaseBackgroundColor #203B38
skinparam databaseBorderColor #68BCAD
skinparam noteBackgroundColor #3C3025
skinparam noteBorderColor #E7A16C
skinparam noteFontColor #FFE2C5
skinparam sequenceParticipantBackgroundColor #203B38
skinparam sequenceParticipantBorderColor #68BCAD
skinparam sequenceParticipantFontColor #EDF4F3
skinparam sequenceLifeLineBorderColor #55736E
skinparam sequenceGroupBorderColor #E7A16C
skinparam sequenceGroupHeaderFontColor #FFE2C5
skinparam sequenceGroupBodyBackgroundColor #152324
skinparam sequenceGroupBackgroundColor #24332F
skinparam sequenceMessageAlign center
hide footbox
top to bottom direction
rectangle "SKILL ZESPOŁU\nTesty + powrót do wersji\n+ nasza komenda wdrożenia" as team
rectangle "PROPOZYCJA WSPÓLNEJ CZĘŚCI\nPrzed wdrożeniem sprawdź testy\ni przygotuj powrót do wersji" as proposal
rectangle "PRZEGLĄD WŁAŚCICIELA\nCzy ta rada nadaje się szerzej?" as review #3C3025
rectangle "BIBLIOTEKA ORGANIZACJI\nWspólna instrukcja\n+ odwołanie do źródeł" as org
team --> proposal : model proponuje
proposal --> review : jeszcze niezatwierdzona
review --> org : po sprawdzeniu i publikacji
note right of team
Lokalna komenda
zostaje w zespole.
end note

@enduml
