#!/usr/bin/env python3
"""guidefold — minimal CLI for hierarchy-aware skill discovery over Google Agent Registry.

Subcommands
  where                     print hierarchy node for cwd (from guidefold.yaml)
  find "<task>" --scope N   task-aware ranked search (Router 0.1) + URN-prefix filter for N
  load <urn>                download default revision into <cache_root>/skills/<urn>/<rev>/
  validate                  CI: enforce CONVENTIONS.md on all skills
  drift --base <ref>        CI: code diff ∩ metadata.references → report
  publish --changed         CI: zip + CreateSkill/CreateSkillRevision for changed skills
  index [--check]           CI: regenerate the hierarchy-index skill + build/verify the binary
                             retrieval artifact at <cache_root>/index/<sha>/ (E1.4)
  materialize [--check]     CI: generate L0 scope cards (AGENTS.md per node, applyTo instructions, CLAUDE.md/GEMINI.md)
  hook                      harness hook (Claude Code / Codex): read JSON on stdin, print <=4 cards
                             for the prompt from the pre-built index artifact only — never
                             guidefold.yaml, never PyYAML, hard watchdog (E1.5)
  prewarm                   Copilot sessionStart: download the node chain's skills into <cache_root>/skills
  init                      bootstrap a consumer monorepo in one command: guidefold.yaml skeleton, .agents/skills/guidefold, harness hooks, CI workflow, .gitignore entries
  doctor [--json]           diagnose a configured repo: gcloud/ADC/roles, hook wiring, skill layout, index freshness — prints a fix for every failure

Design notes
  * All registry access goes through the `registry` section so it can be swapped for MCP
    or an ARD endpoint later without touching SKILL.md (ADR-0003).
  * Uses `gcloud` for auth and for search (Preview API), REST for payload upload/download.
  * Ranking (find) builds an in-memory Index by scanning the local tree via `all_skills()`.
    `hook` instead loads the immutable on-disk artifact `guidefold index` already built for the
    current sha (E1.4) — same Router, same ranking code, different Index source; see
    "Index artifact (E1.4)" below for the file layout. Registry/LocalRegistry are storage +
    transport only (`publish`/`download`/`search_scope`) — no ranking lives there.
  * Intentionally dependency-light: stdlib + PyYAML (imported lazily — see load_map/frontmatter
    — so commands that never touch guidefold.yaml/SKILL.md, e.g. `--help` and `hook`, don't pay
    for it: `hook`'s whole code path imports zero PyYAML, provable with `python3 -X importtime`).
"""
import argparse, array, datetime, fnmatch, hashlib, io, json, math, mmap, os, re, signal, shutil, struct, subprocess, sys, tempfile, unicodedata, uuid, zipfile
from functools import cmp_to_key
from pathlib import Path

# CLI version stamped into shadow telemetry (E1.6) so a later analysis pass can tell which
# ranking code produced a given shadow record. Bump by hand on a user-visible behaviour change;
# nothing parses this beyond string equality today.
CLI_VERSION = "0.1.0"

# ---------------------------------------------------------------- repo helpers
def repo_root() -> Path:
    """Monorepo root = nearest ancestor holding guidefold.yaml (or $GUIDEFOLD_ROOT); git toplevel as fallback."""
    env = os.environ.get("GUIDEFOLD_ROOT")
    if env:
        return Path(env).resolve()
    here = Path.cwd().resolve()
    for d in (here, *here.parents):
        if (d / "guidefold.yaml").is_file():
            return d
    out = subprocess.run(["git", "rev-parse", "--show-toplevel"], capture_output=True, text=True)
    if out.returncode != 0:
        sys.exit("guidefold: no guidefold.yaml above cwd and not inside a git repository")
    return Path(out.stdout.strip())

def load_map(root: Path) -> dict:
    try:
        import yaml
    except ImportError:  # keep the failure loud but friendly
        sys.exit("guidefold: PyYAML missing — pip install pyyaml")
    cfg = yaml.safe_load((root / "guidefold.yaml").read_text())
    cfg.setdefault("nodes", {}).setdefault("_root", {"paths": ["**"], "owner": "unknown"})
    return cfg

def rel(root: Path, p: Path) -> str:
    return str(p.resolve().relative_to(root)).replace(os.sep, "/")

def node_for(cfg: dict, relpath: str) -> str:
    """Most specific node whose paths match relpath (longest glob wins)."""
    best, best_len = "_root", -1
    for node, spec in cfg["nodes"].items():
        for g in spec.get("paths", []):
            if fnmatch.fnmatch(relpath + "/", g) or fnmatch.fnmatch(relpath, g):
                if len(g) > best_len:
                    best, best_len = node, len(g)
    return best

def ancestors(node: str) -> list:
    """atlas.identity.turnstile -> [atlas.identity.turnstile, atlas.identity, atlas, _root]"""
    parts = node.split(".") if node != "_root" else []
    chain = [".".join(parts[:i]) for i in range(len(parts), 0, -1)]
    return chain + ["_root"]

def urn(cfg: dict, node: str, name: str) -> str:
    return f"urn:skill:{cfg['publisher']}:{node}:{name}"

# ------------------------------------------------------------- registry layer
# Verified against Agent Registry v1alpha on 2026-09-04 (see docs/adr/ADR-0008 and docs/ASSESSMENT.md):
#   * resource id we choose:  <publisher>--<node with . -> ->--<name>   ("root" for _root)
#   * server stores it as     private-<resource id>  and assigns
#     skillId = urn:skill:projects-<NUMBER>:locations:<LOC>:private-<resource id>
#   * create (draft, no payload) -> revisions create --payload=<zip> -> update --default-revision -> update --target-state=active
#   * keyword prefix search:  skillId:private-<publisher>--<flat-node>*   (short form only)
#   * revisions download --destination=<dir> extracts the zip into <dir>
ZIP_MAX_COMPRESSED = 500 * 1024        # system limit (fixed)
ZIP_MAX_FILE = 1024 * 1024             # system limit (fixed)
KEEP_REVISIONS = 20                    # quota is 100 revisions per skill

def flat_node(node: str) -> str:
    return node.lstrip("_").replace(".", "-")

def parse_urn(u: str):
    """urn:skill:<publisher>:<node>:<name> -> (publisher, node, name)"""
    parts = u.split(":")
    if len(parts) != 5 or parts[:2] != ["urn", "skill"]:
        sys.exit(f"guidefold: not a logical skill URN: {u}")
    return parts[2], parts[3], parts[4]

def zip_skill_dir(skill_dir: Path, zpath: Path):
    with zipfile.ZipFile(zpath, "w", zipfile.ZIP_DEFLATED) as z:
        for f in sorted(skill_dir.rglob("*")):
            if f.is_file() and not any(part in (".git", "__pycache__") for part in f.parts):
                if f.stat().st_size > ZIP_MAX_FILE:
                    sys.exit(f"guidefold: {f} exceeds 1 MB per-file limit")
                z.write(f, f.relative_to(skill_dir))
    if zpath.stat().st_size > ZIP_MAX_COMPRESSED:
        sys.exit(f"guidefold: {skill_dir} zips to {zpath.stat().st_size} bytes > 500 KB limit")

class Registry:
    """Google Cloud Agent Registry backend (gcloud alpha). Storage + transport only (ADR-0003,
    E0.2): `search_scope`/`download`/`publish`/`default_revision`. No ranking lives here — that's
    Router 0.1 (see Index/Router below), which never depends on this class."""
    def __init__(self, cfg):
        self.cfg = cfg
        self.project = cfg["registry"]["project"]
        self.location = cfg["registry"].get("location", "global")
        self.publisher = cfg["publisher"]
        self._node_by_flat = {flat_node(n): n for n in cfg["nodes"]}
        self._node_by_flat["index"] = "_index"

    # --- gcloud plumbing
    def _gcloud(self, *args, fmt="json", check=True):
        cmd = ["gcloud", "alpha", "agent-registry", *args,
               f"--project={self.project}", f"--location={self.location}", f"--format={fmt}"]
        out = subprocess.run(cmd, capture_output=True, text=True)
        if out.returncode != 0:
            if check:
                err = [l for l in out.stderr.splitlines() if l.strip() and not l.startswith((".", "Waiting for", "Create request", "Update request"))]
                sys.exit("guidefold: gcloud failed: " + " | ".join(err[:4]) if err else f"guidefold: gcloud failed: {' '.join(cmd)}")
            return None
        if fmt != "json":
            return out.stdout
        return json.loads(out.stdout or "null")

    # --- id mapping (ADR-0008)
    def resource_id(self, node: str, name: str) -> str:
        return f"{self.publisher}--{flat_node(node)}--{name}"

    def registry_name(self, node: str, name: str) -> str:
        return "private-" + self.resource_id(node, name)

    def full_name(self, node: str, name: str) -> str:
        return f"projects/{self.project}/locations/{self.location}/skills/{self.registry_name(node, name)}"

    def to_logical(self, s: dict):
        """registry search/list result -> (logical urn, node, name) or None if not ours."""
        rid = (s.get("skillId") or "").rsplit(":", 1)[-1]
        prefix = f"private-{self.publisher}--"
        if not rid.startswith(prefix):
            return None
        flat, _, name = rid[len(prefix):].partition("--")
        node = self._node_by_flat.get(flat)
        if node is None:                                    # fallback: exact node from the description tag
            m = re.match(r"\[([^\]]+)\]", s.get("description", ""))
            node = m.group(1).replace("/", ".") if m and m.group(1) != self.publisher else "_root"
        return urn(self.cfg, node, name), node, name

    def _cards(self, results):
        cards = []
        for s in results or []:
            lg = self.to_logical(s)
            if lg:
                cards.append({"urn": lg[0], "node": lg[1], "name": lg[2],
                              "description": s.get("description", ""), "registry": s.get("skillId")})
        return cards

    # --- reads
    def search_scope(self, nodes):
        """All our skills whose node is in `nodes` (one prefix call per distinct top-level segment)."""
        wanted = set(nodes)
        tops = {flat_node(n).split("-")[0] for n in nodes}
        hits = []
        for top in tops:
            q = f"skillId:private-{self.publisher}--{top}*"
            hits += self._cards(self._gcloud("skills", "search", f"--query={q}", "--search-type=keyword"))
        seen, out = set(), []
        for c in hits:
            if c["node"] in wanted and c["urn"] not in seen:
                seen.add(c["urn"]); out.append(c)
        return out

    def default_revision(self, logical_urn: str) -> str:
        """Resolve the server's default revision id for `logical_urn` without downloading it —
        used by `load`/`prewarm` to compute the E1.7 cache path before deciding whether a
        download is even needed (the cache is immutable, keyed by this revision)."""
        _, node, name = parse_urn(logical_urn)
        rname = self.registry_name(node, name)
        meta = self._gcloud("skills", "describe", rname)
        rev = (meta.get("defaultRevision") or "").rsplit("/", 1)[-1]
        if not rev:
            sys.exit(f"guidefold: {logical_urn} has no default revision")
        return rev

    def download(self, logical_urn: str, dest: Path, rev: str = None):
        _, node, name = parse_urn(logical_urn)
        rname = self.registry_name(node, name)
        if rev is None:
            rev = self.default_revision(logical_urn)
        with tempfile.TemporaryDirectory() as td:
            self._gcloud("skills", "revisions", "download", rev, f"--skill={rname}",
                         f"--destination={td}", "--allow-overwrite", fmt="none")
            src = Path(td)
            if not (src / "SKILL.md").exists():                  # gcloud nests the payload under <revision-id>/
                nested = [d for d in src.iterdir() if (d / "SKILL.md").exists()]
                if len(nested) != 1:
                    sys.exit(f"guidefold: unexpected payload layout for {logical_urn}: {[x.name for x in src.iterdir()]}")
                src = nested[0]
            if dest.exists():
                shutil.rmtree(dest)
            shutil.copytree(src, dest)

    # --- writes (CI only)
    def publish(self, node: str, name: str, skill_dir: Path, display: str, desc: str, rev_id: str):
        rid, rname = self.resource_id(node, name), self.registry_name(node, name)
        existing = self._gcloud("skills", "describe", rname, check=False)
        if existing is None:
            self._gcloud("skills", "create", rid, f"--display-name={display[:63]}", f"--description={desc[:2048]}",
                         "--type=simple", "--target-state=draft")
        elif existing.get("description") != desc[:2048] or existing.get("displayName") != display[:63]:
            self._gcloud("skills", "update", rname, f"--display-name={display[:63]}", f"--description={desc[:2048]}")
        with tempfile.TemporaryDirectory() as td:
            zpath = Path(td) / f"{rid}.zip"
            zip_skill_dir(skill_dir, zpath)
            self._gcloud("skills", "revisions", "create", rev_id, f"--skill={rname}", f"--payload={zpath}")
        self._gcloud("skills", "update", rname, f"--default-revision={self.full_name(node, name)}/revisions/{rev_id}")
        target = "deprecated" if desc.startswith("DEPRECATED") else "active"
        current = (existing or {}).get("targetState", "TARGET_STATE_DRAFT").lower()
        if current == "target_state_draft":
            self._gcloud("skills", "update", rname, "--target-state=active"); current = "target_state_active"
        if current != f"target_state_{target}":
            self._gcloud("skills", "update", rname, f"--target-state={target}")
        revs = self._gcloud("skills", "revisions", "list", f"--skill={rname}") or []
        others = [r for r in revs if not r["name"].endswith("/" + rev_id)]
        failed = [r for r in others if r.get("state") == "FAILED"]                 # rejected payloads: drop immediately
        old = sorted((r for r in others if r.get("state") != "FAILED"), key=lambda r: r.get("createTime", ""))
        for r in failed + old[: max(0, len(old) - (KEEP_REVISIONS - 1))]:
            self._gcloud("skills", "revisions", "delete", r["name"].rsplit("/", 1)[-1], f"--skill={rname}", "--quiet", fmt="none")
        return rname

class LocalRegistry:
    """Filesystem backend (registry.backend: local): the monorepo itself is the registry. Same
    storage/transport interface as Registry — no ranking (E0.2)."""
    def __init__(self, cfg, root: Path):
        self.cfg, self.root = cfg, root
        self._skills = [(d, node, fm) for d, node, fm in all_skills(root, cfg)]
        self._head_rev = _git_head_short(root)

    def _card(self, d, node, fm):
        return {"urn": urn(self.cfg, node, d.name), "node": node, "name": d.name,
                "description": fm.get("description", ""), "registry": "local:" + rel(self.root, d)}

    def search_scope(self, nodes):
        wanted = set(nodes)
        return [self._card(d, n, fm) for d, n, fm in self._skills if n in wanted]

    def default_revision(self, logical_urn: str) -> str:
        """`backend: local` has no per-skill revisioning — the monorepo's current commit stands
        in for it, so the E1.7 cache still gets a fresh, immutable dir per commit."""
        return self._head_rev

    def download(self, logical_urn: str, dest: Path, rev: str = None):
        _, node, name = parse_urn(logical_urn)
        for d, n, fm in self._skills:
            if n == node and d.name == name:
                if dest.exists():
                    shutil.rmtree(dest)
                shutil.copytree(d, dest)
                return
        sys.exit(f"guidefold: {logical_urn} not found in local tree")

    def publish(self, *a, **k):
        sys.exit("guidefold: publish is a no-op with registry.backend: local")

def registry_for(cfg, root: Path):
    backend = (cfg.get("registry") or {}).get("backend", "agent-registry")
    return LocalRegistry(cfg, root) if backend == "local" else Registry(cfg)

def _git_head_short(root: Path) -> str:
    out = subprocess.run(["git", "rev-parse", "--short=7", "HEAD"], capture_output=True, text=True, cwd=root)
    return out.stdout.strip() if out.returncode == 0 and out.stdout.strip() else "worktree"

def _commit_time(root: Path, sha: str) -> str:
    """ISO-8601 commit timestamp for `sha`, or None for the "worktree" (uncommitted) fallback.
    E1.4 reproducibility ("same git sha in -> byte-identical artifact out") needs manifest.json's
    build_time to be a function of the sha, not of wall-clock — a real commit has a stable time
    to anchor to; an uncommitted tree does not, so that one case falls back to wall-clock and
    accepts that manifest.json alone won't be byte-identical across two such builds."""
    if sha == "worktree":
        return None
    out = subprocess.run(["git", "show", "-s", "--format=%cI", sha], capture_output=True, text=True, cwd=root)
    t = out.stdout.strip()
    return t if out.returncode == 0 and t else None

# ------------------------------------------------------------------- cache (E1.7)
# Layout: <cache_root>/skills/<urn>/<rev>/ and <cache_root>/index/<sha>/ — both trees immutable
# (a given <urn>/<rev> or <sha> is never rewritten, only evicted). cache_root defaults to
# ~/.cache/guidefold, overridable with $GUIDEFOLD_CACHE. `index/<sha>/` is not populated by this
# PR (the in-memory Index isn't persisted yet — that's E1.4); the path helper and eviction logic
# exist now so that later PR only has to add a writer, not a layout.
DEFAULT_SKILLS_CACHE_CAP = 500   # immutable <urn>/<rev> dirs kept before LRU eviction
DEFAULT_INDEX_CACHE_CAP = 20     # immutable <sha> dirs kept before LRU eviction

def cache_root() -> Path:
    env = os.environ.get("GUIDEFOLD_CACHE")
    return Path(env).expanduser() if env else Path.home() / ".cache" / "guidefold"

def _encode_urn_segment(u: str) -> str:
    """Filesystem-safe, round-trippable encoding of a URN for use as a cache directory name.
    ':' separates URN fields but is illegal/awkward as a path segment on several filesystems
    (notably Windows/WSL-interop paths); '%' is reserved as our escape character. Escape '%'
    first so the round trip is unambiguous."""
    return u.replace("%", "%25").replace(":", "%3A")

def _decode_urn_segment(seg: str) -> str:
    return seg.replace("%3A", ":").replace("%25", "%")

def skill_cache_dir(logical_urn: str, rev: str) -> Path:
    return cache_root() / "skills" / _encode_urn_segment(logical_urn) / rev

def index_cache_dir(sha: str) -> Path:
    return cache_root() / "index" / sha

def _leaf_dirs(tree_root: Path, depth: int) -> list:
    """All directories exactly `depth` levels under tree_root — the immutable units we evict
    (depth=2 for skills/<urn>/<rev>, depth=1 for index/<sha>)."""
    if not tree_root.is_dir():
        return []
    level = [tree_root]
    for _ in range(depth):
        nxt = []
        for p in level:
            nxt.extend(d for d in p.iterdir() if d.is_dir())
        level = nxt
    return level

def evict_lru(tree_root: Path, depth: int, cap: int):
    """Both cache trees are immutable: entries are never invalidated, only evicted, oldest
    directory-mtime first once the count exceeds `cap`. Callers touch (os.utime) a dir on every
    cache hit so mtime tracks last-use, not just creation time — true LRU, not LRU-by-birth."""
    dirs = _leaf_dirs(tree_root, depth)
    if len(dirs) <= cap:
        return
    dirs.sort(key=lambda d: d.stat().st_mtime)
    for d in dirs[: len(dirs) - cap]:
        shutil.rmtree(d, ignore_errors=True)

def _cache_cap(cfg: dict, key: str, default: int) -> int:
    return int(((cfg.get("cache") or {}).get(key, default)))

# ---------------------------------------------------------------- frontmatter
FM = re.compile(r"^---\n(.*?)\n---", re.S)

def frontmatter(skill_md: Path) -> dict:
    try:
        import yaml
    except ImportError:
        sys.exit("guidefold: PyYAML missing — pip install pyyaml")
    m = FM.match(skill_md.read_text())
    return yaml.safe_load(m.group(1)) if m else {}

def md_list(md: dict, key: str) -> list:
    """metadata.<key> is a comma-separated string (Agent Registry rejects non-scalar metadata, ADR-0010);
    YAML lists are still parsed so validate can report them. Splits on commas AND whitespace, which
    is correct for URN/path lists (requires/refines/replaces/references) — those items never
    contain internal spaces — but wrong for anything whose items are multi-word phrases; use
    `md_phrases` for those instead."""
    v = (md or {}).get(key)
    if v is None or v == "":
        return []
    if isinstance(v, list):
        return [str(x).strip() for x in v if str(x).strip()]
    return [x.strip() for x in re.split(r"[,\s]+", str(v)) if x.strip()]

def md_phrases(md: dict, key: str) -> list:
    """metadata.<key> is a comma-separated string of PHRASES, each of which may itself contain
    spaces (`triggers`, `negative_triggers`: "planned auth change, policy edit" is two phrases,
    not five words). Splits on commas only — never on whitespace — so a two-word negative_trigger
    stays a two-word phrase instead of being shredded into single-word bans (the P1 bug found in
    PR #7 review: "auth" alone was hard-dropping the on-call runbook from every auth-related
    query). Each phrase's own words are tokenized later, at the point of use, by `tokenize()`."""
    v = (md or {}).get(key)
    if v is None or v == "":
        return []
    if isinstance(v, list):
        return [str(x).strip() for x in v if str(x).strip()]
    return [x.strip() for x in str(v).split(",") if x.strip()]

KIND_VALUES = ("governance", "engineering", "knowledge", "ways-of-working", "temporal")
LAYER_VALUES = ("org", "platform", "team")

def node_depth(node: str) -> int:
    """_root -> 0; each dot in the node path adds one level (collapsed to org/platform/team for MVP)."""
    return 0 if node == "_root" else node.count(".") + 1

def check_urn_refs(md: dict, key: str, urns: dict, rd, errors: list):
    """Every URN in metadata.<key> must exist in the tree — shared by requires/refines/replaces."""
    for r in md_list(md, key):
        if r not in urns:
            errors.append(f"{rd}: {key} unknown skill {r}")

def check_cycles(graph: dict, label: str, errors: list):
    """DFS cycle detector shared by the requires graph and the refines graph."""
    state = {}
    def visit(n, stack):
        state[n] = 1
        for m in graph.get(n, []):
            if state.get(m) == 1:
                errors.append(f"{label} cycle: " + " -> ".join(stack + [m]))
            elif state.get(m) is None:
                visit(m, stack + [m])
        state[n] = 2
    for u in graph:
        if state.get(u) is None:
            visit(u, [u])

def all_skills(root: Path, cfg: dict, include_generated: bool = False):
    for md in sorted(root.rglob(".agents/skills/*/SKILL.md")):
        if ".guidefold" in md.parts:
            continue
        fm = frontmatter(md)
        meta = fm.get("metadata") or {}
        if str(meta.get("generated", "")).lower() == "true":   # e.g. hierarchy-index written by `guidefold index`
            if not include_generated:
                continue
            yield md.parent, meta.get("scope", "_index"), fm
            continue
        d = md.parent
        yield d, node_for(cfg, rel(root, d)), fm

# ------------------------------------------------------------------ tokenizer
# One shared tokenizer for Index build and Router query time (ROUTER-SPEC "Determinism by
# construction"), byte-identical to tools/bakeoff/tokenizer.py: NFKD-normalize then strip
# every combining mark the decomposition produced (folds accented Latin letters onto their
# base letter, e.g. "cafe" from "cafe" + combining acute, instead of an NFC-only pass that
# would leave the accented code point in place for an ASCII-only filter to drop wholesale --
# that dropped-not-folded bug shredded every accented word to its consonant skeleton, e.g.
# "RESUME" -> ['r', 'sum'] instead of ['resume']; see PR "fix: shared tokenizer accent
# folding, Zipf direction, and document normalisation"), then ASCII-only lowercase (never
# str.lower(), whose Unicode case table can shift across Python versions), split on
# [a-z0-9]+. If you change this, tools/bakeoff/tokenizer.py must change identically in the
# same commit, or word ids silently drift between CI and the hook.
_ASCII_UPPER_TO_LOWER = str.maketrans(
    "ABCDEFGHIJKLMNOPQRSTUVWXYZ", "abcdefghijklmnopqrstuvwxyz")
_TOKEN_RE = re.compile(r"[a-z0-9]+")

def _ascii_lower(s: str) -> str:
    return s.translate(_ASCII_UPPER_TO_LOWER)

def _fold_accents(text: str) -> str:
    decomposed = unicodedata.normalize("NFKD", text)
    return "".join(ch for ch in decomposed if not unicodedata.combining(ch))

def tokenize(text: str) -> list:
    return _TOKEN_RE.findall(_ascii_lower(_fold_accents(text or "")))

# -------------------------------------------------------------------- Index
class Index:
    """The in-memory routing artifact (ROUTER-SPEC "Class split"). Built by scanning the tree
    via `all_skills()` — for this PR there is no on-disk artifact (that's E1.4); Router depends
    only on the public attributes below, so swapping the build source later touches nothing
    outside this class.

    Holds: `cards` (urn -> card dict), `nodes` (from guidefold.yaml), `graph` (requires/refines/
    replaces/similar adjacency), field-weighted BM25 postings with integer-precomputed IDF and
    per-field length normalization, a static word/skill dense-vector table (empty until E1.4/E1.3
    ship one — `weights["w_dense"]` stays 0), and `weights` (never module constants, so a
    guidefold.yaml `router.weights` override works without touching this class).

    Determinism: math.log is used exactly once per term, here at build time, to compute IDF —
    then immediately rounded to a scaled integer (round(x * 2**20)). Everything Router does at
    query time (candidates/score/select) is pure integer arithmetic.
    """

    K1 = 1.2
    B = 0.75
    IDF_SCALE = 1 << 20
    RRF_SCALE = 1 << 20
    RRF_K = 60
    PPR_ALPHA_NUM, PPR_ALPHA_DEN = 15, 100   # alpha = 0.15 (ROUTER-SPEC)
    PPR_ITERS = 20
    FIELDS = ("name", "description", "digest", "triggers", "body")

    DEFAULT_WEIGHTS = {
        "field.name": 6, "field.description": 4, "field.digest": 3,
        "field.triggers": 5, "field.body": 2,
        # RRF (k=60) over IDF_SCALE=2**20 has a deliberately *flat* dynamic range — by design
        # (Reciprocal Rank Fusion trades magnitude for rank-robustness): over a candidate pool the
        # size this router actually sees (dozens, not thousands), a single-rank step is only
        # ~230-280 units (SCALE/((k+r)(k+r+1)), largest between rank1 and rank2), and rank1-vs-
        # rank8 over an 8-candidate pool spans only ~1770 units. w_scope/w_ppr are calibrated so
        # that even their *maximum* possible contribution (hops=0 for scope; a hit that receives
        # essentially all reverse-PPR mass) stays under one rank step — otherwise the "feature"
        # becomes a de facto sort key again (the P0 bug, just moved downstream; PR #7 review
        # measured the previous 600/2000 values at ~2.4 and ~8 rank-steps respectively, both far
        # too large). Values are chosen on this margin, not tuned against tests/golden/*.yaml —
        # tools/eval/run_golden.py is the tuning signal; see docs/reports/golden/ for before/after.
        "w_scope": 200, "w_ppr": 250, "w_dense": 0,   # w_dense = 0 until the E1.3 bake-off (ADR-0020)
        "edge.requires": 100, "edge.refines": 60, "edge.replaces": 40, "edge.similar": 30,
        "abstain_threshold": 1200,
        # ppr_mode selects which prerequisite-propagation implementation `score()` calls:
        # "pagerank" (_reverse_ppr) or "closure" (default, _decayed_closure, ADR-0020's rejected-
        # alternative note -- a decayed two-hop `requires` walk, no power iteration, no out-degree
        # normalisation). E1 config-selection (docs/reports/tuning/E1-config-selection.md) measured
        # both against the golden set on a held-out split: byte-identical on every metric, on both
        # the tune half and the holdout half independently. Given that equivalence, "closure" ships
        # as the default -- it is exactly hand-verifiable (see test_decayed_closure_matches_the_
        # documented_per_hop_fraction) where pagerank's fixed-point iteration is not. This was
        # measured on a shallow, sparse requires-graph (out-degree ~0.6, see ADR-0020); revisit if
        # a monorepo's graph grows deep/dense enough that out-degree normalisation could matter.
        "ppr_mode": "closure",
        "closure_decay_num": 1, "closure_decay_den": 2,   # _decayed_closure: mass *= 1/2 per hop
        # abstain_mode selects the confidence signal `select()` gates on: "magnitude" (default,
        # scored[0]["score"] < abstain_threshold) or "margin" (rank1-rank2 score gap <
        # abstain_margin_threshold). RRF gives any rank-1 hit a near-constant high score, so
        # magnitude cannot discriminate no_applicable cases from real ones (see
        # docs/reports/golden/README.md); margin was measured as the obvious alternative signal
        # in docs/reports/tuning/E1-config-selection.md -- see that report for the verdict.
        "abstain_mode": "magnitude",
        "abstain_margin_threshold": 1200,
    }

    def __init__(self, cards, nodes, weights):
        self.cards = cards            # urn -> card dict
        self.nodes = nodes            # node -> {owner, paths, ...} from guidefold.yaml
        self.weights = weights
        self.graph = {"requires": {}, "refines": {}, "replaces": {}, "similar": {}}
        self.postings = {f: {} for f in self.FIELDS}   # field -> term -> {urn: tf}
        self.idf = {}                                  # term -> scaled int
        self.field_len = {f: {} for f in self.FIELDS}  # field -> {urn: token count}
        self.field_norm = {f: {} for f in self.FIELDS}  # field -> {urn: scaled int normalization factor}
        self.word_vectors = {}        # word -> tuple[int,...]   (tier-1 static table; empty this PR)
        self.skill_vectors = {}       # urn -> tuple[int,...]
        self.skill_normsq = {}        # urn -> int (|d|^2, integer — never store/compare |d|)

    @classmethod
    def build(cls, root: Path, cfg: dict, word_vectors: dict = None):
        cards = {}
        for d, node, fm in all_skills(root, cfg):
            name = d.name
            u = urn(cfg, node, name)
            md = fm.get("metadata") or {}
            body = (d / "SKILL.md").read_text(errors="ignore")
            cards[u] = {
                "urn": u, "node": node, "name": name,
                "description": str(fm.get("description", "")),
                "digest": md.get("digest") or str(fm.get("description", ""))[:200],
                "triggers": md_phrases(md, "triggers"),
                "negative_triggers": md_phrases(md, "negative_triggers"),
                "requires": md_list(md, "requires"),
                "refines": md_list(md, "refines"),
                "status": md.get("status", "active"),
                "replaced_by": md.get("replaced_by"),
                "kind": md.get("kind"),
                "layer": md.get("layer"),
                "owner": md.get("owner"),
                "_body": body,
            }
        return cls.from_cards(cards, cfg["nodes"], weights=(cfg.get("router") or {}).get("weights"),
                               word_vectors=word_vectors)

    @classmethod
    def from_cards(cls, cards: dict, nodes: dict, weights: dict = None, word_vectors: dict = None):
        """Build an Index directly from pre-built card dicts, bypassing the tree scan — used by
        unit tests to construct small, hand-controlled fixtures (policy filter, BM25, RRF, PPR,
        dense, closure, abstention, ordering) without a filesystem tree. Each card must carry at
        least the keys `Index.build` produces (urn/node/name/description/digest/triggers/
        negative_triggers/requires/refines/status/replaced_by/_body)."""
        w = {**cls.DEFAULT_WEIGHTS, **(weights or {})}
        idx = cls(dict(cards), dict(nodes), w)
        idx._build_graph()
        idx._build_bm25()
        idx._build_dense(word_vectors or {})
        return idx

    def _build_graph(self):
        urns = set(self.cards)
        for u, c in self.cards.items():
            self.graph["requires"][u] = [r for r in c["requires"] if r in urns]
            self.graph["refines"][u] = [r for r in c.get("refines", []) if r in urns]
            self.graph["similar"].setdefault(u, [])
            if c["status"] == "deprecated" and c.get("replaced_by") in urns:
                self.graph["replaces"].setdefault(c["replaced_by"], []).append(u)
        for u in urns:
            self.graph["requires"].setdefault(u, [])
            self.graph["refines"].setdefault(u, [])
            self.graph["replaces"].setdefault(u, [])

    def _field_text(self, card, field):
        if field == "name":
            return card["name"].replace("-", " ")
        if field == "description":
            return card["description"]
        if field == "digest":
            return card["digest"]
        if field == "triggers":
            return " ".join(card["triggers"])
        if field == "body":
            return card["_body"]
        return ""

    def _build_bm25(self):
        postings = {f: {} for f in self.FIELDS}
        field_len = {f: {} for f in self.FIELDS}
        doc_freq = {}
        for u, c in self.cards.items():
            doc_terms = set()
            for f in self.FIELDS:
                toks = tokenize(self._field_text(c, f))
                field_len[f][u] = len(toks)
                tf = {}
                for t in toks:
                    tf[t] = tf.get(t, 0) + 1
                    doc_terms.add(t)
                for t, n in tf.items():
                    postings[f].setdefault(t, {})[u] = n
            for t in doc_terms:
                doc_freq[t] = doc_freq.get(t, 0) + 1
        n_docs = max(1, len(self.cards))
        idf = {}
        for t, df in doc_freq.items():
            x = math.log(1.0 + (n_docs - df + 0.5) / (df + 0.5))   # the one math.log call — build time only
            idf[t] = round(x * self.IDF_SCALE)
        field_norm = {f: {} for f in self.FIELDS}
        for f in self.FIELDS:
            lens = [n for n in field_len[f].values() if n > 0]
            avg = (sum(lens) / len(lens)) if lens else 1.0
            for u in self.cards:
                ln = field_len[f].get(u, 0)
                ratio = (ln / avg) if avg > 0 else 0.0
                norm = (1 - self.B) + self.B * ratio
                field_norm[f][u] = max(1, round(norm * self.IDF_SCALE))
        self.postings, self.idf, self.field_len, self.field_norm = postings, idf, field_len, field_norm

    def _build_dense(self, word_vectors: dict):
        self.word_vectors = dict(word_vectors)
        self.skill_vectors, self.skill_normsq = {}, {}
        if not self.word_vectors:
            return
        dims = len(next(iter(self.word_vectors.values())))
        for u, c in self.cards.items():
            text = " ".join([c["name"].replace("-", " "), c["description"], c["digest"],
                              " ".join(c["triggers"]), c["_body"]])
            vec = [0] * dims
            for t in tokenize(text):
                wv = self.word_vectors.get(t)
                if wv:
                    for i in range(dims):
                        vec[i] += wv[i]
            self.skill_vectors[u] = tuple(vec)
            self.skill_normsq[u] = sum(x * x for x in vec)

# ------------------------------------------------------------- Index artifact (E1.4)
# On-disk form of an Index, keyed by git sha, written once by `guidefold index` and read many
# times by `guidefold hook` (E1.5). ROUTER-SPEC "Determinism by construction" + the BRIEF's
# measured probe (JSON-eager postings: 193ms at 2k skills against a 300ms budget; binary lazy
# postings: 0.3ms) drive two hard rules for every file here:
#   1. little-endian is declared explicitly everywhere multi-byte integers are packed (`struct`,
#      never `array.fromfile`/raw `array.array('I', ...)`, both of which are native-order).
#   2. postings.bin (and vectors.i8/words.bin) are read lazily through an mmap: only the byte
#      range a query's own terms/urns resolve to is ever paged in. The *offset* tables that make
#      that possible (postings.idx, words.idx, terms.bin) are small enough to load eagerly in
#      full — a few thousand entries even at 2k skills — and Index.build already proves that.
#
# Files (all under <cache_root>/index/<sha>/, see index_cache_dir):
#   manifest.json   git_sha, build_time, weights, counts, quant_scale, teacher (null this PR),
#                   and a sha256 checksum of every other file below (index --check's contract).
#   cards.jsonl     one compact JSON object per doc, one line per doc, in sorted-URN doc-id order
#                   (that order IS the doc-id map: line N is doc N in postings.bin/vectors.i8).
#                   No `_body`/`requires`/`refines` — Router never reads those at query time
#                   (BM25 is already baked into postings.bin; the graph is graph.json).
#   graph.json      requires/refines/replaces/similar adjacency (Index.graph), unchanged shape.
#   nodes.json      guidefold.yaml's `nodes` map, verbatim — `cwd -> node` at hook time resolves
#                   from THIS, never the working-tree guidefold.yaml (ROUTER-SPEC).
#   terms.bin       global per-term IDF (Index.idf): [varint term_len, term utf-8, varint idf]*,
#                   sorted by term. Eagerly parsed into a dict at load time.
#   norms.bin       per-(field, doc) BM25 length-normalisation (Index.field_norm): FIELDS blocks
#                   of n_docs little-endian uint32s each, doc order = cards.jsonl order. Eager.
#   postings.bin    delta-varint doc-id postings, one contiguous block per (field, term):
#                   [varint(doc_id delta), varint(tf)]* — mmap'd, sliced lazily per query term.
#   postings.idx    the offset+length table for postings.bin: [varint field_index, varint
#                   term_len, term utf-8, varint offset, varint length]*, sorted by (field, term).
#                   Eagerly parsed into a {(field, term): (offset, length)} dict.
#   vectors.i8      tier-1 dense skill vectors (Index.skill_vectors): n_docs rows of `dims` int8
#                   bytes, doc order = cards.jsonl order. Empty iff dims == 0.
#   words.bin       tier-1 dense word table (Index.word_vectors): one row of `dims` int8 bytes
#                   per distinct word, row order = sorted(word). Empty iff dims == 0 — no
#                   distilled table ships with E1.4 (w_dense stays 0; see ADR-0020). The format
#                   and its lazy-load path are exercised by a synthetic hand-built table in
#                   tests/test_index_artifact.py, never by invented vectors.
#   words.idx       the vocabulary list backing words.bin's row order: one word per line, UTF-8.
#                   words.bin/vectors.i8 need this the same way postings.bin needs postings.idx —
#                   a string->row lookup is unavoidably eager (same as any embedding table).
#
# postings.idx/words.idx/terms.bin are additions beyond the file list sketched in ROUTER-SPEC's
# aspirational design: that list didn't say where per-term IDF or per-field length norms would
# live on disk, and "postings.bin ... with a separate offset+length table" only named the BM25
# side of it. These three files are the minimal, symmetric answer for the dense side and for
# IDF/norms; nothing here changes Router's read contract (idx.idf / idx.field_norm / idx.postings
# / idx.word_vectors / idx.skill_vectors / idx.skill_normsq are still exactly the attributes
# Router reads — only their storage moved from "always in memory" to "lazily faulted in").

def _varint_encode(n: int) -> bytes:
    """Unsigned LEB128. Doc-id deltas and term frequencies are never negative, so no zig-zag/
    sign handling is needed anywhere in this artifact."""
    out = bytearray()
    while True:
        b = n & 0x7F
        n >>= 7
        if n:
            out.append(b | 0x80)
        else:
            out.append(b)
            return bytes(out)

def _varint_decode(buf, pos: int):
    """One varint starting at buf[pos] (buf: bytes/bytearray/memoryview/an mmap slice, all of
    which support integer indexing). Returns (value, next_pos)."""
    result = 0
    shift = 0
    while True:
        b = buf[pos]
        pos += 1
        result |= (b & 0x7F) << shift
        if not (b & 0x80):
            return result, pos
        shift += 7

def _dense_dims(idx: Index) -> int:
    return len(next(iter(idx.word_vectors.values()))) if idx.word_vectors else 0

def _open_mmap(path: Path):
    """(file_obj, mmap_obj) for `path`, or (None, None) for a zero-byte file — mmap.mmap refuses
    to map an empty file, and vectors.i8/words.bin are legitimately empty whenever dims == 0
    (no distilled table shipped). Callers MUST keep both return values alive for the life of any
    memoryview/slice taken from the mmap (stash them as instance attributes) — letting the file
    object get garbage-collected closes the fd out from under the mmap (`OSError: [Errno 9] Bad
    file descriptor`)."""
    if path.stat().st_size == 0:
        return None, None
    fh = path.open("rb")
    mm = mmap.mmap(fh.fileno(), 0, access=mmap.ACCESS_READ)
    return fh, mm

class _LazyFieldPostings:
    """dict-like idx.postings[field], backed by postings.bin (mmap'd) + the eagerly-loaded
    postings.idx offset table. Router only ever calls `.get(term)` — never iterates — so that's
    the entire interface this needs to satisfy."""
    __slots__ = ("_mm", "_offsets", "_field", "_doc_urns")

    def __init__(self, mm, offsets: dict, field: str, doc_urns: list):
        self._mm = mm
        self._offsets = offsets
        self._field = field
        self._doc_urns = doc_urns

    def get(self, term, default=None):
        if self._mm is None:
            return default
        entry = self._offsets.get((self._field, term))
        if entry is None:
            return default
        off, length = entry
        block = self._mm[off:off + length]
        out = {}
        pos, d = 0, 0
        while pos < length:
            delta, pos = _varint_decode(block, pos)
            tf, pos = _varint_decode(block, pos)
            d += delta
            out[self._doc_urns[d]] = tf
        return out

class _LazyVectors:
    """dict-like idx.word_vectors / idx.skill_vectors, backed by a mmap'd int8 matrix (words.bin
    or vectors.i8) plus an eagerly-loaded key->row-index table. Satisfies the exact interface
    Router's _dense_scores uses: `.get(key)`, truthiness/`len()`, and `.values()` (used only to
    peek at one vector's length to learn `dims` — implemented as a generator so that peek never
    materializes the rest of the table)."""
    __slots__ = ("_mm", "_row_by_key", "_dims")

    def __init__(self, mm, row_by_key: dict, dims: int):
        self._mm = mm
        self._row_by_key = row_by_key
        self._dims = dims

    def get(self, key, default=None):
        if self._mm is None:
            return default
        row = self._row_by_key.get(key)
        if row is None:
            return default
        off = row * self._dims
        return tuple(array.array('b', self._mm[off:off + self._dims]))

    def values(self):
        for k in self._row_by_key:
            yield self.get(k)

    def __len__(self):
        return len(self._row_by_key) if self._mm is not None else 0

class _LazyNormsq:
    """dict-like idx.skill_normsq: |d|^2 computed on demand from a _LazyVectors instance rather
    than persisted separately — cheap (one candidate pool's worth of dot products, never all
    n_docs), and it can never drift out of sync with the vector it was computed from."""
    __slots__ = ("_vectors",)

    def __init__(self, vectors: "_LazyVectors"):
        self._vectors = vectors

    def get(self, key, default=0):
        vec = self._vectors.get(key)
        return sum(x * x for x in vec) if vec is not None else default

def _serialize_artifact_files(idx: Index) -> dict:
    """Pure function: an already-built Index -> {filename: bytes} for every artifact file except
    manifest.json (which needs external git-sha/build-time context plus the checksums of exactly
    these bytes). Shared by write_index_artifact (writes to disk) and check_index_artifact
    (rebuilds in memory only, to diff against what's on disk without touching it)."""
    doc_urns = sorted(idx.cards.keys())
    doc_id = {u: i for i, u in enumerate(doc_urns)}
    n_docs = len(doc_urns)

    card_lines = []
    for u in doc_urns:
        c = idx.cards[u]
        row = {
            "urn": u, "node": c["node"], "name": c["name"],
            "description": c["description"], "digest": c.get("digest", ""),
            "triggers": c.get("triggers", []), "negative_triggers": c.get("negative_triggers", []),
            "status": c.get("status", "active"), "replaced_by": c.get("replaced_by"),
            "kind": c.get("kind"), "layer": c.get("layer"), "owner": c.get("owner"),
        }
        card_lines.append(json.dumps(row, sort_keys=True, separators=(",", ":")))
    cards_bytes = ("\n".join(card_lines) + ("\n" if card_lines else "")).encode("utf-8")

    terms_bin = bytearray()
    for term in sorted(idx.idf.keys()):
        term_b = term.encode("utf-8")
        terms_bin += _varint_encode(len(term_b))
        terms_bin += term_b
        terms_bin += _varint_encode(idx.idf[term])

    norms_bin = bytearray()
    for field in Index.FIELDS:
        fn = idx.field_norm.get(field, {})
        vals = [fn.get(u, 0) for u in doc_urns]
        norms_bin += struct.pack(f"<{n_docs}I", *vals)

    postings_bin = bytearray()
    idx_records = []   # (field_index, term, offset, length)
    offset = 0
    for fi, field in enumerate(Index.FIELDS):
        for term in sorted(idx.postings[field].keys()):
            plist = sorted((doc_id[u], tf) for u, tf in idx.postings[field][term].items())
            block = bytearray()
            prev = 0
            for d, tf in plist:
                block += _varint_encode(d - prev)
                block += _varint_encode(tf)
                prev = d
            idx_records.append((fi, term, offset, len(block)))
            postings_bin += block
            offset += len(block)
    postings_idx = bytearray()
    for fi, term, off, length in idx_records:
        term_b = term.encode("utf-8")
        postings_idx += _varint_encode(fi)
        postings_idx += _varint_encode(len(term_b))
        postings_idx += term_b
        postings_idx += _varint_encode(off)
        postings_idx += _varint_encode(length)

    dims = _dense_dims(idx)
    vectors_bin = bytearray()
    for u in doc_urns:
        vec = idx.skill_vectors.get(u) or ((0,) * dims)
        if len(vec) != dims:
            raise ValueError(f"skill vector for {u} has {len(vec)} dims, expected {dims}")
        try:
            vectors_bin += array.array('b', vec).tobytes()
        except OverflowError as e:
            raise ValueError(f"skill vector for {u} has a component outside int8 range "
                              f"([-128,127]) — the distiller must L2-normalise before "
                              f"quantising (ADR-0020): {e}") from e
    words_sorted = sorted(idx.word_vectors.keys())
    words_bin = bytearray()
    for w in words_sorted:
        try:
            words_bin += array.array('b', idx.word_vectors[w]).tobytes()
        except OverflowError as e:
            raise ValueError(f"word vector for {w!r} has a component outside int8 range "
                              f"([-128,127]): {e}") from e
    words_idx = ("\n".join(words_sorted) + ("\n" if words_sorted else "")).encode("utf-8")

    graph_bytes = (json.dumps(idx.graph, sort_keys=True, indent=2) + "\n").encode("utf-8")
    nodes_bytes = (json.dumps(idx.nodes, sort_keys=True, indent=2) + "\n").encode("utf-8")

    return {
        "cards.jsonl": cards_bytes,
        "terms.bin": bytes(terms_bin),
        "norms.bin": bytes(norms_bin),
        "postings.bin": bytes(postings_bin),
        "postings.idx": bytes(postings_idx),
        "vectors.i8": bytes(vectors_bin),
        "words.bin": bytes(words_bin),
        "words.idx": words_idx,
        "graph.json": graph_bytes,
        "nodes.json": nodes_bytes,
    }

def write_index_artifact(root: Path, cfg: dict, dest: Path, git_sha: str) -> dict:
    """Build an Index from the current tree and persist it to `dest` (index_cache_dir(git_sha)).
    Returns the manifest dict. Reproducibility: build_time is the target commit's own timestamp
    (deterministic for a real sha), never wall-clock — so the SAME sha always serialises to
    byte-identical files, manifest.json included; only the "worktree" (uncommitted) sha falls
    back to wall-clock, because an uncommitted tree has no stable time to anchor to."""
    idx = Index.build(root, cfg, word_vectors=None)
    files = _serialize_artifact_files(idx)
    dest.mkdir(parents=True, exist_ok=True)
    checksums = {}
    for name, data in files.items():
        (dest / name).write_bytes(data)
        checksums[name] = hashlib.sha256(data).hexdigest()
    # Distinct global vocabulary size — exactly what terms.bin holds (idx.idf, one row per term).
    # NOT sum(len(idx.postings[f]) for f in FIELDS): that would double-count any term that
    # appears in more than one field (e.g. "auth" in both description and body), overstating
    # vocabulary size relative to what's actually persisted.
    n_terms = len(idx.idf)
    build_time = _commit_time(root, git_sha) or datetime.datetime.now(datetime.timezone.utc).isoformat(timespec="seconds")
    manifest = {
        "format_version": 1,
        "git_sha": git_sha,
        "build_time": build_time,
        "builder": "guidefold index",
        "teacher": {"id": None, "hf_commit_sha": None, "license": None},   # tier-2, not this PR (ADR-0020)
        "student_dims": _dense_dims(idx),
        "quant_scale": 127,
        "weights": idx.weights,
        "counts": {"cards": len(idx.cards), "terms": n_terms, "words": len(idx.word_vectors)},
        "checksums": checksums,
    }
    (dest / "manifest.json").write_text(json.dumps(manifest, sort_keys=True, indent=2) + "\n")
    return manifest

def load_index_artifact(dest: Path) -> Index:
    """Read <cache_root>/index/<sha>/ back into a Router-ready Index. Postings and dense vectors
    are lazily backed by mmap; cards/graph/nodes/idf/field_norm are small enough (a few thousand
    entries even at 2k skills) to load eagerly in full. Raises on a missing/corrupt artifact —
    callers (cmd_hook) treat any exception here as "no artifact yet, print nothing"."""
    manifest = json.loads((dest / "manifest.json").read_text())

    doc_urns = []
    cards = {}
    with (dest / "cards.jsonl").open("r", encoding="utf-8") as f:
        for line in f:
            line = line.strip()
            if not line:
                continue
            row = json.loads(line)
            u = row["urn"]
            doc_urns.append(u)
            cards[u] = {
                "urn": u, "node": row["node"], "name": row["name"],
                "description": row["description"], "digest": row.get("digest", ""),
                "triggers": row.get("triggers", []), "negative_triggers": row.get("negative_triggers", []),
                # requires/refines are NOT persisted here: graph.json already carries this
                # adjacency and Router never reads card["requires"]/["refines"] at query time.
                "requires": [], "refines": [],
                "status": row.get("status", "active"), "replaced_by": row.get("replaced_by"),
                "kind": row.get("kind"), "layer": row.get("layer"), "owner": row.get("owner"),
                "_body": "",   # never read by Router; BM25 is already baked into postings.bin
            }
    doc_id = {u: i for i, u in enumerate(doc_urns)}

    idx = Index(cards, json.loads((dest / "nodes.json").read_text()), manifest["weights"])
    idx.graph = json.loads((dest / "graph.json").read_text())

    idf = {}
    data = (dest / "terms.bin").read_bytes()
    pos, n = 0, len(data)
    while pos < n:
        tlen, pos = _varint_decode(data, pos)
        term = data[pos:pos + tlen].decode("utf-8"); pos += tlen
        val, pos = _varint_decode(data, pos)
        idf[term] = val
    idx.idf = idf

    field_norm = {f: {} for f in Index.FIELDS}
    norms_data = (dest / "norms.bin").read_bytes()
    per_field = len(doc_urns) * 4
    for i, field in enumerate(Index.FIELDS):
        chunk = norms_data[i * per_field:(i + 1) * per_field]
        if chunk:
            vals = struct.unpack(f"<{len(doc_urns)}I", chunk)
            field_norm[field] = dict(zip(doc_urns, vals))
    idx.field_norm = field_norm

    idx._postings_fh, idx._postings_mm = _open_mmap(dest / "postings.bin")
    offsets = {}
    pidx = (dest / "postings.idx").read_bytes()
    pos, n = 0, len(pidx)
    while pos < n:
        fi, pos = _varint_decode(pidx, pos)
        tlen, pos = _varint_decode(pidx, pos)
        term = pidx[pos:pos + tlen].decode("utf-8"); pos += tlen
        off, pos = _varint_decode(pidx, pos)
        length, pos = _varint_decode(pidx, pos)
        offsets[(Index.FIELDS[fi], term)] = (off, length)
    idx.postings = {field: _LazyFieldPostings(idx._postings_mm, offsets, field, doc_urns)
                    for field in Index.FIELDS}

    dims = int(manifest.get("student_dims", 0))
    idx._words_fh, idx._words_mm = _open_mmap(dest / "words.bin")
    idx._vectors_fh, idx._vectors_mm = _open_mmap(dest / "vectors.i8")
    if dims > 0 and idx._words_mm is not None:
        words_list = (dest / "words.idx").read_text(encoding="utf-8").splitlines()
        idx.word_vectors = _LazyVectors(idx._words_mm, {w: i for i, w in enumerate(words_list)}, dims)
    else:
        idx.word_vectors = {}
    if dims > 0 and idx._vectors_mm is not None:
        idx.skill_vectors = _LazyVectors(idx._vectors_mm, doc_id, dims)
        idx.skill_normsq = _LazyNormsq(idx.skill_vectors)
    else:
        idx.skill_vectors, idx.skill_normsq = {}, {}
    return idx

def check_index_artifact(root: Path, cfg: dict, sha: str, dest: Path):
    """Rebuild from the current tree (in memory only) and diff against the manifest checksums
    recorded at `dest` — "a check that cannot fail is not a check" (BRIEF). Two distinct
    failure modes, both reported:
      self-consistency — a file on disk doesn't match what manifest.json says it should hash to
                          (truncated/tampered artifact).
      staleness        — the current tree, rebuilt fresh, hashes to something the on-disk
                          manifest does NOT record (someone edited a SKILL.md and forgot to
                          rerun `guidefold index`).
    Returns (ok: bool, problems: list[str])."""
    problems = []
    manifest_path = dest / "manifest.json"
    if not manifest_path.exists():
        return False, [f"no index artifact at {dest} for sha={sha} — run `guidefold index` first"]
    try:
        manifest = json.loads(manifest_path.read_text())
    except Exception as e:
        return False, [f"manifest.json at {dest} is not valid JSON: {e}"]
    recorded = manifest.get("checksums", {})
    for name, want in recorded.items():
        p = dest / name
        if not p.is_file():
            problems.append(f"{name} is missing from {dest}")
            continue
        got = hashlib.sha256(p.read_bytes()).hexdigest()
        if got != want:
            problems.append(f"{name} on disk does not match its manifest checksum (tampered or truncated)")
    fresh = _serialize_artifact_files(Index.build(root, cfg))
    for name, data in fresh.items():
        got = hashlib.sha256(data).hexdigest()
        want = recorded.get(name)
        if want is None:
            problems.append(f"{name} has no recorded checksum in manifest.json")
        elif got != want:
            problems.append(f"{name} is stale: current tree hashes to {got[:12]}, artifact "
                             f"recorded {want[:12]} — rerun `guidefold index`")
    return (len(problems) == 0), problems

# ------------------------------------------------------------------- Router
def _dense_rank(scores: dict) -> list:
    """scores: urn -> (dot, normsq). Rank by cosine = dot/sqrt(normsq), descending, in integers.

    Cosine is compared without any sqrt by comparing squared cosines with the sign kept separate:
        sign(dot_a)*dot_a^2 * normsq_b  vs  sign(dot_b)*dot_b^2 * normsq_a
    A previous version compared dot_a*normsq_b vs dot_b*normsq_a, i.e. dot/normsq — which is
    NOT cosine and inverts orderings (counterexample: A=(dot 3, normsq 9) cos 1.00 vs
    B=(dot 1, normsq 2) cos 0.71; dot/normsq ranked B first). Caught in the E1.3 peer review;
    the wrong form came verbatim from ROUTER-SPEC, so the spec was the bug, not the port.
    The query norm is a common factor across candidates and never enters the comparison.
    Ties broken on (-dot, urn). Pure integer arithmetic throughout (ADR-0020)."""
    def key(u):
        dot, nsq = scores[u]
        return (dot, nsq)
    def cmp(a, b):
        da, na = scores[a]
        db, nb = scores[b]
        sa = (da > 0) - (da < 0); sb = (db > 0) - (db < 0)
        lhs, rhs = sa * da * da * nb, sb * db * db * na
        if lhs != rhs:
            return -1 if lhs > rhs else 1
        if da != db:
            return -1 if da > db else 1
        return -1 if a < b else (1 if a > b else 0)
    return sorted(scores.keys(), key=cmp_to_key(cmp))

class Router:
    """Ranking. Depends on an Index only — never on Registry (E0.2). candidates() -> score() ->
    select() is the pipeline (E1.1); route() is the convenience wrapper."""

    def __init__(self, index: Index):
        self.index = index

    # ---- policy filter: hard drops, recorded reason per drop, never a demotion ----
    def _visible_nodes(self, node: str) -> set:
        """Own subtree (node + all descendants) union the ancestor chain."""
        out = set(ancestors(node))
        for n in self.index.nodes:
            if node == "_root" or n == node or n.startswith(node + "."):
                out.add(n)
        return out

    def policy_filter(self, node: str, query: str = "", include_deprecated: bool = False):
        visible = self._visible_nodes(node)
        qtoks = set(tokenize(query))
        kept, drops = [], []
        for u, c in sorted(self.index.cards.items()):
            if c["status"] == "deprecated" and not include_deprecated:
                drops.append((u, "deprecated")); continue
            if c["node"] not in visible:
                drops.append((u, "not-visible")); continue
            hit_neg = None
            for t in c.get("negative_triggers", []):
                ttoks = tokenize(t)
                if ttoks and set(ttoks) <= qtoks:
                    hit_neg = t; break
            if hit_neg is not None:
                drops.append((u, f"negative-trigger:{hit_neg}")); continue
            kept.append(u)
        return kept, drops

    # ---- candidates: field-weighted BM25 + dense channel, fused later by RRF ----
    def _bm25_scores(self, query: str, visible: set) -> dict:
        idx = self.index
        qterms = tokenize(query)
        if not qterms:
            return {}
        qtf = {}
        for t in qterms:
            qtf[t] = qtf.get(t, 0) + 1
        k1_scaled = round(idx.K1 * idx.IDF_SCALE)
        scores = {}
        for t, n_q in qtf.items():
            idf = idx.idf.get(t)
            if idf is None:
                continue
            wtf_by_doc = {}
            for field in idx.FIELDS:
                w = idx.weights[f"field.{field}"]
                post = idx.postings[field].get(t)
                if not post:
                    continue
                for u, tf in post.items():
                    if u not in visible:
                        continue
                    norm = idx.field_norm[field][u]
                    wtf_by_doc[u] = wtf_by_doc.get(u, 0) + (w * tf * idx.IDF_SCALE) // norm
            for u, wtf in wtf_by_doc.items():
                denom = k1_scaled + wtf
                term_score = (idf * wtf) // denom if denom else 0
                scores[u] = scores.get(u, 0) + term_score * n_q
        return scores

    def _dense_scores(self, query: str, visible: set) -> dict:
        idx = self.index
        if not idx.word_vectors:
            return {}
        qterms = tokenize(query)
        dims = len(next(iter(idx.word_vectors.values())))
        qvec = [0] * dims
        hit = False
        for t in qterms:
            wv = idx.word_vectors.get(t)
            if wv:
                hit = True
                for i in range(dims):
                    qvec[i] += wv[i]
        if not hit:
            return {}
        out = {}
        for u in visible:
            svec = idx.skill_vectors.get(u)
            if not svec:
                continue
            dot = sum(a * b for a, b in zip(qvec, svec))
            out[u] = (dot, idx.skill_normsq.get(u, 0))
        return out

    def candidates(self, query: str, node: str, include_deprecated: bool = False, top_n: int = 50) -> list:
        visible, drops = self.policy_filter(node, query, include_deprecated)
        visible_set = set(visible)
        bm25 = self._bm25_scores(query, visible_set)
        dense = self._dense_scores(query, visible_set)
        bm25_order = sorted(bm25, key=lambda u: (-bm25[u], u))
        bm25_rank = {u: i + 1 for i, u in enumerate(bm25_order)}
        dense_order = _dense_rank(dense)
        dense_rank = {u: i + 1 for i, u in enumerate(dense_order)}
        cand_urns = set(bm25_order[:top_n]) | set(dense_order[:top_n])
        out = []
        for u in sorted(cand_urns):
            out.append({
                "urn": u, "node": self.index.cards[u]["node"],
                "bm25_rank": bm25_rank.get(u), "dense_rank": dense_rank.get(u),
            })
        self.last_drops = drops
        return out

    # ---- score: RRF fusion + scope feature + reverse PPR ----
    def _hops(self, skill_node: str, caller_node: str) -> int:
        chain = ancestors(caller_node)
        if skill_node in chain:
            return chain.index(skill_node)
        if caller_node == "_root":
            rest = skill_node
        elif skill_node.startswith(caller_node + "."):
            rest = skill_node[len(caller_node) + 1:]
        else:
            rest = skill_node
        return rest.count(".") + 1

    def _reverse_ppr(self, seed_scaled: dict) -> dict:
        """Mass flows FROM a strong hit TOWARD what it requires, so prerequisites (and, via
        `replaces`, the deprecated skill's replacement) gain mass too. Fixed 20-iteration power
        method, fixed-point integer arithmetic throughout."""
        idx = self.index
        nodes = list(idx.cards.keys())
        total_seed = sum(v for v in seed_scaled.values() if v > 0)
        if total_seed <= 0:
            return {u: 0 for u in nodes}
        scale = idx.IDF_SCALE
        p = {u: (max(0, seed_scaled.get(u, 0)) * scale) // total_seed for u in nodes}
        edge_types = ("requires", "refines", "replaces", "similar")
        edges = {u: [] for u in nodes}
        for et in edge_types:
            w = idx.weights.get(f"edge.{et}", 0)
            if w <= 0:
                continue
            for u, targets in idx.graph.get(et, {}).items():
                if u not in p:
                    continue
                for t in targets:
                    if t in p:
                        edges[u].append((t, w))
        out_weight = {u: sum(w for _, w in edges[u]) for u in nodes}
        mass = dict(p)
        a_num, a_den = idx.PPR_ALPHA_NUM, idx.PPR_ALPHA_DEN
        for _ in range(idx.PPR_ITERS):
            new_mass = {u: (a_num * p[u]) // a_den for u in nodes}
            for u in nodes:
                mu, ow = mass[u], out_weight[u]
                if mu == 0 or ow == 0:
                    continue
                for t, w in edges[u]:
                    new_mass[t] += ((a_den - a_num) * mu * w) // (a_den * ow)
            mass = new_mass
        return mass

    def _decayed_closure(self, seed_scaled: dict, max_depth: int = 2) -> dict:
        """Alternative to `_reverse_ppr`, named in ADR-0020's rejected-alternative note: on a
        graph with out-degree ~= 0.6 and few `refines`/`replaces` edges, reverse PPR's power
        iteration may be indistinguishable from a much simpler decayed `requires`-closure walk,
        while being harder to explain in the Probe UI. Selected via `weights["ppr_mode"] ==
        "closure"` (default stays "pagerank" -- see docs/reports/tuning/E1-config-selection.md
        for the measured comparison and the ship/no-ship verdict).

        No power iteration, no restart term, no out-degree normalisation, `requires` edges only
        (the same relation `_requires_closure` walks for hard membership in `select`): each
        seed's normalised mass is propagated a fixed `closure_decay_num/closure_decay_den`
        fraction per hop, up to `max_depth` hops. Same seed normalisation as `_reverse_ppr` (
        positive mass scaled so it sums to `idx.IDF_SCALE`) so `score()` can call either
        implementation interchangeably and get comparable magnitudes."""
        idx = self.index
        nodes = list(idx.cards.keys())
        total_seed = sum(v for v in seed_scaled.values() if v > 0)
        if total_seed <= 0:
            return {u: 0 for u in nodes}
        scale = idx.IDF_SCALE
        p = {u: (max(0, seed_scaled.get(u, 0)) * scale) // total_seed for u in nodes}
        decay_num = idx.weights.get("closure_decay_num", 1)
        decay_den = idx.weights.get("closure_decay_den", 2)
        requires = idx.graph.get("requires", {})
        mass = dict(p)   # each node keeps its own seed mass (mirrors _reverse_ppr's restart term)
        for u, s in p.items():
            if s <= 0:
                continue
            frontier, seen = [u], {u}
            num, den = 1, 1
            for _ in range(max_depth):
                num, den = num * decay_num, den * decay_den
                nxt = []
                for x in frontier:
                    for t in requires.get(x, []):
                        if t in seen:
                            continue
                        seen.add(t)
                        nxt.append(t)
                        if t in mass:
                            mass[t] += (s * num) // den
                frontier = nxt
                if not frontier:
                    break
        return mass

    def score(self, cands: list, query: str, node: str) -> list:
        idx = self.index
        rrf = {}
        for c in cands:
            u = c["urn"]
            s = 0
            if c["bm25_rank"] is not None:
                s += idx.RRF_SCALE // (idx.RRF_K + c["bm25_rank"])
            if c["dense_rank"] is not None:
                s += idx.RRF_SCALE // (idx.RRF_K + c["dense_rank"])
            rrf[u] = s
        w_scope = idx.weights["w_scope"]
        for c in cands:
            rrf[c["urn"]] += w_scope // (1 + self._hops(c["node"], node))
        ppr = self._decayed_closure(rrf) if idx.weights.get("ppr_mode", "pagerank") == "closure" \
            else self._reverse_ppr(rrf)
        w_ppr = idx.weights["w_ppr"]
        scored = []
        for c in cands:
            u = c["urn"]
            total = rrf[u] + (w_ppr * ppr.get(u, 0)) // idx.IDF_SCALE
            scored.append({**c, "score": total})
        scored.sort(key=lambda c: (-c["score"], c["urn"]))
        return scored

    # ---- select: requires closure (depth<=2, hard membership) + cap + abstain + ordering ----
    def _requires_closure(self, u: str, max_depth: int = 2) -> list:
        idx = self.index
        seen = {u}
        frontier = [u]
        out = []
        for _ in range(max_depth):
            nxt = []
            for x in frontier:
                for r in idx.graph["requires"].get(x, []):
                    if r not in seen:
                        seen.add(r); out.append(r); nxt.append(r)
            frontier = nxt
            if not frontier:
                break
        return out

    def _depth(self, node: str) -> int:
        return 0 if node == "_root" else node.count(".") + 1

    def _top_margin(self, scored: list) -> int:
        """rank1-rank2 score gap -- the alternative confidence signal to raw magnitude (RRF gives
        any rank-1 hit a near-constant high score, so magnitude alone cannot tell a confident hit
        apart from a `no_applicable` case with a lucky top candidate; see
        docs/reports/tuning/E1-config-selection.md). A pool of fewer than 2 candidates has no
        second place to compare against, so it is never abstained on margin grounds alone."""
        if len(scored) < 2:
            return 1 << 30
        return scored[0]["score"] - scored[1]["score"]

    def select(self, scored: list, k: int = 4, abstain_threshold: int = None) -> list:
        idx = self.index
        mode = idx.weights.get("abstain_mode", "magnitude")
        if abstain_threshold is None:
            abstain_threshold = idx.weights["abstain_margin_threshold"] if mode == "margin" \
                else idx.weights["abstain_threshold"]
        signal = self._top_margin(scored) if mode == "margin" else (scored[0]["score"] if scored else 0)
        if not scored or signal < abstain_threshold:
            return []
        score_by_urn = {c["urn"]: c["score"] for c in scored}
        chosen, chosen_set = [], set()
        for c in scored:
            if len(chosen) >= k:
                break
            u = c["urn"]
            if u in chosen_set:
                continue
            chosen.append(u); chosen_set.add(u)
            for dep in self._requires_closure(u, max_depth=2):
                if len(chosen) >= k:
                    break
                if dep in chosen_set or dep not in idx.cards:
                    continue
                if idx.cards[dep]["status"] == "deprecated":
                    continue
                chosen.append(dep); chosen_set.add(dep)
        # emit general -> specific (root-most first); ties on score then urn
        chosen.sort(key=lambda u: (self._depth(idx.cards[u]["node"]), -score_by_urn.get(u, 0), u))
        out = []
        for u in chosen:
            c = idx.cards[u]
            out.append({"urn": u, "node": c["node"], "name": c["name"],
                        "description": c["description"], "score": score_by_urn.get(u, 0)})
        return out

    def route(self, query: str, node: str, k: int = 4, include_deprecated: bool = False) -> list:
        cands = self.candidates(query, node, include_deprecated=include_deprecated)
        scored = self.score(cands, query, node)
        return self.select(scored, k=k)

# ------------------------------------------------------------------------- commands
def cmd_where(a, root, cfg):
    node = node_for(cfg, rel(root, Path.cwd()))
    print(json.dumps({"node": node, "owner": cfg["nodes"][node].get("owner"),
                      "ancestors": ancestors(node)}, indent=2))

def cmd_find(a, root, cfg):
    idx = Index.build(root, cfg)
    router = Router(idx)
    scope = a.scope or node_for(cfg, rel(root, Path.cwd()))
    # Inlined router.route()'s three steps (candidates -> score -> select) instead of calling it,
    # so `scored` (the retrieval-order ranking, pre-select) is available for the shadow record
    # below without ranking the query twice. The printed output is exactly what route() would
    # have returned -- same three calls, same arguments -- so it is unaffected by --experimental.
    cands = router.candidates(a.task, scope, include_deprecated=a.include_deprecated)
    scored = router.score(cands, a.task, scope)
    selected = router.select(scored, k=a.limit)
    for c in selected:
        print(f"- {c['urn']}\n    {c['description'][:160]}\n    (score={c['score']} · node={c['node']})")
    if getattr(a, "experimental", False):
        _write_shadow_record(root, a.task, scope, scored, telemetry_raw=getattr(a, "telemetry_raw", False))

# ---------------------------------------------------------- E1.6 shadow telemetry
# `find --experimental` never changes the printed answer (see cmd_find above): it only writes a
# record of what a reranker *would* see, so tools/bakeoff/rerank_shadow.py can score it offline
# (tier 2, torch allowed) and tools/bakeoff/arms.py's B6 bake-off row can be compared against real
# traffic later. Writing this record must never fail or slow down `find` in a way the user can
# see, so every line below this comment runs inside one try/except in _write_shadow_record, and a
# failure here is silent by design (ADR-0020: the shipped CLI stays stdlib-only and this whole
# path is stdlib -- json/hashlib/uuid/datetime -- so there is nothing here that *should* fail, but
# "should" is not a guarantee, and a telemetry bug must never become an outage for `find`).
#
# The query is stored as a SHA-256 hash, not the raw text, by default: prompts routed through
# `find --experimental` can contain proprietary detail (customer names, incident specifics,
# unreleased feature names), and a telemetry file that quietly accumulates that detail on disk is
# exactly the kind of thing that is never noticed until someone greps it by accident. Pass
# --telemetry-raw to opt into keeping the raw query text as well (needed if you actually want
# tools/bakeoff/rerank_shadow.py to score this record later -- see that file's docstring: a
# reranker needs the real query string, a hash cannot be un-hashed).
def _utc_now_iso() -> str:
    return datetime.datetime.now(datetime.timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")

def _shadow_telemetry_path(root: Path) -> Path:
    date = datetime.datetime.now(datetime.timezone.utc).strftime("%Y-%m-%d")
    return root / ".guidefold" / "telemetry" / f"shadow-{date}.jsonl"

def _write_shadow_record(root: Path, query: str, node: str, scored: list, telemetry_raw: bool = False):
    try:
        record = {
            "type": "shadow_request",
            "request_id": str(uuid.uuid4()),
            "ts": _utc_now_iso(),
            "cli_version": CLI_VERSION,
            "index_sha": _git_head_short(root),
            "node": node,
            "query_sha256": hashlib.sha256(query.encode("utf-8")).hexdigest(),
            # retrieval order (Router.score, score desc / urn tie-break) -- NOT injection order
            # (Router.select reorders general -> specific for the agent to read; see
            # docs/reports/golden/README.md, "The Router has two orderings"). A reranker judges
            # relevance, so it must see the same order the ranking metrics are read from.
            "top20": [{"urn": c["urn"], "score": c["score"]} for c in scored[:20]],
        }
        if telemetry_raw:
            record["query"] = query
        path = _shadow_telemetry_path(root)
        path.parent.mkdir(parents=True, exist_ok=True)
        with path.open("a", encoding="utf-8") as f:
            f.write(json.dumps(record, sort_keys=True) + "\n")
    except Exception:
        pass  # telemetry must never fail or block `find` (see comment above)

def cmd_load(a, root, cfg):
    reg = registry_for(cfg, root)
    rev = reg.default_revision(a.urn)
    dest = skill_cache_dir(a.urn, rev)
    if (dest / "SKILL.md").exists():
        os.utime(dest, None)   # cache hit: bump mtime so LRU eviction reflects last use
    else:
        reg.download(a.urn, dest, rev=rev)
    evict_lru(cache_root() / "skills", depth=2, cap=_cache_cap(cfg, "max_skill_revisions", DEFAULT_SKILLS_CACHE_CAP))
    print(dest / "SKILL.md")

def cmd_validate(a, root, cfg):
    skills, errors = _validate_errors(root, cfg)
    for e in errors:
        print("ERROR", e)
    print(f"guidefold validate: {len(skills)} skills, {len(errors)} errors")
    sys.exit(1 if errors else 0)

def _validate_errors(root, cfg):
    """Core CONVENTIONS.md enforcement, split out of cmd_validate so `doctor` can reuse it
    without duplicating the logic or triggering cmd_validate's sys.exit. Returns
    (skills, errors) — skills is the same list `all_skills()` produced, errors is a list of
    human-readable strings (no ERROR prefix, no printing, no exit)."""
    errors = []
    skills = list(all_skills(root, cfg))
    urns = {urn(cfg, node, d.name): fm for d, node, fm in skills}
    node_of = {urn(cfg, node, d.name): node for d, node, fm in skills}
    for d, node, fm in skills:
        md = fm.get("metadata") or {}
        rd = d.relative_to(root)
        if fm.get("name") != d.name:
            errors.append(f"{rd}: name != directory")
        if md.get("scope") != node:
            errors.append(f"{rd}: metadata.scope={md.get('scope')} but path node={node}")
        if md.get("owner") not in (cfg["nodes"][node].get("owner"), *cfg["nodes"][node].get("subteams", [])):
            errors.append(f"{rd}: owner {md.get('owner')} not allowed for node {node}")
        if md.get("kind") and md.get("kind") not in KIND_VALUES:
            errors.append(f"{rd}: metadata.kind must be one of {', '.join(KIND_VALUES)}")
        if md.get("layer") and md.get("layer") not in LAYER_VALUES:
            errors.append(f"{rd}: metadata.layer must be one of {', '.join(LAYER_VALUES)}")
        for k, v in md.items():
            if not isinstance(v, str):
                errors.append(f"{rd}: metadata.{k} must be a scalar string (registry rejects lists/dates/bools; use a comma-separated string)")
        tag = "[" + (cfg["publisher"] if node == "_root" else node.replace(".", "/")) + "]"
        if not str(fm.get("description", "")).startswith(tag):
            errors.append(f"{rd}: description must start with {tag}")
        if len(str(fm.get("description", ""))) > 1024:
            errors.append(f"{rd}: description longer than 1024 chars")
        refs = md_list(md, "references")
        if len(refs) > 10:
            errors.append(f"{rd}: more than 10 references — skill is too broad")
        for r in refs:
            path, _, token = r.partition("#")
            matches = [m for m in root.glob(path) if m.is_file()]
            if not matches:
                errors.append(f"{rd}: reference not found: {r}")
            elif token and not any(token in m.read_text(errors="ignore") for m in matches):
                errors.append(f"{rd}: token '{token}' not found in {path}")
        for key in ("requires", "refines", "replaces"):
            check_urn_refs(md, key, urns, rd, errors)
        for r in md_list(md, "refines"):
            if r in node_of and node_depth(node_of[r]) > node_depth(node):
                errors.append(f"{rd}: refines {r} is in a deeper node than {node} (child refines parent, not the reverse)")
        if md.get("status") not in ("active", "deprecated"):
            errors.append(f"{rd}: metadata.status must be active or deprecated")
        if md.get("status") == "deprecated" and not md.get("replaced_by"):
            errors.append(f"{rd}: deprecated skill must set metadata.replaced_by")
    flats = {}
    for n in cfg["nodes"]:
        flats.setdefault(flat_node(n), []).append(n)
    for f, ns in flats.items():
        if len(ns) > 1:
            errors.append(f"guidefold.yaml: nodes {ns} collide after flattening to '{f}' (ADR-0008)")
    requires_graph = {u: [r for r in md_list(fm.get("metadata") or {}, "requires") if r in urns] for u, fm in urns.items()}
    check_cycles(requires_graph, "requires", errors)
    refines_graph = {u: [r for r in md_list(fm.get("metadata") or {}, "refines") if r in urns] for u, fm in urns.items()}
    check_cycles(refines_graph, "refines", errors)
    return skills, errors

def cmd_drift(a, root, cfg):
    diff = subprocess.run(["git", "diff", "--name-only", "--relative", a.base], capture_output=True, text=True, cwd=root).stdout.split()
    report = []
    for d, node, fm in all_skills(root, cfg):
        for r in md_list(fm.get("metadata") or {}, "references"):
            path, _, token = r.partition("#")
            for changed in diff:
                if fnmatch.fnmatch(changed, path):
                    hit = True
                    if token:
                        patch = subprocess.run(["git", "diff", "--relative", a.base, "--", changed], capture_output=True, text=True, cwd=root).stdout
                        hit = token in patch
                    if hit:
                        report.append((urn(cfg, node, d.name), fm["metadata"].get("owner"), changed, token))
    if report:
        print("⚠ Possibly stale guidance:")
        for u, o, f, t in report:
            print(f"- {u} (owner: {o}) references {f}{'#'+t if t else ''}")
    sys.exit(0)  # advisory in MVP

def cmd_publish(a, root, cfg):
    reg = registry_for(cfg, root)
    changed = set(subprocess.run(["git", "diff", "--name-only", "--relative", a.base], capture_output=True, text=True, cwd=root).stdout.split()) if a.changed else None
    sha = subprocess.run(["git", "rev-parse", "--short=7", "HEAD"], capture_output=True, text=True, cwd=root).stdout.strip() or "nogit"
    rev_id = a.revision or f"rev-{datetime.datetime.now(datetime.timezone.utc).strftime('%Y%m%d%H%M%S')}-{sha}"
    n = 0
    for d, node, fm in all_skills(root, cfg, include_generated=True):
        if changed is not None and not any(c.startswith(rel(root, d)) for c in changed):
            continue
        if a.only and a.only not in urn(cfg, node, d.name):
            continue
        md = fm.get("metadata") or {}
        desc = fm.get("description", "")
        if md.get("status") == "deprecated":
            desc = "DEPRECATED (see " + str(md.get("replaced_by", "?")) + ") " + desc
        print("publish", urn(cfg, node, d.name), "->", reg.publish(node, d.name, d, display=f"{node}/{d.name}", desc=desc, rev_id=rev_id))
        n += 1
    print(f"guidefold publish: {n} skills, revision {rev_id}")

def cmd_index(a, root, cfg):
    sha = _git_head_short(root)
    dest = index_cache_dir(sha)

    if getattr(a, "check", False):
        ok, problems = check_index_artifact(root, cfg, sha, dest)
        for p in problems:
            print("STALE", p)
        if not ok:
            sys.exit(1)
        print(f"guidefold index --check: artifact at {dest} matches sha={sha}")
        return

    pub = cfg["publisher"]
    lines = ["---", "name: hierarchy-index", f'description: "[{pub}] Generated map of all hierarchy nodes, owners and skills. Load once per session when unsure where you are."',
             "metadata:", "  scope: _index", f"  owner: {cfg['nodes']['_root'].get('owner')}", '  generated: "true"', "  status: active", "---", f"# {pub} skill hierarchy", ""]
    by_node = {}
    for d, node, fm in all_skills(root, cfg):
        by_node.setdefault(node, []).append((d.name, fm.get("description", "")))
    for node, spec in cfg["nodes"].items():
        lines.append(f"## {node}  (owner: {spec.get('owner')})  paths: {', '.join(spec.get('paths', []))}")
        for name, desc in sorted(by_node.get(node, [])):
            lines.append(f"- `{urn(cfg, node, name)}` — {desc[:120]}")
        lines.append("")
    out = root / ".agents" / "skills" / "hierarchy-index" / "SKILL.md"
    out.parent.mkdir(parents=True, exist_ok=True)
    out.write_text("\n".join(lines))
    print(out)

    # E1.4: build (or rebuild) the immutable binary retrieval artifact for this sha.
    manifest = write_index_artifact(root, cfg, dest, sha)
    evict_lru(cache_root() / "index", depth=1,
              cap=_cache_cap(cfg, "max_index_shas", DEFAULT_INDEX_CACHE_CAP))
    c = manifest["counts"]
    print(f"guidefold index: wrote artifact for sha={sha} to {dest} "
          f"(cards={c['cards']} terms={c['terms']} words={c['words']})")


# ---------------------------------------------------------- L0: scope cards
CARD_CAP = 80

def node_meta(cfg, node):
    return cfg["nodes"].get(node, {})

def digest_of(fm):
    md = fm.get("metadata", {})
    return md.get("digest") or fm.get("description", "")[:200]

def build_card(root, cfg, node, skills_by_node):
    chain = ancestors(node)                      # node first … _root last
    root_label = f"{cfg['publisher']} (root)"
    lines = [f"# Scope: {node if node != '_root' else root_label}",
             f"Owner: {node_meta(cfg, node).get('owner')} · Hierarchy (specific → general): {' → '.join(chain)}", ""]
    extra = root / (node_meta(cfg, node).get("paths", ["."])[0].split("*")[0]) / ".agents" / "NODE.md"
    if extra.exists():
        lines += [extra.read_text().strip(), ""]
    lines += ["## Inherited guidance (general → specific)", ""]
    for n in reversed(chain):                    # root first
        label = root_label if n == "_root" else n
        lines.append(f"### {label}  (owner: {node_meta(cfg, n).get('owner')})")
        for name, fm in sorted(skills_by_node.get(n, [])):
            md = fm.get("metadata") or {}
            flag = f" **DEPRECATED → {md.get('replaced_by', '?')}**" if md.get("status") == "deprecated" else ""
            lines.append(f"- `{urn(cfg, n, name)}`{flag} — {digest_of(fm)}")
        if not skills_by_node.get(n):
            lines.append("- (no skills at this level yet)")
        lines.append("")
    lines += ["## How to get the full procedure",
              "Skills above are summaries. Before implementing anything platform-specific, run",
              f"`.agents/skills/guidefold/scripts/guidefold find \"<your task>\" --scope {node}` and then",
              "`guidefold load <urn>` for the 1–3 most relevant ones (follow `metadata.requires`).",
              "Generated by guidefold materialize — do not edit; edit guidefold.yaml, NODE.md or the skills instead.", ""]
    if len(lines) > CARD_CAP:
        sys.exit(f"guidefold: scope card for {node} exceeds {CARD_CAP} lines — shorten metadata.digest")
    return "\n".join(lines)

def cmd_materialize(a, root, cfg):
    skills_by_node = {}
    for d, node, fm in all_skills(root, cfg):
        skills_by_node.setdefault(node, []).append((d.name, fm))
    outputs = {}
    for node, spec in cfg["nodes"].items():
        node_dir = root if node == "_root" else root / spec["paths"][0].split("*")[0].rstrip("/")
        card = build_card(root, cfg, node, skills_by_node)
        outputs[node_dir / "AGENTS.md"] = card
        outputs[node_dir / "CLAUDE.md"] = "@AGENTS.md\n"
        outputs[node_dir / "GEMINI.md"] = "@AGENTS.md\n"
        if node != "_root":
            globs = ", ".join(f'"{g}"' for g in spec["paths"])
            outputs[root / ".github" / "instructions" / f"{node}.instructions.md"] = f"---\napplyTo: {globs}\n---\n{card}"
    stale = []
    for path, content in outputs.items():
        if a.check:
            if not path.exists() or path.read_text() != content:
                stale.append(str(path.relative_to(root)))
        else:
            path.parent.mkdir(parents=True, exist_ok=True)
            path.write_text(content)
            print("wrote", path.relative_to(root))
    if a.check and stale:
        print("STALE generated files (run guidefold materialize):\n  " + "\n  ".join(stale)); sys.exit(1)

# ------------------------------------------------- L1: hooks (Claude/Codex)
HOOK_WATCHDOG_SECONDS_DEFAULT = 3.0   # ROUTER-SPEC "Watchdog": hard deadline, 300ms warm budget

class _HookTimeout(Exception):
    pass

def _install_watchdog(seconds: float):
    """SIGALRM-based hard deadline: raises _HookTimeout if `seconds` elapse before `cancel()` is
    called. POSIX only — on a platform without SIGALRM (e.g. native Windows Python with no WSL)
    the hook simply runs without a hard deadline rather than crashing on `signal.SIGALRM`
    AttributeError; it is still bounded in practice by the 300ms warm-path budget. Returns a
    zero-arg `cancel` to call from a `finally` block (idempotent: safe even if never armed)."""
    if not hasattr(signal, "SIGALRM") or seconds <= 0:
        return lambda: None
    def _handler(signum, frame):
        raise _HookTimeout()
    previous = signal.signal(signal.SIGALRM, _handler)
    signal.setitimer(signal.ITIMER_REAL, seconds)
    def cancel():
        signal.setitimer(signal.ITIMER_REAL, 0)
        signal.signal(signal.SIGALRM, previous)
    return cancel

def _emit_timeout_marker(root: Path, sha: str):
    """Best-effort telemetry (docs/DESIGN.md "9 telemetry", a minimal slice of it): one JSONL
    line per watchdog timeout under .guidefold/telemetry/ (gitignored, generated — ADR-0012).
    Never allowed to raise: a broken telemetry write must not turn a timeout into a crash."""
    try:
        tdir = root / ".guidefold" / "telemetry"
        tdir.mkdir(parents=True, exist_ok=True)
        rec = {"event": "hook_timeout", "sha": sha,
               "ts": datetime.datetime.now(datetime.timezone.utc).isoformat(timespec="seconds")}
        with (tdir / "hook.jsonl").open("a") as f:
            f.write(json.dumps(rec, sort_keys=True) + "\n")
    except Exception:
        pass

def cmd_hook(a, root):
    """Claude Code UserPromptSubmit/SessionStart and Codex hooks pass JSON on stdin. We print
    plain text; the harness adds stdout to the model context (exit 0).

    E1.5: reads ONLY the pre-built index artifact at <cache_root>/index/<sha>/ — never
    guidefold.yaml, never the skill tree, never PyYAML. `cwd -> node` resolves from the
    artifact's own nodes.json (ROUTER-SPEC "Determinism by construction": an uncommitted
    working-tree edit must never silently reroute a running session).

    Contract: on ANY failure — no artifact yet for this sha, a corrupt artifact, unreadable
    stdin, a watchdog timeout — print nothing and return normally (exit 0). Injecting late or
    injecting from stale state is worse than injecting nothing."""
    sha = _git_head_short(root)
    seconds = float(os.environ.get("GUIDEFOLD_HOOK_TIMEOUT_S", HOOK_WATCHDOG_SECONDS_DEFAULT))
    # Arm the watchdog *inside* the try. With a deadline that has effectively already passed,
    # setitimer delivers SIGALRM synchronously inside _install_watchdog itself; if the arming
    # sits outside the try, _HookTimeout escapes cmd_hook and main(), and the hook exits 1 with
    # a traceback instead of exiting 0 silently. Observed on CPython 3.10 in CI while 3.11/3.12
    # happened to win the race — which is exactly why the contract is enforced by a test rather
    # than by timing luck.
    cancel = lambda: None
    try:
        cancel = _install_watchdog(seconds)
        try:
            payload = json.load(sys.stdin)
        except _HookTimeout:
            raise
        except Exception:
            payload = {}
        cwd = Path(payload.get("cwd") or Path.cwd())
        prompt = payload.get("prompt") or payload.get("user_prompt") or ""
        idx = load_index_artifact(index_cache_dir(sha))
        try:
            relpath = rel(root, cwd)
        except ValueError:
            relpath = ""
        node = node_for({"nodes": idx.nodes}, relpath)
        if not prompt:                            # SessionStart: just announce scope
            owner = idx.nodes.get(node, {}).get("owner")
            print(f"[guidefold] scope={node} owner={owner} chain={'→'.join(ancestors(node))}")
            return
        if len(prompt) < 12:                      # skip trivial prompts ("yes", "continue")
            return
        top = Router(idx).route(prompt, node, k=3)
        if not top:
            return
        print(f"[guidefold] Relevant organizational guidance for scope {node}:")
        for c in top:
            print(f"- {c['urn']} — {c['description'][:140]}")
        print("Load with: .agents/skills/guidefold/scripts/guidefold load <urn>  (follow metadata.requires).")
    except _HookTimeout:
        _emit_timeout_marker(root, sha)
        return                                    # print nothing — injecting late is worse
    except Exception:
        return                                    # ranking must never break the harness
    finally:
        cancel()

def cmd_prewarm(a, root, cfg):
    """Copilot sessionStart: output is ignored, side effects are not."""
    node = node_for(cfg, rel(root, Path.cwd()))
    reg = registry_for(cfg, root)
    for c in reg.search_scope(ancestors(node)):
        rev = reg.default_revision(c["urn"])
        dest = skill_cache_dir(c["urn"], rev)
        if (dest / "SKILL.md").exists():
            os.utime(dest, None)
            continue
        try:
            reg.download(c["urn"], dest, rev=rev)
        except SystemExit:
            pass
    evict_lru(cache_root() / "skills", depth=2, cap=_cache_cap(cfg, "max_skill_revisions", DEFAULT_SKILLS_CACHE_CAP))

# ------------------------------------------------------------ init / doctor
# E0.4: `guidefold init` bootstraps a *consumer* monorepo (guidefold.yaml skeleton,
# .agents/skills/guidefold, harness hooks, CI workflow, .gitignore) in one idempotent command;
# `guidefold doctor` diagnoses one and prints a concrete fix for every failure. Both must work
# on a repo that has no guidefold.yaml yet, so neither uses repo_root()/load_map() (which
# require one) — see _target_root() and _check_guidefold_yaml() below.

SCRIPT_PATH = Path(__file__).resolve()
TOOL_SKILL_SRC = SCRIPT_PATH.parent.parent            # .../skills/guidefold (the distributable unit)
TOOL_REPO_ROOT = TOOL_SKILL_SRC.parent.parent          # the guidefold tool checkout, if run from one
TOOL_TEMPLATES_DIR = TOOL_REPO_ROOT / "templates"

# harness -> (template filename under skills/guidefold/hooks/, dest path relative to consumer root)
# Claude and Copilot destinations match docs/CONVENTIONS.md §10. Codex is installed repo-local
# (.codex/hooks.json) rather than at CONVENTIONS.md's documented ~/.codex/hooks.json: `init`
# only ever touches the target repo, never the invoking user's home directory, and the shipped
# codex.hooks.json template's own hook command is repo-relative anyway
# (".agents/skills/guidefold/scripts/guidefold hook"), which only resolves correctly when the
# harness's cwd is the repo root — true for a repo-local hook file, not guaranteed for a global
# one shared across every repo on the machine. docs/ASSESSMENT.md's Day-1 checklist already
# flags <project>/.codex/hooks.json as the thing to test, with ~/.codex/hooks.json kept as a
# documented fallback for Codex builds that hit issue #17532 (repo-local hooks not firing).
HARNESS_HOOK_FILES = {
    "claude":  ("claude.settings.json", ".claude/settings.json"),
    "copilot": ("copilot.hooks.json",   ".github/hooks/guidefold.json"),
    "codex":   ("codex.hooks.json",     ".codex/hooks.json"),
}


def _target_root() -> Path:
    """Resolve the target repo for init/doctor. Mirrors repo_root()'s search (env var, nearest
    guidefold.yaml ancestor, git toplevel) but never exits — init runs before guidefold.yaml
    exists, and doctor must always produce a report, even outside a git repo."""
    env = os.environ.get("GUIDEFOLD_ROOT")
    if env:
        return Path(env).resolve()
    here = Path.cwd().resolve()
    for d in (here, *here.parents):
        if (d / "guidefold.yaml").is_file():
            return d
    try:
        out = subprocess.run(["git", "rev-parse", "--show-toplevel"], capture_output=True, text=True, timeout=5)
        if out.returncode == 0 and out.stdout.strip():
            return Path(out.stdout.strip()).resolve()
    except Exception:
        pass
    return here


_SLUG_RE = re.compile(r"[^a-z0-9]+")

def _slugify(s: str) -> str:
    s = _ascii_lower(s or "")
    s = _SLUG_RE.sub("-", s).strip("-")
    return s or "org"


def _infer_publisher(root: Path, override: str = None) -> str:
    if override:
        return _slugify(override)
    try:
        out = subprocess.run(["git", "config", "--get", "remote.origin.url"],
                              capture_output=True, text=True, cwd=root, timeout=5)
        if out.returncode == 0 and out.stdout.strip():
            name = out.stdout.strip().rstrip("/").rsplit("/", 1)[-1]
            if name.endswith(".git"):
                name = name[:-4]
            if name:
                return _slugify(name)
    except Exception:
        pass
    return _slugify(root.name)


def _infer_owner_from_codeowners(root: Path) -> str:
    """Best-effort whole-repo owner from a CODEOWNERS `* @org/team` (or `/*`, `**`, `/**`) rule.
    Falls back to "unknown" (the same default load_map() uses for a node with no explicit
    owner) when there's no CODEOWNERS file, or no whole-repo rule in it."""
    for candidate in (root / "CODEOWNERS", root / ".github" / "CODEOWNERS", root / "docs" / "CODEOWNERS"):
        if not candidate.is_file():
            continue
        for line in candidate.read_text(errors="ignore").splitlines():
            line = line.split("#", 1)[0].strip()
            if not line:
                continue
            parts = line.split()
            if len(parts) < 2 or parts[0] not in ("*", "/*", "**", "/**"):
                continue
            owner = parts[1].lstrip("@")
            return owner.rsplit("/", 1)[-1]
    return "unknown"


def _render_guidefold_yaml(publisher: str, owner: str) -> str:
    # Written as plain text, not yaml.dump(), so `init` never needs to import PyYAML (the CLI
    # stays lazy about it — see load_map()); publisher/owner are already slug-safe bare scalars.
    return (
        "# Guidefold hierarchy map — generated by `guidefold init`.\n"
        "# Add one node per team/component as your monorepo grows; see templates/guidefold.example.yaml\n"
        "# in the guidefold tool repo for a worked multi-node example.\n"
        f"publisher: {publisher}\n"
        "registry:\n"
        "  backend: local              # local | agent-registry — flip once you publish to Agent Registry\n"
        "nodes:\n"
        "  _root:\n"
        '    paths: ["**"]\n'
        f"    owner: {owner}\n"
    )


def _write_guidefold_yaml(dry: bool, root: Path, publisher: str, owner: str):
    dest = root / "guidefold.yaml"
    if dest.is_file():
        print(f"guidefold.yaml already exists at {rel(root, dest)} — leaving it untouched.")
        return
    if dry:
        print(f"[dry-run] would create guidefold.yaml (publisher={publisher}, _root owner={owner})")
        return
    dest.write_text(_render_guidefold_yaml(publisher, owner))
    print(f"created guidefold.yaml (publisher={publisher}, _root owner={owner})")


def _stamp_bootstrap_skill(dest: Path, publisher: str, owner: str):
    """skills/guidefold/SKILL.md ships as a template (see its own header comment): its
    description embeds a literal `<publisher>` placeholder and its metadata.owner is hardcoded
    to "platform-engineering" — both would otherwise fail `guidefold validate` in every
    consumer repo whose publisher/root-owner differ. `init` stamps in the real values so a
    freshly-bootstrapped repo validates clean without a manual edit."""
    skill_md = dest / "SKILL.md"
    if not skill_md.is_file():
        return
    text = skill_md.read_text()
    text = text.replace("<publisher>", publisher)
    text = text.replace("owner: platform-engineering", f"owner: {owner}")
    skill_md.write_text(text)


def _copy_skill_dir(dry: bool, root: Path, publisher: str, owner: str):
    dest = root / ".agents" / "skills" / "guidefold"
    if dest.resolve() == TOOL_SKILL_SRC.resolve():
        print("skipping .agents/skills/guidefold — this is the guidefold tool checkout itself.")
        return
    if dest.exists():
        print(f"{rel(root, dest)} already exists — leaving it untouched.")
        return
    if not TOOL_SKILL_SRC.is_dir():
        print(f"warning: cannot find {TOOL_SKILL_SRC} — skipping the .agents/skills/guidefold install "
              f"(run `init` from a full guidefold tool checkout, not a copied CLI)")
        return
    if dry:
        print(f"[dry-run] would copy skills/guidefold/ -> .agents/skills/guidefold/ "
              f"(stamping publisher={publisher}, owner={owner} into SKILL.md)")
        return
    dest.parent.mkdir(parents=True, exist_ok=True)
    shutil.copytree(TOOL_SKILL_SRC, dest)
    _stamp_bootstrap_skill(dest, publisher, owner)
    print("copied skills/guidefold/ -> .agents/skills/guidefold/")


def _merge_hook_config(existing: dict, template: dict):
    """Additively merge `template` into `existing`: top-level scalar keys are added only if
    absent; the "hooks" dict is merged per event, appending template entries the existing list
    doesn't already have (by JSON equality). Re-merging the same template is a no-op — this is
    what makes `init` idempotent for hook files. Returns (merged, changed)."""
    merged = json.loads(json.dumps(existing)) if existing else {}
    changed = False
    for k, v in template.items():
        if k == "hooks":
            merged.setdefault("hooks", {})
            for event, entries in (v or {}).items():
                bucket = merged["hooks"].setdefault(event, [])
                for entry in entries:
                    if entry not in bucket:
                        bucket.append(entry)
                        changed = True
        elif k not in merged:
            merged[k] = v
            changed = True
    return merged, changed


def _install_hook(dry: bool, root: Path, harness: str):
    tmpl_name, dest_rel = HARNESS_HOOK_FILES[harness]
    tmpl_path = TOOL_SKILL_SRC / "hooks" / tmpl_name
    if not tmpl_path.is_file():
        print(f"warning: hook template missing: {tmpl_path} — skipping {harness}")
        return
    template = json.loads(tmpl_path.read_text())
    dest = root / dest_rel
    existing = {}
    if dest.is_file():
        try:
            existing = json.loads(dest.read_text())
        except json.JSONDecodeError:
            print(f"warning: {dest_rel} is not valid JSON — leaving it untouched, not merging the {harness} hook")
            return
    merged, changed = _merge_hook_config(existing, template)
    if not changed:
        print(f"{dest_rel} already has the {harness} guidefold hook — nothing to do.")
        return
    if dry:
        verb = "update" if dest.is_file() else "create"
        print(f"[dry-run] would {verb} {dest_rel} (merge {harness} hook)")
        return
    dest.parent.mkdir(parents=True, exist_ok=True)
    existed = dest.is_file()
    dest.write_text(json.dumps(merged, indent=2) + "\n")
    print(("updated " if existed else "created ") + dest_rel)


def _install_github_action(dry: bool, root: Path):
    src = TOOL_TEMPLATES_DIR / "github-workflows-skills.yml"
    dest = root / ".github" / "workflows" / "skills.yml"
    if dest.is_file():
        print(f"{rel(root, dest)} already exists — leaving it untouched.")
        return
    if not src.is_file():
        print(f"warning: cannot find {src} — skipping the CI workflow install "
              f"(run `init` from a full guidefold tool checkout, not a copied CLI)")
        return
    if dry:
        print("[dry-run] would create .github/workflows/skills.yml")
        return
    dest.parent.mkdir(parents=True, exist_ok=True)
    dest.write_text(src.read_text())
    print("created .github/workflows/skills.yml")


def _ensure_gitignore(dry: bool, root: Path):
    dest = root / ".gitignore"
    marker = ".guidefold/"
    existing = dest.read_text() if dest.is_file() else ""
    if any(line.strip() == marker for line in existing.splitlines()):
        print(".gitignore already ignores .guidefold/ — nothing to do.")
        return
    if dry:
        verb = "append to" if dest.is_file() else "create"
        print(f"[dry-run] would {verb} .gitignore (add {marker})")
        return
    addition = ("" if not existing or existing.endswith("\n") else "\n")
    addition += "\n# generated guidefold artifacts (ADR-0012): cards, index, cache\n" + marker + "\n"
    with dest.open("a") as f:
        f.write(addition)
    print(("appended to " if existing else "created ") + ".gitignore")


def cmd_init(a):
    root = _target_root()
    dry = a.dry_run
    publisher = _infer_publisher(root, a.publisher)
    owner = _infer_owner_from_codeowners(root)
    harnesses = ("claude", "copilot", "codex") if a.harness == "all" else (a.harness,)
    print(f"guidefold init — target repo: {root}")
    _write_guidefold_yaml(dry, root, publisher, owner)
    _copy_skill_dir(dry, root, publisher, owner)
    for h in harnesses:
        _install_hook(dry, root, h)
    _install_github_action(dry, root)
    _ensure_gitignore(dry, root)
    print()
    if dry:
        print("[dry-run] nothing was written.")
    else:
        print("Next: run `guidefold doctor` to verify the setup.")


# ---------------------------------------------------------------------- doctor

def _doctor_check(name: str, status: str, detail: str, fix: str = None) -> dict:
    return {"name": name, "status": status, "detail": detail, "fix": fix}


def _check_python() -> dict:
    v = sys.version_info
    ok = (v.major, v.minor) >= (3, 10)
    detail = f"Python {v.major}.{v.minor}.{v.micro}"
    return _doctor_check("python-version", "ok" if ok else "warn", detail,
                          None if ok else "upgrade to Python 3.10+ (CI matrix: 3.10, 3.11, 3.12)")


def _check_cli_compiles(root: Path) -> dict:
    cli_path = root / ".agents" / "skills" / "guidefold" / "scripts" / "guidefold"
    if not cli_path.is_file():
        return _doctor_check("cli-installed", "fail", "no .agents/skills/guidefold/scripts/guidefold found",
                              "run `guidefold init` to install the CLI into .agents/skills/guidefold/")
    import py_compile
    try:
        with tempfile.TemporaryDirectory() as td:
            py_compile.compile(str(cli_path), cfile=str(Path(td) / "out.pyc"), doraise=True)
        return _doctor_check("cli-compiles", "ok", f"{rel(root, cli_path)} compiles cleanly")
    except py_compile.PyCompileError as e:
        return _doctor_check("cli-compiles", "fail", f"{rel(root, cli_path)} failed to compile: {e.exc_value}",
                              "fix the syntax error, or re-run `guidefold init`")
    except Exception as e:
        return _doctor_check("cli-compiles", "fail", f"could not compile {rel(root, cli_path)}: {e}",
                              "re-run `guidefold init`")


def _check_guidefold_yaml(root: Path):
    """Returns (checks, cfg) — cfg is None if guidefold.yaml is missing/unparseable, so later
    checks that need it (skill layout, registry backend) can degrade to a single "skipped" entry
    instead of crashing."""
    checks = []
    yaml_path = root / "guidefold.yaml"
    if not yaml_path.is_file():
        checks.append(_doctor_check("guidefold-yaml", "fail", "guidefold.yaml not found at repo root",
                                     "run `guidefold init` to create a skeleton"))
        return checks, None
    checks.append(_doctor_check("guidefold-yaml", "ok", "guidefold.yaml found"))
    try:
        import yaml
    except ImportError:
        checks.append(_doctor_check("guidefold-yaml-parses", "fail", "PyYAML not installed",
                                     "pip install pyyaml"))
        return checks, None
    try:
        cfg = yaml.safe_load(yaml_path.read_text())
    except Exception as e:
        checks.append(_doctor_check("guidefold-yaml-parses", "fail", f"guidefold.yaml did not parse: {e}",
                                     "fix the YAML syntax error in guidefold.yaml"))
        return checks, None
    if not isinstance(cfg, dict) or not cfg.get("publisher"):
        checks.append(_doctor_check("guidefold-yaml-parses", "fail",
                                     "guidefold.yaml parsed but is missing a top-level `publisher:`",
                                     "add `publisher: <your-org>` to guidefold.yaml"))
        return checks, None
    checks.append(_doctor_check("guidefold-yaml-parses", "ok", f"publisher={cfg['publisher']}"))
    cfg.setdefault("nodes", {}).setdefault("_root", {"paths": ["**"], "owner": "unknown"})
    bad_nodes = [n for n, spec in cfg["nodes"].items() if not spec.get("paths") or not spec.get("owner")]
    if bad_nodes:
        checks.append(_doctor_check("guidefold-yaml-nodes", "fail",
                                     f"node(s) missing paths/owner: {', '.join(sorted(bad_nodes))}",
                                     "add `paths:` and `owner:` to every node in guidefold.yaml"))
    else:
        checks.append(_doctor_check("guidefold-yaml-nodes", "ok",
                                     f"{len(cfg['nodes'])} node(s), all have paths+owner"))
    empty = []
    for node, spec in cfg["nodes"].items():
        matched = False
        for g in spec.get("paths", []) or []:
            try:
                if next(iter(root.glob(g)), None) is not None:
                    matched = True
                    break
            except Exception:
                pass
        if not matched:
            empty.append(node)
    if empty:
        checks.append(_doctor_check("guidefold-yaml-globs", "warn",
                                     f"node(s) whose path globs match nothing yet: {', '.join(sorted(empty))}",
                                     "check the `paths:` globs, or remove the node until it has code"))
    else:
        checks.append(_doctor_check("guidefold-yaml-globs", "ok", "every node's path globs match at least one path"))
    return checks, cfg


def _check_skill_layout(root: Path, cfg) -> list:
    if cfg is None:
        return [_doctor_check("skill-layout", "warn", "skipped (guidefold.yaml invalid)", None)]
    checks = []
    try:
        skills = list(all_skills(root, cfg))
    except Exception as e:
        checks.append(_doctor_check("skill-layout", "fail", f"error scanning .agents/skills: {e}",
                                     "check every SKILL.md's frontmatter is valid YAML"))
        checks.append(_doctor_check("validate", "warn", "skipped (skill layout scan failed)", None))
        return checks
    if not skills:
        checks.append(_doctor_check("skill-layout", "warn", "no SKILL.md found under any .agents/skills/",
                                     "add at least one skill (fine to ignore for a brand-new repo)"))
    else:
        checks.append(_doctor_check("skill-layout", "ok", f"{len(skills)} skill(s) found"))
    try:
        _, errors = _validate_errors(root, cfg)
    except Exception as e:
        checks.append(_doctor_check("validate", "fail", f"validate crashed: {e}",
                                     "run `guidefold validate` directly for the full traceback"))
        return checks
    if errors:
        checks.append(_doctor_check("validate", "fail", f"{len(errors)} validation error(s), e.g. {errors[0]}",
                                     "run `guidefold validate` for the full list and fix each SKILL.md"))
    else:
        checks.append(_doctor_check("validate", "ok", f"{len(skills)} skill(s), 0 errors"))
    return checks


def _check_hook(root: Path, harness: str) -> dict:
    _tmpl_name, dest_rel = HARNESS_HOOK_FILES[harness]
    dest = root / dest_rel
    if not dest.is_file():
        return _doctor_check(f"hook-{harness}", "warn", f"{dest_rel} not found",
                              f"run `guidefold init --harness {harness}` to install it")
    try:
        cfg_json = json.loads(dest.read_text())
    except Exception as e:
        return _doctor_check(f"hook-{harness}", "fail", f"{dest_rel} is not valid JSON: {e}",
                              f"fix or remove {dest_rel}, then re-run `guidefold init --harness {harness}`")
    if "scripts/guidefold" not in json.dumps(cfg_json):
        return _doctor_check(f"hook-{harness}", "warn", f"{dest_rel} exists but doesn't reference scripts/guidefold",
                              f"re-run `guidefold init --harness {harness}` to add the guidefold hook")
    cli_path = root / ".agents" / "skills" / "guidefold" / "scripts" / "guidefold"
    if not cli_path.is_file():
        return _doctor_check(f"hook-{harness}", "fail", f"{dest_rel} points at scripts/guidefold, which doesn't exist",
                              "run `guidefold init` to install .agents/skills/guidefold/")
    if not os.access(cli_path, os.X_OK):
        return _doctor_check(f"hook-{harness}", "fail", f"{rel(root, cli_path)} exists but isn't executable",
                              f"chmod +x {rel(root, cli_path)}")
    return _doctor_check(f"hook-{harness}", "ok", f"{dest_rel} wired to an executable scripts/guidefold")


def _check_gitignore(root: Path) -> dict:
    dest = root / ".gitignore"
    if not dest.is_file():
        return _doctor_check("gitignore", "fail", ".gitignore not found", "run `guidefold init` to create one")
    if ".guidefold/" not in dest.read_text():
        return _doctor_check("gitignore", "fail", ".gitignore does not exclude .guidefold/",
                              "add `.guidefold/` to .gitignore (ADR-0012)")
    return _doctor_check("gitignore", "ok", ".gitignore excludes .guidefold/")


def _check_github_action(root: Path) -> dict:
    dest = root / ".github" / "workflows" / "skills.yml"
    if not dest.is_file():
        return _doctor_check("github-action", "warn", ".github/workflows/skills.yml not found",
                              "run `guidefold init` to install the CI workflow")
    return _doctor_check("github-action", "ok", ".github/workflows/skills.yml present")


def _gcloud_json(args: list, timeout: int = 5):
    """Run a gcloud command with --format=json, timeout-guarded, never raising. Returns
    (parsed_json_or_None, error_message_or_None)."""
    try:
        out = subprocess.run(["gcloud", *args, "--format=json"], capture_output=True, text=True, timeout=timeout)
    except FileNotFoundError:
        return None, "gcloud not found on PATH"
    except subprocess.TimeoutExpired:
        return None, "gcloud call timed out (network or auth prompt?)"
    except Exception as e:
        return None, f"gcloud call failed: {e}"
    if out.returncode != 0:
        lines = [l for l in (out.stderr or "").strip().splitlines() if l.strip()]
        return None, lines[-1] if lines else f"gcloud exited {out.returncode}"
    try:
        return json.loads(out.stdout or "null"), None
    except json.JSONDecodeError:
        return None, "gcloud returned non-JSON output"


def _check_registry(root: Path, cfg) -> list:
    if cfg is None:
        return [_doctor_check("registry-backend", "warn", "skipped (guidefold.yaml invalid)", None)]
    backend = (cfg.get("registry") or {}).get("backend", "agent-registry")
    if backend == "local":
        try:
            n = len(list(all_skills(root, cfg)))
            return [_doctor_check("registry-backend", "ok", f"local backend: {n} skill(s) readable")]
        except Exception as e:
            return [_doctor_check("registry-backend", "fail", f"local backend tree unreadable: {e}",
                                   "check filesystem permissions under .agents/skills")]
    checks = []
    if shutil.which("gcloud") is None:
        checks.append(_doctor_check("registry-gcloud", "fail", "gcloud not found on PATH",
                                     "install the Google Cloud SDK and ensure gcloud is on PATH"))
        for name in ("registry-adc", "registry-project", "registry-roles"):
            checks.append(_doctor_check(name, "warn", "skipped (gcloud unavailable)", "resolve registry-gcloud first"))
        return checks
    checks.append(_doctor_check("registry-gcloud", "ok", "gcloud found on PATH"))
    accounts, err = _gcloud_json(["auth", "list"])
    active = None
    if err:
        checks.append(_doctor_check("registry-adc", "warn", f"could not verify ADC/login: {err}",
                                     "run `gcloud auth login` and `gcloud auth application-default login`"))
    else:
        active_entries = [x for x in (accounts or []) if x.get("status") == "ACTIVE"]
        if not active_entries:
            checks.append(_doctor_check("registry-adc", "fail", "no active gcloud account",
                                         "run `gcloud auth login` and `gcloud auth application-default login`"))
        else:
            active = active_entries[0].get("account")
            checks.append(_doctor_check("registry-adc", "ok", f"active account: {active}"))
    project = (cfg.get("registry") or {}).get("project")
    if not project:
        checks.append(_doctor_check("registry-project", "fail", "registry.project not set in guidefold.yaml",
                                     "add `registry.project: <gcp-project-id>` to guidefold.yaml"))
        checks.append(_doctor_check("registry-roles", "warn", "skipped (no project configured)",
                                     "set registry.project first"))
        return checks
    _proj, err = _gcloud_json(["projects", "describe", project])
    if err:
        checks.append(_doctor_check("registry-project", "fail", f"project {project}: {err}",
                                     f"verify registry.project: {project} exists and is accessible"))
        checks.append(_doctor_check("registry-roles", "warn", "skipped (project check failed)",
                                     "resolve registry-project first"))
        return checks
    checks.append(_doctor_check("registry-project", "ok", f"project {project} reachable"))
    if not active:
        checks.append(_doctor_check("registry-roles", "warn", "skipped (no active gcloud account)",
                                     "resolve registry-adc first"))
        return checks
    policy, err = _gcloud_json(["projects", "get-iam-policy", project])
    if err:
        checks.append(_doctor_check("registry-roles", "warn", f"could not read IAM policy: {err}",
                                     "verify resourcemanager.projects.getIamPolicy on the project"))
        return checks
    has_role = any(
        b.get("role") == "roles/agentregistry.admin" and any(active in m for m in b.get("members", []))
        for b in (policy or {}).get("bindings", []) or []
    )
    if has_role:
        checks.append(_doctor_check("registry-roles", "ok", f"{active} has roles/agentregistry.admin on {project}"))
    else:
        checks.append(_doctor_check("registry-roles", "fail", f"{active} lacks roles/agentregistry.admin on {project}",
                                     f"grant roles/agentregistry.admin to {active} on {project}"))
    return checks


def _check_index_freshness(root: Path) -> dict:
    candidates = [root / ".guidefold" / "index"]
    try:
        candidates.append(cache_root() / "index")
    except Exception:
        pass
    sha_dirs = []
    for c in candidates:
        if c.is_dir():
            try:
                sha_dirs.extend(d for d in c.iterdir() if d.is_dir())
            except Exception:
                pass
    if not sha_dirs:
        return _doctor_check("index-freshness", "ok", "no index artifact found — nothing to check", None)
    newest = max(d.stat().st_mtime for d in sha_dirs)
    head_ts = None
    try:
        out = subprocess.run(["git", "log", "-1", "--format=%ct"], capture_output=True, text=True, cwd=root, timeout=5)
        if out.returncode == 0 and out.stdout.strip():
            head_ts = int(out.stdout.strip())
    except Exception:
        pass
    if head_ts is None:
        return _doctor_check("index-freshness", "warn", "could not determine HEAD commit time", None)
    if newest < head_ts:
        return _doctor_check("index-freshness", "warn", "index artifact is older than HEAD",
                              "run `guidefold index` to refresh it")
    return _doctor_check("index-freshness", "ok", "index artifact is at least as new as HEAD")


def cmd_doctor(a):
    root = _target_root()
    checks = [_check_python(), _check_cli_compiles(root)]
    yaml_checks, cfg = _check_guidefold_yaml(root)
    checks.extend(yaml_checks)
    checks.extend(_check_skill_layout(root, cfg))
    for h in ("claude", "copilot", "codex"):
        checks.append(_check_hook(root, h))
    checks.append(_check_gitignore(root))
    checks.append(_check_github_action(root))
    checks.extend(_check_registry(root, cfg))
    checks.append(_check_index_freshness(root))
    ok = not any(c["status"] == "fail" for c in checks)
    if a.json:
        print(json.dumps({"root": str(root), "ok": ok, "checks": checks}, indent=2))
    else:
        for c in checks:
            tag = {"ok": "OK", "warn": "WARN", "fail": "FAIL"}[c["status"]]
            print(f"[{tag}] {c['name']}: {c['detail']}")
            if c["status"] != "ok" and c.get("fix"):
                print(f"       fix: {c['fix']}")
        n_fail = sum(c["status"] == "fail" for c in checks)
        n_warn = sum(c["status"] == "warn" for c in checks)
        print(f"\nguidefold doctor: {len(checks)} checks, {n_fail} failed, {n_warn} warnings")
    sys.exit(0 if ok else 1)


# ------------------------------------------------------------------------ main
def main():
    p = argparse.ArgumentParser(prog="guidefold")
    p.add_argument("--backend", choices=["local", "agent-registry"], help="override registry.backend from guidefold.yaml")
    p.add_argument("--project", help="override registry.project from guidefold.yaml")
    sub = p.add_subparsers(dest="cmd", required=True)
    sub.add_parser("where")
    f = sub.add_parser("find"); f.add_argument("task"); f.add_argument("--scope"); f.add_argument("--limit", type=int, default=8)
    f.add_argument("--include-deprecated", action="store_true", help="don't apply the policy filter's deprecated-skill drop")
    f.add_argument("--experimental", action="store_true",
                   help="E1.6 shadow mode: write a top-20 retrieval-order telemetry record to "
                        ".guidefold/telemetry/shadow-<date>.jsonl for offline reranker scoring "
                        "(tools/bakeoff/rerank_shadow.py). Never changes the printed result.")
    f.add_argument("--telemetry-raw", action="store_true",
                   help="with --experimental, store the raw query text in the shadow record "
                        "instead of only its SHA-256 hash (default: hash only -- prompts can "
                        "carry proprietary detail)")
    l = sub.add_parser("load"); l.add_argument("urn")
    sub.add_parser("validate")
    dr = sub.add_parser("drift"); dr.add_argument("--base", default="origin/main")
    pu = sub.add_parser("publish"); pu.add_argument("--changed", action="store_true"); pu.add_argument("--base", default="HEAD~1"); pu.add_argument("--revision"); pu.add_argument("--only", help="publish only skills whose logical URN contains this substring")
    ix = sub.add_parser("index"); ix.add_argument("--check", action="store_true", help="verify the on-disk artifact matches this sha and the current tree; no writes")
    m = sub.add_parser("materialize"); m.add_argument("--check", action="store_true")
    sub.add_parser("hook")
    sub.add_parser("prewarm")
    i = sub.add_parser("init", help="bootstrap a consumer monorepo: guidefold.yaml skeleton, .agents/skills/guidefold, harness hooks, CI workflow, .gitignore")
    i.add_argument("--publisher", help="override the inferred publisher name")
    i.add_argument("--harness", choices=["claude", "copilot", "codex", "all"], default="all")
    i.add_argument("--dry-run", action="store_true", help="print what would be done; write nothing")
    doc = sub.add_parser("doctor", help="diagnose a configured repo: gcloud/ADC/roles, hook wiring, skill layout, index freshness")
    doc.add_argument("--json", action="store_true")
    a = p.parse_args()
    # init/doctor must work on a repo with no guidefold.yaml yet, so they bypass the
    # repo_root()/load_map() setup below (which requires one) — see _target_root().
    if a.cmd == "init":
        cmd_init(a)
        return
    if a.cmd == "doctor":
        cmd_doctor(a)
        return
    root = repo_root()
    if a.cmd == "hook":
        # E1.5: the hook path must import zero PyYAML (provable via `python3 -X importtime`) and
        # must never resolve cwd -> node from the working-tree guidefold.yaml — both of which
        # `load_map` would do. cmd_hook reads only the pre-built artifact's own nodes.json.
        cmd_hook(a, root)
        return
    cfg = load_map(root)
    cfg.setdefault("registry", {})
    if a.backend:
        cfg["registry"]["backend"] = a.backend
    if a.project:
        cfg["registry"]["project"] = a.project
    globals()[f"cmd_{a.cmd}"](a, root, cfg)

if __name__ == "__main__":
    main()
