#!/usr/bin/env python3
"""guidefold — minimal CLI for hierarchy-aware skill discovery over Google Agent Registry.

Subcommands
  where                     print hierarchy node for cwd (from guidefold.yaml)
  find "<task>" --scope N   task-aware ranked search (Router 0.1) + URN-prefix filter for N
  load <urn>                download default revision into <cache_root>/skills/<urn>/<rev>/;
                             --delivery-policy proof_gated uses service USE 1.2 and fails closed
  validate                  CI: enforce CONVENTIONS.md on all skills
  drift --base <ref>        CI: code diff ∩ metadata.references → report
  report --base <ref>       CI/PR: deterministic change report between <ref> and the working tree —
                             skill/scope/relation/resource diff, structure errors (cycle, missing
                             dependency/resource, invalid card) that fail the run, probable trigger
                             collisions and retrieval examples that only warn (P12/U7)
  publish --changed         CI: zip + CreateSkill/CreateSkillRevision for changed skills
  index [--check]           CI: regenerate the hierarchy-index skill + build/verify the binary
                             retrieval artifact at <cache_root>/index/<sha>/ (E1.4)
  materialize [--check]     CI: generate L0 scope cards (AGENTS.md per node, applyTo instructions, CLAUDE.md/GEMINI.md)
  hook                      harness hook (Claude Code / Codex): read JSON on stdin, print <=4 cards
                             for the prompt from the pre-built index artifact only — never
                             guidefold.yaml, never PyYAML, hard watchdog (E1.5)
  prewarm                   Copilot sessionStart: download the node chain's skills into <cache_root>/skills
  init                      bootstrap a consumer monorepo in one command: guidefold.yaml skeleton, .agents/skills/guidefold, harness hooks, CI workflow, .gitignore entries
  doctor [--json]           diagnose a configured repo: gcloud/ADC/roles, hook wiring, skill layout, index freshness,
                             hosted-service reachability/identity, installed adapter — prints a fix for every failure

Hosted service (product pivot, P03/P10 — needs a running management API for everything but `scan`)
  scan [PATH] [--dry-run]   build the guidefold-import-manifest-v1 for a tree; opens zero sockets
  login / logout            device flow; token in $GUIDEFOLD_CREDENTIALS or ~/.config/guidefold/credentials.json (0600)
  org list | org use SLUG   inspect / select the current organisation
  import [PATH] [--wait]    scan -> POST imports -> upload only the missing blobs -> finalize
  sync [PATH] [--wait]      the same call, reporting the server's new/reused blob split
  status <import_id>        one import's state, per-file result, jobs and publication
  install --harness H       install the portable adapter package + harness wiring (idempotent, has uninstall)
  proposals list|show|apply review exports; `apply --write` writes files and never commits

Design notes
  * All registry access goes through the `registry` section so it can be swapped for MCP
    or an ARD endpoint later without touching SKILL.md (ADR-0003).
  * Uses `gcloud` for auth and for search (Preview API), REST for payload upload/download.
  * Ranking (find) builds an in-memory Index by scanning the local tree via `all_skills()`.
    `hook` instead loads the immutable on-disk artifact `guidefold index` already built for the
    current sha (E1.4) — same Router, same ranking code, different Index source; see
    "Index artifact (E1.4)" below for the file layout. Registry/LocalRegistry are storage +
    transport only (`publish`/`download`/`search_scope`) — no ranking lives there.
  * Intentionally dependency-light: stdlib + PyYAML (imported lazily — see load_map/frontmatter
    — so commands that never touch guidefold.yaml/SKILL.md, e.g. `--help` and `hook`, don't pay
    for it: `hook`'s whole code path imports zero PyYAML, provable with `python3 -X importtime`).
"""
import argparse, array, datetime, fnmatch, json, mmap, os, re, signal, struct, subprocess, sys, time, unicodedata
# Deliberately NOT imported at module scope, even though the module is small: hashlib, math,
# shutil, tempfile, uuid, zipfile. None of these are touched by the `hook` code path (E1.5's
# hard latency budget — DENSE-PROGRAM.md R4), so each is imported locally, right before first
# use, in the handful of functions that actually need it (same lazy-import pattern already used
# for PyYAML in load_map/frontmatter). `io` was imported and never used at all; dropped.
from functools import cmp_to_key
from pathlib import Path

# CLI version stamped into shadow telemetry (E1.6) so a later analysis pass can tell which
# ranking code produced a given shadow record. Bump by hand on a user-visible behaviour change;
# nothing parses this beyond string equality today.
CLI_VERSION = "0.1.0"

# E6.4/E2.7 SEARCH/USE telemetry (docs/SEARCH-USE-TELEMETRY.md Sec4): versions stamped into every
# client event so a later analysis pass can tell which ranking/policy code produced it. Bump by
# hand alongside the corresponding behaviour change; also used as `adapter_version` (== CLI_VERSION,
# there is only one adapter here). Kept next to CLI_VERSION -- same role, same bump discipline.
ROUTER_VERSION = "router-0.1"      # Router class behaviour (candidates/score/select)
POLICY_VERSION = "adr0022-v1"      # ADR-0022 admissibility/relevance/bundle-completeness policy
TELEMETRY_SCHEMA_VERSION = "1.0"   # must match tools/telemetry/ledger.py SCHEMA_VERSIONS

# ---------------------------------------------------------------- repo helpers
def repo_root() -> Path:
    """Monorepo root = nearest ancestor holding guidefold.yaml (or $GUIDEFOLD_ROOT); git toplevel as fallback."""
    env = os.environ.get("GUIDEFOLD_ROOT")
    if env:
        return Path(env).resolve()
    here = Path.cwd().resolve()
    for d in (here, *here.parents):
        if (d / "guidefold.yaml").is_file():
            return d
    out = subprocess.run(["git", "rev-parse", "--show-toplevel"], capture_output=True, text=True)
    if out.returncode != 0:
        sys.exit("guidefold: no guidefold.yaml above cwd and not inside a git repository")
    return Path(out.stdout.strip())

def load_map(root: Path) -> dict:
    try:
        import yaml
    except ImportError:  # keep the failure loud but friendly
        sys.exit("guidefold: PyYAML missing — pip install pyyaml")
    cfg = yaml.safe_load((root / "guidefold.yaml").read_text(encoding="utf-8"))
    cfg.setdefault("nodes", {}).setdefault("_root", {"paths": ["**"], "owner": "unknown"})
    return cfg

def rel(root: Path, p: Path) -> str:
    return str(p.resolve().relative_to(root)).replace(os.sep, "/")

def node_for(cfg: dict, relpath: str) -> str:
    """Most specific node whose paths match relpath (longest glob wins)."""
    best, best_len = "_root", -1
    for node, spec in cfg["nodes"].items():
        for g in spec.get("paths", []):
            if fnmatch.fnmatch(relpath + "/", g) or fnmatch.fnmatch(relpath, g):
                if len(g) > best_len:
                    best, best_len = node, len(g)
    return best

def ancestors(node: str) -> list:
    """atlas.identity.turnstile -> [atlas.identity.turnstile, atlas.identity, atlas, _root]"""
    parts = node.split(".") if node != "_root" else []
    chain = [".".join(parts[:i]) for i in range(len(parts), 0, -1)]
    return chain + ["_root"]

def urn(cfg: dict, node: str, name: str) -> str:
    return f"urn:skill:{cfg['publisher']}:{node}:{name}"

# ------------------------------------------------------------- registry layer
# Verified against Agent Registry v1alpha on 2026-09-04 (see docs/adr/ADR-0008 and docs/ASSESSMENT.md):
#   * resource id we choose:  <publisher>--<node with . -> ->--<name>   ("root" for _root)
#   * server stores it as     private-<resource id>  and assigns
#     skillId = urn:skill:projects-<NUMBER>:locations:<LOC>:private-<resource id>
#   * create (draft, no payload) -> revisions create --payload=<zip> -> update --default-revision -> update --target-state=active
#   * keyword prefix search:  skillId:private-<publisher>--<flat-node>*   (short form only)
#   * revisions download --destination=<dir> extracts the zip into <dir>
ZIP_MAX_COMPRESSED = 500 * 1024        # system limit (fixed)
ZIP_MAX_FILE = 1024 * 1024             # system limit (fixed)
KEEP_REVISIONS = 20                    # quota is 100 revisions per skill

def flat_node(node: str) -> str:
    return node.lstrip("_").replace(".", "-")

def parse_urn(u: str):
    """urn:skill:<publisher>:<node>:<name> -> (publisher, node, name)"""
    parts = u.split(":")
    if len(parts) != 5 or parts[:2] != ["urn", "skill"]:
        sys.exit(f"guidefold: not a logical skill URN: {u}")
    return parts[2], parts[3], parts[4]

def zip_skill_dir(skill_dir: Path, zpath: Path):
    import zipfile
    with zipfile.ZipFile(zpath, "w", zipfile.ZIP_DEFLATED) as z:
        for f in sorted(skill_dir.rglob("*")):
            if f.is_file() and not any(part in (".git", "__pycache__") for part in f.parts):
                if f.stat().st_size > ZIP_MAX_FILE:
                    sys.exit(f"guidefold: {f} exceeds 1 MB per-file limit")
                z.write(f, f.relative_to(skill_dir))
    if zpath.stat().st_size > ZIP_MAX_COMPRESSED:
        sys.exit(f"guidefold: {skill_dir} zips to {zpath.stat().st_size} bytes > 500 KB limit")

class Registry:
    """Google Cloud Agent Registry backend (gcloud alpha). Storage + transport only (ADR-0003,
    E0.2): `search_scope`/`download`/`publish`/`default_revision`. No ranking lives here — that's
    Router 0.1 (see Index/Router below), which never depends on this class."""
    def __init__(self, cfg):
        self.cfg = cfg
        self.project = cfg["registry"]["project"]
        self.location = cfg["registry"].get("location", "global")
        self.publisher = cfg["publisher"]
        self._node_by_flat = {flat_node(n): n for n in cfg["nodes"]}
        self._node_by_flat["index"] = "_index"

    # --- gcloud plumbing
    def _gcloud(self, *args, fmt="json", check=True):
        cmd = ["gcloud", "alpha", "agent-registry", *args,
               f"--project={self.project}", f"--location={self.location}", f"--format={fmt}"]
        out = subprocess.run(cmd, capture_output=True, text=True)
        if out.returncode != 0:
            if check:
                err = [l for l in out.stderr.splitlines() if l.strip() and not l.startswith((".", "Waiting for", "Create request", "Update request"))]
                sys.exit("guidefold: gcloud failed: " + " | ".join(err[:4]) if err else f"guidefold: gcloud failed: {' '.join(cmd)}")
            return None
        if fmt != "json":
            return out.stdout
        return json.loads(out.stdout or "null")

    # --- id mapping (ADR-0008)
    def resource_id(self, node: str, name: str) -> str:
        return f"{self.publisher}--{flat_node(node)}--{name}"

    def registry_name(self, node: str, name: str) -> str:
        return "private-" + self.resource_id(node, name)

    def full_name(self, node: str, name: str) -> str:
        return f"projects/{self.project}/locations/{self.location}/skills/{self.registry_name(node, name)}"

    def to_logical(self, s: dict):
        """registry search/list result -> (logical urn, node, name) or None if not ours."""
        rid = (s.get("skillId") or "").rsplit(":", 1)[-1]
        prefix = f"private-{self.publisher}--"
        if not rid.startswith(prefix):
            return None
        flat, _, name = rid[len(prefix):].partition("--")
        node = self._node_by_flat.get(flat)
        if node is None:                                    # fallback: exact node from the description tag
            m = re.match(r"\[([^\]]+)\]", s.get("description", ""))
            node = m.group(1).replace("/", ".") if m and m.group(1) != self.publisher else "_root"
        return urn(self.cfg, node, name), node, name

    def _cards(self, results):
        cards = []
        for s in results or []:
            lg = self.to_logical(s)
            if lg:
                cards.append({"urn": lg[0], "node": lg[1], "name": lg[2],
                              "description": s.get("description", ""), "registry": s.get("skillId")})
        return cards

    # --- reads
    def search_scope(self, nodes):
        """All our skills whose node is in `nodes` (one prefix call per distinct top-level segment)."""
        wanted = set(nodes)
        tops = {flat_node(n).split("-")[0] for n in nodes}
        hits = []
        for top in tops:
            q = f"skillId:private-{self.publisher}--{top}*"
            hits += self._cards(self._gcloud("skills", "search", f"--query={q}", "--search-type=keyword"))
        seen, out = set(), []
        for c in hits:
            if c["node"] in wanted and c["urn"] not in seen:
                seen.add(c["urn"]); out.append(c)
        return out

    def default_revision(self, logical_urn: str) -> str:
        """Resolve the server's default revision id for `logical_urn` without downloading it —
        used by `load`/`prewarm` to compute the E1.7 cache path before deciding whether a
        download is even needed (the cache is immutable, keyed by this revision)."""
        _, node, name = parse_urn(logical_urn)
        rname = self.registry_name(node, name)
        meta = self._gcloud("skills", "describe", rname)
        rev = (meta.get("defaultRevision") or "").rsplit("/", 1)[-1]
        if not rev:
            sys.exit(f"guidefold: {logical_urn} has no default revision")
        return rev

    def download(self, logical_urn: str, dest: Path, rev: str = None):
        import shutil, tempfile
        _, node, name = parse_urn(logical_urn)
        rname = self.registry_name(node, name)
        if rev is None:
            rev = self.default_revision(logical_urn)
        with tempfile.TemporaryDirectory() as td:
            self._gcloud("skills", "revisions", "download", rev, f"--skill={rname}",
                         f"--destination={td}", "--allow-overwrite", fmt="none")
            src = Path(td)
            if not (src / "SKILL.md").exists():                  # gcloud nests the payload under <revision-id>/
                nested = [d for d in src.iterdir() if (d / "SKILL.md").exists()]
                if len(nested) != 1:
                    sys.exit(f"guidefold: unexpected payload layout for {logical_urn}: {[x.name for x in src.iterdir()]}")
                src = nested[0]
            if dest.exists():
                shutil.rmtree(dest)
            shutil.copytree(src, dest)

    # --- writes (CI only)
    def publish(self, node: str, name: str, skill_dir: Path, display: str, desc: str, rev_id: str):
        import tempfile
        rid, rname = self.resource_id(node, name), self.registry_name(node, name)
        existing = self._gcloud("skills", "describe", rname, check=False)
        if existing is None:
            self._gcloud("skills", "create", rid, f"--display-name={display[:63]}", f"--description={desc[:2048]}",
                         "--type=simple", "--target-state=draft")
        elif existing.get("description") != desc[:2048] or existing.get("displayName") != display[:63]:
            self._gcloud("skills", "update", rname, f"--display-name={display[:63]}", f"--description={desc[:2048]}")
        with tempfile.TemporaryDirectory() as td:
            zpath = Path(td) / f"{rid}.zip"
            zip_skill_dir(skill_dir, zpath)
            self._gcloud("skills", "revisions", "create", rev_id, f"--skill={rname}", f"--payload={zpath}")
        self._gcloud("skills", "update", rname, f"--default-revision={self.full_name(node, name)}/revisions/{rev_id}")
        target = "deprecated" if desc.startswith("DEPRECATED") else "active"
        current = (existing or {}).get("targetState", "TARGET_STATE_DRAFT").lower()
        if current == "target_state_draft":
            self._gcloud("skills", "update", rname, "--target-state=active"); current = "target_state_active"
        if current != f"target_state_{target}":
            self._gcloud("skills", "update", rname, f"--target-state={target}")
        revs = self._gcloud("skills", "revisions", "list", f"--skill={rname}") or []
        others = [r for r in revs if not r["name"].endswith("/" + rev_id)]
        failed = [r for r in others if r.get("state") == "FAILED"]                 # rejected payloads: drop immediately
        old = sorted((r for r in others if r.get("state") != "FAILED"), key=lambda r: r.get("createTime", ""))
        for r in failed + old[: max(0, len(old) - (KEEP_REVISIONS - 1))]:
            self._gcloud("skills", "revisions", "delete", r["name"].rsplit("/", 1)[-1], f"--skill={rname}", "--quiet", fmt="none")
        return rname

class LocalRegistry:
    """Filesystem backend (registry.backend: local): the monorepo itself is the registry. Same
    storage/transport interface as Registry — no ranking (E0.2)."""
    def __init__(self, cfg, root: Path):
        self.cfg, self.root = cfg, root
        self._skills = [(d, node, fm) for d, node, fm in all_skills(root, cfg)]
        self._head_rev = _git_head_short(root)

    def _card(self, d, node, fm):
        return {"urn": urn(self.cfg, node, d.name), "node": node, "name": d.name,
                "description": fm.get("description", ""), "registry": "local:" + rel(self.root, d)}

    def search_scope(self, nodes):
        wanted = set(nodes)
        return [self._card(d, n, fm) for d, n, fm in self._skills if n in wanted]

    def default_revision(self, logical_urn: str) -> str:
        """`backend: local` has no per-skill revisioning — the monorepo's current commit stands
        in for it, so the E1.7 cache still gets a fresh, immutable dir per commit."""
        return self._head_rev

    def download(self, logical_urn: str, dest: Path, rev: str = None):
        import shutil
        _, node, name = parse_urn(logical_urn)
        for d, n, fm in self._skills:
            if n == node and d.name == name:
                if dest.exists():
                    shutil.rmtree(dest)
                shutil.copytree(d, dest)
                return
        sys.exit(f"guidefold: {logical_urn} not found in local tree")

    def publish(self, *a, **k):
        sys.exit("guidefold: publish is a no-op with registry.backend: local")

def registry_for(cfg, root: Path):
    backend = (cfg.get("registry") or {}).get("backend", "agent-registry")
    return LocalRegistry(cfg, root) if backend == "local" else Registry(cfg)

def _git_head_short(root: Path) -> str:
    out = subprocess.run(["git", "rev-parse", "--short=7", "HEAD"], capture_output=True, text=True, cwd=root)
    return out.stdout.strip() if out.returncode == 0 and out.stdout.strip() else "worktree"

def _commit_time(root: Path, sha: str) -> str:
    """ISO-8601 commit timestamp for `sha`, or None for the "worktree" (uncommitted) fallback.
    E1.4 reproducibility ("same git sha in -> byte-identical artifact out") needs manifest.json's
    build_time to be a function of the sha, not of wall-clock — a real commit has a stable time
    to anchor to; an uncommitted tree does not, so that one case falls back to wall-clock and
    accepts that manifest.json alone won't be byte-identical across two such builds."""
    if sha == "worktree":
        return None
    out = subprocess.run(["git", "show", "-s", "--format=%cI", sha], capture_output=True, text=True, cwd=root)
    t = out.stdout.strip()
    return t if out.returncode == 0 and t else None

# ------------------------------------------------------------------- cache (E1.7)
# Layout: <cache_root>/skills/<urn>/<rev>/ and <cache_root>/index/<sha>/ — both trees immutable
# (a given <urn>/<rev> or <sha> is never rewritten, only evicted). cache_root defaults to
# ~/.cache/guidefold, overridable with $GUIDEFOLD_CACHE. `index/<sha>/` is not populated by this
# PR (the in-memory Index isn't persisted yet — that's E1.4); the path helper and eviction logic
# exist now so that later PR only has to add a writer, not a layout.
DEFAULT_SKILLS_CACHE_CAP = 500   # immutable <urn>/<rev> dirs kept before LRU eviction
DEFAULT_INDEX_CACHE_CAP = 20     # immutable <sha> dirs kept before LRU eviction

def cache_root() -> Path:
    env = os.environ.get("GUIDEFOLD_CACHE")
    return Path(env).expanduser() if env else Path.home() / ".cache" / "guidefold"

def _encode_urn_segment(u: str) -> str:
    """Filesystem-safe, round-trippable encoding of a URN for use as a cache directory name.
    ':' separates URN fields but is illegal/awkward as a path segment on several filesystems
    (notably Windows/WSL-interop paths); '%' is reserved as our escape character. Escape '%'
    first so the round trip is unambiguous."""
    return u.replace("%", "%25").replace(":", "%3A")

def _decode_urn_segment(seg: str) -> str:
    return seg.replace("%3A", ":").replace("%25", "%")

def skill_cache_dir(logical_urn: str, rev: str) -> Path:
    return cache_root() / "skills" / _encode_urn_segment(logical_urn) / rev

def index_cache_dir(sha: str) -> Path:
    return cache_root() / "index" / sha

def _leaf_dirs(tree_root: Path, depth: int) -> list:
    """All directories exactly `depth` levels under tree_root — the immutable units we evict
    (depth=2 for skills/<urn>/<rev>, depth=1 for index/<sha>)."""
    if not tree_root.is_dir():
        return []
    level = [tree_root]
    for _ in range(depth):
        nxt = []
        for p in level:
            nxt.extend(d for d in p.iterdir() if d.is_dir())
        level = nxt
    return level

def evict_lru(tree_root: Path, depth: int, cap: int):
    """Both cache trees are immutable: entries are never invalidated, only evicted, oldest
    directory-mtime first once the count exceeds `cap`. Callers touch (os.utime) a dir on every
    cache hit so mtime tracks last-use, not just creation time — true LRU, not LRU-by-birth."""
    dirs = _leaf_dirs(tree_root, depth)
    if len(dirs) <= cap:
        return
    import shutil
    dirs.sort(key=lambda d: d.stat().st_mtime)
    for d in dirs[: len(dirs) - cap]:
        shutil.rmtree(d, ignore_errors=True)

def _cache_cap(cfg: dict, key: str, default: int) -> int:
    return int(((cfg.get("cache") or {}).get(key, default)))

# ---------------------------------------------------------------- frontmatter
FM = re.compile(r"^---\n(.*?)\n---", re.S)

def frontmatter(skill_md: Path) -> dict:
    try:
        import yaml
    except ImportError:
        sys.exit("guidefold: PyYAML missing — pip install pyyaml")
    # UTF-8 explicitly, never the platform default: a `LANG=C` runner would otherwise fail
    # to read any card with a non-ASCII description at all (UnicodeDecodeError: ascii).
    m = FM.match(skill_md.read_text(encoding="utf-8"))
    return yaml.safe_load(m.group(1)) if m else {}

def ranking_body(skill_md: Path) -> str:
    """Return retriever text while excluding structured source provenance.

    ``source_proof`` is checked after candidate selection. Indexing its schema, claims or source
    paths would make provenance a hidden ranking feature and let an otherwise identical card move
    merely because an owner added evidence. Other frontmatter remains indexed for compatibility.
    """
    raw = skill_md.read_text(encoding="utf-8", errors="ignore")
    match = FM.match(raw)
    if not match:
        return raw
    kept = []
    skipping = False
    for line in match.group(1).splitlines(keepends=True):
        if not skipping and re.match(r"^source_proof\s*:", line):
            skipping = True
            continue
        if skipping and re.match(r"^[^\s#][^:]*:", line):
            skipping = False
        if not skipping:
            kept.append(line)
    return raw[:match.start(1)] + "".join(kept) + raw[match.end(1):]

def md_list(md: dict, key: str) -> list:
    """metadata.<key> is a comma-separated string (Agent Registry rejects non-scalar metadata, ADR-0010);
    YAML lists are still parsed so validate can report them. Splits on commas AND whitespace, which
    is correct for URN/path lists (requires/refines/replaces/references) — those items never
    contain internal spaces — but wrong for anything whose items are multi-word phrases; use
    `md_phrases` for those instead."""
    v = (md or {}).get(key)
    if v is None or v == "":
        return []
    if isinstance(v, list):
        return [str(x).strip() for x in v if str(x).strip()]
    return [x.strip() for x in re.split(r"[,\s]+", str(v)) if x.strip()]

def md_phrases(md: dict, key: str) -> list:
    """metadata.<key> is a comma-separated string of PHRASES, each of which may itself contain
    spaces (`triggers`, `negative_triggers`: "planned auth change, policy edit" is two phrases,
    not five words). Splits on commas only — never on whitespace — so a two-word negative_trigger
    stays a two-word phrase instead of being shredded into single-word bans (the P1 bug found in
    PR #7 review: "auth" alone was hard-dropping the on-call runbook from every auth-related
    query). Each phrase's own words are tokenized later, at the point of use, by `tokenize()`."""
    v = (md or {}).get(key)
    if v is None or v == "":
        return []
    if isinstance(v, list):
        return [str(x).strip() for x in v if str(x).strip()]
    return [x.strip() for x in str(v).split(",") if x.strip()]

KIND_VALUES = ("governance", "engineering", "knowledge", "ways-of-working", "temporal")
LAYER_VALUES = ("org", "platform", "team")

def node_depth(node: str) -> int:
    """_root -> 0; each dot in the node path adds one level (collapsed to org/platform/team for MVP)."""
    return 0 if node == "_root" else node.count(".") + 1

def check_urn_refs(md: dict, key: str, urns: dict, rd, errors: list):
    """Every URN in metadata.<key> must exist in the tree — shared by requires/refines/replaces."""
    for r in md_list(md, key):
        if r not in urns:
            errors.append(f"{rd}: {key} unknown skill {r}")

def check_cycles(graph: dict, label: str, errors: list):
    """DFS cycle detector shared by the requires graph and the refines graph."""
    state = {}
    def visit(n, stack):
        state[n] = 1
        for m in graph.get(n, []):
            if state.get(m) == 1:
                errors.append(f"{label} cycle: " + " -> ".join(stack + [m]))
            elif state.get(m) is None:
                visit(m, stack + [m])
        state[n] = 2
    for u in graph:
        if state.get(u) is None:
            visit(u, [u])

def all_skills(root: Path, cfg: dict, include_generated: bool = False, on_error=None):
    """Walk every authored SKILL.md under `root`, yielding (skill_dir, node, frontmatter).

    `on_error` is opt-in tolerance for callers that must survive a corpus containing a broken
    card instead of dying on the first one — `guidefold report` (P12/U7), whose whole job is to
    *report* "invalid card" as a finding, needs the other 500 skills to still be compared. When
    it is None the behaviour is byte-for-byte the historical one: a YAML error propagates and a
    non-mapping frontmatter/metadata raises at the caller's own `.get()`, exactly as before.
    When it is given, `on_error(skill_md_path, exception)` is called and that skill is skipped."""
    for md in sorted(root.rglob(".agents/skills/*/SKILL.md")):
        if ".guidefold" in md.parts:
            continue
        if on_error is None:
            fm = frontmatter(md)
        else:
            try:
                fm = frontmatter(md)
            except Exception as exc:                       # noqa: BLE001 — reported, not swallowed
                on_error(md, exc)
                continue
            if not isinstance(fm, dict):
                on_error(md, ValueError("frontmatter is not a YAML mapping"))
                continue
            if fm.get("metadata") is not None and not isinstance(fm.get("metadata"), dict):
                on_error(md, ValueError("metadata is not a YAML mapping"))
                continue
        meta = fm.get("metadata") or {}
        if str(meta.get("generated", "")).lower() == "true":   # e.g. hierarchy-index written by `guidefold index`
            if not include_generated:
                continue
            yield md.parent, meta.get("scope", "_index"), fm
            continue
        d = md.parent
        yield d, node_for(cfg, rel(root, d)), fm

# ------------------------------------------------------------------ tokenizer
# One shared tokenizer for Index build and Router query time (ROUTER-SPEC "Determinism by
# construction"), byte-identical to tools/bakeoff/tokenizer.py: NFKD-normalize then strip
# every combining mark the decomposition produced (folds accented Latin letters onto their
# base letter, e.g. "cafe" from "cafe" + combining acute, instead of an NFC-only pass that
# would leave the accented code point in place for an ASCII-only filter to drop wholesale --
# that dropped-not-folded bug shredded every accented word to its consonant skeleton, e.g.
# "RESUME" -> ['r', 'sum'] instead of ['resume']; see PR "fix: shared tokenizer accent
# folding, Zipf direction, and document normalisation"), then ASCII-only lowercase (never
# str.lower(), whose Unicode case table can shift across Python versions), split on
# [a-z0-9]+. If you change this, tools/bakeoff/tokenizer.py must change identically in the
# same commit, or word ids silently drift between CI and the hook.
_ASCII_UPPER_TO_LOWER = str.maketrans(
    "ABCDEFGHIJKLMNOPQRSTUVWXYZ", "abcdefghijklmnopqrstuvwxyz")
_TOKEN_RE = re.compile(r"[a-z0-9]+")

def _ascii_lower(s: str) -> str:
    return s.translate(_ASCII_UPPER_TO_LOWER)

def _fold_accents(text: str) -> str:
    decomposed = unicodedata.normalize("NFKD", text)
    return "".join(ch for ch in decomposed if not unicodedata.combining(ch))

def tokenize(text: str) -> list:
    return _TOKEN_RE.findall(_ascii_lower(_fold_accents(text or "")))

# -------------------------------------------------------------------- Index
class Index:
    """The in-memory routing artifact (ROUTER-SPEC "Class split"). Built by scanning the tree
    via `all_skills()` — for this PR there is no on-disk artifact (that's E1.4); Router depends
    only on the public attributes below, so swapping the build source later touches nothing
    outside this class.

    Holds: `cards` (urn -> card dict), `nodes` (from guidefold.yaml), `graph` (requires/refines/
    replaces/similar adjacency), field-weighted BM25 postings with integer-precomputed IDF and
    per-field length normalization, a static word/skill dense-vector table (empty until E1.4/E1.3
    ship one — `weights["w_dense"]` stays 0), and `weights` (never module constants, so a
    guidefold.yaml `router.weights` override works without touching this class).

    Determinism: math.log is used exactly once per term, here at build time, to compute IDF —
    then immediately rounded to a scaled integer (round(x * 2**20)). Everything Router does at
    query time (candidates/score/select) is pure integer arithmetic.
    """

    K1 = 1.2
    B = 0.75
    IDF_SCALE = 1 << 20
    RRF_SCALE = 1 << 20
    RRF_K = 60
    PPR_ALPHA_NUM, PPR_ALPHA_DEN = 15, 100   # alpha = 0.15 (ROUTER-SPEC)
    PPR_ITERS = 20
    FIELDS = ("name", "description", "digest", "triggers", "body")
    # Fixed record order inside graph.bin (R4, lazy-graph): every per-card adjacency record packs
    # these 4 lists in exactly this order, so writer and reader agree without needing a name tag
    # per list. Matches the literal tuple `_reverse_ppr` used before this constant existed.
    GRAPH_EDGE_TYPES = ("requires", "refines", "replaces", "similar")

    DEFAULT_WEIGHTS = {
        "field.name": 6, "field.description": 4, "field.digest": 3,
        "field.triggers": 5, "field.body": 2,
        # RRF (k=60) over IDF_SCALE=2**20 has a deliberately *flat* dynamic range — by design
        # (Reciprocal Rank Fusion trades magnitude for rank-robustness): over a candidate pool the
        # size this router actually sees (dozens, not thousands), a single-rank step is only
        # ~230-280 units (SCALE/((k+r)(k+r+1)), largest between rank1 and rank2), and rank1-vs-
        # rank8 over an 8-candidate pool spans only ~1770 units. w_scope/w_ppr are calibrated so
        # that even their *maximum* possible contribution (hops=0 for scope; a hit that receives
        # essentially all reverse-PPR mass) stays under one rank step — otherwise the "feature"
        # becomes a de facto sort key again (the P0 bug, just moved downstream; PR #7 review
        # measured the previous 600/2000 values at ~2.4 and ~8 rank-steps respectively, both far
        # too large). Values are chosen on this margin, not tuned against tests/golden/*.yaml —
        # tools/eval/run_golden.py is the tuning signal; see docs/reports/golden/ for before/after.
        "w_scope": 200, "w_ppr": 250, "w_dense": 0,   # w_dense = 0 until the E1.3 bake-off (ADR-0020)
        "edge.requires": 100, "edge.refines": 60, "edge.replaces": 40, "edge.similar": 30,
        "abstain_threshold": 1200,
        # ppr_mode selects which prerequisite-propagation implementation `score()` calls:
        # "pagerank" (_reverse_ppr) or "closure" (default, _decayed_closure, ADR-0020's rejected-
        # alternative note -- a decayed two-hop `requires` walk, no power iteration, no out-degree
        # normalisation). E1 config-selection (docs/reports/tuning/E1-config-selection.md) measured
        # both against the golden set on a held-out split: byte-identical on every metric, on both
        # the tune half and the holdout half independently. Given that equivalence, "closure" ships
        # as the default -- it is exactly hand-verifiable (see test_decayed_closure_matches_the_
        # documented_per_hop_fraction) where pagerank's fixed-point iteration is not. This was
        # measured on a shallow, sparse requires-graph (out-degree ~0.6, see ADR-0020); revisit if
        # a monorepo's graph grows deep/dense enough that out-degree normalisation could matter.
        "ppr_mode": "closure",
        "closure_decay_num": 1, "closure_decay_den": 2,   # _decayed_closure: mass *= 1/2 per hop
        # abstain_mode selects the confidence signal `select()` gates on: "magnitude" (default,
        # scored[0]["score"] < abstain_threshold) or "margin" (rank1-rank2 score gap <
        # abstain_margin_threshold). RRF gives any rank-1 hit a near-constant high score, so
        # magnitude cannot discriminate no_applicable cases from real ones (see
        # docs/reports/golden/README.md); margin was measured as the obvious alternative signal
        # in docs/reports/tuning/E1-config-selection.md -- see that report for the verdict.
        "abstain_mode": "magnitude",
        "abstain_margin_threshold": 1200,
        # compose_mode gates the composer stage `select()` runs after abstention and before
        # emission (ADR-0022 §4 / ADR-0024 §4, DENSE-PROGRAM.md v2.4 family C): "off" (default)
        # is the unmodified legacy closure-fill select() every existing test/golden fixture
        # depends on; "on" runs the deterministic integer composer (_select_composed) instead,
        # which only ever *diverges* from "off" on queries its own score-plateau detector (below)
        # flags as needing more than one skill -- every other query is byte-identical to "off"
        # because the composer falls back to the same closure fill (_select_closure) it shares
        # with "off". compose_tau_pct: a candidate within this many percent of the top score
        # counts toward the plateau (score-distribution bundle signal -- no `requires` edges
        # needed, since neither test corpus has any, DENSE-PROGRAM.md v2.4 §4). compose_coverage:
        # when true, fill greedily by query-term coverage gain over the plateau pool; when false,
        # fill in plain score order (still capped to the plateau/top-15 pool) -- the (tau,
        # coverage) grid the dev arms C-det-1..4 sweep.
        "compose_mode": "off",
        "compose_tau_pct": 20,
        "compose_coverage": True,
    }

    def __init__(self, cards, nodes, weights):
        self.cards = cards            # urn -> card dict
        self.nodes = nodes            # node -> {owner, paths, ...} from guidefold.yaml
        self.weights = weights
        self.graph = {"requires": {}, "refines": {}, "replaces": {}, "similar": {}}
        self.postings = {f: {} for f in self.FIELDS}   # field -> term -> {urn: tf}
        self.idf = {}                                  # term -> scaled int
        self.field_len = {f: {} for f in self.FIELDS}  # field -> {urn: token count}
        self.field_norm = {f: {} for f in self.FIELDS}  # field -> {urn: scaled int normalization factor}
        self.word_vectors = {}        # word -> tuple[int,...]   (tier-1 static table; empty this PR)
        self.skill_vectors = {}       # urn -> tuple[int,...]
        self.skill_normsq = {}        # urn -> int (|d|^2, integer — never store/compare |d|)

    @classmethod
    def build(cls, root: Path, cfg: dict, word_vectors: dict = None, on_error=None):
        cards = {}
        for d, node, fm in all_skills(root, cfg, on_error=on_error):
            name = d.name
            u = urn(cfg, node, name)
            md = fm.get("metadata") or {}
            body = ranking_body(d / "SKILL.md")
            cards[u] = {
                "urn": u, "node": node, "name": name,
                "description": str(fm.get("description", "")),
                "digest": md.get("digest") or str(fm.get("description", ""))[:200],
                "triggers": md_phrases(md, "triggers"),
                "negative_triggers": md_phrases(md, "negative_triggers"),
                "requires": md_list(md, "requires"),
                "refines": md_list(md, "refines"),
                "status": md.get("status", "active"),
                "replaced_by": md.get("replaced_by"),
                "kind": md.get("kind"),
                "layer": md.get("layer"),
                "owner": md.get("owner"),
                "_body": body,
            }
            # `source_proof` lives at the frontmatter root rather than under
            # `metadata`: registry metadata is intentionally scalar, while a
            # proof is a bounded structured record.  Keep it out of every
            # ranking field and carry it into the immutable service snapshot
            # as `proof`; the Go delivery gate is the only reader.
            if "source_proof" in fm:
                cards[u]["proof"] = fm["source_proof"]
        return cls.from_cards(cards, cfg["nodes"], weights=(cfg.get("router") or {}).get("weights"),
                               word_vectors=word_vectors)

    @classmethod
    def from_cards(cls, cards: dict, nodes: dict, weights: dict = None, word_vectors: dict = None):
        """Build an Index directly from pre-built card dicts, bypassing the tree scan — used by
        unit tests to construct small, hand-controlled fixtures (policy filter, BM25, RRF, PPR,
        dense, closure, abstention, ordering) without a filesystem tree. Each card must carry at
        least the keys `Index.build` produces (urn/node/name/description/digest/triggers/
        negative_triggers/requires/refines/status/replaced_by/_body); an optional `proof`
        record is carried through unchanged and is never a ranking signal."""
        w = {**cls.DEFAULT_WEIGHTS, **(weights or {})}
        idx = cls(dict(cards), dict(nodes), w)
        idx._build_graph()
        idx._build_bm25()
        idx._build_dense(word_vectors or {})
        return idx

    def _build_graph(self):
        urns = set(self.cards)
        for u, c in self.cards.items():
            self.graph["requires"][u] = [r for r in c["requires"] if r in urns]
            self.graph["refines"][u] = [r for r in c.get("refines", []) if r in urns]
            self.graph["similar"].setdefault(u, [])
            if c["status"] == "deprecated" and c.get("replaced_by") in urns:
                self.graph["replaces"].setdefault(c["replaced_by"], []).append(u)
        for u in urns:
            self.graph["requires"].setdefault(u, [])
            self.graph["refines"].setdefault(u, [])
            self.graph["replaces"].setdefault(u, [])

    def card_header_items(self):
        """(urn, node, status, has_negative_triggers_bool) for every card, sorted-URN order.
        Router.policy_filter iterates this uniformly whether `self.cards` is a freshly-built
        in-memory plain dict (Index.build/from_cards -- one dict-key lookup per field, the same
        cost policy_filter always paid) or a loaded artifact's _LazyCards (a header-table lookup,
        zero JSON parsing, R4). Kept on Index rather than duplicated in Router so both card
        representations are satisfied by one call site."""
        header_items = getattr(self.cards, "header_items", None)
        if header_items is not None:
            yield from header_items()
            return
        for u in sorted(self.cards.keys()):
            c = self.cards[u]
            yield u, c["node"], c.get("status", "active"), bool(c.get("negative_triggers"))

    def _field_text(self, card, field):
        if field == "name":
            return card["name"].replace("-", " ")
        if field == "description":
            return card["description"]
        if field == "digest":
            return card["digest"]
        if field == "triggers":
            return " ".join(card["triggers"])
        if field == "body":
            return card["_body"]
        return ""

    def _build_bm25(self):
        import math
        postings = {f: {} for f in self.FIELDS}
        field_len = {f: {} for f in self.FIELDS}
        doc_freq = {}
        for u, c in self.cards.items():
            doc_terms = set()
            for f in self.FIELDS:
                toks = tokenize(self._field_text(c, f))
                field_len[f][u] = len(toks)
                tf = {}
                for t in toks:
                    tf[t] = tf.get(t, 0) + 1
                    doc_terms.add(t)
                for t, n in tf.items():
                    postings[f].setdefault(t, {})[u] = n
            for t in doc_terms:
                doc_freq[t] = doc_freq.get(t, 0) + 1
        n_docs = max(1, len(self.cards))
        idf = {}
        for t, df in doc_freq.items():
            x = math.log(1.0 + (n_docs - df + 0.5) / (df + 0.5))   # the one math.log call — build time only
            idf[t] = round(x * self.IDF_SCALE)
        field_norm = {f: {} for f in self.FIELDS}
        for f in self.FIELDS:
            lens = [n for n in field_len[f].values() if n > 0]
            avg = (sum(lens) / len(lens)) if lens else 1.0
            for u in self.cards:
                ln = field_len[f].get(u, 0)
                ratio = (ln / avg) if avg > 0 else 0.0
                norm = (1 - self.B) + self.B * ratio
                field_norm[f][u] = max(1, round(norm * self.IDF_SCALE))
        self.postings, self.idf, self.field_len, self.field_norm = postings, idf, field_len, field_norm

    def _build_dense(self, word_vectors: dict):
        self.word_vectors = dict(word_vectors)
        self.skill_vectors, self.skill_normsq = {}, {}
        if not self.word_vectors:
            return
        dims = len(next(iter(self.word_vectors.values())))
        for u, c in self.cards.items():
            text = " ".join([c["name"].replace("-", " "), c["description"], c["digest"],
                              " ".join(c["triggers"]), c["_body"]])
            vec = [0] * dims
            for t in tokenize(text):
                wv = self.word_vectors.get(t)
                if wv:
                    for i in range(dims):
                        vec[i] += wv[i]
            self.skill_vectors[u] = tuple(vec)
            self.skill_normsq[u] = sum(x * x for x in vec)

# ------------------------------------------------------------- Index artifact (E1.4)
# On-disk form of an Index, keyed by git sha, written once by `guidefold index` and read many
# times by `guidefold hook` (E1.5). ROUTER-SPEC "Determinism by construction" + the BRIEF's
# measured probe (JSON-eager postings: 193ms at 2k skills against a 300ms budget; binary lazy
# postings: 0.3ms) drive two hard rules for every file here:
#   1. little-endian is declared explicitly everywhere multi-byte integers are packed (`struct`,
#      never `array.fromfile`/raw `array.array('I', ...)`, both of which are native-order).
#   2. postings.bin (and vectors.i8/words.bin) are read lazily through an mmap: only the byte
#      range a query's own terms/urns resolve to is ever paged in. words.idx is small enough
#      (one row per distinct *word*, capped by the distilled table, not by corpus size) to load
#      eagerly in full. terms.bin/postings.idx are NOT small at real-corpus vocabulary sizes
#      (89,630 distinct terms at 6,006 real skills) — R4's cards/graph fix left them the dominant
#      remaining load-time cost (~250ms of ~271ms), so they get the same lazy mmap+binary-search
#      treatment postings.bin already had, rather than a whole-file parse into a Python dict; see
#      their entries below and `_LazyTerms`/`_LazyPostingsIndex`/`_LazyFieldPostings`.
#
# Files (all under <cache_root>/index/<sha>/, see index_cache_dir):
#   manifest.json   git_sha, build_time, weights, counts, quant_scale, teacher (null this PR),
#                   and a sha256 checksum of every other file below (index --check's contract).
#   cards.jsonl     one compact JSON object per doc, one line per doc, in sorted-URN doc-id order
#                   (that order IS the doc-id map: line N is doc N in postings.bin/vectors.i8).
#                   No `_body`/`requires`/`refines` — Router never reads those at query time
#                   (BM25 is already baked into postings.bin; the graph is graph.bin). Never
#                   parsed in full: cards.idx gives byte offsets into it, one line materialised at
#                   a time, only for the handful of urns Router ever needs a whole card for (R4).
#   cards.idx       byte offset+length into cards.jsonl, one per doc: `u32 n_docs` then
#                   n_docs*(u32 offset, u32 length), doc-id order. Small (8 bytes/doc) — eager.
#   cards.hdr       (urn, node, status, has_negative_triggers) for every doc, doc-id order:
#                   `u32 n_docs` then n_docs*(varint urn_len, urn utf-8, varint node_len, node
#                   utf-8, 1 flags byte [bit0=deprecated, bit1=has negative_triggers]). Answers
#                   every question Router's policy_filter asks about EVERY card without ever
#                   opening cards.jsonl (R4). Tens of bytes/doc — eager.
#   graph.bin       requires/refines/replaces/similar adjacency (Index.graph), one record per
#                   doc-id: GRAPH_EDGE_TYPES (fixed order) as `varint(count) +
#                   count*varint(target doc-id)`. Read lazily through graph.idx — closure and
#                   PPR propagation touch only the docs they actually expand, never the whole
#                   graph (R4; superseded a `graph.json` sibling that cost 407KB at the
#                   ADR-0021 2000-skill scale against a budget with ~6% headroom to spare).
#   graph.idx       the offset+length table for graph.bin, same shape as cards.idx. Eager.
#   nodes.json      guidefold.yaml's `nodes` map, verbatim — `cwd -> node` at hook time resolves
#                   from THIS, never the working-tree guidefold.yaml (ROUTER-SPEC).
#   terms.bin       global per-term IDF (Index.idf), sorted by term, binary-searched on the mmap
#                   (R4 cont'd/"R5" — see the caveat this superseded, below): `u32 n_terms`, then
#                   (n_terms+1) fixed-width directory records `<II` (string_offset, idf) — record
#                   i's term occupies string_blob[dir[i].offset : dir[i+1].offset), so the last,
#                   idf-less record is a length sentinel, not a real term — followed by the
#                   string blob (sorted term bytes, back to back, no separators). No Python dict
#                   is ever built from this file; `_LazyTerms.lookup(term)` binary-searches the
#                   directory directly against the mmap, string-comparing only the O(log V)
#                   candidate terms the search actually visits, and returns (term_id, idf) — the
#                   term_id (that term's rank in this same sorted order) is what postings.idx
#                   below is keyed by, so one string search resolves both idf and postings offset.
#   norms.bin       per-(field, doc) BM25 length-normalisation (Index.field_norm): FIELDS blocks
#                   of n_docs little-endian uint32s each, doc order = cards.jsonl order. Eager —
#                   scales with doc count (tens of KB even at 6 006 skills), not vocabulary; see
#                   the R4/R5 caveat below for why that distinction is what matters here.
#   postings.bin    delta-varint doc-id postings, one contiguous block per (field, term):
#                   [varint(doc_id delta), varint(tf)]* — mmap'd, sliced lazily per query term.
#   postings.idx    the (field, term_id) -> (offset, length) lookup for postings.bin, binary-
#                   searched on the mmap exactly like terms.bin (R5): `u32 n_entries`, then
#                   (n_entries+1) fixed-width records `<II` (combined_key, offset), sorted
#                   ascending by `combined_key = field_index * n_terms + term_id`. Since every
#                   term_id is < n_terms, that key is strictly monotonic across field boundaries
#                   too (field 1's smallest key already exceeds field 0's largest), so ALL fields
#                   share one flat sorted array and one binary search — no per-field dict, no
#                   term bytes stored here at all (a term string is only ever compared once, in
#                   terms.bin). The final record is a length sentinel (offset = len(postings.bin),
#                   an unmatchable key) so a hit's length is next_record.offset - hit.offset with
#                   no special-casing the last real entry.
#   vectors.i8      tier-1 dense skill vectors (Index.skill_vectors): n_docs rows of `dims` int8
#                   bytes, doc order = cards.jsonl order. Empty iff dims == 0.
#   words.bin       tier-1 dense word table (Index.word_vectors): one row of `dims` int8 bytes
#                   per distinct word, row order = sorted(word). Empty iff dims == 0 — no
#                   distilled table ships with E1.4 (w_dense stays 0; see ADR-0020). The format
#                   and its lazy-load path are exercised by a synthetic hand-built table in
#                   tests/test_index_artifact.py, never by invented vectors.
#   words.idx       the vocabulary list backing words.bin's row order: one word per line, UTF-8.
#                   words.bin/vectors.i8 need this the same way postings.bin needs postings.idx —
#                   a string->row lookup is unavoidably eager (same as any embedding table).
#
# postings.idx/words.idx/terms.bin are additions beyond the file list sketched in ROUTER-SPEC's
# aspirational design: that list didn't say where per-term IDF or per-field length norms would
# live on disk, and "postings.bin ... with a separate offset+length table" only named the BM25
# side of it. These three files are the minimal, symmetric answer for the dense side and for
# IDF/norms; nothing here changes Router's read contract (idx.idf / idx.field_norm / idx.postings
# / idx.word_vectors / idx.skill_vectors / idx.skill_normsq are still exactly the attributes
# Router reads — only their storage moved from "always in memory" to "lazily faulted in").

def _varint_encode(n: int) -> bytes:
    """Unsigned LEB128. Doc-id deltas and term frequencies are never negative, so no zig-zag/
    sign handling is needed anywhere in this artifact."""
    out = bytearray()
    while True:
        b = n & 0x7F
        n >>= 7
        if n:
            out.append(b | 0x80)
        else:
            out.append(b)
            return bytes(out)

def _varint_decode(buf, pos: int):
    """One varint starting at buf[pos] (buf: bytes/bytearray/memoryview/an mmap slice, all of
    which support integer indexing). Returns (value, next_pos)."""
    result = 0
    shift = 0
    while True:
        b = buf[pos]
        pos += 1
        result |= (b & 0x7F) << shift
        if not (b & 0x80):
            return result, pos
        shift += 7

def _dense_dims(idx: Index) -> int:
    return len(next(iter(idx.word_vectors.values()))) if idx.word_vectors else 0

def _open_mmap(path: Path):
    """(file_obj, mmap_obj) for `path`, or (None, None) for a zero-byte file — mmap.mmap refuses
    to map an empty file, and vectors.i8/words.bin are legitimately empty whenever dims == 0
    (no distilled table shipped). Callers MUST keep both return values alive for the life of any
    memoryview/slice taken from the mmap (stash them as instance attributes) — letting the file
    object get garbage-collected closes the fd out from under the mmap (`OSError: [Errno 9] Bad
    file descriptor`)."""
    if path.stat().st_size == 0:
        return None, None
    fh = path.open("rb")
    mm = mmap.mmap(fh.fileno(), 0, access=mmap.ACCESS_READ)
    return fh, mm

def _find_terms_directory(mm, base: int, n_terms: int, term_bytes: bytes):
    """Binary search terms.bin's directory for `term_bytes` (already UTF-8 encoded). Directory
    layout at `mm[base:]`: (n_terms + 1) fixed-width `<II` records (string_offset, idf); record
    i's term spans string_blob[dir[i].offset : dir[i+1].offset), where the string blob starts
    right after the directory, at `base + (n_terms + 1) * 8` — so record n_terms (idf-less) is a
    pure length sentinel, never a real term, which is why the search space below is
    `[0, n_terms - 1]`. Returns (term_id, idf) or None. term_id is that term's rank in this same
    sorted order — the shared key `postings.idx` is keyed by (R4 cont'd/"R5"), so a caller that
    already has a term_id never needs to repeat this string search."""
    if n_terms == 0:
        return None
    blob_base = base + (n_terms + 1) * 8
    lo, hi = 0, n_terms - 1
    while lo <= hi:
        mid = (lo + hi) // 2
        off, idf = struct.unpack_from("<II", mm, base + mid * 8)
        (next_off,) = struct.unpack_from("<I", mm, base + (mid + 1) * 8)
        cand = bytes(mm[blob_base + off:blob_base + next_off])
        if cand == term_bytes:
            return mid, idf
        if cand < term_bytes:
            lo = mid + 1
        else:
            hi = mid - 1
    return None

class _LazyTerms:
    """dict-like idx.idf, backed by terms.bin (mmap'd): a sorted directory of (string_offset,
    idf) records plus a concatenated string blob (see `_find_terms_directory`), binary-searched
    per lookup rather than parsed into a Python dict up front (R4 cont'd/"R5" — terms.bin was
    ~86ms of load_index_artifact's ~271ms at 6,006 real skills / 89,630 distinct terms; a query
    touches ~10-20 terms, so O(log V) per term beats O(V) once regardless of the query).

    `lookup(term)` is the shared primitive — it returns (term_id, idf) so `_LazyFieldPostings`
    can resolve a term's postings.idx row (keyed by the SAME sorted-term order) without a second
    string search. `.get(term, default)` (idx.idf's public dict-like contract, what Router's
    `_bm25_scores` calls) is just `lookup(term)[1]` when found. `__eq__` against a plain dict
    exists only so the round-trip test (`loaded.idf == mem_idx.idf`) can assert equivalence
    without this class ever materialising a dict itself on the hook's query path."""
    __slots__ = ("_mm", "_base", "_n_terms")

    def __init__(self, mm, base: int, n_terms: int):
        self._mm = mm
        self._base = base
        self._n_terms = n_terms

    def lookup(self, term: str):
        if self._mm is None or self._n_terms == 0:
            return None
        return _find_terms_directory(self._mm, self._base, self._n_terms, term.encode("utf-8"))

    def get(self, term, default=None):
        found = self.lookup(term)
        return found[1] if found is not None else default

    def __len__(self):
        return self._n_terms

    def __eq__(self, other):
        try:
            other_items = dict(other)
        except (TypeError, ValueError):
            return NotImplemented
        if len(other_items) != self._n_terms:
            return False
        for term, val in other_items.items():
            found = self.lookup(term)
            if found is None or found[1] != val:
                return False
        return True

    def __ne__(self, other):
        result = self.__eq__(other)
        return NotImplemented if result is NotImplemented else not result

class _LazyPostingsIndex:
    """The (field_index, term_id) -> (offset, length) lookup for postings.bin, backed by
    postings.idx (mmap'd): entries sorted by one combined key `field_index * n_terms + term_id`
    (R4 cont'd/"R5"). Every term_id is < n_terms, so that key is strictly monotonic across field
    boundaries too — field f+1's smallest key already exceeds field f's largest — meaning one
    flat sorted array and one binary search serve every field; no per-field dict, and no term
    bytes stored here at all (a term string is compared exactly once, in `_LazyTerms`). The final
    directory record is a length sentinel (an unmatchable key, offset = len(postings.bin)), so a
    hit's length is `next_record.offset - hit.offset` with no special-casing the last real entry."""
    __slots__ = ("_mm", "_base", "_n_entries", "_n_terms")

    def __init__(self, mm, base: int, n_entries: int, n_terms: int):
        self._mm = mm
        self._base = base
        self._n_entries = n_entries
        self._n_terms = n_terms

    def find(self, field_index: int, term_id: int):
        if self._mm is None or self._n_entries == 0:
            return None
        key = field_index * self._n_terms + term_id
        lo, hi = 0, self._n_entries - 1
        while lo <= hi:
            mid = (lo + hi) // 2
            k, off = struct.unpack_from("<II", self._mm, self._base + mid * 8)
            if k == key:
                (next_off,) = struct.unpack_from("<I", self._mm, self._base + (mid + 1) * 8 + 4)
                return off, next_off - off
            if k < key:
                lo = mid + 1
            else:
                hi = mid - 1
        return None

class _LazyFieldPostings:
    """dict-like idx.postings[field], backed by postings.bin (mmap'd) plus a shared `_LazyTerms`
    (term -> term_id, idf) and `_LazyPostingsIndex` ((field_index, term_id) -> (offset, length)) —
    neither ever parsed into a Python dict in full (R4 cont'd/"R5"). Router only ever calls
    `.get(term)` — never iterates — so that's the entire interface this needs to satisfy."""
    __slots__ = ("_mm", "_terms", "_pidx", "_field_index", "_doc_urns")

    def __init__(self, mm, terms: "_LazyTerms", pidx: "_LazyPostingsIndex", field_index: int, doc_urns: list):
        self._mm = mm
        self._terms = terms
        self._pidx = pidx
        self._field_index = field_index
        self._doc_urns = doc_urns

    def get(self, term, default=None):
        if self._mm is None:
            return default
        found = self._terms.lookup(term)
        if found is None:
            return default
        term_id, _idf = found
        entry = self._pidx.find(self._field_index, term_id)
        if entry is None:
            return default
        off, length = entry
        block = self._mm[off:off + length]
        out = {}
        pos, d = 0, 0
        while pos < length:
            delta, pos = _varint_decode(block, pos)
            tf, pos = _varint_decode(block, pos)
            d += delta
            out[self._doc_urns[d]] = tf
        return out

class _LazyVectors:
    """dict-like idx.word_vectors / idx.skill_vectors, backed by a mmap'd int8 matrix (words.bin
    or vectors.i8) plus an eagerly-loaded key->row-index table. Satisfies the exact interface
    Router's _dense_scores uses: `.get(key)`, truthiness/`len()`, and `.values()` (used only to
    peek at one vector's length to learn `dims` — implemented as a generator so that peek never
    materializes the rest of the table)."""
    __slots__ = ("_mm", "_row_by_key", "_dims")

    def __init__(self, mm, row_by_key: dict, dims: int):
        self._mm = mm
        self._row_by_key = row_by_key
        self._dims = dims

    def get(self, key, default=None):
        if self._mm is None:
            return default
        row = self._row_by_key.get(key)
        if row is None:
            return default
        off = row * self._dims
        return tuple(array.array('b', self._mm[off:off + self._dims]))

    def values(self):
        for k in self._row_by_key:
            yield self.get(k)

    def __len__(self):
        return len(self._row_by_key) if self._mm is not None else 0

class _LazyNormsq:
    """dict-like idx.skill_normsq: |d|^2 computed on demand from a _LazyVectors instance rather
    than persisted separately — cheap (one candidate pool's worth of dot products, never all
    n_docs), and it can never drift out of sync with the vector it was computed from."""
    __slots__ = ("_vectors",)

    def __init__(self, vectors: "_LazyVectors"):
        self._vectors = vectors

    def get(self, key, default=0):
        vec = self._vectors.get(key)
        return sum(x * x for x in vec) if vec is not None else default

class _LazyCards:
    """dict-like idx.cards, backed by cards.jsonl (mmap'd) + cards.idx (byte offset/length per
    doc) + cards.hdr (urn/node/status/has-negative-triggers, parsed eagerly in full -- it is tiny,
    tens of bytes per doc even at 6 000+ skills, nowhere near the cost of json.loads()-ing every
    line of cards.jsonl). Header data alone answers every question Router's policy_filter asks
    about EVERY card (status, node, "does it have any negative_triggers at all") without ever
    opening cards.jsonl; a full card body (name/description/digest/...) is only ever parsed on
    demand, for the handful of urns Router actually needs a whole card for (a chosen card's
    requires-closure, the <=4 finally-selected cards). This is R4's whole point: the old
    `load_index_artifact` json.loads()'d every one of n_docs lines up front; this parses zero
    lines unless something asks for one."""
    __slots__ = ("_mm", "_offsets", "_doc_urns", "_urn_to_doc", "_node", "_status", "_has_neg")

    def __init__(self, mm, offsets, doc_urns, node_by_doc, status_by_doc, has_neg_by_doc):
        self._mm = mm
        self._offsets = offsets                 # doc_id -> (offset, length) into cards.jsonl
        self._doc_urns = doc_urns               # doc_id -> urn, sorted-URN order
        self._urn_to_doc = {u: i for i, u in enumerate(doc_urns)}
        self._node = node_by_doc                # doc_id -> node string
        self._status = status_by_doc            # doc_id -> "active" | "deprecated"
        self._has_neg = has_neg_by_doc           # doc_id -> bool

    def __contains__(self, u):
        return u in self._urn_to_doc

    def __len__(self):
        return len(self._doc_urns)

    def __iter__(self):
        return iter(self._doc_urns)

    def keys(self):
        return self._urn_to_doc.keys()

    def header_items(self):
        """(urn, node, status, has_negative_triggers) for every doc, sorted-URN order, zero JSON
        parsing -- what Router.policy_filter iterates instead of `.items()` (R4)."""
        node, status, has_neg = self._node, self._status, self._has_neg
        for i, u in enumerate(self._doc_urns):
            yield u, node[i], status[i], has_neg[i]

    def _materialize(self, d):
        off, length = self._offsets[d]
        raw = bytes(self._mm[off:off + length]) if self._mm is not None else b"{}"
        row = json.loads(raw)
        card = {
            "urn": row["urn"], "node": row["node"], "name": row["name"],
            "description": row["description"], "digest": row.get("digest", ""),
            "triggers": row.get("triggers", []), "negative_triggers": row.get("negative_triggers", []),
            # requires/refines are NOT persisted here: graph.bin already carries this adjacency
            # and Router never reads card["requires"]/["refines"] at query time.
            "requires": [], "refines": [],
            "status": row.get("status", "active"), "replaced_by": row.get("replaced_by"),
            "kind": row.get("kind"), "layer": row.get("layer"), "owner": row.get("owner"),
            "_body": "",   # never read by Router; BM25 is already baked into postings.bin
        }
        if row.get("proof") is not None:
            card["proof"] = row["proof"]
        return card

    def get(self, u, default=None):
        d = self._urn_to_doc.get(u)
        return self._materialize(d) if d is not None else default

    def __getitem__(self, u):
        d = self._urn_to_doc.get(u)
        if d is None:
            raise KeyError(u)
        return self._materialize(d)

    def items(self):
        for i, u in enumerate(self._doc_urns):
            yield u, self._materialize(i)

    def values(self):
        for i in range(len(self._doc_urns)):
            yield self._materialize(i)

class _LazyGraphEdgeType:
    """dict-like view of one edge type's adjacency (e.g. idx.graph['requires']), backed by the
    mmap'd graph.bin record every edge type for a doc shares. .get(u, default) decodes only that
    one doc's record, walking past the OTHER edge types' varint-encoded lists (without ever
    decoding their targets) to reach the one requested -- so a query that only ever asks about
    `requires` (the default ppr_mode="closure" path) never pays any cost for refines/replaces/
    similar, and no doc but the one asked for is ever touched (R4)."""
    __slots__ = ("_mm", "_offsets", "_doc_urns", "_urn_to_doc", "_et_index", "_n_types")

    def __init__(self, mm, offsets, doc_urns, urn_to_doc, et_index, n_types):
        self._mm = mm
        self._offsets = offsets
        self._doc_urns = doc_urns
        self._urn_to_doc = urn_to_doc
        self._et_index = et_index
        self._n_types = n_types

    def get(self, u, default=None):
        if default is None:
            default = []
        d = self._urn_to_doc.get(u)
        if d is None or self._mm is None:
            return default
        off, length = self._offsets[d]
        data = self._mm[off:off + length]
        pos = 0
        for i in range(self._n_types):
            count, pos = _varint_decode(data, pos)
            if i == self._et_index:
                targets = []
                for _ in range(count):
                    tid, pos = _varint_decode(data, pos)
                    targets.append(self._doc_urns[tid])
                return targets
            for _ in range(count):
                _, pos = _varint_decode(data, pos)
        return default

class _LazyGraph:
    """dict-like idx.graph, backed by graph.bin/graph.idx. idx.graph[et] and idx.graph.get(et, {})
    both return a _LazyGraphEdgeType rather than materialising the whole edge-type mapping, so
    Router's closure/propagation (_requires_closure, _decayed_closure, _reverse_ppr) touch only
    the handful of docs they actually expand instead of paging in the whole graph on every hook
    invocation (R4). graph.bin is checksummed in manifest.json like any other artifact file, so
    `index --check` still catches tampering/staleness even though nothing on the hook path ever
    parses it in full."""
    __slots__ = ("_views",)

    def __init__(self, mm, offsets, doc_urns, urn_to_doc):
        n_types = len(Index.GRAPH_EDGE_TYPES)
        self._views = {
            et: _LazyGraphEdgeType(mm, offsets, doc_urns, urn_to_doc, i, n_types)
            for i, et in enumerate(Index.GRAPH_EDGE_TYPES)
        }

    def __getitem__(self, et):
        return self._views[et]

    def get(self, et, default=None):
        v = self._views.get(et)
        return v if v is not None else (default if default is not None else {})

    def keys(self):
        return self._views.keys()

def _serialize_artifact_files(idx: Index) -> dict:
    """Pure function: an already-built Index -> {filename: bytes} for every artifact file except
    manifest.json (which needs external git-sha/build-time context plus the checksums of exactly
    these bytes). Shared by write_index_artifact (writes to disk) and check_index_artifact
    (rebuilds in memory only, to diff against what's on disk without touching it)."""
    doc_urns = sorted(idx.cards.keys())
    doc_id = {u: i for i, u in enumerate(doc_urns)}
    n_docs = len(doc_urns)

    # cards.jsonl stays exactly as before (byte-for-byte) -- other tooling and `index --check`
    # still read it, and it's the thing cards.idx's offsets point into. What changes is that
    # `load_index_artifact` no longer parses it eagerly: cards.idx (below) gives O(1) byte-offset
    # access to one line, and cards.hdr gives Router the few fields it needs for literally every
    # card (node, status, "has any negative_triggers") without opening cards.jsonl at all (R4).
    cards_bytes_parts = []
    cards_idx = bytearray(struct.pack("<I", n_docs))   # count, then n_docs*(offset u32, length u32)
    cards_hdr = bytearray(struct.pack("<I", n_docs))   # count, then n_docs*(urn, node, flags)
    running_offset = 0
    for u in doc_urns:
        c = idx.cards[u]
        row = {
            "urn": u, "node": c["node"], "name": c["name"],
            "description": c["description"], "digest": c.get("digest", ""),
            "triggers": c.get("triggers", []), "negative_triggers": c.get("negative_triggers", []),
            "status": c.get("status", "active"), "replaced_by": c.get("replaced_by"),
            "kind": c.get("kind"), "layer": c.get("layer"), "owner": c.get("owner"),
        }
        if c.get("proof") is not None:
            row["proof"] = c["proof"]
        line = json.dumps(row, sort_keys=True, separators=(",", ":")).encode("utf-8") + b"\n"
        cards_idx += struct.pack("<II", running_offset, len(line))
        running_offset += len(line)
        cards_bytes_parts.append(line)

        node_b = c["node"].encode("utf-8")
        urn_b = u.encode("utf-8")
        flags = (1 if c.get("status", "active") == "deprecated" else 0) \
            | (2 if c.get("negative_triggers") else 0)
        cards_hdr += _varint_encode(len(urn_b)) + urn_b
        cards_hdr += _varint_encode(len(node_b)) + node_b
        cards_hdr += bytes([flags])
    cards_bytes = b"".join(cards_bytes_parts)

    # terms.bin (R4 cont'd/"R5"): sorted term directory + string blob, binary-searched on the
    # mmap by `_LazyTerms` rather than parsed whole into a dict at load time (see the file-table
    # comment above `_varint_encode` for the exact byte layout). `term_rank` assigns every term
    # its position in this same sorted order — its term_id — which postings.idx below reuses as
    # its own sort/search key, so a query's one string search resolves both idf and posting
    # offset without encoding or comparing the term a second time.
    sorted_terms = sorted(idx.idf.keys())
    n_terms = len(sorted_terms)
    term_rank = {t: i for i, t in enumerate(sorted_terms)}
    terms_dir = bytearray()
    terms_blob = bytearray()
    running = 0
    for t in sorted_terms:
        term_b = t.encode("utf-8")
        terms_dir += struct.pack("<II", running, idx.idf[t])
        terms_blob += term_b
        running += len(term_b)
    terms_dir += struct.pack("<II", running, 0)   # sentinel: string-blob length; idf field unused
    terms_bin = struct.pack("<I", n_terms) + bytes(terms_dir) + bytes(terms_blob)

    norms_bin = bytearray()
    for field in Index.FIELDS:
        fn = idx.field_norm.get(field, {})
        vals = [fn.get(u, 0) for u in doc_urns]
        norms_bin += struct.pack(f"<{n_docs}I", *vals)

    # postings.idx (R4 cont'd/"R5"): one flat array, sorted ascending by combined_key =
    # field_index * n_terms + term_id (see _LazyPostingsIndex for why one array safely serves
    # every field). `postings_entries` is already built in that exact order — fi is the outer
    # loop, sorted(idx.postings[field]) the inner one, and term_rank preserves string sort order
    # by construction — so no separate sort step is needed before writing the directory.
    postings_bin = bytearray()
    postings_entries = []   # (combined_key, offset), offset order == write order == sort order
    offset = 0
    for fi, field in enumerate(Index.FIELDS):
        for term in sorted(idx.postings[field].keys()):
            plist = sorted((doc_id[u], tf) for u, tf in idx.postings[field][term].items())
            block = bytearray()
            prev = 0
            for d, tf in plist:
                block += _varint_encode(d - prev)
                block += _varint_encode(tf)
                prev = d
            postings_entries.append((fi * n_terms + term_rank[term], offset))
            postings_bin += block
            offset += len(block)
    n_entries = len(postings_entries)
    postings_idx_dir = bytearray()
    for key, off in postings_entries:
        postings_idx_dir += struct.pack("<II", key, off)
    # length sentinel: key exceeds every real key (max real key is len(FIELDS)*n_terms - 1), so
    # it can never match a lookup; offset = len(postings_bin), giving the last real entry's
    # length as next_record.offset - hit.offset with no special case.
    postings_idx_dir += struct.pack("<II", len(Index.FIELDS) * n_terms, offset)
    postings_idx = struct.pack("<I", n_entries) + bytes(postings_idx_dir)

    dims = _dense_dims(idx)
    vectors_bin = bytearray()
    for u in doc_urns:
        vec = idx.skill_vectors.get(u) or ((0,) * dims)
        if len(vec) != dims:
            raise ValueError(f"skill vector for {u} has {len(vec)} dims, expected {dims}")
        try:
            vectors_bin += array.array('b', vec).tobytes()
        except OverflowError as e:
            raise ValueError(f"skill vector for {u} has a component outside int8 range "
                              f"([-128,127]) — the distiller must L2-normalise before "
                              f"quantising (ADR-0020): {e}") from e
    words_sorted = sorted(idx.word_vectors.keys())
    words_bin = bytearray()
    for w in words_sorted:
        try:
            words_bin += array.array('b', idx.word_vectors[w]).tobytes()
        except OverflowError as e:
            raise ValueError(f"word vector for {w!r} has a component outside int8 range "
                              f"([-128,127]): {e}") from e
    words_idx = ("\n".join(words_sorted) + ("\n" if words_sorted else "")).encode("utf-8")

    # graph.bin/graph.idx are the ONLY on-disk graph representation (R4): a `graph.json` sibling
    # was tried first, kept purely for human/tooling readability, but it cost 407KB at the
    # ADR-0021 2000-skill/889-real-SKILL.md scale -- against a budget that already had only ~6%
    # headroom (ADR-0021), that overshot 15MB once cards.hdr/cards.idx/graph.idx were added too.
    # graph.bin is checksummed in manifest.json exactly like every other file, so `index --check`
    # still catches tampering/staleness; it is just binary instead of JSON. Per doc-id (same
    # doc_id numbering as cards.idx/cards.hdr, sorted-URN order), one record packs GRAPH_EDGE_TYPES
    # (fixed order) as varint(count) + count*varint(target doc-id). Every edge target is
    # guaranteed to be a key of idx.cards (`_build_graph` filters requires/refines with `if r in
    # urns` and replaces with `c.get("replaced_by") in urns`), so doc_id[...] never raises
    # KeyError here. This lets closure/propagation touch only the few docs it expands instead of
    # paging in the whole graph on every hook invocation.
    graph_bin_parts = []
    graph_idx = bytearray(struct.pack("<I", n_docs))
    running_offset = 0
    for u in doc_urns:
        rec = bytearray()
        for et in Index.GRAPH_EDGE_TYPES:
            targets = idx.graph.get(et, {}).get(u, [])
            rec += _varint_encode(len(targets))
            for t in targets:
                rec += _varint_encode(doc_id[t])
        graph_idx += struct.pack("<II", running_offset, len(rec))
        running_offset += len(rec)
        graph_bin_parts.append(bytes(rec))
    graph_bin = b"".join(graph_bin_parts)

    nodes_bytes = (json.dumps(idx.nodes, sort_keys=True, indent=2) + "\n").encode("utf-8")

    return {
        "cards.jsonl": cards_bytes,
        "cards.idx": bytes(cards_idx),
        "cards.hdr": bytes(cards_hdr),
        "terms.bin": bytes(terms_bin),
        "norms.bin": bytes(norms_bin),
        "postings.bin": bytes(postings_bin),
        "postings.idx": bytes(postings_idx),
        "vectors.i8": bytes(vectors_bin),
        "words.bin": bytes(words_bin),
        "words.idx": words_idx,
        "graph.bin": graph_bin,
        "graph.idx": bytes(graph_idx),
        "nodes.json": nodes_bytes,
    }

def write_index_artifact(root: Path, cfg: dict, dest: Path, git_sha: str) -> dict:
    """Build an Index from the current tree and persist it to `dest` (index_cache_dir(git_sha)).
    Returns the manifest dict. Reproducibility: build_time is the target commit's own timestamp
    (deterministic for a real sha), never wall-clock — so the SAME sha always serialises to
    byte-identical files, manifest.json included; only the "worktree" (uncommitted) sha falls
    back to wall-clock, because an uncommitted tree has no stable time to anchor to."""
    import hashlib
    idx = Index.build(root, cfg, word_vectors=None)
    files = _serialize_artifact_files(idx)
    dest.mkdir(parents=True, exist_ok=True)
    checksums = {}
    for name, data in files.items():
        (dest / name).write_bytes(data)
        checksums[name] = hashlib.sha256(data).hexdigest()
    # Distinct global vocabulary size — exactly what terms.bin holds (idx.idf, one row per term).
    # NOT sum(len(idx.postings[f]) for f in FIELDS): that would double-count any term that
    # appears in more than one field (e.g. "auth" in both description and body), overstating
    # vocabulary size relative to what's actually persisted.
    n_terms = len(idx.idf)
    build_time = _commit_time(root, git_sha) or datetime.datetime.now(datetime.timezone.utc).isoformat(timespec="seconds")
    manifest = {
        "format_version": 1,
        "git_sha": git_sha,
        "build_time": build_time,
        "builder": "guidefold index",
        "teacher": {"id": None, "hf_commit_sha": None, "license": None},   # tier-2, not this PR (ADR-0020)
        "student_dims": _dense_dims(idx),
        "quant_scale": 127,
        "weights": idx.weights,
        "counts": {"cards": len(idx.cards), "terms": n_terms, "words": len(idx.word_vectors)},
        "checksums": checksums,
    }
    (dest / "manifest.json").write_text(json.dumps(manifest, sort_keys=True, indent=2) + "\n")
    return manifest

def load_index_artifact(dest: Path) -> Index:
    """Read <cache_root>/index/<sha>/ back into a Router-ready Index. Postings, dense vectors,
    cards, graph, idf (terms.bin) and the postings offset table (postings.idx) are all lazily
    backed by mmap; only nodes.json and the small per-doc header tables (cards.hdr, cards.idx,
    graph.idx, norms.bin — all O(doc count), never O(vocabulary)) are loaded eagerly in full.
    Raises on a missing/corrupt artifact — callers (cmd_hook) treat any exception here as "no
    artifact yet, print nothing".

    R4 (lazy cards/graph): the previous version json.loads()'d every line of cards.jsonl and the
    whole of graph.json here, unconditionally, on every hook invocation — cost scaling linearly
    with corpus size (measured ~50ms at 501 skills; ~46ms of it at 6 006 real skills). cards.hdr/
    cards.idx/graph.idx give Router everything policy_filter and closure/propagation need for O(1)
    per-card access without ever parsing a card body or the graph JSON, unless something actually
    asks for one (see _LazyCards/_LazyGraph above). That fix landed exactly as scoped and shaved
    the ~46ms it targeted — but at 6 006 real skills (89 630 distinct terms across Index.FIELDS)
    it revealed a LARGER pre-existing, still-eager cost one layer down: parsing terms.bin (~86ms
    median) and postings.idx (~165ms median), whole-file, into `idf`/`offsets` dicts, was ~250ms
    of this function's ~271ms total — the true dominant cost at that corpus size, scaling with
    vocabulary rather than doc count.

    R4 cont'd / "R5" (this fix): terms.bin and postings.idx are now mmap'd and binary-searched
    (`_LazyTerms`, `_LazyPostingsIndex`) exactly like postings.bin already was — see the file-table
    comment above `_varint_encode` for the on-disk layout and `_find_terms_directory` for the
    search itself. Neither file is parsed into a Python dict here at all any more; load cost for
    both drops from O(vocabulary) to O(1) (open the mmap, read one `u32` header), and per-query
    cost becomes O(log vocabulary) per query term instead of amortised-already-paid. See
    docs/reports/bakeoff/R4-latency-lazy-load-2026-09-05.md for the R4 breakdown this fix
    addresses, and docs/reports/bakeoff/R4-latency-terms-postings-2026-09-05.md for this one's."""
    manifest = json.loads((dest / "manifest.json").read_text())

    hdr_data = (dest / "cards.hdr").read_bytes()
    (n_docs,) = struct.unpack_from("<I", hdr_data, 0)
    pos = 4
    doc_urns, node_by_doc, status_by_doc, has_neg_by_doc = [], [], [], []
    for _ in range(n_docs):
        ulen, pos = _varint_decode(hdr_data, pos)
        u = hdr_data[pos:pos + ulen].decode("utf-8"); pos += ulen
        nlen, pos = _varint_decode(hdr_data, pos)
        node = hdr_data[pos:pos + nlen].decode("utf-8"); pos += nlen
        flags = hdr_data[pos]; pos += 1
        doc_urns.append(u)
        node_by_doc.append(node)
        status_by_doc.append("deprecated" if flags & 1 else "active")
        has_neg_by_doc.append(bool(flags & 2))
    doc_id = {u: i for i, u in enumerate(doc_urns)}

    cards_idx_data = (dest / "cards.idx").read_bytes()
    cards_idx_flat = struct.unpack(f"<{2 * n_docs}I", cards_idx_data[4:4 + 8 * n_docs]) if n_docs else ()
    card_offsets = [(cards_idx_flat[2 * i], cards_idx_flat[2 * i + 1]) for i in range(n_docs)]
    idx_cards_fh, idx_cards_mm = _open_mmap(dest / "cards.jsonl")

    idx = Index(
        _LazyCards(idx_cards_mm, card_offsets, doc_urns, node_by_doc, status_by_doc, has_neg_by_doc),
        json.loads((dest / "nodes.json").read_text()), manifest["weights"],
    )
    idx._cards_fh, idx._cards_mm = idx_cards_fh, idx_cards_mm

    graph_idx_data = (dest / "graph.idx").read_bytes()
    (n_graph_docs,) = struct.unpack_from("<I", graph_idx_data, 0)
    graph_idx_flat = struct.unpack(f"<{2 * n_graph_docs}I", graph_idx_data[4:4 + 8 * n_graph_docs]) if n_graph_docs else ()
    graph_offsets = [(graph_idx_flat[2 * i], graph_idx_flat[2 * i + 1]) for i in range(n_graph_docs)]
    idx._graph_fh, idx._graph_mm = _open_mmap(dest / "graph.bin")
    idx.graph = _LazyGraph(idx._graph_mm, graph_offsets, doc_urns, doc_id)

    # terms.bin (R4 cont'd/"R5"): mmap + one 4-byte header read, never a whole-file parse. Every
    # term is left on disk, binary-searched by `_LazyTerms.lookup` only when a query actually
    # asks for it — see the file-table comment above `_varint_encode` for the exact layout.
    idx._terms_fh, idx._terms_mm = _open_mmap(dest / "terms.bin")
    n_terms = 0
    if idx._terms_mm is not None:
        (n_terms,) = struct.unpack_from("<I", idx._terms_mm, 0)
    idx.idf = _LazyTerms(idx._terms_mm, 4, n_terms)

    field_norm = {f: {} for f in Index.FIELDS}
    norms_data = (dest / "norms.bin").read_bytes()
    per_field = len(doc_urns) * 4
    for i, field in enumerate(Index.FIELDS):
        chunk = norms_data[i * per_field:(i + 1) * per_field]
        if chunk:
            vals = struct.unpack(f"<{len(doc_urns)}I", chunk)
            field_norm[field] = dict(zip(doc_urns, vals))
    idx.field_norm = field_norm

    # postings.idx (R4 cont'd/"R5"): same treatment — mmap + one 4-byte header read, then
    # `_LazyPostingsIndex.find` binary-searches the (field_index, term_id)-keyed directory
    # directly on the mmap, keyed by the SAME term_id space `idx.idf` (_LazyTerms) assigns.
    idx._postings_fh, idx._postings_mm = _open_mmap(dest / "postings.bin")
    idx._postings_idx_fh, idx._postings_idx_mm = _open_mmap(dest / "postings.idx")
    n_entries = 0
    if idx._postings_idx_mm is not None:
        (n_entries,) = struct.unpack_from("<I", idx._postings_idx_mm, 0)
    pidx = _LazyPostingsIndex(idx._postings_idx_mm, 4, n_entries, n_terms)
    idx.postings = {field: _LazyFieldPostings(idx._postings_mm, idx.idf, pidx, fi, doc_urns)
                    for fi, field in enumerate(Index.FIELDS)}

    dims = int(manifest.get("student_dims", 0))
    idx._words_fh, idx._words_mm = _open_mmap(dest / "words.bin")
    idx._vectors_fh, idx._vectors_mm = _open_mmap(dest / "vectors.i8")
    if dims > 0 and idx._words_mm is not None:
        words_list = (dest / "words.idx").read_text(encoding="utf-8").splitlines()
        idx.word_vectors = _LazyVectors(idx._words_mm, {w: i for i, w in enumerate(words_list)}, dims)
    else:
        idx.word_vectors = {}
    if dims > 0 and idx._vectors_mm is not None:
        idx.skill_vectors = _LazyVectors(idx._vectors_mm, doc_id, dims)
        idx.skill_normsq = _LazyNormsq(idx.skill_vectors)
    else:
        idx.skill_vectors, idx.skill_normsq = {}, {}
    return idx

def check_index_artifact(root: Path, cfg: dict, sha: str, dest: Path):
    """Rebuild from the current tree (in memory only) and diff against the manifest checksums
    recorded at `dest` — "a check that cannot fail is not a check" (BRIEF). Two distinct
    failure modes, both reported:
      self-consistency — a file on disk doesn't match what manifest.json says it should hash to
                          (truncated/tampered artifact).
      staleness        — the current tree, rebuilt fresh, hashes to something the on-disk
                          manifest does NOT record (someone edited a SKILL.md and forgot to
                          rerun `guidefold index`).
    Returns (ok: bool, problems: list[str])."""
    import hashlib
    problems = []
    manifest_path = dest / "manifest.json"
    if not manifest_path.exists():
        return False, [f"no index artifact at {dest} for sha={sha} — run `guidefold index` first"]
    try:
        manifest = json.loads(manifest_path.read_text())
    except Exception as e:
        return False, [f"manifest.json at {dest} is not valid JSON: {e}"]
    recorded = manifest.get("checksums", {})
    for name, want in recorded.items():
        p = dest / name
        if not p.is_file():
            problems.append(f"{name} is missing from {dest}")
            continue
        got = hashlib.sha256(p.read_bytes()).hexdigest()
        if got != want:
            problems.append(f"{name} on disk does not match its manifest checksum (tampered or truncated)")
    fresh = _serialize_artifact_files(Index.build(root, cfg))
    for name, data in fresh.items():
        got = hashlib.sha256(data).hexdigest()
        want = recorded.get(name)
        if want is None:
            problems.append(f"{name} has no recorded checksum in manifest.json")
        elif got != want:
            problems.append(f"{name} is stale: current tree hashes to {got[:12]}, artifact "
                             f"recorded {want[:12]} — rerun `guidefold index`")
    return (len(problems) == 0), problems

# ------------------------------------------------------------------- Router
def _dense_rank(scores: dict) -> list:
    """scores: urn -> (dot, normsq). Rank by cosine = dot/sqrt(normsq), descending, in integers.

    Cosine is compared without any sqrt by comparing squared cosines with the sign kept separate:
        sign(dot_a)*dot_a^2 * normsq_b  vs  sign(dot_b)*dot_b^2 * normsq_a
    A previous version compared dot_a*normsq_b vs dot_b*normsq_a, i.e. dot/normsq — which is
    NOT cosine and inverts orderings (counterexample: A=(dot 3, normsq 9) cos 1.00 vs
    B=(dot 1, normsq 2) cos 0.71; dot/normsq ranked B first). Caught in the E1.3 peer review;
    the wrong form came verbatim from ROUTER-SPEC, so the spec was the bug, not the port.
    The query norm is a common factor across candidates and never enters the comparison.
    Ties broken on (-dot, urn). Pure integer arithmetic throughout (ADR-0020)."""
    def key(u):
        dot, nsq = scores[u]
        return (dot, nsq)
    def cmp(a, b):
        da, na = scores[a]
        db, nb = scores[b]
        sa = (da > 0) - (da < 0); sb = (db > 0) - (db < 0)
        lhs, rhs = sa * da * da * nb, sb * db * db * na
        if lhs != rhs:
            return -1 if lhs > rhs else 1
        if da != db:
            return -1 if da > db else 1
        return -1 if a < b else (1 if a > b else 0)
    return sorted(scores.keys(), key=cmp_to_key(cmp))

class Router:
    """Ranking. Depends on an Index only — never on Registry (E0.2). candidates() -> score() ->
    select() is the pipeline (E1.1); route() is the convenience wrapper."""

    def __init__(self, index: Index):
        self.index = index

    # ---- policy filter: hard drops, recorded reason per drop, never a demotion ----
    def _visible_nodes(self, node: str) -> set:
        """Own subtree (node + all descendants) union the ancestor chain."""
        out = set(ancestors(node))
        for n in self.index.nodes:
            if node == "_root" or n == node or n.startswith(node + "."):
                out.add(n)
        return out

    def _negative_trigger_tokens_for(self, u: str) -> list:
        """[(phrase, frozenset(tokens)), ...] for ONE card, tokenised once and cached per-urn on
        the Router instance. Only ever called for a urn whose header flag says it carries
        negative_triggers at all (R4) -- on a corpus where none do (e.g. SKILLRET-test, 6 006
        skills) this method is never called and zero card bodies are parsed to discover that.

        Profiled on the 501-skill SkillRetBench index (every skill DOES have anti-triggers):
        re-tokenising each phrase on every query made policy_filter 84% of the in-process query
        path — 34 575 tokenize() calls for 25 queries. Phrases do not change between queries or
        between the two policy_filter calls one route() makes, so cache per-urn across both."""
        cache = getattr(self, "_neg_tok_cache", None)
        if cache is None:
            cache = {}
            self._neg_tok_cache = cache
        toks = cache.get(u)
        if toks is None:
            c = self.index.cards[u]
            raw = [(t, frozenset(tokenize(t))) for t in c.get("negative_triggers", [])]
            toks = [(t, s) for t, s in raw if s]
            cache[u] = toks
        return toks

    def policy_filter(self, node: str, query: str = "", include_deprecated: bool = False):
        visible = self._visible_nodes(node)
        qtoks = set(tokenize(query))
        kept, drops, kept_node = [], [], {}
        # Iterates the cheap header (urn, node, status, has_negative_triggers) rather than
        # `self.index.cards.items()` -- the latter would materialise (json.loads) every single
        # card's full body just to read `status`/`node`/`negative_triggers`, which is exactly the
        # eager-parse cost a lazily-loaded artifact exists to avoid (R4). A card's full body is
        # only ever fetched (via _negative_trigger_tokens_for) when its header flag says it
        # actually has negative_triggers to check.
        for u, cnode, status, has_neg in self.index.card_header_items():
            if status == "deprecated" and not include_deprecated:
                drops.append((u, "deprecated")); continue
            if cnode not in visible:
                drops.append((u, "not-visible")); continue
            hit_neg = None
            if has_neg:
                for t, ttoks in self._negative_trigger_tokens_for(u):
                    if ttoks <= qtoks:
                        hit_neg = t; break
            if hit_neg is not None:
                drops.append((u, f"negative-trigger:{hit_neg}")); continue
            kept.append(u)
            kept_node[u] = cnode
        # Nearest wins (ADR-0037, E2 run 2026-09-08): when the same skill *name* is visible at
        # more than one depth (a team-level copy and a service-level edit), only the copy closest
        # to `node` survives. Before this, BM25F ranked the ancestor copy first in 24/24 conflict
        # cells and the agent applied its values 23/24 times. Visible nodes are ancestors-or-self
        # of `node`, so "closest" is simply the deepest node.
        nearest = {}
        for u in kept:
            name = u.rsplit(":", 1)[-1]
            depth = 0 if kept_node[u] == "_root" else kept_node[u].count(".") + 1
            if name not in nearest or depth > nearest[name][0]:
                nearest[name] = (depth, u)
        winners = {u for _, u in nearest.values()}
        shadowed = [u for u in kept if u not in winners]
        if shadowed:
            for u in shadowed:
                drops.append((u, f"shadowed-by-nearer:{nearest[u.rsplit(':', 1)[-1]][1]}"))
            kept = [u for u in kept if u in winners]
        return kept, drops

    # ---- candidates: field-weighted BM25 + dense channel, fused later by RRF ----
    def _bm25_scores(self, query: str, visible: set) -> dict:
        idx = self.index
        qterms = tokenize(query)
        if not qterms:
            return {}
        qtf = {}
        for t in qterms:
            qtf[t] = qtf.get(t, 0) + 1
        # Fixed-point contract (peer review, 2026-09-05): k1, idf, field_norm and the weighted TF
        # must all live on the SAME scale S = IDF_SCALE. Previously wtf was (w*tf*S)//norm with norm
        # already scaled by S — i.e. wtf came out UNSCALED (order 1..100) while k1_scaled was ~1.26M.
        # Two consequences: denom ~= k1_scaled regardless of tf, so there was no saturation (near-
        # linear in tf), and idf*wtf // denom truncated to 0 for tf=1 on most terms. Scoring wtf by
        # S*S//norm restores wtf on scale S; the quotient idf*wtf//(k1+wtf) then lands on scale S.
        S = idx.IDF_SCALE
        k1_scaled = round(idx.K1 * S)
        scores = {}
        for t, n_q in qtf.items():
            idf = idx.idf.get(t)
            if idf is None:
                continue
            wtf_by_doc = {}
            for field in idx.FIELDS:
                w = idx.weights[f"field.{field}"]
                post = idx.postings[field].get(t)
                if not post:
                    continue
                for u, tf in post.items():
                    if u not in visible:
                        continue
                    norm = idx.field_norm[field][u]
                    wtf_by_doc[u] = wtf_by_doc.get(u, 0) + (w * tf * S * S) // norm
            for u, wtf in wtf_by_doc.items():
                denom = k1_scaled + wtf
                term_score = (idf * wtf) // denom if denom else 0
                scores[u] = scores.get(u, 0) + term_score * n_q
        return scores

    def _dense_scores(self, query: str, visible: set) -> dict:
        idx = self.index
        if not idx.word_vectors:
            return {}
        qterms = tokenize(query)
        dims = len(next(iter(idx.word_vectors.values())))
        qvec = [0] * dims
        hit = False
        for t in qterms:
            wv = idx.word_vectors.get(t)
            if wv:
                hit = True
                for i in range(dims):
                    qvec[i] += wv[i]
        if not hit:
            return {}
        out = {}
        for u in visible:
            svec = idx.skill_vectors.get(u)
            if not svec:
                continue
            dot = sum(a * b for a, b in zip(qvec, svec))
            out[u] = (dot, idx.skill_normsq.get(u, 0))
        return out

    def candidates(self, query: str, node: str, include_deprecated: bool = False, top_n: int = 50) -> list:
        visible, drops = self.policy_filter(node, query, include_deprecated)
        visible_set = set(visible)
        bm25 = self._bm25_scores(query, visible_set)
        # w_dense = 0 switches the channel OFF: no vector work, no dense rank, no RRF vote. Before
        # this the weight was never read and the channel ran whenever a word table existed.
        dense = self._dense_scores(query, visible_set) if self.index.weights.get("w_dense", 0) > 0 else {}
        bm25_order = sorted(bm25, key=lambda u: (-bm25[u], u))
        bm25_rank = {u: i + 1 for i, u in enumerate(bm25_order)}
        dense_order = _dense_rank(dense)
        dense_rank = {u: i + 1 for i, u in enumerate(dense_order)}
        cand_urns = set(bm25_order[:top_n]) | set(dense_order[:top_n])
        out = []
        for u in sorted(cand_urns):
            out.append({
                "urn": u, "node": self.index.cards[u]["node"],
                "bm25_rank": bm25_rank.get(u), "dense_rank": dense_rank.get(u),
            })
        self.last_drops = drops
        return out

    # ---- score: RRF fusion + scope feature + reverse PPR ----
    def _hops(self, skill_node: str, caller_node: str) -> int:
        chain = ancestors(caller_node)
        if skill_node in chain:
            return chain.index(skill_node)
        if caller_node == "_root":
            rest = skill_node
        elif skill_node.startswith(caller_node + "."):
            rest = skill_node[len(caller_node) + 1:]
        else:
            rest = skill_node
        return rest.count(".") + 1

    def _reverse_ppr(self, seed_scaled: dict) -> dict:
        """Mass flows FROM a strong hit TOWARD what it requires, so prerequisites (and, via
        `replaces`, the deprecated skill's replacement) gain mass too. Fixed 20-iteration power
        method, fixed-point integer arithmetic throughout."""
        idx = self.index
        nodes = list(idx.cards.keys())
        total_seed = sum(v for v in seed_scaled.values() if v > 0)
        if total_seed <= 0:
            return {u: 0 for u in nodes}
        scale = idx.IDF_SCALE
        p = {u: (max(0, seed_scaled.get(u, 0)) * scale) // total_seed for u in nodes}
        edges = {u: [] for u in nodes}
        # Point-lookup per (edge_type, node) rather than `idx.graph.get(et, {}).items()` -- the
        # latter demands the WHOLE edge-type mapping in one call, which defeats a lazily-loaded
        # graph (R4: graph.bin is addressable per card, never parsed in full on the hook path).
        # `nodes` already ranges over every urn `p` is keyed by, so this visits the same universe
        # `u not in p` used to filter (dead code: every graph key is always a card urn, ADR-0020).
        for et in idx.GRAPH_EDGE_TYPES:
            w = idx.weights.get(f"edge.{et}", 0)
            if w <= 0:
                continue
            et_graph = idx.graph.get(et, {})
            for u in nodes:
                for t in et_graph.get(u, []):
                    if t in p:
                        edges[u].append((t, w))
        out_weight = {u: sum(w for _, w in edges[u]) for u in nodes}
        mass = dict(p)
        a_num, a_den = idx.PPR_ALPHA_NUM, idx.PPR_ALPHA_DEN
        for _ in range(idx.PPR_ITERS):
            new_mass = {u: (a_num * p[u]) // a_den for u in nodes}
            for u in nodes:
                mu, ow = mass[u], out_weight[u]
                if mu == 0 or ow == 0:
                    continue
                for t, w in edges[u]:
                    new_mass[t] += ((a_den - a_num) * mu * w) // (a_den * ow)
            mass = new_mass
        return mass

    def _decayed_closure(self, seed_scaled: dict, max_depth: int = 2) -> dict:
        """Alternative to `_reverse_ppr`, named in ADR-0020's rejected-alternative note: on a
        graph with out-degree ~= 0.6 and few `refines`/`replaces` edges, reverse PPR's power
        iteration may be indistinguishable from a much simpler decayed `requires`-closure walk,
        while being harder to explain in the Probe UI. Selected via `weights["ppr_mode"] ==
        "closure"` (default stays "pagerank" -- see docs/reports/tuning/E1-config-selection.md
        for the measured comparison and the ship/no-ship verdict).

        No power iteration, no restart term, no out-degree normalisation, `requires` edges only
        (the same relation `_requires_closure` walks for hard membership in `select`): each
        seed's normalised mass is propagated a fixed `closure_decay_num/closure_decay_den`
        fraction per hop, up to `max_depth` hops. Same seed normalisation as `_reverse_ppr` (
        positive mass scaled so it sums to `idx.IDF_SCALE`) so `score()` can call either
        implementation interchangeably and get comparable magnitudes."""
        idx = self.index
        nodes = list(idx.cards.keys())
        total_seed = sum(v for v in seed_scaled.values() if v > 0)
        if total_seed <= 0:
            return {u: 0 for u in nodes}
        scale = idx.IDF_SCALE
        p = {u: (max(0, seed_scaled.get(u, 0)) * scale) // total_seed for u in nodes}
        decay_num = idx.weights.get("closure_decay_num", 1)
        decay_den = idx.weights.get("closure_decay_den", 2)
        requires = idx.graph.get("requires", {})
        mass = dict(p)   # each node keeps its own seed mass (mirrors _reverse_ppr's restart term)
        for u, s in p.items():
            if s <= 0:
                continue
            frontier, seen = [u], {u}
            num, den = 1, 1
            for _ in range(max_depth):
                num, den = num * decay_num, den * decay_den
                nxt = []
                for x in frontier:
                    for t in requires.get(x, []):
                        if t in seen:
                            continue
                        seen.add(t)
                        nxt.append(t)
                        if t in mass:
                            mass[t] += (s * num) // den
                frontier = nxt
                if not frontier:
                    break
        return mass

    def score(self, cands: list, query: str, node: str) -> list:
        idx = self.index
        rrf = {}
        for c in cands:
            u = c["urn"]
            s = 0
            if c["bm25_rank"] is not None:
                s += idx.RRF_SCALE // (idx.RRF_K + c["bm25_rank"])
            if c["dense_rank"] is not None:
                s += idx.RRF_SCALE // (idx.RRF_K + c["dense_rank"])
            rrf[u] = s
        w_scope = idx.weights["w_scope"]
        for c in cands:
            rrf[c["urn"]] += w_scope // (1 + self._hops(c["node"], node))
        ppr = self._decayed_closure(rrf) if idx.weights.get("ppr_mode", "pagerank") == "closure" \
            else self._reverse_ppr(rrf)
        w_ppr = idx.weights["w_ppr"]
        scored = []
        for c in cands:
            u = c["urn"]
            total = rrf[u] + (w_ppr * ppr.get(u, 0)) // idx.IDF_SCALE
            scored.append({**c, "score": total})
        scored.sort(key=lambda c: (-c["score"], c["urn"]))
        return scored

    # ---- select: requires closure (depth<=2, hard membership) + cap + abstain + ordering ----
    def _requires_closure(self, u: str, max_depth: int = 2) -> list:
        idx = self.index
        seen = {u}
        frontier = [u]
        out = []
        for _ in range(max_depth):
            nxt = []
            for x in frontier:
                for r in idx.graph["requires"].get(x, []):
                    if r not in seen:
                        seen.add(r); out.append(r); nxt.append(r)
            frontier = nxt
            if not frontier:
                break
        return out

    def _depth(self, node: str) -> int:
        return 0 if node == "_root" else node.count(".") + 1

    def _top_margin(self, scored: list) -> int:
        """rank1-rank2 score gap -- the alternative confidence signal to raw magnitude (RRF gives
        any rank-1 hit a near-constant high score, so magnitude alone cannot tell a confident hit
        apart from a `no_applicable` case with a lucky top candidate; see
        docs/reports/tuning/E1-config-selection.md). A pool of fewer than 2 candidates has no
        second place to compare against, so it is never abstained on margin grounds alone."""
        if len(scored) < 2:
            return 1 << 30
        return scored[0]["score"] - scored[1]["score"]

    # ---- composer (ADR-0022 §4 / ADR-0024 §4, DENSE-PROGRAM.md v2.4 family C) ----
    def _card_terms(self, u: str) -> frozenset:
        """Tokenized, memoized bag of a card's own terms (name/description/digest/triggers) --
        the coverage-fill signal in `_select_composed`. Memoized on the Router instance because a
        dev/eval harness calls `select()` thousands of times against the same Index."""
        cache = self.__dict__.setdefault("_card_terms_cache", {})
        terms = cache.get(u)
        if terms is None:
            c = self.index.cards[u]
            text = " ".join([c.get("name", ""), c.get("description", ""), c.get("digest", ""),
                              " ".join(c.get("triggers") or [])])
            terms = frozenset(tokenize(text))
            cache[u] = terms
        return terms

    def _detect_bundle(self, pool: list, tau_pct: int) -> bool:
        """True when >= 2 candidates in `pool` (already sorted desc by score) sit within
        `tau_pct` percent of the top score -- a plateau in the score distribution. This is the
        only bundle signal available on corpora with no `requires` edges (neither test corpus in
        DENSE-PROGRAM.md has any): a single dominant winner is a single-skill query; several
        near-tied candidates is a query the ranking alone cannot resolve into one answer.
        Integer-only: `threshold = top * (100 - tau_pct) // 100`, floor division."""
        if len(pool) < 2:
            return False
        top = pool[0]["score"]
        if top <= 0:
            return False
        threshold = (top * (100 - tau_pct)) // 100
        return sum(1 for c in pool if c["score"] >= threshold) >= 2

    def _emit(self, chosen: list, score_by_urn: dict) -> list:
        """Shared tail of every select() path: general -> specific (root-most first) injection
        order, ties on score then urn."""
        idx = self.index
        chosen = sorted(chosen, key=lambda u: (self._depth(idx.cards[u]["node"]), -score_by_urn.get(u, 0), u))
        out = []
        for u in chosen:
            c = idx.cards[u]
            out.append({"urn": u, "node": c["node"], "name": c["name"],
                        "description": c["description"], "score": score_by_urn.get(u, 0)})
        return out

    def _select_closure(self, scored: list, k: int, admissible: set) -> list:
        """The legacy select() body (unchanged since before family C): greedy top-score fill,
        each pick pulling in its own `requires` closure (depth<=2, hard membership, admissibility-
        gated). `compose_mode="off"` calls this directly; `compose_mode="on"` falls back to it
        for every query its own bundle detector does not flag (ADR-0022 §4: composition is its
        own stage, and a single-skill query has nothing to compose)."""
        idx = self.index
        score_by_urn = {c["urn"]: c["score"] for c in scored}
        chosen, chosen_set = [], set()
        for c in scored:
            if len(chosen) >= k:
                break
            u = c["urn"]
            if u in chosen_set:
                continue
            chosen.append(u); chosen_set.add(u)
            for dep in self._requires_closure(u, max_depth=2):
                if len(chosen) >= k:
                    break
                if dep in chosen_set or dep not in idx.cards:
                    continue
                # Admissibility is decided once, by policy_filter, and applies everywhere (ADR-0022):
                # a dependency the filter rejected — out of scope, deprecated, negative-trigger — must
                # not be re-admitted through `requires`. It is an unresolved requirement instead.
                if dep not in admissible:
                    continue
                chosen.append(dep); chosen_set.add(dep)
        return self._emit(chosen, score_by_urn)

    def _select_composed(self, scored: list, k: int, admissible: set, query: str) -> list:
        """Deterministic composer body (ADR-0022 §4's "cannot fit" semantics, ADR-0024 §4's
        interface). Sets `self.last_multi_skill`/`self.last_cannot_fit` for the caller (an eval
        harness reads these off the Router instance; the CLI itself never prints them)."""
        idx = self.index
        tau_pct = idx.weights.get("compose_tau_pct", 20)
        coverage_on = bool(idx.weights.get("compose_coverage", True))
        # ADR-0024 §4: the composer sees at most 15 admissible candidates.
        pool = [c for c in scored if c["urn"] in admissible][:15]
        is_bundle = self._detect_bundle(pool, tau_pct)
        self.last_multi_skill = is_bundle
        if not is_bundle:
            return self._select_closure(scored, k, admissible)
        score_by_urn = {c["urn"]: c["score"] for c in scored}
        top = pool[0]["score"]
        threshold = (top * (100 - tau_pct)) // 100
        plateau = {c["urn"] for c in pool if c["score"] >= threshold}
        qterms = set(tokenize(query)) if coverage_on else set()
        chosen, chosen_set, covered = [], set(), set()

        def _add(u: str) -> None:
            if len(chosen) >= k or u in chosen_set or u not in idx.cards:
                return
            chosen.append(u); chosen_set.add(u)
            covered.update((self._card_terms(u) & qterms) - covered)
            for dep in self._requires_closure(u, max_depth=2):
                if len(chosen) >= k:
                    break
                if dep in chosen_set or dep not in idx.cards or dep not in admissible:
                    continue
                chosen.append(dep); chosen_set.add(dep)
                covered.update((self._card_terms(dep) & qterms) - covered)

        if coverage_on and qterms:
            remaining = list(pool)
            while len(chosen) < k and remaining:
                def _gain(c):
                    return len((self._card_terms(c["urn"]) & qterms) - covered)
                remaining.sort(key=lambda c: (-_gain(c), -c["score"], c["urn"]))
                best = remaining[0]
                if _gain(best) <= 0 and chosen:
                    break   # no remaining candidate covers a new query term -- stop filling
                _add(best["urn"])
                remaining = [c for c in remaining if c["urn"] not in chosen_set]
        else:
            for c in pool:
                if len(chosen) >= k:
                    break
                _add(c["urn"])
        # cannot_fit (ADR-0022 §4): say so rather than silently truncating. With coverage
        # signal, a plateau member left out that still holds an uncovered query term is the
        # bundle not fitting the budget; without it (coverage_on=False or an empty query),
        # any plateau member left out once the budget is exhausted is the same fact reported
        # the only way available.
        if qterms:
            self.last_cannot_fit = any(
                u not in chosen_set and len((self._card_terms(u) & qterms) - covered) > 0
                for u in plateau
            )
        else:
            self.last_cannot_fit = len(chosen) >= k and bool(plateau - chosen_set)
        return self._emit(chosen, score_by_urn)

    def select(self, scored: list, k: int = 4, abstain_threshold: int = None, *, admissible: set,
               query: str = "") -> list:
        idx = self.index
        mode = idx.weights.get("abstain_mode", "magnitude")
        if abstain_threshold is None:
            abstain_threshold = idx.weights["abstain_margin_threshold"] if mode == "margin" \
                else idx.weights["abstain_threshold"]
        signal = self._top_margin(scored) if mode == "margin" else (scored[0]["score"] if scored else 0)
        self.last_multi_skill = False
        self.last_cannot_fit = False
        if not scored or signal < abstain_threshold:
            return []
        if idx.weights.get("compose_mode", "off") == "on":
            return self._select_composed(scored, k, admissible, query)
        return self._select_closure(scored, k, admissible)

    def route(self, query: str, node: str, k: int = 4, include_deprecated: bool = False) -> list:
        cands = self.candidates(query, node, include_deprecated=include_deprecated)
        scored = self.score(cands, query, node)
        # The same admissibility decision governs candidates AND dependency expansion (ADR-0022).
        admissible, _ = self.policy_filter(node, query, include_deprecated)
        return self.select(scored, k=k, admissible=set(admissible), query=query)

# ------------------------------------------------------------------------- commands
# ------------------------------------------------------- E2.6/E2.9 search.backend: service
# The client (this file) is the SAME at every deployment tier (ADR-0024 T0/T1/T2): by default it
# ranks in-process against the local artifact ("local"); when `search.backend: service` is
# configured it also races a POST /v1/search against the Go/ParadeDB service (contract 1.1,
# docs/HARNESS-SERVICE-CONTRACT.md) with one monotonic absolute deadline, and always keeps the
# local sparse computation as the answer of record if the remote does not win the race in time
# (ADR-0023 Sec3). Nothing here changes Router.candidates/score/select/policy_filter -- this layer
# only decides *which already-produced ordered list* becomes the answer, never how either list is
# produced or ranked.
#
# stdlib only (http.client/urllib.parse/socket/threading), imported lazily inside the functions
# that need them -- same discipline as hashlib/uuid/zipfile elsewhere in this file. `cmd_hook`
# must open ZERO sockets on the (default) `backend: local` path (E1.5-adjacent non-negotiable,
# test-asserted in tests/test_service_backend.py).

DEFAULT_SEARCH_DEADLINE_HOOK_MS = 300          # ADR-0023 Sec3 hook budget
DEFAULT_SEARCH_DEADLINE_INTERACTIVE_MS = 1000  # docs/SEARCH-USE-TELEMETRY.md Sec7 interactive p95 target

def _search_config_from_env() -> dict:
    """Env overrides (GUIDEFOLD_SEARCH_*): the ONLY config source `cmd_hook` may use -- it never
    reads guidefold.yaml/PyYAML (E1.5). Returns only keys actually set, so a caller that also has
    a parsed `cfg["search"]` block can layer this on top (env always wins)."""
    out = {}
    if os.environ.get("GUIDEFOLD_SEARCH_BACKEND", "").strip():
        out["backend"] = os.environ["GUIDEFOLD_SEARCH_BACKEND"].strip()
    if os.environ.get("GUIDEFOLD_SEARCH_URL", "").strip():
        out["url"] = os.environ["GUIDEFOLD_SEARCH_URL"].strip()
    if os.environ.get("GUIDEFOLD_SEARCH_DEADLINE_MS", "").strip():
        try:
            out["deadline_ms"] = int(os.environ["GUIDEFOLD_SEARCH_DEADLINE_MS"])
        except ValueError:
            pass
    if os.environ.get("GUIDEFOLD_SEARCH_TOKEN_FILE", "").strip():
        out["token_file"] = os.environ["GUIDEFOLD_SEARCH_TOKEN_FILE"].strip()
    return out

def resolve_search_config(cfg: dict = None, profile: str = "interactive") -> dict:
    """Merge guidefold.yaml's `search:` block (if any -- `cfg` is None from cmd_hook) with env
    overrides (env wins), validate, and fall back to backend=local on anything wrong. A bad
    config never crashes `find`/`hook`; it degrades silently to local with `config_error=True`,
    which callers turn into telemetry `degradation_reason="config"` (Deliverable 1: "a bad
    config falls back to local with a visible degradation_reason=config").

    Returns {"backend": "local"|"service", "url": str|None, "deadline_ms": int,
             "token": str|None, "config_error": bool}. The bearer token comes from
    GUIDEFOLD_TOKEN or a token file -- never from guidefold.yaml directly, never logged."""
    search_block = (cfg or {}).get("search")
    raw = dict(search_block) if isinstance(search_block, dict) else {}
    raw.update(_search_config_from_env())
    default_deadline = (DEFAULT_SEARCH_DEADLINE_HOOK_MS if profile == "hook"
                        else DEFAULT_SEARCH_DEADLINE_INTERACTIVE_MS)
    backend = raw.get("backend", "local")
    config_error = False
    if backend not in ("local", "service"):
        backend, config_error = "local", True
    url = raw.get("url")
    if backend == "service" and (not isinstance(url, str) or not url.strip()):
        backend, config_error = "local", True
    deadline_ms = raw.get("deadline_ms", default_deadline)
    try:
        deadline_ms = int(deadline_ms)
        if not (1 <= deadline_ms <= 5000):    # contract 1.1: deadline_ms is 1..5000
            raise ValueError
    except (TypeError, ValueError):
        deadline_ms, config_error = default_deadline, True
    token = os.environ.get("GUIDEFOLD_TOKEN") or None
    token_file = raw.get("token_file")
    if not token and token_file:
        try:
            token = Path(token_file).expanduser().read_text(encoding="utf-8").strip() or None
        except Exception:
            config_error = True   # configured but unreadable: a real config problem, not silence
    if backend == "service" and not token:
        # A service backend that can never authenticate can never succeed (contract: POST
        # requires the bearer token) -- fail fast into local rather than paying for a request
        # that is guaranteed to 401 every time.
        backend, config_error = "local", True
    return {"backend": backend, "url": url, "deadline_ms": deadline_ms,
            "token": token, "config_error": config_error}


def _parse_search_url(url: str):
    import urllib.parse
    p = urllib.parse.urlsplit(url)
    if p.scheme not in ("http", "https") or not p.hostname:
        raise ValueError(f"unusable search.url: {url!r}")
    port = p.port or (443 if p.scheme == "https" else 80)
    return p.scheme, p.hostname, port, p.path.rstrip("/")


class _RemoteSearchResult:
    """Mailbox shared between the background request thread and the caller. Single writer (the
    worker thread), single reader-after-`done` (the caller) -- no lock needed. `conn` is set as
    soon as the connection object exists so the caller can force-close it from outside the thread
    to abandon a hung request on deadline (ADR-0023 Sec3: closed, never joined)."""
    def __init__(self):
        import threading
        self.done = threading.Event()
        self.status = None
        self.body = None
        self.error = None   # "timeout"/"connection"/"invalid_response" -- set on transport failure
        self.conn = None
        self.phase = None   # "connect", "request", or "read"; used to classify timeouts


def _remote_call(scheme, host, port, path, token, payload, timeout_s, result):
    """Runs in a daemon thread. POSTs one contract-1.1 JSON body and stores the outcome on
    `result`. `timeout_s` bounds socket connect/read. Never raises out of the thread; never
    returns anything (the caller only ever reads `result`, and only up to its own deadline)."""
    import http.client
    try:
        conn_cls = http.client.HTTPSConnection if scheme == "https" else http.client.HTTPConnection
        conn = conn_cls(host, port, timeout=max(timeout_s, 0.001))
        result.conn = conn
        body = json.dumps(payload).encode("utf-8")
        # Connect explicitly so a timeout while the endpoint is unreachable is reported as a
        # connection failure.  HTTPConnection.request() otherwise combines connect and write,
        # which makes a refused/unroutable endpoint indistinguishable from a slow response on
        # platforms where the kernel drops SYNs instead of returning ECONNREFUSED.
        result.phase = "connect"
        conn.connect()
        result.phase = "request"
        conn.request("POST", path or "/", body=body, headers={
            "Content-Type": "application/json", "Content-Length": str(len(body)),
            "Authorization": "Bearer " + token,
        })
        result.phase = "read"
        resp = conn.getresponse()
        raw = resp.read()
        result.status = resp.status
        try:
            result.body = json.loads(raw)
        except Exception:
            result.body = None
            result.error = "invalid_response"
        try:
            conn.close()
        except Exception:
            pass
    except TimeoutError:
        result.error = "connection" if result.phase == "connect" else "timeout"
    except Exception:
        # Any other transport-layer failure (refused, reset, DNS, TLS, or the socket being
        # force-closed out from under this thread by _abandon_remote below) is reported the same
        # way: the service was not reachable in time, so the client falls back to local.
        result.error = result.error or "connection"
    finally:
        result.done.set()


def _abandon_remote(result: "_RemoteSearchResult"):
    """Force-close the background request's socket (never join the thread -- ADR-0023 Sec3). Best
    effort, never raises: shutdown() first so a thread blocked in recv() wakes up promptly on
    POSIX instead of waiting for the OS's own timeout, then close()."""
    try:
        conn = result.conn
        sock = getattr(conn, "sock", None) if conn is not None else None
        if sock is not None:
            import socket as _socket
            try:
                sock.shutdown(_socket.SHUT_RDWR)
            except OSError:
                pass
        if conn is not None:
            conn.close()
    except Exception:
        pass


def _cards_from_service_response(body):
    """Structural validation with stdlib only (Deliverable 3): `schema_version=='1.1'`, a
    non-empty `search_id`, and a `cards` list whose items each carry non-empty `urn`/`revision`/
    `description` strings (contract 1.1 JSON Schema's own required fields for a card). Anything
    else -> (None, "invalid_response"). On success, returns cards reshaped into this CLI's own
    local card shape (urn/description/revision/node/score) so callers can print/telemeter both
    sources identically; `node` is parsed from the URN (best-effort, never required); `score` is
    a synthetic descending rank -- the service is the product router of record here (contract
    doc: "the client uses the service's ordered selection as-is"), so order is everything and
    this number is cosmetic display parity with the local card shape, never compared numerically
    against a local score."""
    if not isinstance(body, dict) or body.get("schema_version") != "1.1":
        return None, "invalid_response"
    search_id = body.get("search_id")
    cards = body.get("cards")
    if not isinstance(search_id, str) or not search_id or not isinstance(cards, list):
        return None, "invalid_response"
    out = []
    n = len(cards)
    for i, c in enumerate(cards):
        if not isinstance(c, dict):
            return None, "invalid_response"
        u, rev, desc = c.get("urn"), c.get("revision"), c.get("description")
        if not (isinstance(u, str) and u and isinstance(rev, str) and rev and isinstance(desc, str)):
            return None, "invalid_response"
        node = None
        parts = u.split(":")
        if len(parts) == 5 and parts[:2] == ["urn", "skill"]:
            node = parts[3]
        out.append({"urn": u, "description": desc, "revision": rev, "node": node, "score": n - i})
    return out, None


def _classify_remote(result: "_RemoteSearchResult"):
    """-> (cards_or_None, degradation_reason_or_None, raw_body_or_None). Maps the failure classes
    required by Deliverable 2 (`timeout`/`connection`/`http_4xx`/`http_5xx`/`invalid_response`/
    `auth`) onto whatever the background thread observed."""
    if result.error:
        return None, result.error, result.body
    status, body = result.status, result.body
    if status is None or body is None:
        return None, "invalid_response", body
    if status == 200:
        cards, err = _cards_from_service_response(body)
        return (cards, None, body) if cards is not None else (None, err, body)
    if status in (401, 403):
        return None, "auth", body
    if 400 <= status < 500:
        return None, "http_4xx", body
    return None, "http_5xx", body


def _local_selected(router: "Router", query: str, node: str, k: int, include_deprecated: bool = False):
    """The exact three public Router calls route() itself makes (candidates -> score ->
    policy_filter -> select), just returning `scored` alongside `selected` so callers can build
    telemetry without ranking twice. Touches nothing inside Router (E2.6 constraint: no change to
    ranking or select()); `query=query` is threaded through exactly as route() does (E7.3 composer,
    PR #59 -- select()'s compose_mode stage needs the raw query for its coverage-fill signal, and
    this keeps the local path behaviourally identical to route() regardless of compose_mode)."""
    cands = router.candidates(query, node, include_deprecated=include_deprecated)
    scored = router.score(cands, query, node)
    admissible, _ = router.policy_filter(node, query, include_deprecated)
    selected = router.select(scored, k=k, admissible=set(admissible), query=query)
    return selected, scored


def _selected_set_hash(selected: list) -> str:
    """E2.9 parity counter: a stable hash of the ordered URN list only -- never the query text,
    never card bodies (non-negotiable: no prompt/token text in the spool)."""
    import hashlib
    key = "|".join(c["urn"] for c in selected)
    return hashlib.sha256(key.encode("utf-8")).hexdigest()[:16]


def search_with_backend(root: Path, router: "Router", query: str, node: str, *, profile: str,
                         k: int, search_id: str, include_deprecated: bool = False,
                         search_cfg: dict = None):
    """The one place `find`/`hook` ask "what should I show for this query" once `search.backend`
    can be `service`. Always computes the local sparse answer (it is the fallback, and the only
    answer when `backend: local`); when `backend: service`, races a POST /v1/search in a daemon
    thread against ONE monotonic absolute deadline while the local computation runs on this same
    (calling) thread -- the local computation is genuinely concurrent with the network wait
    because the socket read releases the GIL, not because it runs on its own thread, so no
    Router code needs to run off the main thread. `deadline_ms` therefore covers the whole call;
    only the *remaining* budget after the (measured) local computation is left to wait for the
    remote. The remote result replaces the local one only if it validates and arrives before the
    deadline; otherwise the socket is abandoned (never joined) and the local result stands
    (ADR-0023 Sec3). `backend: local` opens no socket at all: the whole service branch below is
    skipped and `http.client`/`threading` for a connection are never imported.

    Returns {"selected": list, "backend": "online_sparse"|"local_sparse"|"none",
    "degradation_reason": str|None, "local_selected": list, "local_scored": list,
    "remote_body": dict|None, "parity_mismatch": bool}. Emits `telemetry_health.parity_mismatch`
    itself (Deliverable 4) when both sides finished in time and disagree -- silent on agreement."""
    import time
    if search_cfg is None:
        search_cfg = resolve_search_config(None, profile=profile)
    degradation_reason = "config" if search_cfg.get("config_error") else None
    remote_thread = None
    remote_result = None
    # Contract v1.1 can only ever express a SUBSET of what a local caller can ask for (E2.9
    # fixture audit, 2026-09-05, cross-checked against the service worktree's independent
    # MERIDIAN-GRAPH-PARITY-2026-09-05.md finding of the same client defect):
    #   - `budget.max_cards` is 0..4. Omitted entirely (as this call used to send it), the Go/
    #     ParadeDB service applies its OWN default of 4 -- silently disagreeing with whatever local
    #     `k` actually is (hook's k=3, find's default k=8, any --limit). The client MUST send it
    #     whenever k is in range, so both sides target the same budget.
    #   - There is no field at all for include_deprecated, and the service unconditionally excludes
    #     deprecated cards with no override on that side either.
    # Whenever the caller's actual local request falls outside what the wire format can carry --
    # k>4 (or k<0), or include_deprecated=True -- a remote reply can never be a correct answer to
    # what was actually asked, regardless of ranking correctness. Racing it anyway would silently
    # replace a local answer that DOES honour the request with one that structurally cannot, with
    # nothing downstream showing the discrepancy. Treat it exactly like any other backend the
    # service cannot satisfy: never open the socket, fall back to local with a visible reason.
    budget_representable = 0 <= k <= 4
    if (include_deprecated or not budget_representable) and search_cfg["backend"] == "service":
        degradation_reason = degradation_reason or "config"
    elif search_cfg["backend"] == "service":
        import threading
        remote_result = _RemoteSearchResult()
        try:
            scheme, host, port, prefix = _parse_search_url(search_cfg["url"])
            payload = {"schema_version": "1.1", "query": query, "node": node, "profile": profile,
                       "deadline_ms": search_cfg["deadline_ms"], "request_id": search_id,
                       "budget": {"max_cards": k}}
            timeout_s = search_cfg["deadline_ms"] / 1000.0
            # Leave a small handoff margin for the worker to publish its transport error before
            # the caller's monotonic deadline expires.  Without it, a platform that reports an
            # unreachable local port as a kernel-level connect timeout can race the deadline and
            # get mislabeled as the caller abandoning a slow response.
            transport_timeout_s = max(timeout_s - min(0.05, timeout_s * 0.25), 0.001)
            remote_thread = threading.Thread(
                target=_remote_call,
                args=(scheme, host, port, prefix + "/v1/search", search_cfg["token"], payload,
                      transport_timeout_s, remote_result),
                daemon=True)
            remote_thread.start()
        except Exception:
            degradation_reason, remote_thread = "config", None
    t0 = time.monotonic()
    deadline_at = t0 + search_cfg["deadline_ms"] / 1000.0
    local_failed = False
    try:
        local_selected, local_scored = _local_selected(router, query, node, k, include_deprecated)
    except Exception:
        local_selected, local_scored, local_failed = [], [], True
    backend_used = "none" if local_failed else "local_sparse"
    final_selected = local_selected
    remote_body = None
    parity_mismatch = False
    if remote_thread is not None:
        remaining = deadline_at - time.monotonic()
        if remaining > 0 and remote_result.done.wait(remaining):
            cards, reason, body = _classify_remote(remote_result)
            remote_body = body
            if cards is not None:
                backend_used, degradation_reason = "online_sparse", None
                final_selected = cards
                if not local_failed:
                    parity_mismatch = _selected_set_hash(local_selected) != _selected_set_hash(cards)
                    if parity_mismatch:
                        _emit_telemetry(root, "telemetry_health.parity_mismatch", {
                            "search_id": search_id, "local_hash": _selected_set_hash(local_selected),
                            "remote_hash": _selected_set_hash(cards),
                        })
            else:
                degradation_reason = reason
        else:
            degradation_reason = degradation_reason or "timeout"
            _abandon_remote(remote_result)
        # remote_result / remote_thread are never consulted again past this point, and the
        # thread is never joined -- a late reply after this is simply ignored (ADR-0023 Sec3).
    return {"selected": final_selected, "backend": backend_used, "degradation_reason": degradation_reason,
            "local_selected": local_selected, "local_scored": local_scored,
            "remote_body": remote_body, "parity_mismatch": parity_mismatch}

def cmd_where(a, root, cfg):
    node = node_for(cfg, rel(root, Path.cwd()))
    print(json.dumps({"node": node, "owner": cfg["nodes"][node].get("owner"),
                      "ancestors": ancestors(node)}, indent=2))

def cmd_find(a, root, cfg):
    import time
    idx = Index.build(root, cfg)
    router = Router(idx)
    scope = a.scope or node_for(cfg, rel(root, Path.cwd()))
    search_id = _new_id()
    index_snapshot = _git_head_short(root)   # E6.4: the client has no per-skill revision from the
    # in-memory Index/Router (only Registry.download resolves one, and that would mean a network
    # call per candidate on every `find` -- not acceptable here either). The whole-snapshot git sha
    # stands in for every card's "exact revision" in this event, exactly as LocalRegistry.
    # default_revision() already does for the real load path below -- except for cards that come
    # back from `search.backend: service`, which carry their own exact per-card revision (E2.6).
    search_cfg = resolve_search_config(cfg, profile="interactive")
    forced = getattr(a, "search_backend", None)
    if forced:
        search_cfg = dict(search_cfg, backend=forced, config_error=False)
        if forced == "service" and not search_cfg.get("url"):
            # explicitly asked for the service backend but nothing is configured to reach --
            # this really is a config problem, not ordinary local operation.
            search_cfg["backend"], search_cfg["config_error"] = "local", True
    deadline_ms = search_cfg["deadline_ms"]
    _emit_telemetry(root, "search_requested", {
        "search_id": search_id, "profile": "interactive", "scope": scope, "deadline_ms": deadline_ms,
        "query_hmac": _query_hmac(a.task, root), "router_version": ROUTER_VERSION,
        "policy_version": POLICY_VERSION, "index_snapshot": index_snapshot,
        "backend": "online_sparse" if search_cfg["backend"] == "service" else "local_sparse",   # attempted, not outcome
    })
    t0 = time.perf_counter()
    result = search_with_backend(root, router, a.task, scope, profile="interactive", k=a.limit,
                                  search_id=search_id, include_deprecated=a.include_deprecated,
                                  search_cfg=search_cfg)
    t_select = time.perf_counter()
    selected = result["selected"]
    # `select()` returns the *injection* order (general -> specific, ADR-0006) so that a hook's
    # ≤ 4 cards read root-most first. `find` is the interactive command a person or an agent reads
    # top-down to pick ONE skill, so it prints the same set in *relevance* order: the card that best
    # matches the task first, root-level conventions last. Same membership, different order — the
    # hook path is untouched. (Before this, the exact match sat 7th of 8 behind four root cards.)
    for c in sorted(selected, key=lambda c: (-c["score"], c["urn"])):
        print(f"- {c['urn']}\n    {c['description'][:160]}\n    (score={c['score']} · node={c.get('node')})")
    if getattr(a, "experimental", False):
        _write_shadow_record(root, a.task, scope, result["local_scored"],
                              telemetry_raw=getattr(a, "telemetry_raw", False))
    _emit_telemetry(root, "search_results", {
        "search_id": search_id, "status": "ok" if selected else "abstained",
        "fallback_reason": result["degradation_reason"], "backend": result["backend"],
        "results": [{"urn": c["urn"], "revision": c.get("revision") or index_snapshot,
                     "score": c["score"], "rank": i} for i, c in enumerate(selected, start=1)],
        "timings": {"total_ms": round((t_select - t0) * 1000, 3)},
    })
    exposed = []
    for position, c in enumerate(selected, start=1):
        exposure_id = _new_id()
        exposed.append((c["urn"], c.get("revision") or index_snapshot, exposure_id))
        _emit_telemetry(root, "card_injected", {
            "exposure_id": exposure_id, "search_id": search_id, "skill_id": c["urn"],
            "revision": c.get("revision") or index_snapshot, "position": position, "surface": "interactive",
            "delivery_evidence": "printed_stdout", "scope": scope,   # extra, non-required field:
            # scope is already known here (same value as search_requested's), so
            # tools/telemetry/report.py's distinct_scopes rollup has something real to read.
        })
    _remember_exposures(root, search_id, exposed, _telemetry_ids_from_env().get("session_id"))

# ---------------------------------------------------------- E1.6 shadow telemetry
# `find --experimental` never changes the printed answer (see cmd_find above): it only writes a
# record of what a reranker *would* see, so tools/bakeoff/rerank_shadow.py can score it offline
# (tier 2, torch allowed) and tools/bakeoff/arms.py's B6 bake-off row can be compared against real
# traffic later. Writing this record must never fail or slow down `find` in a way the user can
# see, so every line below this comment runs inside one try/except in _write_shadow_record, and a
# failure here is silent by design (ADR-0020: the shipped CLI stays stdlib-only and this whole
# path is stdlib -- json/hashlib/uuid/datetime -- so there is nothing here that *should* fail, but
# "should" is not a guarantee, and a telemetry bug must never become an outage for `find`).
#
# The query is stored as a SHA-256 hash, not the raw text, by default: prompts routed through
# `find --experimental` can contain proprietary detail (customer names, incident specifics,
# unreleased feature names), and a telemetry file that quietly accumulates that detail on disk is
# exactly the kind of thing that is never noticed until someone greps it by accident. Pass
# --telemetry-raw to opt into keeping the raw query text as well (needed if you actually want
# tools/bakeoff/rerank_shadow.py to score this record later -- see that file's docstring: a
# reranker needs the real query string, a hash cannot be un-hashed).
def _utc_now_iso() -> str:
    return datetime.datetime.now(datetime.timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")

def _shadow_telemetry_path(root: Path) -> Path:
    date = datetime.datetime.now(datetime.timezone.utc).strftime("%Y-%m-%d")
    return root / ".guidefold" / "telemetry" / f"shadow-{date}.jsonl"

def _write_shadow_record(root: Path, query: str, node: str, scored: list, telemetry_raw: bool = False):
    try:
        import hashlib, uuid
        record = {
            "type": "shadow_request",
            "request_id": str(uuid.uuid4()),
            "ts": _utc_now_iso(),
            "cli_version": CLI_VERSION,
            "index_sha": _git_head_short(root),
            "node": node,
            "query_sha256": hashlib.sha256(query.encode("utf-8")).hexdigest(),
            # retrieval order (Router.score, score desc / urn tie-break) -- NOT injection order
            # (Router.select reorders general -> specific for the agent to read; see
            # docs/reports/golden/README.md, "The Router has two orderings"). A reranker judges
            # relevance, so it must see the same order the ranking metrics are read from.
            "top20": [{"urn": c["urn"], "score": c["score"]} for c in scored[:20]],
        }
        if telemetry_raw:
            record["query"] = query
        path = _shadow_telemetry_path(root)
        path.parent.mkdir(parents=True, exist_ok=True)
        with path.open("a", encoding="utf-8") as f:
            f.write(json.dumps(record, sort_keys=True) + "\n")
    except Exception:
        pass  # telemetry must never fail or block `find` (see comment above)

# ---------------------------------------------------------- E6.4/E2.7 SEARCH/USE telemetry
# docs/SEARCH-USE-TELEMETRY.md is normative (Sec3 event vocabulary, Sec4 IDs/grain, Sec5 data
# boundaries). This block emits the client-observable event vocabulary -- search_requested,
# search_results, card_injected, skill_load_requested, skill_load_completed, telemetry_health --
# from `find`, `hook` and `load` into a bounded local JSONL spool; `guidefold telemetry flush`
# uploads it later, and never from the hook path itself (no network call happens anywhere in this
# block). This is a separate, contract-shaped pipeline from the E1.6 shadow writer just above --
# that one is for offline reranker scoring; this one is for the SEARCH/USE ledger (tools/telemetry
# /ledger.py) and per-skill usage reports (tools/telemetry/report.py). Do not conflate them.
#
# Same rule as the shadow writer: a telemetry bug must never break or slow the command it
# instruments, so every public entry point here writes inside one try/except and a failure is
# silent by design.
#
# No raw prompt text is ever spooled here (Sec5 "Raw prompts ... are not saved by default, ...
# including ... telemetry spools"; the non-negotiable for this work is the same: prompt text stays
# out of the spool by default). The existing --telemetry-raw opt-in only ever affects the E1.6
# shadow file above -- it is deliberately NOT wired into this spool, because docs/SEARCH-USE-
# TELEMETRY.md's search_requested schema has no raw-query field at all, only an "optional query
# HMAC" (Sec3/Sec4); adding a raw-text field here would both contradict the contract's schema and
# widen what "stays out of the spool by default" actually means. Instead this spool always tries a
# tenant-scoped keyed HMAC of the query text for grouping repeated queries without storing them --
# never a plain hash (Sec5 explicitly deprecates "plain prompt hashes" as not applying here).

TELEMETRY_PRODUCER = "guidefold-cli"
TELEMETRY_SPOOL_MAX_BYTES = 10 * 1024 * 1024   # Sec5 proposed default
TELEMETRY_SPOOL_MAX_AGE_DAYS = 7                # Sec5 proposed default
TELEMETRY_FLUSH_BATCH_MAX = 500                 # events per POST /v1/events:batch
# This adapter cannot observe harness receipt or invocation (no such API from any supported
# harness today) -- only that it printed/wrote something. Recorded so a later analysis pass never
# mistakes "we emitted a card" for "the harness rendered it" or "the agent invoked the skill"
# (Sec3: exposure is not confirmed attention; only supported adapters emit skill_use_observed).
TELEMETRY_CAPABILITY_FLAGS = ["observation:none", "delivery_evidence:printed_stdout"]

def _telemetry_disabled() -> bool:
    return os.environ.get("GUIDEFOLD_TELEMETRY_DISABLE", "").strip() not in ("", "0")

def _telemetry_environment() -> str:
    env = os.environ.get("GUIDEFOLD_TELEMETRY_ENVIRONMENT", "dev")
    return env if env in ("dev", "eval", "pilot") else "dev"

def _telemetry_tenant() -> str:
    return os.environ.get("GUIDEFOLD_TELEMETRY_TENANT") or "local"

def _telemetry_ids_from_env() -> dict:
    """session_id/task_id/correlation_id "where available" (Sec4): this bare CLI has no session/
    task concept of its own, so these come only from a caller-supplied environment (a harness
    wrapper, CI job, or a future service adapter) -- or, for `hook`, from the harness's own stdin
    payload (see cmd_hook, which overrides session_id from there when present). Absent means
    genuinely unknown, never fabricated."""
    return {
        "session_id": os.environ.get("GUIDEFOLD_SESSION_ID") or None,
        "task_id": os.environ.get("GUIDEFOLD_TASK_ID") or None,
        "correlation_id": os.environ.get("GUIDEFOLD_CORRELATION_ID") or None,
    }

def _new_id() -> str:
    import uuid
    return str(uuid.uuid4())

_TELEMETRY_SEQUENCE = [0]   # per-process client sequence (Sec4) -- a same-process ordering hint
                            # only, not a durable global counter; the ledger orders by occurred_at.

def _next_sequence() -> int:
    _TELEMETRY_SEQUENCE[0] += 1
    return _TELEMETRY_SEQUENCE[0]

def _telemetry_spool_dir(root: Path, tenant: str, env: str) -> Path:
    return root / ".guidefold" / "telemetry" / "spool" / tenant / env

def _telemetry_spool_path(root: Path, tenant: str, env: str) -> Path:
    date = datetime.datetime.now(datetime.timezone.utc).strftime("%Y-%m-%d")
    return _telemetry_spool_dir(root, tenant, env) / f"events-{date}.jsonl"

# Contract 1.1.4: link a `load` back to the SEARCH that exposed the card. `find`/`hook` and `load`
# are separate processes, so the only thing that can carry the search_id across is a small local
# file of recent exposures. It holds ids and timestamps only -- never the query, never a body --
# is bounded, and is best-effort: a miss just leaves `search_id` null as before (unknown, not 0).
RECENT_EXPOSURES_MAX = 64
RECENT_EXPOSURES_TTL_S = 3600

def _recent_exposures_path(root: Path) -> Path:
    return root / ".guidefold" / "telemetry" / "recent-exposures.json"

def _remember_exposures(root: Path, search_id: str, cards: list, session_id: str = None):
    """`cards` is a list of (skill_id, revision, exposure_id). Newest last; capped and never raises."""
    if _telemetry_disabled():
        return
    try:
        path = _recent_exposures_path(root)
        now = time.time()
        entries = []
        if path.exists():
            try:
                entries = [e for e in json.loads(path.read_text(encoding="utf-8"))
                           if isinstance(e, dict) and now - float(e.get("at", 0)) <= RECENT_EXPOSURES_TTL_S]
            except Exception:
                entries = []
        for skill_id, revision, exposure_id in cards:
            entries.append({"skill_id": skill_id, "revision": revision, "exposure_id": exposure_id,
                            "search_id": search_id, "session_id": session_id, "at": now})
        entries = entries[-RECENT_EXPOSURES_MAX:]
        path.parent.mkdir(parents=True, exist_ok=True)
        tmp = path.with_suffix(".json.tmp")
        tmp.write_text(json.dumps(entries), encoding="utf-8")
        os.replace(tmp, path)
    except Exception:
        pass

def _recall_exposure_search(root: Path, skill_id: str, session_id: str = None):
    """The search_id of the most recent, unexpired exposure of `skill_id`, or None. A session id
    known on both sides and different is not a link: another session's card is not this one's."""
    if _telemetry_disabled():
        return None
    try:
        path = _recent_exposures_path(root)
        if not path.exists():
            return None
        now = time.time()
        for e in reversed(json.loads(path.read_text(encoding="utf-8"))):
            if not isinstance(e, dict) or e.get("skill_id") != skill_id:
                continue
            if now - float(e.get("at", 0)) > RECENT_EXPOSURES_TTL_S:
                continue
            theirs = e.get("session_id")
            if session_id and theirs and theirs != session_id:
                continue
            return e.get("search_id") or None
    except Exception:
        return None
    return None

def _telemetry_hmac_key(root: Path) -> bytes:
    """Tenant-scoped keyed HMAC key (Sec5: "a tenant-scoped keyed HMAC, never an unkeyed prompt
    hash"; "rotate monthly"). Lives under .guidefold/telemetry/ (gitignored, generated) and never
    leaves this host -- it exists only so the *same* query hashes to the *same* value within one
    month, for grouping, without the plaintext ever being stored."""
    import secrets
    month = datetime.datetime.now(datetime.timezone.utc).strftime("%Y-%m")
    key_path = root / ".guidefold" / "telemetry" / f"hmac-key-{month}.bin"
    if key_path.exists():
        return key_path.read_bytes()
    key_path.parent.mkdir(parents=True, exist_ok=True)
    key = secrets.token_bytes(32)
    key_path.write_bytes(key)
    return key

def _query_hmac(query: str, root: Path):
    """Returns None (never raises) if a stable monthly key can't be read/created -- query grouping
    then just degrades to "ungrouped" for this event rather than blocking it."""
    try:
        import hashlib, hmac
        key = _telemetry_hmac_key(root)
        return hmac.new(key, query.encode("utf-8"), hashlib.sha256).hexdigest()
    except Exception:
        return None

def _health_path(env_dir: Path) -> Path:
    return env_dir / ".health.json"

def _read_health(path: Path) -> dict:
    try:
        return json.loads(path.read_text(encoding="utf-8"))
    except Exception:
        return {"produced": 0, "acknowledged": 0, "dropped": 0}

def _write_health(path: Path, health: dict):
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text(json.dumps(health, sort_keys=True), encoding="utf-8")

def _oldest_queued_age_s(env_dir: Path):
    """Age in seconds of the oldest event line still sitting in this partition's spool, or None if
    the spool is empty right now -- a genuine "unknown", not a stand-in for zero."""
    oldest_ts = None
    for f in sorted(env_dir.glob("events-*.jsonl")):
        for l in f.read_text(encoding="utf-8").splitlines():
            if not l.strip():
                continue
            try:
                oldest_ts = json.loads(l).get("occurred_at")
            except Exception:
                oldest_ts = None
            break
        if oldest_ts:
            break
    if not oldest_ts:
        return None
    try:
        parsed = datetime.datetime.strptime(oldest_ts, "%Y-%m-%dT%H:%M:%SZ").replace(tzinfo=datetime.timezone.utc)
    except ValueError:
        return None
    return (datetime.datetime.now(datetime.timezone.utc) - parsed).total_seconds()

def _telemetry_health_event(env_dir: Path, env: str, health: dict, window_start: str) -> dict:
    oldest_age_s = _oldest_queued_age_s(env_dir)
    return {
        "schema_version": TELEMETRY_SCHEMA_VERSION, "event_id": _new_id(),
        "event_type": "telemetry_health", "occurred_at": _utc_now_iso(),
        "sequence": _next_sequence(), "producer": TELEMETRY_PRODUCER,
        "adapter_version": CLI_VERSION, "environment": env,
        "session_id": None, "task_id": None, "correlation_id": None,
        "produced": health.get("produced", 0), "acknowledged": health.get("acknowledged", 0),
        "dropped": health.get("dropped", 0), "oldest_queued_age_s": oldest_age_s,
        "capability_flags": list(TELEMETRY_CAPABILITY_FLAGS),
        "window": {"start": window_start, "end": _utc_now_iso()},
    }

def _prune_and_append(root: Path, tenant: str, env: str, record: dict):
    """Append-only JSONL write, bounded by TELEMETRY_SPOOL_MAX_AGE_DAYS (whole stale files dropped)
    and then TELEMETRY_SPOOL_MAX_BYTES (oldest lines of the oldest remaining file dropped) -- both
    counted into the partition's persisted `dropped` counter (Sec5 "Eviction/drop reasons
    increment health counters"; events are never silently lost without a visible counter). When a
    drop actually happens, one telemetry_health event is appended too, straight after -- written
    directly (not through this same function) to avoid re-entering the bound check on ourselves."""
    env_dir = _telemetry_spool_dir(root, tenant, env)
    env_dir.mkdir(parents=True, exist_ok=True)
    health_path = _health_path(env_dir)
    health = _read_health(health_path)
    if health.get("produced", 0) == 0:
        health["window_start"] = record["occurred_at"]
    health["produced"] = health.get("produced", 0) + 1
    dropped_before = health.get("dropped", 0)

    cutoff = datetime.datetime.now(datetime.timezone.utc) - datetime.timedelta(days=TELEMETRY_SPOOL_MAX_AGE_DAYS)
    for f in sorted(env_dir.glob("events-*.jsonl")):
        date_part = f.stem[len("events-"):]
        try:
            file_date = datetime.datetime.strptime(date_part, "%Y-%m-%d").replace(tzinfo=datetime.timezone.utc)
        except ValueError:
            continue
        if file_date < cutoff:
            lines = [l for l in f.read_text(encoding="utf-8").splitlines() if l.strip()]
            health["dropped"] = health.get("dropped", 0) + len(lines)
            f.unlink()

    path = _telemetry_spool_path(root, tenant, env)
    with path.open("a", encoding="utf-8") as fh:
        fh.write(json.dumps(record, sort_keys=True) + "\n")

    files = sorted(env_dir.glob("events-*.jsonl"))
    total_bytes = sum(f.stat().st_size for f in files)
    i = 0
    while total_bytes > TELEMETRY_SPOOL_MAX_BYTES and i < len(files):
        f = files[i]
        lines = [l for l in f.read_text(encoding="utf-8").splitlines() if l.strip()]
        if not lines:
            i += 1
            continue
        dropped_here = min(len(lines), max(1, len(lines) // 2))
        remaining = lines[dropped_here:]
        health["dropped"] = health.get("dropped", 0) + dropped_here
        before_size = f.stat().st_size
        if remaining:
            f.write_text("\n".join(remaining) + "\n", encoding="utf-8")
        else:
            f.unlink()
        after_size = f.stat().st_size if f.exists() else 0
        total_bytes -= (before_size - after_size)
        if not remaining:
            i += 1

    _write_health(health_path, health)
    if health.get("dropped", 0) > dropped_before:
        window_start = health.get("window_start") or record["occurred_at"]
        health_event = _telemetry_health_event(env_dir, env, health, window_start)
        with path.open("a", encoding="utf-8") as fh:
            fh.write(json.dumps(health_event, sort_keys=True) + "\n")

def _emit_telemetry(root: Path, event_type: str, fields: dict, ids: dict = None):
    """Append one event to the bounded local spool. Never raises. `ids`, if given, overrides the
    environment-derived session/task/correlation IDs (e.g. cmd_hook passing session_id read from
    its own stdin payload)."""
    if _telemetry_disabled():
        return
    try:
        tenant = _telemetry_tenant()
        env = _telemetry_environment()
        resolved_ids = dict(_telemetry_ids_from_env())
        if ids:
            resolved_ids.update({k: v for k, v in ids.items() if v is not None})
        record = {
            "schema_version": TELEMETRY_SCHEMA_VERSION, "event_id": _new_id(),
            "event_type": event_type, "occurred_at": _utc_now_iso(),
            "sequence": _next_sequence(), "producer": TELEMETRY_PRODUCER,
            "adapter_version": CLI_VERSION, "environment": env,
            "session_id": resolved_ids.get("session_id"), "task_id": resolved_ids.get("task_id"),
            "correlation_id": resolved_ids.get("correlation_id"),
        }
        record.update(fields)
        _prune_and_append(root, tenant, env, record)
    except Exception:
        pass  # telemetry must never fail or block the command it instruments (see block docstring)

def _use_via_service(search_cfg: dict, skill_id: str, revision: str,
                     delivery_policy: str = "legacy"):
    """Blocking POST /v1/use -- no local race/fallback exists for USE (unlike SEARCH, ADR-0023
    Sec3): an exact urn@revision either hydrates from the configured service or it doesn't. The
    legacy path sends contract 1.1 unchanged. ``proof_gated`` opts into contract 1.2 and returns
    ``"ask"`` as the reason when the service deliberately abstains; that is a valid response,
    not a transport failure, and the caller must never cache its body."""
    import threading
    result = _RemoteSearchResult()
    try:
        scheme, host, port, prefix = _parse_search_url(search_cfg["url"])
    except Exception:
        return None, "config"
    if delivery_policy not in ("legacy", "proof_gated"):
        return None, "config"
    proof_gated = delivery_policy == "proof_gated"
    payload = {"schema_version": "1.2" if proof_gated else "1.1",
               "skill_id": skill_id, "revision": revision,
               "deadline_ms": search_cfg["deadline_ms"], "request_id": _new_id()}
    if proof_gated:
        payload["delivery_policy"] = "proof_gated"
    timeout_s = search_cfg["deadline_ms"] / 1000.0
    t = threading.Thread(target=_remote_call,
                          args=(scheme, host, port, prefix + "/v1/use", search_cfg["token"],
                                payload, timeout_s, result),
                          daemon=True)
    t.start()
    if not result.done.wait(timeout_s + 0.5):   # small grace beyond the socket's own timeout
        _abandon_remote(result)
        return None, "timeout"
    if result.error:
        return None, result.error
    status, body = result.status, result.body
    if status is None or body is None:
        return None, "invalid_response"
    if status == 200:
        expected_schema = "1.2" if proof_gated else "1.1"
        if not (isinstance(body, dict) and body.get("schema_version") == expected_schema
                and isinstance(body.get("body"), str) and isinstance(body.get("checksum"), str)
                and body.get("skill_id") == skill_id and body.get("revision") == revision):
            return None, "invalid_response"
        if proof_gated:
            delivery = body.get("delivery")
            if not isinstance(delivery, dict) or delivery.get("action") not in ("LOAD", "ASK"):
                return None, "invalid_response"
            proof_reasons = {
                "source_proof_complete", "proof_missing", "proof_schema_invalid",
                "proof_identity_mismatch", "proof_snapshot_mismatch", "proof_revision_mismatch",
                "proof_body_hash_mismatch", "proof_scope_incomplete", "proof_claim_incomplete",
                "proof_conflict", "closure_incomplete", "proof_source_ref_invalid",
                "proof_recursive_invalid",
                "proof_source_unavailable", "proof_source_hash_mismatch", "proof_source_line_range",
            }
            action, reason = delivery.get("action"), delivery.get("reason")
            if reason not in proof_reasons or not isinstance(delivery.get("missing"), list) or len(delivery["missing"]) > 32 or not isinstance(delivery.get("provenance"), dict):
                return None, "invalid_response"
            if action == "LOAD" and reason != "source_proof_complete":
                return None, "invalid_response"
            if action == "ASK" and reason == "source_proof_complete":
                return None, "invalid_response"
            for item in delivery["missing"]:
                if (not isinstance(item, dict) or not isinstance(item.get("requirement"), str)
                        or not item["requirement"].strip() or len(item["requirement"]) > 128
                        or not isinstance(item.get("reason"), str) or not item["reason"].strip()
                        or len(item["reason"]) > 256):
                    return None, "invalid_response"
            # ASK is fail-closed at the wire boundary too. A server that labels a response ASK
            # while returning bytes is not a safe proof-gated peer.
            if action == "ASK" and (body.get("body") != "" or body.get("status") != "ask"):
                return None, "invalid_response"
            if action == "LOAD" and body.get("status") != "hydrated":
                return None, "invalid_response"
            return body, "ask" if action == "ASK" else None
        return body, None
    if status in (401, 403):
        return None, "auth"
    if 400 <= status < 500:
        return None, "http_4xx"
    return None, "http_5xx"


def _download_service_resource(search_cfg: dict, resource: dict):
    """Fetch one 1.2 package resource and verify its content address.

    Resource URLs are service-issued relative paths. The client never follows a
    host supplied by the response, and it checks both the declared digest and
    the optional response digest before a caller can write bytes to the cache.
    """
    import http.client
    import urllib.parse
    try:
        url = resource.get("url")
        expected = resource.get("sha256")
        size = resource.get("size")
        if (not isinstance(url, str) or not url.startswith("/") or "\x00" in url
                or not isinstance(expected, str) or not re.fullmatch(r"[0-9a-f]{64}", expected)
                or type(size) is not int or size < 0 or size > 64 * 1024 * 1024):
            return None, "invalid_response"
        parsed_url = urllib.parse.urlsplit(url)
        # USE is the only endpoint allowed to mint package URLs. Keep the
        # follow-up request on the resource route and reject query/fragment
        # tricks before attaching the configured service prefix or bearer.
        if (parsed_url.scheme or parsed_url.netloc or parsed_url.query or parsed_url.fragment
                or not parsed_url.path.startswith("/v1/skills/")
                or ".." in parsed_url.path.split("/")):
            return None, "invalid_response"
        scheme, host, port, prefix = _parse_search_url(search_cfg["url"])
        path = (prefix + parsed_url.path) if prefix else parsed_url.path
        if parsed_url.query:
            path += "?" + parsed_url.query
        conn_cls = http.client.HTTPSConnection if scheme == "https" else http.client.HTTPConnection
        conn = conn_cls(host, port, timeout=max(search_cfg["deadline_ms"] / 1000.0, 0.001))
        try:
            conn.connect()
            conn.request("GET", path, headers={"Authorization": "Bearer " + search_cfg["token"]})
            response = conn.getresponse()
            if response.status != 200:
                response.read(1024)
                return None, "http_4xx" if 400 <= response.status < 500 else "http_5xx"
            data = response.read(64 * 1024 * 1024 + 1)
            if len(data) > 64 * 1024 * 1024 or len(data) != size:
                return None, "resource_size_mismatch"
            if _sha256_bytes(data) != expected:
                return None, "resource_hash_mismatch"
            header_sha = response.getheader("X-Content-SHA256")
            if header_sha is not None and header_sha != expected:
                return None, "resource_hash_mismatch"
            return data, None
        finally:
            conn.close()
    except TimeoutError:
        return None, "timeout"
    except Exception:
        return None, "connection"


def _fetch_service_resources(search_cfg: dict, body: dict):
    """Download all resources from a validated 1.2 USE response before caching anything."""
    resources = body.get("resources")
    if resources is None:
        return [], None
    if not isinstance(resources, list) or len(resources) > 64:
        return None, "invalid_response"
    out = []
    seen_paths = set()
    for resource in resources:
        if not isinstance(resource, dict):
            return None, "invalid_response"
        rel = resource.get("path")
        if (not isinstance(resource.get("required"), bool)
                or not isinstance(rel, str) or not rel or rel.lower() == "skill.md" or rel.startswith("/") or "\\" in rel
                or "\x00" in rel or any(part in ("", ".", "..") for part in rel.split("/"))):
            return None, "invalid_response"
        if rel in seen_paths:
            return None, "invalid_response"
        seen_paths.add(rel)
        data, reason = _download_service_resource(search_cfg, resource)
        if data is None:
            return None, reason
        out.append((rel, data))
    return out, None

def cmd_load(a, root, cfg):
    # E6.4: skill_load_requested/skill_load_completed bracket the exact same operations this
    # function already performed -- default_revision() then a cache-hit check or download() -- the
    # SystemExit paths below are the same sys.exit(...) calls those two already raise; they are
    # caught only long enough to emit a failed-load event, then re-raised unchanged so the user-
    # visible exit code/message are untouched.
    load_id = _new_id()
    t0 = time.perf_counter()
    search_cfg = resolve_search_config(cfg, profile="interactive")
    delivery_policy = getattr(a, "delivery_policy", "legacy") or "legacy"
    if delivery_policy not in ("legacy", "proof_gated"):
        sys.exit(f"guidefold: unsupported delivery policy {delivery_policy!r}")
    if delivery_policy == "proof_gated" and search_cfg["backend"] != "service":
        sys.exit("guidefold: --delivery-policy proof_gated requires search.backend: service; "
                 "the local backend has no source-proof gate")
    # Contract 1.1.4: the search that exposed this skill's card, if a recent `find`/`hook` in this
    # root did (and, when both sides know a session, the same one). None is "unknown", as before.
    linked_search = _recall_exposure_search(root, a.urn.partition("@")[0],
                                            _telemetry_ids_from_env().get("session_id"))
    link = {"search_id": linked_search} if linked_search else {}   # optional, additive on completed
    if search_cfg["backend"] == "service":
        # E2.6 Deliverable 6: load via /v1/use needs an EXACT urn@revision -- there is no default-
        # revision concept on the service side equivalent to Registry.default_revision() (that is
        # a gcloud Agent Registry revision id, a different revisioning system entirely). The
        # revision normally comes from a card a prior `find --backend service` printed.
        urn_part, sep, revision_part = a.urn.partition("@")
        if not sep or not revision_part:
            sys.exit(f"guidefold: search.backend: service requires an exact revision -- "
                      f"pass `load {a.urn}@<revision>` (see a prior `find`'s printed revision)")
        _emit_telemetry(root, "skill_load_requested", {
            "load_id": load_id, "skill_id": urn_part, "revision": revision_part, "source": "service",
            "use_id": None, "search_id": linked_search,
        })
        body, reason = _use_via_service(search_cfg, urn_part, revision_part, delivery_policy)
        if body is None:
            _emit_telemetry(root, "skill_load_completed", {
                "load_id": load_id, "status": "error", "cache_source": None, "bytes": 0,
                "duration_ms": round((time.perf_counter() - t0) * 1000, 3),
                "closure_status": "incomplete", "skill_id": urn_part, "revision": revision_part, **link,
            })
            sys.exit(f"guidefold: service USE failed ({reason}) for {a.urn}")
        if delivery_policy == "proof_gated" and reason == "ask":
            delivery = body.get("delivery") if isinstance(body, dict) else {}
            missing = delivery.get("missing") if isinstance(delivery, dict) else []
            requirements = []
            if isinstance(missing, list):
                for item in missing[:8]:
                    if isinstance(item, dict) and isinstance(item.get("requirement"), str):
                        requirements.append(item["requirement"])
            detail = ", ".join(requirements)
            if detail:
                detail = f"; missing: {detail}"
            _emit_telemetry(root, "skill_load_completed", {
                "load_id": load_id, "status": "denied", "cache_source": "service", "bytes": 0,
                "duration_ms": round((time.perf_counter() - t0) * 1000, 3),
                "closure_status": "unresolved", "skill_id": urn_part, "revision": revision_part, **link,
            })
            sys.exit(f"guidefold: service ASK for {a.urn} ({delivery.get('reason', 'proof_incomplete')}){detail}")
        import hashlib
        checksum_ok = hashlib.sha256(body["body"].encode("utf-8")).hexdigest() == body.get("checksum")
        if not checksum_ok:
            _emit_telemetry(root, "skill_load_completed", {
                "load_id": load_id, "status": "error", "cache_source": "service", "bytes": 0,
                "duration_ms": round((time.perf_counter() - t0) * 1000, 3),
                "closure_status": "incomplete", "skill_id": urn_part, "revision": revision_part, **link,
            })
            sys.exit(f"guidefold: checksum mismatch for {a.urn} -- refusing to use")
        resources, resource_reason = _fetch_service_resources(search_cfg, body)
        if resources is None:
            _emit_telemetry(root, "skill_load_completed", {
                "load_id": load_id, "status": "error", "cache_source": "service", "bytes": 0,
                "duration_ms": round((time.perf_counter() - t0) * 1000, 3),
                "closure_status": "incomplete", "skill_id": urn_part, "revision": revision_part, **link,
            })
            sys.exit(f"guidefold: service resource fetch failed ({resource_reason}) for {a.urn}")
        dest = skill_cache_dir(urn_part, revision_part)
        dest_root = dest.resolve()
        resource_targets = []
        for rel, data in resources:
            target = (dest / Path(*rel.split("/"))).resolve()
            if target != dest_root and dest_root not in target.parents:
                _emit_telemetry(root, "skill_load_completed", {
                    "load_id": load_id, "status": "error", "cache_source": "service", "bytes": 0,
                    "duration_ms": round((time.perf_counter() - t0) * 1000, 3),
                    "closure_status": "incomplete", "skill_id": urn_part, "revision": revision_part, **link,
                })
                sys.exit(f"guidefold: unsafe resource path {rel!r} -- refusing to use")
            resource_targets.append((target, data))
        # Validate every target before creating the directory or writing SKILL.md. A malformed
        # manifest must leave no half-populated revision in the cache.
        dest.mkdir(parents=True, exist_ok=True)
        (dest / "SKILL.md").write_text(body["body"], encoding="utf-8")
        for target, data in resource_targets:
            target.parent.mkdir(parents=True, exist_ok=True)
            target.write_bytes(data)
        bytes_loaded = len(body["body"].encode("utf-8")) + sum(len(data) for _, data in resources)
        _emit_telemetry(root, "skill_load_completed", {
            "load_id": load_id, "status": "ok", "cache_source": "service", "bytes": bytes_loaded,
            "duration_ms": round((time.perf_counter() - t0) * 1000, 3),
            "closure_status": "complete", "skill_id": urn_part, "revision": revision_part, **link,
        })
        evict_lru(cache_root() / "skills", depth=2,
                  cap=_cache_cap(cfg, "max_skill_revisions", DEFAULT_SKILLS_CACHE_CAP))
        print(dest / "SKILL.md")
        return
    reg = registry_for(cfg, root)
    try:
        rev = reg.default_revision(a.urn)
    except SystemExit:
        _emit_telemetry(root, "skill_load_requested", {
            "load_id": load_id, "skill_id": a.urn, "revision": None, "source": "explicit",
            "use_id": None, "search_id": linked_search,
        })
        _emit_telemetry(root, "skill_load_completed", {
            "load_id": load_id, "status": "error", "cache_source": None, "bytes": 0,
            "duration_ms": round((time.perf_counter() - t0) * 1000, 3),
            "closure_status": "incomplete", "skill_id": a.urn, "revision": None, **link,
        })
        raise
    _emit_telemetry(root, "skill_load_requested", {
        "load_id": load_id, "skill_id": a.urn, "revision": rev, "source": "explicit",
        "use_id": None, "search_id": linked_search,
    })
    dest = skill_cache_dir(a.urn, rev)
    cache_hit = (dest / "SKILL.md").exists()
    try:
        if cache_hit:
            os.utime(dest, None)   # cache hit: bump mtime so LRU eviction reflects last use
        else:
            reg.download(a.urn, dest, rev=rev)
    except SystemExit:
        _emit_telemetry(root, "skill_load_completed", {
            "load_id": load_id, "status": "error",
            "cache_source": "cache" if cache_hit else "download", "bytes": 0,
            "duration_ms": round((time.perf_counter() - t0) * 1000, 3),
            "closure_status": "incomplete", "skill_id": a.urn, "revision": rev, **link,
        })
        raise
    bytes_loaded = sum(f.stat().st_size for f in dest.rglob("*") if f.is_file())
    _emit_telemetry(root, "skill_load_completed", {
        "load_id": load_id, "status": "ok", "cache_source": "cache" if cache_hit else "download",
        "bytes": bytes_loaded, "duration_ms": round((time.perf_counter() - t0) * 1000, 3),
        "closure_status": "complete", "skill_id": a.urn, "revision": rev, **link,
    })
    evict_lru(cache_root() / "skills", depth=2, cap=_cache_cap(cfg, "max_skill_revisions", DEFAULT_SKILLS_CACHE_CAP))
    print(dest / "SKILL.md")

# ------------------------------------------------------------------ F5: trigger/negative-trigger
# suggestions for `validate --suggest` (docs/MVP.md "3-6 authoring loop"). Ported from
# tools/enrich/derive.py's deterministic extractor (section mining -> "when to use"/"do not use"
# material; sentence mining in unheaded prose) — stdlib only, no model path. Only the
# triggers/negative_triggers half of derive.py is ported: its `requires`/`similar` edge-mining
# (skill-to-skill mention detection) is out of scope for this command and is not reproduced here.
# Constants/regexes/functions below are named `_SUG_*`/`_sug_*` and are a deliberate, reviewable
# duplicate of tools/enrich/derive.py rather than an import of it — `scripts/guidefold` ships
# stdlib+PyYAML only inside the skill ZIP (see module docstring) and cannot depend on a sibling
# tools/ package at runtime. If derive.py's extraction rules change, this block must change with
# it in the same commit.
_SUG_TRIGGERS_CAP = 12
_SUG_NEGATIVE_TRIGGERS_CAP = 8
_SUG_MIN_PHRASE_TOKENS = 3
_SUG_MAX_PHRASE_TOKENS = 8
_SUG_NEG_BOILERPLATE_MIN_SKILLS = 15
_SUG_NEG_BOILERPLATE_FRACTION = 0.01

_SUG_STOPWORDS = frozenset(['a', 'about', 'above', 'again', 'all', 'also', 'an', 'and', 'another', 'any', 'are', 'as', 'at', 'be', 'been', 'being', 'below', 'but', 'by', 'can', 'did', 'do', 'does', 'down', 'each', 'every', 'for', 'from', 'here', 'how', 'i', 'if', 'in', 'into', 'is', 'it', 'its', 'just', 'may', 'me', 'might', 'mine', 'more', 'most', 'my', 'myself', 'no', 'nor', 'not', 'of', 'off', 'on', 'once', 'only', 'onto', 'or', 'other', 'our', 'out', 'over', 'own', 'per', 'same', 'shall', 'should', 'so', 'some', 'such', 'than', 'that', 'the', 'then', 'there', 'these', 'this', 'those', 'to', 'under', 'up', 'use', 'used', 'using', 'very', 'via', 'was', 'we', 'were', 'what', 'when', 'where', 'which', 'who', 'whom', 'why', 'will', 'with', 'would', 'you', 'your'])

_SUG_USAGE_HEADING_RE = re.compile('^(when\\s+to\\s+use|use\\s+this\\s+skill\\b|use\\s+cases?\\b|when\\s+to\\s+activate|trigger\\s+(phrases?|conditions?)\\b|how\\s+to\\s+(use|activate)\\s+this\\s+skill)', re.I)
_SUG_EXCLUSION_HEADING_RE = re.compile('^(do\\s*not\\s*use|don.t\\s*use|when\\s+not\\s+to\\s+(use|activate)|out\\s+of\\s+scope|not\\s+for\\b|avoid\\s+this\\s+skill|avoid\\s+(when|if))', re.I)
_SUG_USAGE_SENTENCE_RE = re.compile('\\buse\\s+(?:this\\s+skill\\s+|it\\s+)?(when|for|if)\\b', re.I)
_SUG_EXCLUSION_SENTENCE_RE = re.compile('\\b(do\\s*not\\s*use|don.t\\s*use|not\\s+for|avoid\\s+(when|if)|out\\s+of\\s+scope)\\b', re.I)
_SUG_HEADING_LINE_RE = re.compile('^(#{1,6})\\s*(.+?)\\s*$')
_SUG_BULLET_LINE_RE = re.compile('^\\s*(?:[-*•]|\\d+[.)])\\s+(.*)$')
_SUG_MD_LINK_RE = re.compile('\\[([^\\]]*)\\]\\([^)]*\\)')
_SUG_MD_CODE_RE = re.compile('`([^`]*)`')
_SUG_MD_EMPHASIS_RE = re.compile('[*_~>#]{1,3}')
_SUG_PAREN_RE = re.compile('\\([^)]*\\)')
_SUG_LEADING_NUMBERING_RE = re.compile('^\\d+[.)]\\s*')
_SUG_SENTENCE_SPLIT_RE = re.compile('(?<=[.!?])\\s+|\\n+')

def _sug_clean_markdown(text):
    text = _SUG_MD_LINK_RE.sub(r"\1", text)
    text = _SUG_MD_CODE_RE.sub(r"\1", text)
    text = _SUG_MD_EMPHASIS_RE.sub("", text)
    text = _SUG_BULLET_LINE_RE.sub(r"\1", text)
    return text.strip()

def _sug_normalize_heading(heading):
    h = _sug_clean_markdown(heading or "")
    h = _SUG_LEADING_NUMBERING_RE.sub("", h)
    return h.strip().rstrip(":").strip()

def _sug_split_sentences(text):
    text = _sug_clean_markdown(text or "")
    return [p.strip() for p in _SUG_SENTENCE_SPLIT_RE.split(text) if p.strip()]

def _sug_split_sections(body):
    """[(heading_or_None, [content_line, ...]), ...] — index 0 always has heading None (the
    content, if any, before the first markdown heading)."""
    sections = []
    cur_heading = None
    cur_lines = []
    for line in (body or "").splitlines():
        m = _SUG_HEADING_LINE_RE.match(line.strip())
        if m:
            sections.append((cur_heading, cur_lines))
            cur_heading = m.group(2).strip()
            cur_lines = []
        else:
            cur_lines.append(line)
    sections.append((cur_heading, cur_lines))
    return sections

def _sug_sections_with_description(body, description):
    sections = _sug_split_sections(body)
    lead = [description] if description else []
    sections[0] = (sections[0][0], lead + sections[0][1])
    return sections

def _sug_extract_items(content):
    """Bullet items if the section has bullets, else sentence-split paragraph text."""
    lines = [l for l in content.splitlines() if l.strip()]
    bullets = []
    for l in lines:
        m = _SUG_BULLET_LINE_RE.match(l)
        if m:
            bullets.append(_sug_clean_markdown(m.group(1)))
    if bullets:
        return bullets
    return _sug_split_sentences(content)

def _sug_cue_remainder(text, cue_re):
    """Text after the last word of the cue match to the end of the sentence — "Use when X" ->
    "X"; "Do NOT use for Y (Z)" -> "Y (Z)" (the parenthetical is stripped later, in
    `_sug_finalize_phrase`)."""
    m = cue_re.search(text)
    if not m:
        return ""
    return text[m.end():].strip(" \t-:—")

def _sug_finalize_phrase(raw, seen_tokenforms, min_content_tokens=1):
    """Clean, cap, dedupe-by-tokenized-form. Returns None if the phrase should be dropped.

    `min_content_tokens` (non-stopword tokens required) defaults to 1 for `triggers`, which only
    feed BM25F soft scoring. `negative_triggers` callers pass 2: the router's hard filter
    (`Router.policy_filter`) matches a negative trigger by unordered token-SET containment, not
    phrase or substring match, and has no length floor of its own — a phrase with only one
    non-stopword token plus common connectives is a real hard-drop hazard. Requiring 2
    independent content tokens makes an accidental full-set match far less likely."""
    raw = _SUG_PAREN_RE.sub("", raw or "")
    raw = raw.strip(" \t.,:;!-—")
    if not raw:
        return None
    raw = re.split(r"\s+or\s+|;", raw, maxsplit=1)[0].strip()
    toks = tokenize(raw)
    if len(toks) <= _SUG_MIN_PHRASE_TOKENS - 1:
        return None
    if sum(1 for t in toks if t not in _SUG_STOPWORDS) < min_content_tokens:
        return None
    if len(toks) > _SUG_MAX_PHRASE_TOKENS:
        toks = toks[:_SUG_MAX_PHRASE_TOKENS]
        raw = " ".join(toks)
        if len(toks) <= _SUG_MIN_PHRASE_TOKENS - 1:
            return None
        if sum(1 for t in toks if t not in _SUG_STOPWORDS) < min_content_tokens:
            return None
    key = tuple(toks)
    if key in seen_tokenforms:
        return None
    seen_tokenforms.add(key)
    return raw

def _sug_mine_skill(body, description):
    """Mine one skill's triggers/negative_triggers. Returns
    (triggers, trig_prov, neg, neg_prov) where each `*_prov` entry is
    {"phrase", "rule", "heading", "derived": True, "evidence"} — `evidence` is the original,
    uncleaned bullet/sentence text the phrase came from, captured here at extraction time (never
    reconstructed after the fact by re-searching the body)."""
    sections = _sug_sections_with_description(body or "", description or "")

    triggers, trig_prov = [], []
    neg, neg_prov = [], []
    seen_trig_forms, seen_neg_forms = set(), set()

    for heading, lines in sections:
        content = "\n".join(lines)
        h_norm = _sug_normalize_heading(heading) if heading else None
        is_usage = bool(h_norm) and bool(_SUG_USAGE_HEADING_RE.search(h_norm))
        is_exclusion = bool(h_norm) and bool(_SUG_EXCLUSION_HEADING_RE.search(h_norm))

        if is_usage and len(triggers) < _SUG_TRIGGERS_CAP:
            for item in _sug_extract_items(content):
                if len(triggers) >= _SUG_TRIGGERS_CAP:
                    break
                # A combined heading ("When to use / when NOT to use") is `is_usage` only, but its
                # bullet items can still individually be "do not use ..." — reroute those to
                # negative_triggers instead of mislabelling them as triggers.
                if len(neg) < _SUG_NEGATIVE_TRIGGERS_CAP and _SUG_EXCLUSION_SENTENCE_RE.search(item):
                    cleaned = _sug_cue_remainder(item, _SUG_EXCLUSION_SENTENCE_RE) or item
                    phrase = _sug_finalize_phrase(cleaned, seen_neg_forms, min_content_tokens=2)
                    if phrase:
                        neg.append(phrase)
                        neg_prov.append({"phrase": phrase, "rule": "section_mining",
                                          "heading": heading, "derived": True, "evidence": item[:200]})
                    continue
                cleaned = _sug_cue_remainder(item, _SUG_USAGE_SENTENCE_RE) or item
                phrase = _sug_finalize_phrase(cleaned, seen_trig_forms)
                if phrase:
                    triggers.append(phrase)
                    trig_prov.append({"phrase": phrase, "rule": "section_mining",
                                       "heading": heading, "derived": True, "evidence": item[:200]})

        if is_exclusion and len(neg) < _SUG_NEGATIVE_TRIGGERS_CAP:
            for item in _sug_extract_items(content):
                if len(neg) >= _SUG_NEGATIVE_TRIGGERS_CAP:
                    break
                cleaned = _sug_cue_remainder(item, _SUG_EXCLUSION_SENTENCE_RE) or item
                phrase = _sug_finalize_phrase(cleaned, seen_neg_forms, min_content_tokens=2)
                if phrase:
                    neg.append(phrase)
                    neg_prov.append({"phrase": phrase, "rule": "section_mining",
                                      "heading": heading, "derived": True, "evidence": item[:200]})

        # Sentence-level usage/exclusion cues in *unheaded* prose.
        if h_norm is None:
            for sentence in _sug_split_sentences(content):
                # Exclusion is checked FIRST and is exclusive with usage for the same sentence:
                # "Do not use for X" contains the literal substring "use for" that the usage
                # regex also matches, with no negation-awareness of its own.
                is_excl_sentence = bool(_SUG_EXCLUSION_SENTENCE_RE.search(sentence))
                if len(triggers) < _SUG_TRIGGERS_CAP and not is_excl_sentence and _SUG_USAGE_SENTENCE_RE.search(sentence):
                    phrase = _sug_finalize_phrase(_sug_cue_remainder(sentence, _SUG_USAGE_SENTENCE_RE), seen_trig_forms)
                    if phrase:
                        triggers.append(phrase)
                        trig_prov.append({"phrase": phrase, "rule": "sentence_mining",
                                           "heading": None, "derived": True, "evidence": sentence[:200]})
                if len(neg) < _SUG_NEGATIVE_TRIGGERS_CAP and is_excl_sentence:
                    phrase = _sug_finalize_phrase(
                        _sug_cue_remainder(sentence, _SUG_EXCLUSION_SENTENCE_RE), seen_neg_forms, min_content_tokens=2
                    )
                    if phrase:
                        neg.append(phrase)
                        neg_prov.append({"phrase": phrase, "rule": "sentence_mining",
                                          "heading": None, "derived": True, "evidence": sentence[:200]})

    return triggers, trig_prov, neg, neg_prov

def _sug_derive(skills):
    """skills: [{"id":..., "description":..., "body":..., "triggers": [...], "negative_triggers":
    [...]}, ...] -> {id: {"triggers":[...], "trig_prov":[...], "negative_triggers":[...],
    "neg_prov":[...]}}.

    Mirrors tools/enrich/derive.py's own merge for these two fields: existing fields win (kept
    verbatim, provenance rule "existing"), derived phrases are appended up to the cap, then a
    corpus-wide boilerplate guard drops any *derived* negative_trigger phrase that recurs (by
    tokenized form) in more skills than max(_SUG_NEG_BOILERPLATE_MIN_SKILLS,
    _SUG_NEG_BOILERPLATE_FRACTION * n_corpus) — a phrase identical across dozens of otherwise
    unrelated skills is boilerplate from a shared authoring template, not skill-specific signal,
    and `negative_triggers` is a hard filter (no length floor) so repeating it everywhere is a
    precision hazard out of proportion to its provenance. Only derived phrases are ever removed;
    an authored phrase repeated by its own author is left alone (rule: existing fields win)."""
    by_id = {str(s["id"]): s for s in skills}
    mined = {sid: _sug_mine_skill(s.get("body") or "", s.get("description") or "") for sid, s in by_id.items()}
    results = {sid: {"triggers": [], "trig_prov": [], "negative_triggers": [], "neg_prov": []} for sid in by_id}

    for sid, s in by_id.items():
        r = results[sid]
        m_triggers, m_trig_prov, m_neg, m_neg_prov = mined[sid]
        existing_trig = [str(x) for x in (s.get("triggers") or [])]
        existing_neg = [str(x) for x in (s.get("negative_triggers") or [])]
        seen_trig_forms = {tuple(tokenize(x)) for x in existing_trig}
        seen_neg_forms = {tuple(tokenize(x)) for x in existing_neg}

        r["triggers"].extend(existing_trig)
        r["trig_prov"].extend(
            {"phrase": x, "rule": "existing", "heading": None, "derived": False, "evidence": None}
            for x in existing_trig)
        for phrase, prov in zip(m_triggers, m_trig_prov):
            if len(r["triggers"]) >= _SUG_TRIGGERS_CAP:
                break
            if tuple(tokenize(phrase)) in seen_trig_forms:
                continue
            seen_trig_forms.add(tuple(tokenize(phrase)))
            r["triggers"].append(phrase)
            r["trig_prov"].append(prov)

        r["negative_triggers"].extend(existing_neg)
        r["neg_prov"].extend(
            {"phrase": x, "rule": "existing", "heading": None, "derived": False, "evidence": None}
            for x in existing_neg)
        for phrase, prov in zip(m_neg, m_neg_prov):
            if len(r["negative_triggers"]) >= _SUG_NEGATIVE_TRIGGERS_CAP:
                break
            if tuple(tokenize(phrase)) in seen_neg_forms:
                continue
            seen_neg_forms.add(tuple(tokenize(phrase)))
            r["negative_triggers"].append(phrase)
            r["neg_prov"].append(prov)

    if by_id:
        form_skill_counts = {}
        for r in results.values():
            seen_forms_this_skill = set()
            for prov in r["neg_prov"]:
                if not prov.get("derived"):
                    continue
                key = tuple(tokenize(prov["phrase"]))
                if key in seen_forms_this_skill:
                    continue
                seen_forms_this_skill.add(key)
                form_skill_counts[key] = form_skill_counts.get(key, 0) + 1
        threshold = max(_SUG_NEG_BOILERPLATE_MIN_SKILLS, _SUG_NEG_BOILERPLATE_FRACTION * len(by_id))
        boilerplate_forms = {k for k, n in form_skill_counts.items() if n > threshold}
        if boilerplate_forms:
            for r in results.values():
                kept_phrases, kept_prov = [], []
                for phrase, prov in zip(r["negative_triggers"], r["neg_prov"]):
                    if prov.get("derived") and tuple(tokenize(phrase)) in boilerplate_forms:
                        continue
                    kept_phrases.append(phrase)
                    kept_prov.append(prov)
                r["negative_triggers"] = kept_phrases
                r["neg_prov"] = kept_prov

    return results

def _validate_suggestions(root, cfg, skills):
    """skills: the (dir, node, frontmatter) tuples `_validate_errors` already produced via
    `all_skills()`. Mines the WHOLE corpus (the negative_triggers boilerplate guard in
    `_sug_derive` needs every skill's derived phrases to compute cross-skill frequency, not just
    the ones missing a field) and returns a suggestion dict for every skill missing `triggers`
    and/or `negative_triggers`, sorted by URN. Suggestions are data only — nothing here writes to
    a SKILL.md."""
    skill_dicts = []
    meta = {}
    for d, node, fm in skills:
        u = urn(cfg, node, d.name)
        md = fm.get("metadata") or {}
        body = (d / "SKILL.md").read_text(errors="ignore")
        existing_trig = md_phrases(md, "triggers")
        existing_neg = md_phrases(md, "negative_triggers")
        skill_dicts.append({
            "id": u, "description": fm.get("description", ""), "body": body,
            "triggers": existing_trig, "negative_triggers": existing_neg,
        })
        meta[u] = {"node": node, "missing_triggers": not existing_trig,
                   "missing_negative_triggers": not existing_neg}

    enrichment = _sug_derive(skill_dicts)
    suggestions = []
    for u in sorted(meta):
        info = meta[u]
        if not (info["missing_triggers"] or info["missing_negative_triggers"]):
            continue
        enr = enrichment.get(u) or {}
        sug_triggers, sug_neg = [], []
        if info["missing_triggers"]:
            for phrase, prov in zip(enr.get("triggers", []), enr.get("trig_prov", [])):
                if prov.get("derived"):
                    sug_triggers.append({"phrase": phrase, "heading": prov.get("heading"),
                                          "rule": prov.get("rule"), "evidence": prov.get("evidence")})
        if info["missing_negative_triggers"]:
            for phrase, prov in zip(enr.get("negative_triggers", []), enr.get("neg_prov", [])):
                if prov.get("derived"):
                    sug_neg.append({"phrase": phrase, "heading": prov.get("heading"),
                                     "rule": prov.get("rule"), "evidence": prov.get("evidence")})

        fm_lines = ["metadata:"]
        if sug_triggers:
            fm_lines.append('  triggers: "' + ", ".join(s["phrase"] for s in sug_triggers) + '"')
        if sug_neg:
            fm_lines.append('  negative_triggers: "' + ", ".join(s["phrase"] for s in sug_neg) + '"')

        suggestions.append({
            "urn": u, "node": info["node"],
            "missing_triggers": info["missing_triggers"],
            "missing_negative_triggers": info["missing_negative_triggers"],
            "suggested_triggers": sug_triggers,
            "suggested_negative_triggers": sug_neg,
            "frontmatter_block": "\n".join(fm_lines) if len(fm_lines) > 1 else None,
            "found_nothing": not sug_triggers and not sug_neg,
        })
    return suggestions

def _sug_print_text(suggestions):
    """Plain-text rendering for `validate --suggest` (no --json). Ends with the one-line summary
    'N skills without triggers; run with --suggest' the brief specifies -- printed only here,
    inside --suggest's own output, never on the default `validate` path: on the fixture today 14
    of 26 real skills lack `negative_triggers` (N != 0), so adding any line to the default output
    would break the byte-identical guarantee `tests/test_validate.py` / the fixture-validate CI
    job depend on."""
    missing_triggers_count = sum(1 for s in suggestions if s["missing_triggers"])
    if not suggestions:
        print("guidefold validate --suggest: no skill is missing triggers or negative_triggers")
        return
    print("--- F5 trigger/negative_trigger suggestions (deterministic; suggestions only, never written to files) ---")
    for s in suggestions:
        print()
        print(f"{s['urn']} (node {s['node']})")
        missing = []
        if s["missing_triggers"]:
            missing.append("triggers")
        if s["missing_negative_triggers"]:
            missing.append("negative_triggers")
        print(f"  missing: {', '.join(missing)}")
        if s["found_nothing"]:
            print('  no usage/exclusion material found to derive from -- add a "## When to use '
                  '/ when NOT to use" section, or write these fields by hand')
            continue
        for item in s["suggested_triggers"]:
            print(f"  + trigger \"{item['phrase']}\"")
            print(f"      <- \"{item['evidence']}\"")
        for item in s["suggested_negative_triggers"]:
            print(f"  + negative_trigger \"{item['phrase']}\"")
            print(f"      <- \"{item['evidence']}\"")
        if s["frontmatter_block"]:
            print("  paste into metadata:")
            for line in s["frontmatter_block"].splitlines():
                print(f"    {line}")
    print()
    print(f"{missing_triggers_count} skills without triggers; run with --suggest")

def cmd_validate(a, root, cfg):
    skills, errors = _validate_errors(root, cfg)
    if getattr(a, "suggest", False):
        suggestions = _validate_suggestions(root, cfg, skills)
        if getattr(a, "json", False):
            print(json.dumps({
                "skill_count": len(skills), "error_count": len(errors), "errors": errors,
                "missing_triggers_count": sum(1 for s in suggestions if s["missing_triggers"]),
                "suggestions": suggestions,
            }, indent=2, sort_keys=True))
        else:
            for e in errors:
                print("ERROR", e)
            print(f"guidefold validate: {len(skills)} skills, {len(errors)} errors")
            print()
            _sug_print_text(suggestions)
        sys.exit(1 if errors else 0)
    for e in errors:
        print("ERROR", e)
    print(f"guidefold validate: {len(skills)} skills, {len(errors)} errors")
    sys.exit(1 if errors else 0)

def cmd_procedure(a, root, cfg):
    """S20: deterministic procedure contract and optional, explicit local verifier run.

    The hosted worker never executes client code.  An owner may opt into ``--run`` locally
    after the structural checks pass; the verifier path is resolved inside the repository and
    receives no network or secret injection from Guidefold.
    """
    raw = Path(a.skill)
    skill_md = (root / raw).resolve() if not raw.is_absolute() else raw.resolve()
    try:
        skill_md.relative_to(root.resolve())
    except ValueError:
        print("ERROR procedure path must stay inside the repository")
        sys.exit(2)
    if not skill_md.is_file() or skill_md.name != "SKILL.md":
        print(f"ERROR procedure file not found: {a.skill}")
        sys.exit(2)
    text = skill_md.read_text(encoding="utf-8")
    fm = frontmatter(skill_md)
    body = FM.sub("", text, count=1) if FM.match(text) else text
    headings = {m.group(1).strip().lower() for m in re.finditer(r"^#{2,3}\s+(.+?)\s*$", body, re.M)}
    required = ("inputs", "outputs", "preconditions", "steps", "verification")
    missing = [h for h in required if h not in headings]
    steps = re.findall(r"^\s*(?:\d+[.)]|step\s+\d+)\s+.+$", body, re.I | re.M)
    errors = [f"missing section: {h}" for h in missing]
    if not steps:
        errors.append("steps section must contain at least one ordered step")
    md = fm.get("metadata") or {}
    verifier_value = str(md.get("verifier", "")).strip()
    verifier = None
    if verifier_value:
        verifier = (root / verifier_value).resolve()
        try:
            verifier.relative_to(root.resolve())
        except ValueError:
            errors.append("metadata.verifier must stay inside the repository")
            verifier = None
        if verifier is not None and not verifier.is_file():
            errors.append(f"metadata.verifier not found: {verifier_value}")
    if getattr(a, "run", False) and verifier is None:
        errors.append("--run requires metadata.verifier pointing to a file")
    result = {"schema": "guidefold-procedure-verification-v1", "skill": str(skill_md.relative_to(root)),
              "sections": sorted(headings), "step_count": len(steps), "verifier": verifier_value or None,
              "status": "failed" if errors else "passed", "errors": errors}
    if not errors and getattr(a, "run", False):
        command = [sys.executable, str(verifier)] if verifier.suffix == ".py" else [str(verifier)]
        try:
            completed = subprocess.run(command, cwd=root, capture_output=True, text=True, timeout=30)
            result["verifier_exit_code"] = completed.returncode
            result["verifier_output"] = (completed.stdout + completed.stderr)[-4000:]
            if completed.returncode != 0:
                result["status"] = "failed"
                result["errors"].append(f"verifier exited {completed.returncode}")
        except (OSError, subprocess.TimeoutExpired) as exc:
            result["status"] = "failed"
            result["errors"].append(f"verifier could not complete: {exc}")
    if getattr(a, "json", False):
        print(json.dumps(result, indent=2, sort_keys=True))
    else:
        print(f"guidefold procedure: {result['status']} ({result['step_count']} ordered step(s))")
        for error in result["errors"]:
            print("ERROR", error)
        if result.get("verifier_exit_code") is not None:
            print(f"verifier exit: {result['verifier_exit_code']}")
    sys.exit(0 if result["status"] == "passed" else 1)


def _validate_errors(root, cfg):
    """Core CONVENTIONS.md enforcement, split out of cmd_validate so `doctor` can reuse it
    without duplicating the logic or triggering cmd_validate's sys.exit. Returns
    (skills, errors) — skills is the same list `all_skills()` produced, errors is a list of
    human-readable strings (no ERROR prefix, no printing, no exit)."""
    errors = []
    skills = list(all_skills(root, cfg))
    urns = {urn(cfg, node, d.name): fm for d, node, fm in skills}
    node_of = {urn(cfg, node, d.name): node for d, node, fm in skills}
    for d, node, fm in skills:
        md = fm.get("metadata") or {}
        rd = d.relative_to(root)
        if fm.get("name") != d.name:
            errors.append(f"{rd}: name != directory")
        if md.get("scope") != node:
            errors.append(f"{rd}: metadata.scope={md.get('scope')} but path node={node}")
        if md.get("owner") not in (cfg["nodes"][node].get("owner"), *cfg["nodes"][node].get("subteams", [])):
            errors.append(f"{rd}: owner {md.get('owner')} not allowed for node {node}")
        if md.get("kind") and md.get("kind") not in KIND_VALUES:
            errors.append(f"{rd}: metadata.kind must be one of {', '.join(KIND_VALUES)}")
        if md.get("layer") and md.get("layer") not in LAYER_VALUES:
            errors.append(f"{rd}: metadata.layer must be one of {', '.join(LAYER_VALUES)}")
        for k, v in md.items():
            if not isinstance(v, str):
                errors.append(f"{rd}: metadata.{k} must be a scalar string (registry rejects lists/dates/bools; use a comma-separated string)")
        tag = "[" + (cfg["publisher"] if node == "_root" else node.replace(".", "/")) + "]"
        if not str(fm.get("description", "")).startswith(tag):
            errors.append(f"{rd}: description must start with {tag}")
        if len(str(fm.get("description", ""))) > 1024:
            errors.append(f"{rd}: description longer than 1024 chars")
        refs = md_list(md, "references")
        if len(refs) > 10:
            errors.append(f"{rd}: more than 10 references — skill is too broad")
        for r in refs:
            path, _, token = r.partition("#")
            matches = [m for m in root.glob(path) if m.is_file()]
            if not matches:
                errors.append(f"{rd}: reference not found: {r}")
            elif token and not any(token in m.read_text(errors="ignore") for m in matches):
                errors.append(f"{rd}: token '{token}' not found in {path}")
        for key in ("requires", "refines", "replaces"):
            check_urn_refs(md, key, urns, rd, errors)
        for r in md_list(md, "refines"):
            if r in node_of and node_depth(node_of[r]) > node_depth(node):
                errors.append(f"{rd}: refines {r} is in a deeper node than {node} (child refines parent, not the reverse)")
        if md.get("status") not in ("active", "deprecated"):
            errors.append(f"{rd}: metadata.status must be active or deprecated")
        if md.get("status") == "deprecated" and not md.get("replaced_by"):
            errors.append(f"{rd}: deprecated skill must set metadata.replaced_by")
    flats = {}
    for n in cfg["nodes"]:
        flats.setdefault(flat_node(n), []).append(n)
    for f, ns in flats.items():
        if len(ns) > 1:
            errors.append(f"guidefold.yaml: nodes {ns} collide after flattening to '{f}' (ADR-0008)")
    requires_graph = {u: [r for r in md_list(fm.get("metadata") or {}, "requires") if r in urns] for u, fm in urns.items()}
    check_cycles(requires_graph, "requires", errors)
    refines_graph = {u: [r for r in md_list(fm.get("metadata") or {}, "refines") if r in urns] for u, fm in urns.items()}
    check_cycles(refines_graph, "refines", errors)
    return skills, errors

# ------------------------------------------------------------------------------------------
# E7.5: `guidefold eval` -- ports tools/eval/metrics.py's pure functions (prefixed `_eval_`)
# and tools/eval/run_golden.py's Router call pattern into the CLI, so a consumer monorepo gets
# the quality gate without a second, hidden ranking/metrics implementation living outside the
# CLI. Parity with tools/eval/{metrics,run_golden}.py is verified in tests/test_eval.py to 4
# decimal places on the 220-case golden set; see docs/CONVENTIONS.md for what diverges and why.
_EVAL_MUST_BE_FIRST = 3
_EVAL_MUST_BE_IN_TOP_K = 2
_EVAL_RETRIEVAL_K = 10          # >= the largest k any metric slices (nDCG@10); matches
                                # tools/eval/run_golden.py's EVAL_K.


def _eval_graded(case):
    return {r["urn"]: int(r["grade"]) for r in case.get("relevant") or []}


def _eval_distractors(case):
    return {d["urn"] for d in case.get("distractors") or []}


def _eval_is_abstention_case(case):
    """True when the correct behaviour is to return nothing."""
    return not (case.get("relevant") or [])


def _eval_hit_at_1(ranked, case):
    if not ranked:
        return 0.0
    return 1.0 if _eval_graded(case).get(ranked[0], 0) >= _EVAL_MUST_BE_IN_TOP_K else 0.0


def _eval_recall_at_k(ranked, case, k=8):
    required = {u for u, g in _eval_graded(case).items() if g >= _EVAL_MUST_BE_IN_TOP_K}
    if not required:
        return float("nan")            # undefined for abstention cases; caller filters these out
    return len(required & set(ranked[:k])) / len(required)


def _eval_ndcg_at_k(ranked, case, k=10):
    import math
    rel = _eval_graded(case)
    if not rel:
        return float("nan")
    dcg = sum((2 ** rel.get(u, 0) - 1) / math.log2(i + 2) for i, u in enumerate(ranked[:k]))
    ideal = sum((2 ** g - 1) / math.log2(i + 2)
                for i, g in enumerate(sorted(rel.values(), reverse=True)[:k]))
    return dcg / ideal if ideal else float("nan")


def _eval_completeness_at_k(ranked, case, k=4):
    must = {u for u, g in _eval_graded(case).items() if g >= _EVAL_MUST_BE_FIRST}
    if not must:
        return float("nan")
    return 1.0 if must <= set(ranked[:k]) else 0.0


def _eval_all_required_at_k(ranked, case, k=4):
    required = {u for u, g in _eval_graded(case).items() if g >= _EVAL_MUST_BE_IN_TOP_K}
    if not required:
        return float("nan")
    return 1.0 if required <= set(ranked[:k]) else 0.0


def _eval_distractor_rate(ranked, case, k=4):
    d = _eval_distractors(case)
    if not d:
        return float("nan")
    return 1.0 if d & set(ranked[:k]) else 0.0


def _eval_abstention_counts(ranked, case):
    """(tp, fp, fn, tn) treating "the router returned nothing" as the positive class."""
    abstained = not ranked
    should = _eval_is_abstention_case(case)
    return (
        int(abstained and should),
        int(abstained and not should),
        int(not abstained and should),
        int(not abstained and not should),
    )


def _eval_mean(xs):
    import math
    vals = [x for x in xs if not math.isnan(x)]
    return sum(vals) / len(vals) if vals else float("nan")


def _eval_evaluate(results, k_cards=4):
    """Aggregate every metric over `(ranked_urns, case)` pairs. Ranking metrics are
    macro-averaged over the cases where they are defined; abstained queries are excluded from
    them (an abstention is scored on its own axis, never as a ranking failure of 0)."""
    tp = fp = fn = tn = 0
    answerable = [(r, c) for r, c in results if not _eval_is_abstention_case(c)]
    answered = [(r, c) for r, c in answerable if r]
    for ranked, case in results:
        ta, fpa, fna, tna = _eval_abstention_counts(ranked, case)
        tp += ta; fp += fpa; fn += fna; tn += tna
    return {
        "n": len(results),
        "n_answerable": len(answerable),
        "n_answered": len(answered),
        "hit@1": _eval_mean(_eval_hit_at_1(r, c) for r, c in answered),
        "recall@8": _eval_mean(_eval_recall_at_k(r, c, 8) for r, c in answered),
        "ndcg@10": _eval_mean(_eval_ndcg_at_k(r, c, 10) for r, c in answered),
        f"completeness@{k_cards}": _eval_mean(_eval_completeness_at_k(r, c, k_cards) for r, c in answered),
        f"all_required@{k_cards}": _eval_mean(_eval_all_required_at_k(r, c, k_cards) for r, c in answered),
        f"distractor_rate@{k_cards}": _eval_mean(_eval_distractor_rate(r, c, k_cards) for r, c in results if r),
        "abstention_precision": tp / (tp + fp) if (tp + fp) else float("nan"),
        "abstention_recall": tp / (tp + fn) if (tp + fn) else float("nan"),
        "coverage": len(answered) / len(answerable) if answerable else float("nan"),
    }


def _eval_by_category(results, k_cards=4):
    """Per-stratum breakdown -- an overall number hides exactly the regressions that matter."""
    buckets = {}
    for ranked, case in results:
        buckets.setdefault(case.get("category", "unknown"), []).append((ranked, case))
    return {cat: _eval_evaluate(rs, k_cards) for cat, rs in sorted(buckets.items())}


def _eval_format_table(overall, per_cat, k_cards=4):
    import math
    cols = ["n", "hit@1", "recall@8", "ndcg@10", f"completeness@{k_cards}", f"all_required@{k_cards}",
            f"distractor_rate@{k_cards}", "abstention_precision"]
    head = f"{'stratum':<20}" + "".join(f"{c:>22}" for c in cols)
    lines = [head, "-" * len(head)]
    for name, m in list(per_cat.items()) + [("OVERALL", overall)]:
        row = f"{name:<20}"
        for c in cols:
            v = m.get(c, float("nan"))
            row += f"{v:>22}" if isinstance(v, int) else (
                f"{chr(8212):>22}" if isinstance(v, float) and math.isnan(v) else f"{v:>22.4f}")
        lines.append(row)
    return "\n".join(lines)


def _eval_json_safe(m):
    import math
    return {k: (None if isinstance(v, float) and math.isnan(v) else v) for k, v in m.items()}


def _eval_load_queries(path):
    """Load cases from `--queries`. Three accepted shapes:

    - a directory: every `*.yaml`/`*.yml` inside, golden schema (tests/golden/README.md) --
      `version`/`category`/`cases`, category copied down onto each case. Generalises
      tools/eval/run_golden.py's hardcoded 5-file CATEGORY_FILES list to "every golden file in
      the directory", so any consumer's own golden set works unmodified.
    - a single `.yaml`/`.yml` file: same golden schema, one category.
    - a single `.jsonl` file: the minimal unlabelled format -- one `{"query": ..., "node": ...}`
      object per line, no `relevant`/`distractors`. Yields exposure metrics only (no
      hit@1/recall/ndcg/all_required/distractor_rate -- those need graded labels).

    Returns (cases, mode) where mode is "golden" or "unlabelled".
    """
    import yaml
    p = Path(path)
    cases = []

    def _load_golden_file(f):
        doc = yaml.safe_load(f.read_text()) or {}
        category = doc.get("category", f.stem)
        for c in doc.get("cases", []):
            c = dict(c)
            c.setdefault("category", category)
            cases.append(c)

    if p.is_dir():
        files = sorted(x for x in p.iterdir() if x.suffix in (".yaml", ".yml"))
        if not files:
            sys.exit(f"guidefold eval: no .yaml/.yml files found under {p}")
        for f in files:
            _load_golden_file(f)
        mode = "golden"
    elif p.suffix in (".yaml", ".yml"):
        if not p.exists():
            sys.exit(f"guidefold eval: --queries file not found: {p}")
        _load_golden_file(p)
        mode = "golden"
    elif p.suffix == ".jsonl":
        if not p.exists():
            sys.exit(f"guidefold eval: --queries file not found: {p}")
        mode = "unlabelled"
        for i, line in enumerate(p.read_text().splitlines()):
            line = line.strip()
            if not line:
                continue
            obj = dict(json.loads(line))
            obj.setdefault("id", f"case_{i}")
            obj.setdefault("category", "unlabelled")
            cases.append(obj)
    else:
        sys.exit(f"guidefold eval: --queries must be a directory of golden *.yaml files, a "
                 f"single .yaml/.yml file, or a .jsonl file of unlabelled {{query, node}} "
                 f"objects (got {p})")
    if not cases:
        sys.exit(f"guidefold eval: no cases loaded from {p}")
    return cases, mode


def _eval_run_cases(router, cases, k_cards=4, retrieval_k=_EVAL_RETRIEVAL_K):
    """Mirrors tools/eval/run_golden.py's run_cases() exactly: two orderings, because
    Router.score (retrieval, best-match-first) and Router.select (injection, general-to-specific,
    <=k_cards, admissible-gated per ADR-0022) answer different questions. Conflating them
    understated hit@1 by ~64 points against the Meridian fixture (PR #9) -- both are always
    computed and reported, never just one."""
    retrieval, injection = [], []
    for c in cases:
        cands = router.candidates(c["query"], c["node"])
        scored = router.score(cands, c["query"], c["node"])
        retrieval.append(([s["urn"] for s in scored[:retrieval_k]], c))
        # ADR-0022: the same admissibility decision governs candidates and select's dependency
        # expansion -- exactly what route() does, spelled out here because eval needs both the
        # retrieval and injection lists separately, which route() does not expose.
        admissible, _ = router.policy_filter(c["node"], c["query"])
        injection.append(([r["urn"] for r in router.select(scored, k=k_cards, admissible=set(admissible))], c))
    return retrieval, injection


def _eval_per_case_metrics(retrieval, injection, k_cards):
    """Per-case values for exactly the three metrics `--gate` compares (hit@1, all_required@k,
    distractor_rate@k) -- enough for a paired bootstrap CI keyed by case id. A metric is present
    for a case only when it was actually counted into the matching `_eval_evaluate` aggregate
    (same answerable/answered/`if r` gating as `_eval_evaluate` above), so the per-case mean
    always reconciles with the overall mean. NaN (e.g. all_required@k on a case whose relevant
    items are all grade-1, or distractor_rate@k on a case with no distractors listed) is left out
    of the entry entirely -- "undefined for this case", the same convention _eval_mean uses, and
    the only way to keep NaN out of both the baseline JSON (a raw NaN is not valid JSON) and the
    bootstrap CI (a single NaN pair silently poisons every resampled mean)."""
    import math

    def _put(entry, key, value):
        if not (isinstance(value, float) and math.isnan(value)):
            entry[key] = value

    out = {}
    for (r, c), (rinj, _c2) in zip(retrieval, injection):
        cid = str(c.get("id") or c.get("query"))
        entry = {"category": c.get("category", "unknown")}
        if not _eval_is_abstention_case(c) and r:
            _put(entry, "hit@1", _eval_hit_at_1(r, c))
        if not _eval_is_abstention_case(c) and rinj:
            _put(entry, f"all_required@{k_cards}", _eval_all_required_at_k(rinj, c, k_cards))
        if rinj:
            _put(entry, f"distractor_rate@{k_cards}", _eval_distractor_rate(rinj, c, k_cards))
        out[cid] = entry
    return out


def _eval_index_checksum(idx):
    import hashlib
    payload = json.dumps({"cards": sorted(idx.cards.items()), "weights": idx.weights},
                          sort_keys=True, default=str)
    return hashlib.sha256(payload.encode("utf-8")).hexdigest()


def _eval_query_file_sha256(path):
    """sha256 of every file under --queries, concatenated in the same sorted order they were
    loaded in -- so a baseline records exactly which query bytes it was measured against."""
    import hashlib
    p = Path(path)
    h = hashlib.sha256()
    if p.is_dir():
        for f in sorted(x for x in p.iterdir() if x.suffix in (".yaml", ".yml")):
            h.update(f.read_bytes())
    else:
        h.update(p.read_bytes())
    return h.hexdigest()


def _eval_bootstrap_ci(pairs, resamples=1000, seed=0):
    """Paired bootstrap 95% CI on mean(current) - mean(baseline), resampling case pairs with
    replacement. stdlib `random` only, fixed seed (0) for determinism. This is diagnostic --
    noise vs signal, printed next to the delta -- the gate itself never reads it, only the point
    estimate vs its margin (docs/CONVENTIONS.md)."""
    import random
    pairs = [(float(b), float(c)) for b, c in pairs]
    n = len(pairs)
    if n == 0:
        nan = float("nan")
        return {"n": 0, "delta": nan, "ci_lo": nan, "ci_hi": nan}
    rng = random.Random(seed)
    point_delta = (sum(c for _, c in pairs) / n) - (sum(b for b, _ in pairs) / n)
    deltas = []
    for _ in range(resamples):
        sample = [pairs[rng.randrange(n)] for _ in range(n)]
        mb = sum(b for b, _ in sample) / n
        mc = sum(c for _, c in sample) / n
        deltas.append(mc - mb)
    deltas.sort()
    lo_idx = int(resamples * 0.025)
    hi_idx = min(int(resamples * 0.975), resamples - 1)
    return {"n": n, "delta": point_delta, "ci_lo": deltas[lo_idx], "ci_hi": deltas[hi_idx]}


def _eval_compare_to_baseline(overall, per_case, baseline, k_cards, margins):
    """Compares `overall`/`per_case` (current run) to a `--write-baseline` JSON payload. Returns
    (problems, lines): `problems` empty iff the gate should pass. Only three metrics are gated --
    hit@1 / all_required@k dropping, or distractor_rate@k rising, beyond `margins` (fractions,
    e.g. 0.01 == 1.0pp) -- matching DENSE-PROGRAM Sec5's guardrails."""
    base_overall = baseline.get("overall") or {}
    base_per_case = baseline.get("per_case") or {}
    gated = (
        ("hit@1", "higher", margins["hit_at_1"]),
        (f"all_required@{k_cards}", "higher", margins["all_required"]),
        (f"distractor_rate@{k_cards}", "lower", margins["distractor_rate"]),
    )
    import math
    problems, lines = [], []
    for metric, direction, margin in gated:
        cur_v, base_v = overall.get(metric), base_overall.get(metric)
        if (cur_v is None or (isinstance(cur_v, float) and math.isnan(cur_v))
                or base_v is None or (isinstance(base_v, float) and math.isnan(base_v))):
            lines.append(f"{metric}: undefined in current or baseline run -- skipped")
            continue
        delta = cur_v - base_v
        pairs = []
        for cid, cur_entry in per_case.items():
            if metric not in cur_entry:
                continue
            base_entry = base_per_case.get(cid)
            if not base_entry or metric not in base_entry:
                continue
            pairs.append((base_entry[metric], cur_entry[metric]))
        ci = _eval_bootstrap_ci(pairs)
        lines.append(
            f"{metric}: {cur_v:.4f} vs baseline {base_v:.4f} (delta {delta:+.4f}, "
            f"95% CI [{ci['ci_lo']:+.4f}, {ci['ci_hi']:+.4f}] over {ci['n']} paired cases)"
        )
        if direction == "higher" and delta < -margin:
            problems.append(f"{metric} dropped by {-delta:.4f} (margin {margin:.4f})")
        elif direction == "lower" and delta > margin:
            problems.append(f"{metric} rose by {delta:.4f} (margin {margin:.4f})")
    return problems, lines


def _eval_exposure_report(router, cases, k_cards=4):
    """Unlabelled --queries (.jsonl of {query, node}): no relevant/distractors means the graded
    metrics above are undefined for every case, so this reports what the router actually surfaces
    instead -- abstention rate, average cards returned, and which skills got exposure. Useful to
    sanity-check a new query set before labelling it, or to watch for a skill going dark."""
    n = len(cases)
    n_abstained = 0
    total_cards = 0
    urn_counts = {}
    per_case = {}
    for c in cases:
        cid = str(c.get("id") or c.get("query"))
        cands = router.candidates(c["query"], c["node"])
        scored = router.score(cands, c["query"], c["node"])
        admissible, _ = router.policy_filter(c["node"], c["query"])
        selected = router.select(scored, k=k_cards, admissible=set(admissible))
        urns = [s["urn"] for s in selected]
        if not urns:
            n_abstained += 1
        total_cards += len(urns)
        for u in urns:
            urn_counts[u] = urn_counts.get(u, 0) + 1
        per_case[cid] = {"category": c.get("category", "unlabelled"), "n_cards": len(urns),
                          "top_urn": urns[0] if urns else None}
    report = {
        "n": n,
        "n_abstained": n_abstained,
        "abstain_rate": n_abstained / n if n else float("nan"),
        "coverage": (n - n_abstained) / n if n else float("nan"),
        "avg_cards_returned": total_cards / n if n else float("nan"),
        "top_skills": sorted(urn_counts.items(), key=lambda kv: (-kv[1], kv[0]))[:20],
    }
    return report, per_case


def cmd_eval(a, root, cfg):
    """E7.5: run every query in `--queries` through the exact product path
    (policy_filter -> candidates -> score -> select(admissible=...), ADR-0022) and report the
    same metrics tools/eval/metrics.py defines, ported here as the `_eval_*` functions above
    (verified in tests/test_eval.py to 4 decimal places against tools/eval/run_golden.py on the
    220-case golden set) so a consumer monorepo gets the quality gate without a second ranking/
    metrics implementation living outside the CLI.

    Retrieval (Router.score order) gives hit@1/recall@8/ndcg@10 -- "did ranking put the right
    skills on top". Injection (the <=k cards Router.select actually emits, admissible-gated)
    gives completeness@k/all_required@k/distractor_rate@k *and* abstention_precision/
    abstention_recall/n_answered/coverage -- "did the agent's actual cards hold the whole
    answer, no distractor, and did the router correctly say nothing when it should". Reading
    abstention/coverage from injection rather than retrieval is a deliberate, documented
    widening of tools/eval/run_golden.py's own overwrite (which only re-sources
    completeness@4/distractor_rate@4 from injection, leaving abstention on the retrieval list):
    a retrieval list is empty only when candidates() found nothing, so abstention computed on it
    misses every case where select()'s abstain_threshold is what actually said no -- the same
    "wrong list understates the real signal" bug class as PR #9's hit@1 fix.
    """
    k = getattr(a, "k", None) or 4
    eval_cfg = cfg.get("eval") or {}
    gate_cfg = eval_cfg.get("gate") or {}
    margins = {
        "hit_at_1": float(gate_cfg.get("hit_at_1_margin", 1.0)) / 100.0,
        "all_required": float(gate_cfg.get("all_required_margin", 1.0)) / 100.0,
        "distractor_rate": float(gate_cfg.get("distractor_rate_margin", 1.0)) / 100.0,
    }

    idx = Index.build(root, cfg)
    router = Router(idx)
    cases, mode = _eval_load_queries(a.queries)

    if mode == "unlabelled":
        if getattr(a, "gate", False) or getattr(a, "baseline", None) or getattr(a, "write_baseline", None):
            sys.exit("guidefold eval: --gate/--baseline/--write-baseline need labelled cases "
                     "(a golden YAML --queries source, not .jsonl)")
        report, per_case = _eval_exposure_report(router, cases, k_cards=k)
        print(f"guidefold eval (unlabelled -- exposure only): {report['n']} queries, "
              f"abstain_rate={report['abstain_rate']:.4f}, coverage={report['coverage']:.4f}, "
              f"avg_cards_returned={report['avg_cards_returned']:.4f}")
        print("top skills returned:")
        for u, n in report["top_skills"]:
            print(f"  {n:>4}  {u}")
        if getattr(a, "json", None):
            payload = {
                "mode": "unlabelled", "cli_version": CLI_VERSION, "k": k,
                "query_file_sha256": _eval_query_file_sha256(a.queries),
                "exposure": _eval_json_safe(report),
                "per_case": per_case,
            }
            Path(a.json).write_text(json.dumps(payload, indent=2, sort_keys=True) + "\n")
        sys.exit(0)

    retrieval, injection = _eval_run_cases(router, cases, k_cards=k)
    ret_overall = _eval_evaluate(retrieval)
    ret_per_cat = _eval_by_category(retrieval)
    inj_overall = _eval_evaluate(injection, k_cards=k)
    inj_per_cat = _eval_by_category(injection, k_cards=k)

    injected_keys = (f"completeness@{k}", f"all_required@{k}", f"distractor_rate@{k}",
                     "abstention_precision", "abstention_recall", "coverage")
    overall = dict(ret_overall)
    overall["n_answered"] = inj_overall["n_answered"]
    for key in injected_keys:
        overall[key] = inj_overall.get(key, float("nan"))
    per_cat = {}
    for cat in sorted(set(ret_per_cat) | set(inj_per_cat)):
        merged = dict(ret_per_cat.get(cat, {}))
        inj_m = inj_per_cat.get(cat, {})
        merged["n_answered"] = inj_m.get("n_answered", merged.get("n_answered"))
        for key in injected_keys:
            merged[key] = inj_m.get(key, float("nan"))
        per_cat[cat] = merged

    table = ("RETRIEVAL  (Router.score order -- hit@1 / recall@8 / nDCG@10)\n"
             + _eval_format_table(ret_overall, ret_per_cat, k_cards=k)
             + "\n\nINJECTION  (<=k cards Router.select emits -- completeness@k / all_required@k / "
               "distractor_rate@k / abstention / coverage)\n"
             + _eval_format_table(inj_overall, inj_per_cat, k_cards=k))
    print(table)

    per_case = _eval_per_case_metrics(retrieval, injection, k)
    exit_code = 0

    if getattr(a, "write_baseline", None):
        baseline_payload = {
            "cli_version": CLI_VERSION,
            "git_sha": _git_head_short(root),
            "index_checksum": _eval_index_checksum(idx),
            "query_file_sha256": _eval_query_file_sha256(a.queries),
            "k": k,
            "overall": _eval_json_safe(overall),
            "by_category": {c: _eval_json_safe(m) for c, m in per_cat.items()},
            "per_case": per_case,
        }
        Path(a.write_baseline).write_text(json.dumps(baseline_payload, indent=2, sort_keys=True) + "\n")
        print(f"\nwrote baseline: {a.write_baseline}")

    if getattr(a, "baseline", None):
        bpath = Path(a.baseline)
        if not bpath.exists():
            msg = f"guidefold eval: no baseline at {bpath} yet"
            if getattr(a, "gate", False):
                sys.exit(msg + " -- run with --write-baseline once to create it")
            print("\n" + msg)
        else:
            baseline = json.loads(bpath.read_text())
            if baseline.get("k") is not None and baseline.get("k") != k:
                sys.exit(f"guidefold eval: baseline {bpath} was written with --k {baseline.get('k')}, "
                         f"this run used --k {k} -- re-run with the matching --k, or a fresh --write-baseline")
            problems, lines = _eval_compare_to_baseline(overall, per_case, baseline, k, margins)
            print(f"\nvs baseline {bpath}:")
            for line in lines:
                print("  " + line)
            if getattr(a, "gate", False):
                if problems:
                    print("\nGATE FAILED:")
                    for pr in problems:
                        print("  - " + pr)
                    exit_code = 1
                else:
                    print("\ngate passed: no gated metric regressed beyond its margin")
    elif getattr(a, "gate", False):
        sys.exit("guidefold eval: --gate requires --baseline")

    if getattr(a, "json", None):
        payload = {
            "mode": "golden", "cli_version": CLI_VERSION, "git_sha": _git_head_short(root),
            "index_checksum": _eval_index_checksum(idx),
            "query_file_sha256": _eval_query_file_sha256(a.queries),
            "k": k, "overall": _eval_json_safe(overall),
            "by_category": {c: _eval_json_safe(m) for c, m in per_cat.items()},
        }
        Path(a.json).write_text(json.dumps(payload, indent=2, sort_keys=True) + "\n")

    sys.exit(exit_code)


def cmd_drift(a, root, cfg):
    diff = subprocess.run(["git", "diff", "--name-only", "--relative", a.base], capture_output=True, text=True, cwd=root).stdout.split()
    report = []
    for d, node, fm in all_skills(root, cfg):
        for r in md_list(fm.get("metadata") or {}, "references"):
            path, _, token = r.partition("#")
            for changed in diff:
                if fnmatch.fnmatch(changed, path):
                    hit = True
                    if token:
                        patch = subprocess.run(["git", "diff", "--relative", a.base, "--", changed], capture_output=True, text=True, cwd=root).stdout
                        hit = token in patch
                    if hit:
                        report.append((urn(cfg, node, d.name), fm["metadata"].get("owner"), changed, token))
    if report:
        print("⚠ Possibly stale guidance:")
        for u, o, f, t in report:
            print(f"- {u} (owner: {o}) references {f}{'#'+t if t else ''}")
    sys.exit(0)  # advisory in MVP

# ----------------------------------------------------- P12 / U7: pre-merge change report
# PRODUCT-PIVOT §10 U7 ("Kontrola jakości skilla przed merge"): CI compares two revisions of the
# skill corpus, checks the graph, and shows the impact on retrieval examples. Two rules from that
# section drive every severity below:
#
#   * "Struktura blokuje; przypuszczalna kolizja ostrzega" — a cycle, a missing dependency, a
#     missing declared resource and a missing/invalid card are `error` and fail the run under the
#     default `--fail-on structure`. Everything an author could reasonably disagree with (probable
#     trigger collision, no owner, a scope change, a shortened description, an unknown scope) is
#     `warning` and never changes the exit code unless `--fail-on any` is asked for explicitly.
#   * "Test retrievalu nie dowodzi wykonania procedury" — the retrieval section is an *example*,
#     never a proof that the procedure runs. Its findings are `warning`s only.
#
# Nothing here is a second parser or a second ranking implementation. The base view is a
# `git archive` extraction into a private temp dir (never the working tree, never a second
# `git worktree` inside the repo) loaded through the same `load_map`/`frontmatter`/`all_skills`/
# `Index.build` the working tree goes through; the retrieval section replays the exact product
# path `_eval_run_cases` uses (policy_filter -> candidates -> score -> select(admissible=...),
# ADR-0022) and scores it with the same `_eval_*` functions `guidefold eval` uses.
REPORT_SCHEMA = "guidefold-change-report-v1"
# The hidden marker `tools/authoring/sticky_comment.py` finds and updates by. A DIFFERENT marker
# from that script's DEFAULT_MARKER on purpose: the `skill-authoring-report` job already owns one
# sticky comment under the default marker, and two jobs sharing a marker would overwrite each
# other's comment on every push. Retry-safety (U7 AC: "Retry nie dubluje komentarza") comes from
# the marker being stable, not from it being shared.
REPORT_MARKER = "<!-- guidefold:change-report -->"
REPORT_MD_MAX_LINES = 200          # a PR comment nobody scrolls past is a report nobody reads
REPORT_MD_LIST_CAP = 20            # per Markdown list; the JSON artifact always carries all of it
REPORT_MD_FINDING_CAP = 30
REPORT_ARCHIVE_BATCH = 200         # paths per `git archive` call — keeps argv well under any limit
REPORT_MAX_EXTRA_RESOURCES = 2000  # guard against a pathological `references: "**"` declaration
_REPORT_SEVERITY_ORDER = {"error": 0, "warning": 1, "info": 2}
# Per-skill fields the diff reports individually (PRODUCT-PIVOT §10 U7 "diff trafień, severity").
_REPORT_FIELD_KEYS = ("description", "scope", "owner", "layer", "status",
                      "triggers", "requires", "refines", "references", "body_sha256")
_REPORT_RELATION_KEYS = ("requires", "refines", "replaces")


def _report_finding(severity, code, message, skill_id=None, details=None):
    f = {"severity": severity, "code": code, "message": message,
         "details": details if details is not None else {}}
    if skill_id is not None:                   # `skill_id?` — absent, not null, when unattributable
        f["skill_id"] = skill_id
    return f


def _report_sorted_findings(findings):
    """Stable order: severity, then code, then skill, then message — never discovery order, so
    two runs over the same two commits emit byte-identical JSON and Markdown."""
    seen, out = set(), []
    for f in findings:
        key = _canonical_json(f)
        if key in seen:
            continue
        seen.add(key)
        out.append(f)
    return sorted(out, key=lambda f: (_REPORT_SEVERITY_ORDER.get(f["severity"], 9), f["code"],
                                       f.get("skill_id") or "", f["message"]))


def _report_declared_resources(md: dict) -> list:
    """The resource files a card *declares* it depends on: `metadata.references` (CONVENTIONS §4 —
    comma-separated repo paths, globs allowed, optional `#token`) plus `metadata.scripts` where an
    author uses one. Both are treated as required: `guidefold validate` already fails when a
    declared reference resolves to nothing, and this report restates that as
    `missing_required_resource`."""
    return sorted(set(md_list(md, "references")) | set(md_list(md, "scripts")))


def _is_canonical_skill_path(relpath: str) -> bool:
    """`<anything>/.agents/skills/<name>/SKILL.md` — the exact shape `all_skills` rglobs for, and
    therefore the only shape `find`/`load`/`validate`/`materialize`/`doctor`/`report` and the
    worker's `build_tree.py` will ever discover. Shared by `report` (U7) and `scan_manifest`
    (U1): a `SKILL.md` that fails this check can be imported but can never be published, and
    both callers need to say so rather than one of them silently going along with it."""
    parts = relpath.split("/")
    return (len(parts) >= 4 and parts[-1] == "SKILL.md" and parts[-3] == "skills"
            and parts[-4] == ".agents" and ".guidefold" not in parts)


def _report_is_packaged_resource(relpath: str) -> bool:
    """A file inside a skill's own `references/` / `scripts/` / `assets/` directory — the payload
    the registry ships with the card (CONVENTIONS §4, `zip_skill_dir`)."""
    parts = relpath.split("/")
    if ".guidefold" in parts:
        return False
    for i, part in enumerate(parts):
        if (part == ".agents" and i + 4 < len(parts) and parts[i + 1] == "skills"
                and parts[i + 3] in SCAN_RESOURCE_DIRS):
            return True
    return False


def _report_git_text(root: Path, args: list):
    out = subprocess.run(["git", "-C", str(root), *args], capture_output=True, text=True)
    return out.stdout.strip() if out.returncode == 0 else None


def _report_head_commit_and_dirt(root: Path):
    """(head_commit|None, dirty). Unlike `_git_head_and_dirt` (which deliberately reports no
    commit at all for a dirty tree, because a manifest may not claim a commit it does not match)
    the report always names HEAD and says separately whether the working tree adds to it — the
    head view here is explicitly "committed + uncommitted", like `validate`."""
    commit = _report_git_text(root, ["rev-parse", "HEAD"])
    if commit is not None and not re.fullmatch(r"[0-9a-f]{40}", commit):
        commit = None
    status = subprocess.run(["git", "-C", str(root), "status", "--porcelain",
                             "--untracked-files=normal", "--", "."], capture_output=True, text=True)
    dirty = True if status.returncode != 0 else bool(status.stdout.strip())
    return commit, dirty


def _report_archive_paths(root: Path, ref: str, paths: list, dest: Path):
    """`git archive <ref> -- <paths>` piped through stdlib tarfile into `dest`. Batched so a
    corpus with thousands of files never builds an argv the OS refuses."""
    import io
    import tarfile
    for i in range(0, len(paths), REPORT_ARCHIVE_BATCH):
        batch = paths[i:i + REPORT_ARCHIVE_BATCH]
        out = subprocess.run(["git", "-C", str(root), "archive", "--format=tar", ref, "--", *batch],
                              capture_output=True)
        if out.returncode != 0:
            _die("report: git archive failed for --base " + ref + ": "
                 + out.stderr.decode("utf-8", "replace").strip())
        with tarfile.open(fileobj=io.BytesIO(out.stdout), mode="r|") as tf:
            try:
                tf.extractall(dest, filter="data")     # Python >= 3.12
            except TypeError:
                tf.extractall(dest)                    # Python < 3.12 has no `filter` kwarg


def _report_extract_base(root: Path, ref: str, work: Path):
    """Materialise the base view under `work` and return (commit, base_root, cfg).

    Extracts only what the report reads — `guidefold.yaml`, every `SKILL.md`, each skill's
    packaged resource directories, and (second pass, once the cards have been parsed) the files
    `metadata.references`/`metadata.scripts` declare. A whole-repo `git archive` would be correct
    too, and far more expensive on the monorepos this is aimed at."""
    commit = _report_git_text(root, ["rev-parse", "--verify", "--quiet", ref + "^{commit}"])
    if not commit:
        _die("report: --base " + repr(ref) + " is not a commit in this repository — fetch it "
             "first (e.g. `git fetch origin <branch>`) or pass a ref that exists locally")
    prefix = _report_git_text(root, ["rev-parse", "--show-prefix"]) or ""
    tree_out = subprocess.run(["git", "-C", str(root), "ls-tree", "-r", "-z", "--name-only", commit],
                               capture_output=True)
    if tree_out.returncode != 0:
        _die("report: cannot list the tree of --base " + ref + " (" + commit[:7] + ")")
    tree = [p.decode("utf-8", "surrogateescape") for p in tree_out.stdout.split(b"\0") if p]
    cfg_path = prefix + "guidefold.yaml"
    if cfg_path not in tree:
        _die("report: --base " + ref + " (" + commit[:7] + ") has no " + cfg_path + " — there is "
             "no skill map at that commit to compare against")

    rel_of = {}
    want = [cfg_path]
    for p in tree:
        if not p.startswith(prefix):
            continue
        r = p[len(prefix):]
        rel_of[p] = r
        if _is_canonical_skill_path(r) or _report_is_packaged_resource(r):
            want.append(p)
    _report_archive_paths(root, commit, sorted(set(want)), work)

    base_root = (work / prefix.rstrip("/")) if prefix else work
    base_root = base_root.resolve()
    try:
        cfg = load_map(base_root)
    except SystemExit:
        raise
    except Exception as exc:                                # noqa: BLE001
        _die("report: guidefold.yaml at --base " + ref + " (" + commit[:7] + ") does not parse: "
             + str(exc))

    # Second pass: the declared references/scripts. Their patterns are resolved against the base
    # tree listing with fnmatch (a superset of `Path.glob` for these patterns, plus the `/**/`
    # -> `/` variant `Path.glob` matches but fnmatch does not), then the winners are extracted so
    # `_report_resolve_resources` can resolve them with the same `root.glob` `validate` uses.
    declared = set()
    for md_path in sorted(base_root.rglob(".agents/skills/*/SKILL.md")):
        try:
            fm = frontmatter(md_path)
        except Exception:                                   # noqa: BLE001 — reported later, per view
            continue
        meta = fm.get("metadata") if isinstance(fm, dict) else None
        if isinstance(meta, dict):
            declared.update(r.partition("#")[0] for r in _report_declared_resources(meta))
    have = set(want)
    extra = []
    for pat in sorted(declared):
        if not pat or pat.startswith("/") or ".." in pat.split("/"):
            continue
        variants = {pat}
        if "/**/" in pat:
            variants.add(pat.replace("/**/", "/"))
        for p, r in rel_of.items():
            if p in have:
                continue
            if any(fnmatch.fnmatch(r, v) for v in variants):
                extra.append(p)
    extra = sorted(set(extra))[:REPORT_MAX_EXTRA_RESOURCES]
    if extra:
        _report_archive_paths(root, commit, extra, work)
    return commit, base_root, cfg


def _report_scan_view(root: Path, cfg: dict):
    """One side of the comparison: the product `Index` plus the report-only per-skill extras
    (declared resources, packaged resource shas, body sha) and every `invalid_card` finding the
    tolerant frontmatter walk produced. Frontmatter is parsed by `frontmatter()`/`all_skills()`;
    the index is built by `Index.build`. Nothing here reads YAML on its own."""
    root = root.resolve()
    invalid = []

    def record(md_path, message, skip):
        d = md_path.parent
        try:
            node = node_for(cfg, rel(root, d))
            skill_id = urn(cfg, node, d.name)
        except Exception:                                   # noqa: BLE001 — a path we cannot place
            skill_id = None
        invalid.append(_report_finding("error", "invalid_card",
                                        rel(root, md_path) + ": " + message, skill_id=skill_id,
                                        details={"path": rel(root, md_path), "skipped": skip}))

    def on_error(md_path, exc):
        record(md_path, "frontmatter does not parse (" + type(exc).__name__ + ": " + str(exc) + ")",
               True)

    skills = {}
    for d, node, fm in all_skills(root, cfg, on_error=on_error):
        name = d.name
        u = urn(cfg, node, name)
        text = (d / "SKILL.md").read_text(errors="ignore")
        m = FM.match(text)
        if m is None:
            record(d / "SKILL.md", "no YAML frontmatter block (--- ... ---)", False)
        else:
            if fm.get("name") != name:
                record(d / "SKILL.md", "frontmatter name " + repr(fm.get("name"))
                       + " != directory name " + repr(name), False)
            if not str(fm.get("description") or "").strip():
                record(d / "SKILL.md", "frontmatter has no description", False)
        md = fm.get("metadata") or {}
        skills[u] = {
            "urn": u, "node": node, "name": name, "dir": rel(root, d),
            "description": str(fm.get("description") or ""),
            "scope": node,                         # the effective node — what the router uses
            "declared_scope": md.get("scope"),     # what the card claims
            "owner": md.get("owner"),
            "layer": md.get("layer"),
            "status": md.get("status"),
            "triggers": md_phrases(md, "triggers"),
            "requires": md_list(md, "requires"),
            "refines": md_list(md, "refines"),
            "replaces": md_list(md, "replaces"),
            "references": _report_declared_resources(md),
            "body_sha256": _sha256_bytes(text[m.end():].encode("utf-8", "surrogateescape")
                                          if m else text.encode("utf-8", "surrogateescape")),
        }

    resources, missing = _report_resolve_resources(root, skills)
    return {"root": root, "cfg": cfg, "skills": skills, "resources": resources,
            "missing_resources": missing, "invalid": invalid,
            "index": Index.build(root, cfg, on_error=lambda *_a: None)}


def _report_resolve_resources(root: Path, skills: dict):
    """({(skill_id, relpath): sha256}, [(skill_id, declared_entry, reason)]).

    Two sources: the files inside a skill's own `references/`/`scripts/`/`assets/` directory (the
    payload shipped with the card) and the repo files its `metadata.references`/`metadata.scripts`
    declare. Resolution of the declared ones is `root.glob(pattern)` — the same call `validate`
    makes — so "missing" here means exactly what "reference not found" means there."""
    resources, missing = {}, []
    for u in sorted(skills):
        s = skills[u]
        skill_dir = root / s["dir"]
        for sub in SCAN_RESOURCE_DIRS:
            base = skill_dir / sub
            if not base.is_dir():
                continue
            for f in sorted(base.rglob("*")):
                if f.is_file():
                    resources[(u, rel(root, f))] = _sha256_file(f)
        for raw in s["references"]:
            pattern, _, token = raw.partition("#")
            if not pattern or pattern.startswith("/") or ".." in pattern.split("/"):
                missing.append((u, raw, "not a repo-relative path"))
                continue
            try:
                matches = sorted(p for p in root.glob(pattern) if p.is_file())
            except (ValueError, IndexError):
                missing.append((u, raw, "not a usable glob pattern"))
                continue
            if not matches:
                missing.append((u, raw, "no file in the tree matches it"))
                continue
            if token and not any(token in p.read_text(errors="ignore") for p in matches):
                missing.append((u, raw, "token " + repr(token) + " not found in any match"))
            for p in matches:
                resources[(u, rel(root, p))] = _sha256_file(p)
    return resources, missing


def _report_field_changes(before: dict, after: dict) -> list:
    return [{"field": key, "base": before.get(key), "head": after.get(key)}
            for key in _REPORT_FIELD_KEYS if before.get(key) != after.get(key)]


def _report_renames(base_skills: dict, head_skills: dict, added: list, removed: list, aliases: list):
    """Renames, so a moved or re-scoped skill reads as one rename instead of add+remove (U1 AC5's
    rule, applied to the PR report). Two signals, in this order: an explicit `import.aliases`
    entry in `guidefold.yaml` (`_scan_aliases`), then an identical body sha256 — body only, never
    the whole file, because a legitimate move changes `metadata.scope` and would otherwise defeat
    content matching. Content matching is applied only when it is unambiguous (exactly one removed
    and one added card share the sha)."""
    renames = []
    used_from, used_to = set(), set()
    added_set, removed_set = set(added), set(removed)

    def key(p):
        p = str(p).strip().strip("/")
        return p[:-len("/SKILL.md")] if p.endswith("/SKILL.md") else p

    dir_base = {s["dir"]: u for u, s in base_skills.items()}
    dir_head = {s["dir"]: u for u, s in head_skills.items()}
    for alias in aliases:
        fu, tu = dir_base.get(key(alias["from"])), dir_head.get(key(alias["to"]))
        if fu in removed_set and tu in added_set and fu not in used_from and tu not in used_to:
            used_from.add(fu); used_to.add(tu)
            renames.append({"from": fu, "to": tu, "reason": "alias"})

    by_sha_removed, by_sha_added = {}, {}
    for u in removed:
        by_sha_removed.setdefault(base_skills[u]["body_sha256"], []).append(u)
    for u in added:
        by_sha_added.setdefault(head_skills[u]["body_sha256"], []).append(u)
    for sha in sorted(set(by_sha_removed) & set(by_sha_added)):
        rem = sorted(u for u in by_sha_removed[sha] if u not in used_from)
        add = sorted(u for u in by_sha_added[sha] if u not in used_to)
        if len(rem) == 1 and len(add) == 1:
            used_from.add(rem[0]); used_to.add(add[0])
            renames.append({"from": rem[0], "to": add[0], "reason": "identical_body_sha256"})

    for r in renames:
        r["fields"] = _report_field_changes(base_skills[r["from"]], head_skills[r["to"]])
    renames.sort(key=lambda r: (r["from"], r["to"]))
    return renames, used_from, used_to


def _report_relations(skills: dict) -> set:
    return {(kind, u, target) for u, s in skills.items()
            for kind in _REPORT_RELATION_KEYS for target in s[kind]}


def _report_changes(base: dict, head: dict):
    """The deterministic diff. Every list is sorted; nothing here reads a clock."""
    base_skills, head_skills = base["skills"], head["skills"]
    added = sorted(set(head_skills) - set(base_skills))
    removed = sorted(set(base_skills) - set(head_skills))
    renames, used_from, used_to = _report_renames(
        base_skills, head_skills, added, removed, _scan_aliases(head["cfg"]))
    added = [u for u in added if u not in used_to]
    removed = [u for u in removed if u not in used_from]

    changed = []
    for u in sorted(set(base_skills) & set(head_skills)):
        fields = _report_field_changes(base_skills[u], head_skills[u])
        if fields:
            changed.append({"skill_id": u, "fields": fields})

    base_nodes = base["cfg"].get("nodes") or {}
    head_nodes = head["cfg"].get("nodes") or {}
    scope_changed = []
    for n in sorted(set(base_nodes) & set(head_nodes)):
        b, h = base_nodes[n] or {}, head_nodes[n] or {}
        fields = [{"field": f, "base": b.get(f), "head": h.get(f)}
                  for f in ("paths", "owner") if b.get(f) != h.get(f)]
        if fields:
            scope_changed.append({"node": n, "fields": fields})

    base_rel, head_rel = _report_relations(base_skills), _report_relations(head_skills)
    rel_added = sorted(head_rel - base_rel)
    rel_removed = sorted(base_rel - head_rel)

    base_res, head_res = base["resources"], head["resources"]
    res_added = sorted(set(head_res) - set(base_res))
    res_removed = sorted(set(base_res) - set(head_res))
    res_changed = sorted(k for k in set(base_res) & set(head_res) if base_res[k] != head_res[k])

    return {
        "skills": {"added": added, "removed": removed, "renamed": renames, "changed": changed},
        "scopes": {"added": sorted(set(head_nodes) - set(base_nodes)),
                    "removed": sorted(set(base_nodes) - set(head_nodes)),
                    "changed": scope_changed},
        "relations": {
            "added": [{"relation": k, "from": f, "to": t} for k, f, t in rel_added],
            "removed": [{"relation": k, "from": f, "to": t} for k, f, t in rel_removed],
        },
        "resources": {
            "added": [{"skill_id": u, "path": p} for u, p in res_added],
            "removed": [{"skill_id": u, "path": p} for u, p in res_removed],
            "changed": [{"skill_id": u, "path": p, "base_sha256": base_res[(u, p)],
                          "head_sha256": head_res[(u, p)]} for u, p in res_changed],
        },
    }


def _report_structure_findings(base: dict, head: dict, changes: dict) -> list:
    """Errors first (they block), then the warnings PRODUCT-PIVOT §10 U7 keeps advisory."""
    findings = list(head["invalid"])
    skills = head["skills"]

    for key in ("requires", "refines"):
        graph = {u: [t for t in skills[u][key] if t in skills] for u in sorted(skills)}
        errs = []
        check_cycles(graph, key, errs)                       # the CLI's own detector, not a copy
        for e in sorted(set(errs)):
            label, _, path = e.partition(" cycle: ")
            chain = path.split(" -> ")
            findings.append(_report_finding(
                "error", "graph_cycle", label + " cycle: " + path,
                skill_id=chain[0] if chain else None,
                details={"relation": label, "path": chain}))

    for u in sorted(skills):
        for key in _REPORT_RELATION_KEYS:
            for target in skills[u][key]:
                if target not in skills:
                    findings.append(_report_finding(
                        "error", "missing_required_dependency",
                        u + ": metadata." + key + " points at " + target
                        + ", which no skill in the tree provides",
                        skill_id=u, details={"relation": key, "target": target}))

    for u, raw, reason in head["missing_resources"]:
        findings.append(_report_finding(
            "error", "missing_required_resource",
            u + ": declared resource " + repr(raw) + " — " + reason,
            skill_id=u, details={"entry": raw, "reason": reason}))

    nodes = set(head["cfg"].get("nodes") or {})
    for u in sorted(skills):
        s = skills[u]
        if not str(s.get("owner") or "").strip():
            findings.append(_report_finding(
                "warning", "missing_owner", u + ": no metadata.owner — nobody is on the hook for "
                "reviewing this skill", skill_id=u, details={"node": s["node"]}))
        declared = s.get("declared_scope")
        if declared is None or not str(declared).strip():
            findings.append(_report_finding(
                "warning", "unknown_scope", u + ": no metadata.scope; its path resolves to node "
                + s["node"], skill_id=u, details={"declared": None, "resolved": s["node"]}))
        elif str(declared) not in nodes:
            findings.append(_report_finding(
                "warning", "unknown_scope", u + ": metadata.scope " + repr(str(declared))
                + " is not a node in guidefold.yaml", skill_id=u,
                details={"declared": str(declared), "resolved": s["node"]}))
        elif str(declared) != s["node"]:
            findings.append(_report_finding(
                "warning", "unknown_scope", u + ": metadata.scope " + repr(str(declared))
                + " but its path resolves to node " + s["node"], skill_id=u,
                details={"declared": str(declared), "resolved": s["node"]}))

    pairs = [(u, u) for u in sorted(set(base["skills"]) & set(skills))]
    pairs += [(r["from"], r["to"]) for r in changes["skills"]["renamed"]]
    for bu, hu in sorted(pairs):
        b, h = base["skills"][bu], skills[hu]
        if b["scope"] != h["scope"] or b.get("declared_scope") != h.get("declared_scope"):
            findings.append(_report_finding(
                "warning", "scope_changed", hu + ": scope moved from " + str(b["scope"]) + " to "
                + str(h["scope"]) + " — inheritance and ownership change with it", skill_id=hu,
                details={"base_scope": b["scope"], "head_scope": h["scope"]}))
        if len(h["description"]) < len(b["description"]):
            findings.append(_report_finding(
                "warning", "description_shortened",
                hu + ": description shortened from " + str(len(b["description"])) + " to "
                + str(len(h["description"])) + " chars — the description is what the router "
                "matches on", skill_id=hu,
                details={"base_chars": len(b["description"]), "head_chars": len(h["description"])}))

    touched = ({r["to"] for r in changes["skills"]["renamed"]}
               | set(changes["skills"]["added"])
               | {c["skill_id"] for c in changes["skills"]["changed"]})
    findings += _report_trigger_collisions(head, touched)
    return findings


def _report_trigger_collisions(head: dict, touched: set) -> list:
    """Probable trigger collisions — a `warning`, never a block ("przypuszczalna kolizja
    ostrzega"). Same signal `tools/authoring/collision_report.py` calls the HSR proxy (two skills
    in the SAME node competing for the same queries), reduced to the part that needs no query set:
    two same-node cards carrying a trigger phrase that tokenises identically (`tokenize`, the one
    shared tokenizer). Only pairs this change actually touches are reported — a collision that
    predates the PR is not the PR's finding."""
    if not touched:
        return []
    by_node = {}
    for u, s in head["skills"].items():
        by_node.setdefault(s["node"], []).append(u)
    out = []
    for node in sorted(by_node):
        members = sorted(by_node[node])
        forms = {u: {" ".join(tokenize(t)): t for t in head["skills"][u]["triggers"]}
                 for u in members}
        for i, a in enumerate(members):
            for b in members[i + 1:]:
                if not ({a, b} & touched):
                    continue
                shared = sorted(k for k in set(forms[a]) & set(forms[b]) if k)
                if not shared:
                    continue
                phrases = sorted({forms[a][k] for k in shared} | {forms[b][k] for k in shared})
                out.append(_report_finding(
                    "warning", "trigger_collision",
                    a + " and " + b + " share " + str(len(shared)) + " trigger phrase(s) in node "
                    + node + ": " + ", ".join(repr(p) for p in phrases),
                    skill_id=a, details={"node": node, "other": b, "shared_triggers": phrases}))
    return out


def _report_route(router, query: str, node: str, k: int):
    """The product path, stage for stage, exactly as `_eval_run_cases` runs it (ADR-0022): the
    same admissibility decision governs candidates and `select`'s dependency expansion. Never
    `Router.route()`, which would collapse retrieval and injection into one list."""
    cands = router.candidates(query, node)
    scored = router.score(cands, query, node)
    admissible, _ = router.policy_filter(node, query)
    selected = router.select(scored, k=k, admissible=set(admissible))
    return [s["urn"] for s in scored[:_EVAL_RETRIEVAL_K]], [s["urn"] for s in selected]


def _report_retrieval(base: dict, head: dict, queries_path: str, k: int):
    """Retrieval EXAMPLE diff — never a proof (PRODUCT-PIVOT §10 U7: "Test retrievalu nie dowodzi
    wykonania procedury"). Same `--queries` shapes `guidefold eval` accepts, same product path,
    same `_eval_*` metric functions. Findings from here are always `warning`s."""
    import math
    cases, mode = _eval_load_queries(queries_path)
    base_router, head_router = Router(base["index"]), Router(head["index"])
    per_query, changed_ids, reordered_ids, hit_pairs, allreq_pairs, seen = [], [], [], [], [], set()
    for i, case in enumerate(cases):
        cid = str(case.get("id") or case.get("query") or ("case_" + str(i)))
        if cid in seen:
            n = 2
            while cid + "#" + str(n) in seen:
                n += 1
            cid = cid + "#" + str(n)
        seen.add(cid)
        query, node = str(case.get("query") or ""), str(case.get("node") or "_root")
        b_ret, b_sel = _report_route(base_router, query, node, k)
        h_ret, h_sel = _report_route(head_router, query, node, k)
        # A *set* change is what U7 asks for ("the selected set changed"); a same-set reorder is
        # reported separately because injection order is a presentation decision (general ->
        # specific), not a ranking signal — see run_golden.py's retrieval-vs-injection docstring.
        set_changed = set(b_sel) != set(h_sel)
        entry = {"id": cid, "query": query, "node": node, "base_selected": b_sel,
                 "head_selected": h_sel, "set_changed": set_changed,
                 "order_changed": (not set_changed) and b_sel != h_sel,
                 "changed": b_sel != h_sel}
        if mode == "golden" and not _eval_is_abstention_case(case):
            if b_ret and h_ret:
                hb, hh = _eval_hit_at_1(b_ret, case), _eval_hit_at_1(h_ret, case)
                entry["hit@1"] = {"base": hb, "head": hh, "delta": hh - hb}
                hit_pairs.append((hb, hh))
            ab = _eval_all_required_at_k(b_sel, case, k)
            ah = _eval_all_required_at_k(h_sel, case, k)
            if not (math.isnan(ab) or math.isnan(ah)):
                entry["all_required@" + str(k)] = {"base": ab, "head": ah, "delta": ah - ab}
                allreq_pairs.append((ab, ah))
        per_query.append(entry)
        if entry["set_changed"]:
            changed_ids.append(cid)
        elif entry["order_changed"]:
            reordered_ids.append(cid)

    def paired(pairs):
        if not pairs:
            return None
        b = sum(p[0] for p in pairs) / len(pairs)
        h = sum(p[1] for p in pairs) / len(pairs)
        return {"base": b, "head": h, "delta": h - b, "n": len(pairs)}

    deltas = None
    if mode == "golden":
        deltas = {"hit@1": paired(hit_pairs), "all_required@" + str(k): paired(allreq_pairs)}

    retrieval = {
        "mode": mode, "queries": str(queries_path), "k": k,
        "queries_sha256": _eval_query_file_sha256(queries_path),
        "n_queries": len(per_query), "n_changed": len(changed_ids),
        "n_reordered": len(reordered_ids), "changed_query_ids": changed_ids,
        "reordered_query_ids": reordered_ids, "deltas": deltas, "per_query": per_query,
        "note": "retrieval example, not procedure execution",
    }
    findings = []
    if changed_ids or reordered_ids:
        findings.append(_report_finding(
            "warning", "retrieval_selection_changed",
            str(len(changed_ids)) + " of " + str(len(per_query)) + " example queries select a "
            "different card set after this change (" + str(len(reordered_ids)) + " keep the same "
            "set in a different order) — retrieval example, not procedure execution",
            details={"n_changed": len(changed_ids), "n_reordered": len(reordered_ids),
                      "n_queries": len(per_query), "query_ids": changed_ids[:50],
                      "reordered_query_ids": reordered_ids[:50]}))
    for name, d in sorted((deltas or {}).items()):
        if d and d["delta"] != 0:
            findings.append(_report_finding(
                "warning", "retrieval_metric_delta",
                name + " moved " + ("%+.4f" % d["delta"]) + " on " + str(d["n"]) + " labelled "
                "example queries (retrieval example, not procedure execution)",
                details={"metric": name, **d}))
    return retrieval, findings


# --------------------------------------------------------------------------- rendering
def _report_md_list(lines: list, title: str, items: list, cap: int = REPORT_MD_LIST_CAP):
    if not items:
        return
    lines.append("**" + title + "** (" + str(len(items)) + ")")
    lines.append("")
    for item in items[:cap]:
        lines.append("- " + item)
    if len(items) > cap:
        lines.append("- … and " + str(len(items) - cap) + " more (see the JSON artifact)")
    lines.append("")


def _report_markdown(payload: dict) -> str:
    """A PR comment: <= REPORT_MD_MAX_LINES lines, deterministic, no clock. The first line is the
    hidden marker `tools/authoring/sticky_comment.py` finds and updates by, so a re-run replaces
    the comment instead of adding one (U7 AC: "Retry nie dubluje komentarza")."""
    s, c = payload["summary"], payload["changes"]
    head = payload["head_commit"][:7] if payload["head_commit"] else "working tree"
    lines = [REPORT_MARKER, "# Guidefold change report", "", "## Summary", "",
             "- base `" + (payload["base_commit"] or "?")[:7] + "` (`" + payload["base_ref"]
             + "`) → head `" + head + "`" + (" _+ uncommitted changes_" if payload["dirty"] else ""),
             "- structure: **" + str(s["errors"]) + " error(s)**, " + str(s["warnings"])
             + " warning(s) — `--fail-on " + payload["fail_on"] + "`",
             "- skills: +" + str(s["skills_added"]) + " / −" + str(s["skills_removed"]) + " / ~"
             + str(s["skills_changed"]) + " changed / " + str(s["skills_renamed"]) + " renamed",
             "- scopes changed: " + str(s["scopes_changed"]) + " · relations ±"
             + str(s["relations_added"]) + "/" + str(s["relations_removed"])
             + " · resources ±" + str(s["resources_added"]) + "/" + str(s["resources_removed"])
             + " (~" + str(s["resources_changed"]) + ")", ""]

    lines += ["## Structure", ""]
    errors = [f for f in payload["findings"] if f["severity"] == "error"]
    warnings = [f for f in payload["findings"] if f["severity"] == "warning"]
    if not errors and not warnings:
        lines += ["No structure findings.", ""]
    else:
        lines += ["| Severity | Code | Skill | Message |", "|---|---|---|---|"]
        shown = (errors + warnings)[:REPORT_MD_FINDING_CAP]
        for f in shown:
            msg = f["message"]
            if f.get("skill_id") and msg.startswith(f["skill_id"] + ": "):
                msg = msg[len(f["skill_id"]) + 2:]     # the Skill column already says which one
            msg = msg.replace("|", "\\|").replace("\n", " ")
            lines.append("| " + f["severity"] + " | `" + f["code"] + "` | "
                          + ("`" + f["skill_id"] + "`" if f.get("skill_id") else "—") + " | "
                          + msg + " |")
        if len(errors) + len(warnings) > len(shown):
            lines.append("| … | … | … | "
                          + str(len(errors) + len(warnings) - len(shown))
                          + " more finding(s) in the JSON artifact |")
        lines.append("")
        lines += ["Structure findings block the run; warnings never do "
                  "(`--fail-on structure` is the default).", ""]

    lines += ["## Changes", ""]
    changes_start = len(lines)
    _report_md_list(lines, "Skills added", ["`" + u + "`" for u in c["skills"]["added"]])
    _report_md_list(lines, "Skills removed", ["`" + u + "`" for u in c["skills"]["removed"]])
    _report_md_list(lines, "Skills renamed",
                    ["`" + r["from"] + "` → `" + r["to"] + "` (" + r["reason"] + ")"
                     for r in c["skills"]["renamed"]])
    _report_md_list(lines, "Skills changed",
                    ["`" + ch["skill_id"] + "`: " + ", ".join(f["field"] for f in ch["fields"])
                     for ch in c["skills"]["changed"]])
    _report_md_list(lines, "Scopes",
                    ["added `" + n + "`" for n in c["scopes"]["added"]]
                    + ["removed `" + n + "`" for n in c["scopes"]["removed"]]
                    + ["`" + ch["node"] + "`: " + ", ".join(f["field"] for f in ch["fields"])
                       for ch in c["scopes"]["changed"]])
    _report_md_list(lines, "Relations",
                    ["+ " + r["relation"] + " `" + r["from"] + "` → `" + r["to"] + "`"
                     for r in c["relations"]["added"]]
                    + ["− " + r["relation"] + " `" + r["from"] + "` → `" + r["to"] + "`"
                       for r in c["relations"]["removed"]])
    _report_md_list(lines, "Resources",
                    ["+ `" + r["path"] + "`" for r in c["resources"]["added"]]
                    + ["− `" + r["path"] + "`" for r in c["resources"]["removed"]]
                    + ["~ `" + r["path"] + "`" for r in c["resources"]["changed"]])
    if len(lines) == changes_start:
        lines += ["No skill, scope, relation or resource changed.", ""]

    lines += ["## Retrieval examples", ""]
    r = payload["retrieval"]
    if r is None:
        lines += ["Not run — no `--queries` and no `eval.queries` in `guidefold.yaml`.", ""]
    else:
        lines += ["_Retrieval example, not procedure execution: these queries show what the "
                  "router would select, not that any procedure was executed. They never block "
                  "the run on their own._", "",
                  "- " + str(r["n_changed"]) + " of " + str(r["n_queries"])
                  + " example queries select a different card set (`" + r["mode"] + "`, k="
                  + str(r["k"]) + "); " + str(r["n_reordered"])
                  + " keep the same set in a different order", ""]
        if r["deltas"]:
            lines += ["| Metric | base | head | Δ | n |", "|---|---|---|---|---|"]
            for name in sorted(r["deltas"]):
                d = r["deltas"][name]
                if not d:
                    continue
                lines.append("| " + name + " | " + ("%.4f" % d["base"]) + " | "
                              + ("%.4f" % d["head"]) + " | " + ("%+.4f" % d["delta"]) + " | "
                              + str(d["n"]) + " |")
            lines.append("")
        changed = [q for q in r["per_query"] if q["set_changed"]]
        if changed:
            lines += ["| Query | base selection | head selection |", "|---|---|---|"]
            for q in changed[:REPORT_MD_LIST_CAP]:
                lines.append("| `" + q["id"] + "` | "
                              + (", ".join("`" + u + "`" for u in q["base_selected"]) or "_none_")
                              + " | "
                              + (", ".join("`" + u + "`" for u in q["head_selected"]) or "_none_")
                              + " |")
            if len(changed) > REPORT_MD_LIST_CAP:
                lines.append("| … | " + str(len(changed) - REPORT_MD_LIST_CAP)
                              + " more in the JSON artifact | |")
            lines.append("")
        if r["reordered_query_ids"]:
            ids = r["reordered_query_ids"][:REPORT_MD_LIST_CAP]
            lines += ["Same set, different injection order: "
                      + ", ".join("`" + i + "`" for i in ids)
                      + (" … and " + str(len(r["reordered_query_ids"]) - len(ids)) + " more"
                         if len(r["reordered_query_ids"]) > len(ids) else ""), ""]

    lines.append("<sub>`" + REPORT_SCHEMA + "` · `guidefold report --base "
                 + payload["base_ref"] + "`</sub>")
    if len(lines) > REPORT_MD_MAX_LINES:
        lines = lines[:REPORT_MD_MAX_LINES - 1]
        lines.append("<sub>report truncated to " + str(REPORT_MD_MAX_LINES)
                     + " lines — the JSON artifact is complete.</sub>")
    return "\n".join(lines) + "\n"


def cmd_report(a, root, cfg):
    """P12/U7. Compare the skill corpus at `--base` with the working tree, block on structure,
    warn on everything else, and write a deterministic JSON + Markdown pair for CI."""
    import shutil
    import tempfile

    k = getattr(a, "k", None) or 4
    queries = getattr(a, "queries", None) or ((cfg.get("eval") or {}).get("queries") or None)
    work = Path(tempfile.mkdtemp(prefix="guidefold-report-"))
    try:
        base_commit, base_root, base_cfg = _report_extract_base(root, a.base, work)
        base = _report_scan_view(base_root, base_cfg)
        head = _report_scan_view(root, cfg)
        changes = _report_changes(base, head)
        findings = _report_structure_findings(base, head, changes)
        retrieval = None
        if queries:
            retrieval, extra = _report_retrieval(base, head, queries, k)
            findings += extra
        findings = _report_sorted_findings(findings)
    finally:
        shutil.rmtree(work, ignore_errors=True)

    head_commit, dirty = _report_head_commit_and_dirt(root)
    n_err = sum(1 for f in findings if f["severity"] == "error")
    n_warn = sum(1 for f in findings if f["severity"] == "warning")
    payload = {
        "schema": REPORT_SCHEMA,
        "cli_version": CLI_VERSION,
        "base_ref": a.base,
        "base_commit": base_commit,
        "head_commit": head_commit,
        "dirty": dirty,
        "fail_on": a.fail_on,
        "summary": {
            "errors": n_err, "warnings": n_warn,
            "skills_base": len(base["skills"]), "skills_head": len(head["skills"]),
            "skills_added": len(changes["skills"]["added"]),
            "skills_removed": len(changes["skills"]["removed"]),
            "skills_changed": len(changes["skills"]["changed"]),
            "skills_renamed": len(changes["skills"]["renamed"]),
            "scopes_changed": len(changes["scopes"]["changed"]) + len(changes["scopes"]["added"])
                              + len(changes["scopes"]["removed"]),
            "relations_added": len(changes["relations"]["added"]),
            "relations_removed": len(changes["relations"]["removed"]),
            "resources_added": len(changes["resources"]["added"]),
            "resources_removed": len(changes["resources"]["removed"]),
            "resources_changed": len(changes["resources"]["changed"]),
            "queries_changed": (retrieval or {}).get("n_changed") if retrieval else None,
        },
        "findings": findings,
        "changes": changes,
        "retrieval": retrieval,
    }
    # The one clock read in the whole command, and only when reproducibility was switched off:
    # `--reproducible` is the default precisely so a CI artifact is byte-identical across re-runs.
    if not getattr(a, "reproducible", True):
        payload["generated_at"] = _utc_now_iso()

    # Explicit UTF-8: these are CI artifacts and the markdown embeds skill descriptions
    # verbatim, so the platform default encoding on a `LANG=C` runner would raise
    # UnicodeEncodeError and kill the gate job on the first non-ASCII description.
    if getattr(a, "json", None):
        Path(a.json).write_text(json.dumps(payload, indent=2, sort_keys=True) + "\n",
                                encoding="utf-8")
    if getattr(a, "markdown", None):
        Path(a.markdown).write_text(_report_markdown(payload), encoding="utf-8")

    for f in findings:
        print(f["severity"].upper(), f["code"], "-", f["message"])
    print("guidefold report: base " + (base_commit or "?")[:7] + " -> head "
          + ((head_commit or "worktree")[:7]) + (" (dirty)" if dirty else "")
          + "; " + str(n_err) + " errors, " + str(n_warn) + " warnings; "
          + "skills +" + str(payload["summary"]["skills_added"])
          + " -" + str(payload["summary"]["skills_removed"])
          + " ~" + str(payload["summary"]["skills_changed"])
          + " renamed " + str(payload["summary"]["skills_renamed"]))
    if retrieval:
        print("retrieval example (not procedure execution): "
              + str(retrieval["n_changed"]) + "/" + str(retrieval["n_queries"])
              + " queries select a different card set, "
              + str(retrieval["n_reordered"]) + " only reordered")

    if a.fail_on == "any" and (n_err or n_warn):
        sys.exit(2)
    if a.fail_on == "structure" and n_err:
        sys.exit(2)
    sys.exit(0)


def cmd_publish(a, root, cfg):
    reg = registry_for(cfg, root)
    changed = set(subprocess.run(["git", "diff", "--name-only", "--relative", a.base], capture_output=True, text=True, cwd=root).stdout.split()) if a.changed else None
    sha = subprocess.run(["git", "rev-parse", "--short=7", "HEAD"], capture_output=True, text=True, cwd=root).stdout.strip() or "nogit"
    rev_id = a.revision or f"rev-{datetime.datetime.now(datetime.timezone.utc).strftime('%Y%m%d%H%M%S')}-{sha}"
    n = 0
    for d, node, fm in all_skills(root, cfg, include_generated=True):
        if changed is not None and not any(c.startswith(rel(root, d)) for c in changed):
            continue
        if a.only and a.only not in urn(cfg, node, d.name):
            continue
        md = fm.get("metadata") or {}
        desc = fm.get("description", "")
        if md.get("status") == "deprecated":
            desc = "DEPRECATED (see " + str(md.get("replaced_by", "?")) + ") " + desc
        print("publish", urn(cfg, node, d.name), "->", reg.publish(node, d.name, d, display=f"{node}/{d.name}", desc=desc, rev_id=rev_id))
        n += 1
    print(f"guidefold publish: {n} skills, revision {rev_id}")

def cmd_index(a, root, cfg):
    sha = _git_head_short(root)
    dest = index_cache_dir(sha)

    if getattr(a, "check", False):
        ok, problems = check_index_artifact(root, cfg, sha, dest)
        for p in problems:
            print("STALE", p)
        if not ok:
            sys.exit(1)
        print(f"guidefold index --check: artifact at {dest} matches sha={sha}")
        return

    pub = cfg["publisher"]
    lines = ["---", "name: hierarchy-index", f'description: "[{pub}] Generated map of all hierarchy nodes, owners and skills. Load once per session when unsure where you are."',
             "metadata:", "  scope: _index", f"  owner: {cfg['nodes']['_root'].get('owner')}", '  generated: "true"', "  status: active", "---", f"# {pub} skill hierarchy", ""]
    by_node = {}
    for d, node, fm in all_skills(root, cfg):
        by_node.setdefault(node, []).append((d.name, fm.get("description", "")))
    for node, spec in cfg["nodes"].items():
        lines.append(f"## {node}  (owner: {spec.get('owner')})  paths: {', '.join(spec.get('paths', []))}")
        for name, desc in sorted(by_node.get(node, [])):
            lines.append(f"- `{urn(cfg, node, name)}` — {desc[:120]}")
        lines.append("")
    out = root / ".agents" / "skills" / "hierarchy-index" / "SKILL.md"
    out.parent.mkdir(parents=True, exist_ok=True)
    out.write_text("\n".join(lines))
    print(out)

    # E1.4: build (or rebuild) the immutable binary retrieval artifact for this sha.
    manifest = write_index_artifact(root, cfg, dest, sha)
    evict_lru(cache_root() / "index", depth=1,
              cap=_cache_cap(cfg, "max_index_shas", DEFAULT_INDEX_CACHE_CAP))
    c = manifest["counts"]
    print(f"guidefold index: wrote artifact for sha={sha} to {dest} "
          f"(cards={c['cards']} terms={c['terms']} words={c['words']})")


# ---------------------------------------------------------- L0: scope cards
CARD_CAP = 80

def node_meta(cfg, node):
    return cfg["nodes"].get(node, {})

def digest_of(fm):
    md = fm.get("metadata", {})
    return md.get("digest") or fm.get("description", "")[:200]

def build_card(root, cfg, node, skills_by_node):
    chain = ancestors(node)                      # node first … _root last
    root_label = f"{cfg['publisher']} (root)"
    lines = [f"# Scope: {node if node != '_root' else root_label}",
             f"Owner: {node_meta(cfg, node).get('owner')} · Hierarchy (specific → general): {' → '.join(chain)}", ""]
    extra = root / (node_meta(cfg, node).get("paths", ["."])[0].split("*")[0]) / ".agents" / "NODE.md"
    if extra.exists():
        lines += [extra.read_text().strip(), ""]
    # ADR-0035: ascended scope maps first, root-most first, so a harness that only reads files
    # on disk (Copilot applyTo, Codex/Gemini nested AGENTS.md) gets the shape of the organisation
    # before any specific guidance. A map is a normal skill; it is pulled out of the bullet
    # list below so it is stated once.
    def _is_map(fm):
        md = fm.get("metadata") or {}
        return md.get("generated_by") == ASCEND_MARKER and md.get("ascend_kind") == "map"
    maps = [(n, name, fm) for n in reversed(chain) for name, fm in sorted(skills_by_node.get(n, [])) if _is_map(fm)]
    if maps:
        lines += ["## Scope map (general → specific)", ""]
        for n, name, fm in maps:
            lines.append(f"- **{root_label if n == '_root' else n}** `{urn(cfg, n, name)}` — {digest_of(fm)}")
        lines.append("")
    lines += ["## Inherited guidance (general → specific)", ""]
    for n in reversed(chain):                    # root first
        label = root_label if n == "_root" else n
        lines.append(f"### {label}  (owner: {node_meta(cfg, n).get('owner')})")
        for name, fm in sorted(skills_by_node.get(n, [])):
            if _is_map(fm):
                continue
            md = fm.get("metadata") or {}
            flag = f" **DEPRECATED → {md.get('replaced_by', '?')}**" if md.get("status") == "deprecated" else ""
            lines.append(f"- `{urn(cfg, n, name)}`{flag} — {digest_of(fm)}")
        if not skills_by_node.get(n):
            lines.append("- (no skills at this level yet)")
        lines.append("")
    lines += ["## How to get the full procedure",
              "Skills above are summaries. Before implementing anything platform-specific, run",
              f"`.agents/skills/guidefold/scripts/guidefold find \"<your task>\" --scope {node}` and then",
              "`guidefold load <urn>` for the 1–3 most relevant ones (follow `metadata.requires`).",
              "Generated by guidefold materialize — do not edit; edit guidefold.yaml, NODE.md or the skills instead.", ""]
    if len(lines) > CARD_CAP:
        sys.exit(f"guidefold: scope card for {node} exceeds {CARD_CAP} lines — shorten metadata.digest")
    return "\n".join(lines)

def cmd_materialize(a, root, cfg):
    skills_by_node = {}
    for d, node, fm in all_skills(root, cfg):
        skills_by_node.setdefault(node, []).append((d.name, fm))
    outputs = {}
    for node, spec in cfg["nodes"].items():
        node_dir = root if node == "_root" else root / spec["paths"][0].split("*")[0].rstrip("/")
        card = build_card(root, cfg, node, skills_by_node)
        outputs[node_dir / "AGENTS.md"] = card
        outputs[node_dir / "CLAUDE.md"] = "@AGENTS.md\n"
        outputs[node_dir / "GEMINI.md"] = "@AGENTS.md\n"
        if node != "_root":
            globs = ", ".join(f'"{g}"' for g in spec["paths"])
            outputs[root / ".github" / "instructions" / f"{node}.instructions.md"] = f"---\napplyTo: {globs}\n---\n{card}"
    stale = []
    for path, content in outputs.items():
        if a.check:
            if not path.exists() or path.read_text() != content:
                stale.append(str(path.relative_to(root)))
        else:
            path.parent.mkdir(parents=True, exist_ok=True)
            path.write_text(content)
            print("wrote", path.relative_to(root))
    if a.check and stale:
        print("STALE generated files (run guidefold materialize):\n  " + "\n  ".join(stale)); sys.exit(1)

# ------------------------------------------------- L1: hooks (Claude/Codex)
HOOK_WATCHDOG_SECONDS_DEFAULT = 3.0   # ROUTER-SPEC "Watchdog": hard deadline, 300ms warm budget

class _HookTimeout(Exception):
    pass

def _install_watchdog(seconds: float):
    """SIGALRM-based hard deadline: raises _HookTimeout if `seconds` elapse before `cancel()` is
    called. POSIX only — on a platform without SIGALRM (e.g. native Windows Python with no WSL)
    the hook simply runs without a hard deadline rather than crashing on `signal.SIGALRM`
    AttributeError; it is still bounded in practice by the 300ms warm-path budget. Returns a
    zero-arg `cancel` to call from a `finally` block (idempotent: safe even if never armed)."""
    if not hasattr(signal, "SIGALRM") or seconds <= 0:
        return lambda: None
    def _handler(signum, frame):
        raise _HookTimeout()
    previous = signal.signal(signal.SIGALRM, _handler)
    signal.setitimer(signal.ITIMER_REAL, seconds)
    def cancel():
        signal.setitimer(signal.ITIMER_REAL, 0)
        signal.signal(signal.SIGALRM, previous)
    return cancel

def _emit_timeout_marker(root: Path, sha: str):
    """Best-effort telemetry (docs/DESIGN.md "9 telemetry", a minimal slice of it): one JSONL
    line per watchdog timeout under .guidefold/telemetry/ (gitignored, generated — ADR-0012).
    Never allowed to raise: a broken telemetry write must not turn a timeout into a crash."""
    try:
        tdir = root / ".guidefold" / "telemetry"
        tdir.mkdir(parents=True, exist_ok=True)
        rec = {"event": "hook_timeout", "sha": sha,
               "ts": datetime.datetime.now(datetime.timezone.utc).isoformat(timespec="seconds")}
        with (tdir / "hook.jsonl").open("a") as f:
            f.write(json.dumps(rec, sort_keys=True) + "\n")
    except Exception:
        pass

def cmd_hook(a, root):
    """Claude Code UserPromptSubmit/SessionStart and Codex hooks pass JSON on stdin. We print
    plain text; the harness adds stdout to the model context (exit 0).

    E1.5: reads ONLY the pre-built index artifact at <cache_root>/index/<sha>/ — never
    guidefold.yaml, never the skill tree, never PyYAML. `cwd -> node` resolves from the
    artifact's own nodes.json (ROUTER-SPEC "Determinism by construction": an uncommitted
    working-tree edit must never silently reroute a running session).

    Contract: on ANY failure — no artifact yet for this sha, a corrupt artifact, unreadable
    stdin, a watchdog timeout — print nothing and return normally (exit 0). Injecting late or
    injecting from stale state is worse than injecting nothing."""
    sha = _git_head_short(root)
    seconds = float(os.environ.get("GUIDEFOLD_HOOK_TIMEOUT_S", HOOK_WATCHDOG_SECONDS_DEFAULT))
    # Arm the watchdog *inside* the try. With a deadline that has effectively already passed,
    # setitimer delivers SIGALRM synchronously inside _install_watchdog itself; if the arming
    # sits outside the try, _HookTimeout escapes cmd_hook and main(), and the hook exits 1 with
    # a traceback instead of exiting 0 silently. Observed on CPython 3.10 in CI while 3.11/3.12
    # happened to win the race — which is exactly why the contract is enforced by a test rather
    # than by timing luck.
    cancel = lambda: None
    try:
        cancel = _install_watchdog(seconds)
        try:
            payload = json.load(sys.stdin)
        except _HookTimeout:
            raise
        except Exception:
            payload = {}
        cwd = Path(payload.get("cwd") or Path.cwd())
        prompt = payload.get("prompt") or payload.get("user_prompt") or ""
        session_id = payload.get("session_id") or None   # E6.4: Claude Code's own hook payload
        # field, "where available" (Sec4) -- Codex/Copilot payloads observed so far don't carry
        # one, so this stays None there, not fabricated.
        dest = index_cache_dir(sha)
        if not (dest / "manifest.json").exists():
            # E1.5 keeps the prompt hook read-only and silent when the artifact for this sha is
            # missing -- and that silence is the most likely "it does nothing" a first-time user
            # sees after `init`, a checkout or a commit (PR #68). SessionStart runs once per session
            # and has no card budget, so it builds the artifact here (same writer as `index`);
            # the prompt hook stays read-only and says why it is idle on stderr -- never stdout,
            # which is the agent's context.
            if not prompt:
                try:
                    import yaml   # lazy, like every other optional import in this file
                    cfg = yaml.safe_load((root / "guidefold.yaml").read_text())
                    write_index_artifact(root, cfg, dest, sha)
                except _HookTimeout:
                    raise
                except Exception as e:      # say why, on stderr, instead of the silent no-op
                    print(f"[guidefold] index build failed for sha {sha}: {type(e).__name__}: {e}",
                          file=sys.stderr)
                    return
            else:
                print(f"[guidefold] hook idle: no index artifact for sha {sha}; run "
                      f"`.agents/skills/guidefold/scripts/guidefold index` or start a new session "
                      f"(SessionStart builds it)", file=sys.stderr)
                return
        idx = load_index_artifact(dest)
        try:
            relpath = rel(root, cwd)
        except ValueError:
            relpath = ""
        node = node_for({"nodes": idx.nodes}, relpath)
        if not prompt:                            # SessionStart: just announce scope
            owner = idx.nodes.get(node, {}).get("owner")
            print(f"[guidefold] scope={node} owner={owner} chain={'→'.join(ancestors(node))}")
            return
        if len(prompt) < 12:                      # skip trivial prompts ("yes", "continue")
            return
        # E6.4: no SEARCH is attempted above this line (SessionStart/trivial-prompt returns above
        # never reach the Router at all -- correctly, no search_requested for either). A ranking
        # exception from Router.route() itself is still caught only by the outer except Exception
        # below (unchanged), so this invocation's search_results is simply never written for that
        # rare case -- consistent with Sec5 "lost events reduce reported coverage" being expected
        # and reported as missing, never fabricated as a status.
        #
        # E2.6: search.backend config here comes ONLY from the environment (GUIDEFOLD_SEARCH_*) --
        # never from guidefold.yaml/PyYAML (E1.5's hard constraint, unaffected by this feature).
        # `seconds`/the SIGALRM watchdog above is a separate, portable crash deadline (ADR-0023
        # Sec3: "not the normal timeout or SLO"); the SEARCH deadline reported below and used for
        # the service race is search_cfg["deadline_ms"], never the watchdog value.
        import time
        search_id = _new_id()
        search_cfg = resolve_search_config(None, profile="hook")
        _emit_telemetry(root, "search_requested", {
            "search_id": search_id, "profile": "hook", "scope": node,
            "deadline_ms": search_cfg["deadline_ms"],
            "query_hmac": _query_hmac(prompt, root), "router_version": ROUTER_VERSION,
            "policy_version": POLICY_VERSION, "index_snapshot": sha,
            "backend": "online_sparse" if search_cfg["backend"] == "service" else "local_sparse",
        }, ids={"session_id": session_id})
        t0 = time.perf_counter()
        result = search_with_backend(root, Router(idx), prompt, node, profile="hook", k=3,
                                      search_id=search_id, search_cfg=search_cfg)
        elapsed_ms = round((time.perf_counter() - t0) * 1000, 3)
        top = result["selected"]
        _emit_telemetry(root, "search_results", {
            "search_id": search_id, "status": "ok" if top else "abstained",
            "fallback_reason": result["degradation_reason"], "backend": result["backend"],
            "results": [{"urn": c["urn"], "revision": c.get("revision") or sha,
                        "score": c["score"], "rank": i} for i, c in enumerate(top, start=1)],
            "timings": {"total_ms": elapsed_ms},
        }, ids={"session_id": session_id})
        if not top:
            return
        # ADR-0035: the nearest ascended scope map rides along ahead of the best card, in a
        # fourth slot (hook k=3, cap 4). Read from the artifact by URN only -- no YAML here.
        top = _with_parent_map(idx, top)
        print(f"[guidefold] Relevant organizational guidance for scope {node}:")
        for c in top:
            print(f"- {c['urn']} — {c['description'][:140]}")
        print("Load with: .agents/skills/guidefold/scripts/guidefold load <urn>  (follow metadata.requires).")
        exposed = []
        for position, c in enumerate(top, start=1):
            exposure_id = _new_id()
            exposed.append((c["urn"], c.get("revision") or sha, exposure_id))
            _emit_telemetry(root, "card_injected", {
                "exposure_id": exposure_id, "search_id": search_id, "skill_id": c["urn"],
                "revision": c.get("revision") or sha, "position": position, "surface": "hook",
                "delivery_evidence": "printed_stdout", "scope": node,   # see cmd_find's card_injected
                # for why: non-required, but lets report.py's distinct_scopes rollup mean something.
            }, ids={"session_id": session_id})
        _remember_exposures(root, search_id, exposed, session_id)
    except _HookTimeout:
        _emit_timeout_marker(root, sha)
        return                                    # print nothing — injecting late is worse
    except Exception:
        return                                    # ranking must never break the harness
    finally:
        cancel()

def cmd_prewarm(a, root, cfg):
    """Copilot sessionStart: output is ignored, side effects are not."""
    node = node_for(cfg, rel(root, Path.cwd()))
    reg = registry_for(cfg, root)
    for c in reg.search_scope(ancestors(node)):
        rev = reg.default_revision(c["urn"])
        dest = skill_cache_dir(c["urn"], rev)
        if (dest / "SKILL.md").exists():
            os.utime(dest, None)
            continue
        try:
            reg.download(c["urn"], dest, rev=rev)
        except SystemExit:
            pass
    evict_lru(cache_root() / "skills", depth=2, cap=_cache_cap(cfg, "max_skill_revisions", DEFAULT_SKILLS_CACHE_CAP))

# ------------------------------------------------------------ E6.4/E2.7 telemetry commands
def cmd_telemetry(a, root, cfg):
    if a.telemetry_cmd == "status":
        cmd_telemetry_status(a, root)
    elif a.telemetry_cmd == "flush":
        cmd_telemetry_flush(a, root, cfg)
    elif a.telemetry_cmd == "report":
        cmd_telemetry_report(a, root, cfg)
    else:
        sys.exit("guidefold telemetry: choose a subcommand: status | flush | report")

def _telemetry_partitions(root: Path) -> list:
    """[(tenant, environment, env_dir), ...] for every partition actually present on disk."""
    spool_root = root / ".guidefold" / "telemetry" / "spool"
    out = []
    if not spool_root.is_dir():
        return out
    for tenant_dir in sorted(p for p in spool_root.iterdir() if p.is_dir()):
        for env_dir in sorted(p for p in tenant_dir.iterdir() if p.is_dir()):
            out.append((tenant_dir.name, env_dir.name, env_dir))
    return out

def cmd_telemetry_status(a, root):
    """Counts, oldest queued age, and partitions -- a read-only inspection of the local spool.
    Never writes anything (no event is emitted just for looking at spool health)."""
    rows = []
    for tenant, env, env_dir in _telemetry_partitions(root):
        health = _read_health(_health_path(env_dir))
        queued = 0
        for f in sorted(env_dir.glob("events-*.jsonl")):
            queued += sum(1 for l in f.read_text(encoding="utf-8").splitlines() if l.strip())
        rows.append({
            "tenant": tenant, "environment": env, "queued": queued,
            "produced": health.get("produced", 0), "acknowledged": health.get("acknowledged", 0),
            "dropped": health.get("dropped", 0),
            "oldest_queued_age_s": _oldest_queued_age_s(env_dir),
        })
    if getattr(a, "json", False):
        print(json.dumps({"partitions": rows}, indent=2))
        return
    if not rows:
        print("guidefold telemetry status: spool is empty")
        return
    for r in rows:
        print(f"{r['tenant']}/{r['environment']}: queued={r['queued']} produced={r['produced']} "
              f"acknowledged={r['acknowledged']} dropped={r['dropped']} "
              f"oldest_queued_age_s={r['oldest_queued_age_s']}")

def _flush_token(a, cfg) -> str:
    """The bearer for `telemetry flush`, in precedence order: `--token-file`, then the same
    `search.token_file` (or `GUIDEFOLD_SEARCH_TOKEN_FILE`) that `find`/`load` already use.

    `/v1/events:batch` authenticates exactly like `/v1/search` and `/v1/use` -- one credential
    for the whole delivery contract (docs/HARNESS-SERVICE-CONTRACT.md). Without this the flush
    could only ever reach the unauthenticated demo ingest server, never the real service, which
    answers `401 unauthorized`. The token is read from a file and never printed or logged."""
    path = (getattr(a, "token_file", None) or "").strip()
    if path:
        try:
            return Path(path).expanduser().read_text(encoding="utf-8").strip()
        except OSError as e:
            _die(f"telemetry flush: cannot read --token-file: {e}", 2)
    return (resolve_search_config(cfg, profile="interactive").get("token") or "").strip()


def cmd_telemetry_flush(a, root, cfg=None):
    """POST queued events to `--url`/v1/events:batch in batches of at most
    TELEMETRY_FLUSH_BATCH_MAX, one tenant/environment partition at a time. The credential is a
    bearer token (see `_flush_token`); the X-Guidefold-Tenant header stays for the
    unauthenticated demo ingest server (tools/telemetry/ingest_server.py) and is never what a
    real service trusts (docs/SEARCH-USE-TELEMETRY.md Sec4/Sec5). Only events the server did NOT resolve
    (neither accepted, duplicate, nor rejected) stay queued for a future flush; rejected
    (bad-schema) events are logged and dropped too, since resending an invalid event never becomes
    valid. Never invoked from `hook` -- no call to this function exists there -- and it makes a
    network call only when a human or CI explicitly runs it."""
    import urllib.request, urllib.error
    token = _flush_token(a, cfg)
    totals = {"sent": 0, "accepted": 0, "duplicate": 0, "rejected": 0}
    for tenant, env, env_dir in _telemetry_partitions(root):
        health_path = _health_path(env_dir)
        health = _read_health(health_path)
        for f in sorted(env_dir.glob("events-*.jsonl")):
            parsed = []
            for line in f.read_text(encoding="utf-8").splitlines():
                if not line.strip():
                    continue
                try:
                    parsed.append((line, json.loads(line)))
                except Exception:
                    continue   # corrupt line: can't be usefully retried, drop silently
            resolved_ids, newly_acked = set(), 0
            for i in range(0, len(parsed), TELEMETRY_FLUSH_BATCH_MAX):
                batch = [ev for _, ev in parsed[i:i + TELEMETRY_FLUSH_BATCH_MAX]]
                if not batch:
                    continue
                body = json.dumps({"events": batch}).encode("utf-8")
                headers = {"Content-Type": "application/json", "X-Guidefold-Tenant": tenant}
                if token:
                    headers["Authorization"] = "Bearer " + token
                req = urllib.request.Request(
                    a.url.rstrip("/") + "/v1/events:batch", data=body, method="POST",
                    headers=headers)
                try:
                    resp = urllib.request.urlopen(req, timeout=10)
                    result = json.loads(resp.read().decode("utf-8"))
                except Exception as e:
                    print(f"guidefold telemetry flush: {tenant}/{env}/{f.name}: batch failed: {e}")
                    continue   # leave these events queued; retry on the next flush
                totals["sent"] += len(batch)
                for eid in result.get("accepted", []):
                    resolved_ids.add(eid); totals["accepted"] += 1; newly_acked += 1
                for eid in result.get("duplicate", []):
                    resolved_ids.add(eid); totals["duplicate"] += 1; newly_acked += 1
                for r in result.get("rejected", []):
                    eid = r.get("event_id")
                    if eid:
                        resolved_ids.add(eid)
                    totals["rejected"] += 1
                    print(f"guidefold telemetry flush: rejected {eid}: {r.get('reason')}")
            if resolved_ids:
                kept = [line for line, ev in parsed if ev.get("event_id") not in resolved_ids]
                if kept:
                    f.write_text("\n".join(kept) + "\n", encoding="utf-8")
                else:
                    f.unlink()
                health["acknowledged"] = health.get("acknowledged", 0) + newly_acked
        _write_health(health_path, health)
    print(f"guidefold telemetry flush: sent={totals['sent']} accepted={totals['accepted']} "
          f"duplicate={totals['duplicate']} rejected={totals['rejected']}")

def cmd_telemetry_report(a, root, cfg):
    """Wraps tools/telemetry/report.py (stdlib-only) if this is a guidefold tool checkout, not
    just a shipped skill install -- report.py is not part of the skill ZIP (see TOOL_REPO_ROOT
    below), so a consumer monorepo without that checkout gets a clear message instead of a
    traceback."""
    report_script = TOOL_REPO_ROOT / "tools" / "telemetry" / "report.py"
    if not report_script.is_file():
        sys.exit("guidefold telemetry report: tools/telemetry/report.py not found (only available "
                  "from a guidefold tool checkout, not a shipped skill install)")
    db = a.db or str(root / ".guidefold" / "telemetry" / "ledger.sqlite3")
    cmd = [sys.executable, str(report_script), "--db", db, "--format", a.format]
    if a.tenant:
        cmd += ["--tenant", a.tenant]
    if a.roster_file:
        cmd += ["--roster-file", a.roster_file]
    out = subprocess.run(cmd, capture_output=True, text=True)
    if out.returncode != 0:
        sys.exit(f"guidefold telemetry report: {out.stderr.strip() or 'report.py failed'}")
    sys.stdout.write(out.stdout)

# ------------------------------------------------------------ init / doctor
# E0.4: `guidefold init` bootstraps a *consumer* monorepo (guidefold.yaml skeleton,
# .agents/skills/guidefold, harness hooks, CI workflow, .gitignore) in one idempotent command;
# `guidefold doctor` diagnoses one and prints a concrete fix for every failure. Both must work
# on a repo that has no guidefold.yaml yet, so neither uses repo_root()/load_map() (which
# require one) — see _target_root() and _check_guidefold_yaml() below.

SCRIPT_PATH = Path(__file__).resolve()
TOOL_SKILL_SRC = SCRIPT_PATH.parent.parent            # .../skills/guidefold (the distributable unit)
TOOL_REPO_ROOT = TOOL_SKILL_SRC.parent.parent          # the guidefold tool checkout, if run from one
TOOL_TEMPLATES_DIR = TOOL_REPO_ROOT / "templates"

# harness -> (template filename under skills/guidefold/hooks/, dest path relative to consumer root)
# Claude and Copilot destinations match docs/CONVENTIONS.md §10. Codex is installed repo-local
# (.codex/hooks.json) rather than at CONVENTIONS.md's documented ~/.codex/hooks.json: `init`
# only ever touches the target repo, never the invoking user's home directory, and the shipped
# codex.hooks.json template's own hook command is repo-relative anyway
# (".agents/skills/guidefold/scripts/guidefold hook"), which only resolves correctly when the
# harness's cwd is the repo root — true for a repo-local hook file, not guaranteed for a global
# one shared across every repo on the machine. docs/ASSESSMENT.md's Day-1 checklist already
# flags <project>/.codex/hooks.json as the thing to test, with ~/.codex/hooks.json kept as a
# documented fallback for Codex builds that hit issue #17532 (repo-local hooks not firing).
HARNESS_HOOK_FILES = {
    "claude":  ("claude.settings.json", ".claude/settings.json"),
    "copilot": ("copilot.hooks.json",   ".github/hooks/guidefold.json"),
    "codex":   ("codex.hooks.json",     ".codex/hooks.json"),
    # No template ships for Gemini CLI (it has no session hook); `install` reports it as skipped
    # and relies on the materialized GEMINI.md/AGENTS.md cards instead.
    "gemini":  ("gemini.hooks.json",    "GEMINI.md"),
}


def _target_root() -> Path:
    """Resolve the target repo for init/doctor. Mirrors repo_root()'s search (env var, nearest
    guidefold.yaml ancestor, git toplevel) but never exits — init runs before guidefold.yaml
    exists, and doctor must always produce a report, even outside a git repo."""
    env = os.environ.get("GUIDEFOLD_ROOT")
    if env:
        return Path(env).resolve()
    here = Path.cwd().resolve()
    for d in (here, *here.parents):
        if (d / "guidefold.yaml").is_file():
            return d
    try:
        out = subprocess.run(["git", "rev-parse", "--show-toplevel"], capture_output=True, text=True, timeout=5)
        if out.returncode == 0 and out.stdout.strip():
            return Path(out.stdout.strip()).resolve()
    except Exception:
        pass
    return here


_SLUG_RE = re.compile(r"[^a-z0-9]+")

def _slugify(s: str) -> str:
    s = _ascii_lower(s or "")
    s = _SLUG_RE.sub("-", s).strip("-")
    return s or "org"


def _infer_publisher(root: Path, override: str = None) -> str:
    if override:
        return _slugify(override)
    try:
        out = subprocess.run(["git", "config", "--get", "remote.origin.url"],
                              capture_output=True, text=True, cwd=root, timeout=5)
        if out.returncode == 0 and out.stdout.strip():
            name = out.stdout.strip().rstrip("/").rsplit("/", 1)[-1]
            if name.endswith(".git"):
                name = name[:-4]
            if name:
                return _slugify(name)
    except Exception:
        pass
    return _slugify(root.name)


def _infer_owner_from_codeowners(root: Path) -> str:
    """Best-effort whole-repo owner from a CODEOWNERS `* @org/team` (or `/*`, `**`, `/**`) rule.
    Falls back to "unknown" (the same default load_map() uses for a node with no explicit
    owner) when there's no CODEOWNERS file, or no whole-repo rule in it."""
    for candidate in (root / "CODEOWNERS", root / ".github" / "CODEOWNERS", root / "docs" / "CODEOWNERS"):
        if not candidate.is_file():
            continue
        for line in candidate.read_text(errors="ignore").splitlines():
            line = line.split("#", 1)[0].strip()
            if not line:
                continue
            parts = line.split()
            if len(parts) < 2 or parts[0] not in ("*", "/*", "**", "/**"):
                continue
            owner = parts[1].lstrip("@")
            return owner.rsplit("/", 1)[-1]
    return "unknown"


def _render_guidefold_yaml(publisher: str, owner: str) -> str:
    # Written as plain text, not yaml.dump(), so `init` never needs to import PyYAML (the CLI
    # stays lazy about it — see load_map()); publisher/owner are already slug-safe bare scalars.
    return (
        "# Guidefold hierarchy map — generated by `guidefold init`.\n"
        "# Add one node per team/component as your monorepo grows; see templates/guidefold.example.yaml\n"
        "# in the guidefold tool repo for a worked multi-node example.\n"
        f"publisher: {publisher}\n"
        "registry:\n"
        "  backend: local              # local | agent-registry — flip once you publish to Agent Registry\n"
        "nodes:\n"
        "  _root:\n"
        '    paths: ["**"]\n'
        f"    owner: {owner}\n"
    )


def _plan_guidefold_yaml(plan, root: Path, publisher: str, owner: str):
    dest = root / "guidefold.yaml"
    if dest.is_file():
        plan.add("kept", "guidefold.yaml", "already exists — never rewritten")
        return
    plan.add("create", "guidefold.yaml", f"publisher={publisher}, _root owner={owner}")
    plan.writes.append((dest, _render_guidefold_yaml(publisher, owner).encode("utf-8"), False))


def _stamped_skill_md(text: str, publisher: str, owner: str) -> str:
    """skills/guidefold/SKILL.md ships as a template (see its own header comment): its
    description embeds a literal `<publisher>` placeholder and its metadata.owner is hardcoded
    to "platform-engineering" — both would otherwise fail `guidefold validate` in every
    consumer repo whose publisher/root-owner differ. `init` stamps in the real values so a
    freshly-bootstrapped repo validates clean without a manual edit. Stamping happens before
    the digest is taken, so the manifest records what actually lands on disk."""
    return text.replace("<publisher>", publisher).replace("owner: platform-engineering", f"owner: {owner}")


def _plan_skill_dir(plan, root: Path, publisher: str, owner: str, recorded: dict) -> dict:
    """Plan .agents/skills/guidefold file by file against the recorded digests, the same way
    `install` does. The previous all-or-nothing copy skipped the whole directory once it
    existed, so a copy interrupted partway through was never repaired by a rerun."""
    files = {}
    dest_dir = root / ADAPTER_DEST_REL
    if dest_dir.resolve() == TOOL_SKILL_SRC.resolve():
        plan.add("kept", ADAPTER_DEST_REL, "this is the guidefold tool checkout itself")
        return files
    if not TOOL_SKILL_SRC.is_dir():
        plan.add("kept", ADAPTER_DEST_REL,
                 f"cannot find {TOOL_SKILL_SRC} — run `init` from a full guidefold checkout")
        return files
    for rel_path in _package_files(TOOL_SKILL_SRC):
        src = TOOL_SKILL_SRC / rel_path
        content = src.read_bytes()
        if rel_path == "SKILL.md":
            content = _stamped_skill_md(content.decode("utf-8"), publisher, owner).encode("utf-8")
        target = f"{ADAPTER_DEST_REL}/{rel_path}"
        executable = bool(src.stat().st_mode & 0o111)
        files[target] = _plan_file(plan, root, target, content, recorded.get(target), executable)
    return files


# Every shipped hook template invokes the CLI at its installed path. That string, and not JSON
# equality, is what identifies an entry as ours: an entry whose command points at our script was
# written by some version of guidefold, so a rerun replaces it. Dedupe by equality cannot do that
# — when the template changes between versions the old entry is no longer equal to the new one,
# so both end up in the file and the hook fires twice.
HOOK_ENTRY_MARKER = ".agents/skills/guidefold/scripts/guidefold"


def _is_guidefold_hook_entry(entry) -> bool:
    try:
        return HOOK_ENTRY_MARKER in json.dumps(entry)
    except (TypeError, ValueError):
        return False


def _merge_hook_config(existing: dict, template: dict):
    """Reconcile `template` into `existing`: top-level scalar keys are added only if absent; per
    event, entries that belong to guidefold are replaced by the template's, and every entry the
    consumer owns is kept in its original order. Re-merging the same template is a no-op, which
    is what makes `init` idempotent; re-merging a *changed* template replaces the stale entry
    instead of adding a second one. Returns (merged, changed)."""
    merged = json.loads(json.dumps(existing)) if existing else {}
    changed = False
    for k, v in template.items():
        if k == "hooks":
            merged.setdefault("hooks", {})
            for event, entries in (v or {}).items():
                bucket = merged["hooks"].setdefault(event, [])
                before = json.dumps(bucket)
                at = next((i for i, e in enumerate(bucket) if _is_guidefold_hook_entry(e)), len(bucket))
                kept = [e for e in bucket if not _is_guidefold_hook_entry(e)]
                bucket[:] = kept[:at] + list(entries) + kept[at:]
                if json.dumps(bucket) != before:
                    changed = True
        elif k not in merged:
            merged[k] = v
            changed = True
    return merged, changed


def _plan_hook(plan, root: Path, harness: str, hooks: dict, blockers: list):
    tmpl_name, dest_rel = HARNESS_HOOK_FILES[harness]
    tmpl_path = TOOL_SKILL_SRC / "hooks" / tmpl_name
    if not tmpl_path.is_file():
        plan.add("kept", dest_rel, f"no {tmpl_name} template shipped — skipped")
        return
    template = json.loads(tmpl_path.read_text(encoding="utf-8"))
    dest = root / dest_rel
    existing = {}
    if dest.is_file():
        try:
            existing = json.loads(dest.read_text(encoding="utf-8"))
        except json.JSONDecodeError as e:
            # A half-written file from an interrupted run reads as invalid JSON. Merging into it
            # is impossible and overwriting it would discard whatever the consumer had, so this
            # is the one state `init` cannot reconcile: say so and fail, rather than warn and
            # exit 0 while the install stays broken across every CI retry.
            blockers.append(f"{dest_rel} is not valid JSON ({e}); "
                            f"restore it from git or delete it, then re-run `guidefold init`")
            plan.add("kept", dest_rel, "unparseable JSON — cannot reconcile")
            return
    merged, changed = _merge_hook_config(existing, template)
    hooks[dest_rel] = tmpl_name
    if not changed:
        plan.add("unchanged", dest_rel, f"{harness} hook")
        return
    plan.add("update" if dest.is_file() else "create", dest_rel, f"{harness} hook")
    plan.writes.append((dest, (json.dumps(merged, indent=2) + "\n").encode("utf-8"), False))


def _plan_github_action(plan, root: Path):
    src = TOOL_TEMPLATES_DIR / "github-workflows-skills.yml"
    dest_rel = ".github/workflows/skills.yml"
    if (root / dest_rel).is_file():
        plan.add("kept", dest_rel, "already exists — never rewritten")
        return
    if not src.is_file():
        plan.add("kept", dest_rel,
                 "no workflow template here — run `init` from a full guidefold checkout")
        return
    plan.add("create", dest_rel)
    plan.writes.append((root / dest_rel, src.read_bytes(), False))


def _plan_gitignore(plan, root: Path):
    dest = root / ".gitignore"
    marker = ".guidefold/"
    existing = dest.read_text(encoding="utf-8") if dest.is_file() else ""
    if any(line.strip() == marker for line in existing.splitlines()):
        plan.add("unchanged", ".gitignore", f"already ignores {marker}")
        return
    addition = ("" if not existing or existing.endswith("\n") else "\n")
    addition += "\n# generated guidefold artifacts (ADR-0012): cards, index, cache\n" + marker + "\n"
    plan.add("update" if existing else "create", ".gitignore", f"add {marker}")
    plan.writes.append((dest, (existing + addition).encode("utf-8"), False))


def cmd_init(a):
    """Bootstrap a consumer monorepo, reconciling whatever a previous run left behind.

    `init` lands several files and merges harness hook config, so a run that fails partway
    leaves a partial install. Every rerun therefore plans against the recorded digests in
    .agents/skills/guidefold/INSTALL-MANIFEST.json: a file we wrote and is now missing or stale
    is restored, a file the consumer edited is kept, a hook entry pointing at our CLI is
    replaced rather than duplicated, and a state that cannot be reconciled exits non-zero."""
    root = _target_root()
    dry = a.dry_run
    publisher = _infer_publisher(root, a.publisher)
    owner = _infer_owner_from_codeowners(root)
    harnesses = ("claude", "copilot", "codex") if a.harness == "all" else (a.harness,)
    print(f"guidefold init — target repo: {root}")

    manifest = _read_install_manifest(root)
    recorded = manifest.get("files") if isinstance(manifest.get("files"), dict) else {}
    hooks = manifest.get("hooks") if isinstance(manifest.get("hooks"), dict) else {}
    plan = _InstallPlan()
    blockers = []

    _plan_guidefold_yaml(plan, root, publisher, owner)
    files = _plan_skill_dir(plan, root, publisher, owner, recorded)
    for h in harnesses:
        _plan_hook(plan, root, h, hooks, blockers)
    _plan_github_action(plan, root)
    _plan_gitignore(plan, root)

    new_manifest = {
        "format": INSTALL_MANIFEST_FORMAT,
        "cli_version": CLI_VERSION,
        "harnesses": sorted(set(manifest.get("harnesses") or []) | set(harnesses)),
        "files": files or recorded,
        "hooks": hooks,
    }
    manifest_bytes = _canonical_json(new_manifest) + b"\n"
    manifest_path = _install_manifest_path(root)
    manifest_rel = f"{ADAPTER_DEST_REL}/{INSTALL_MANIFEST_NAME}"
    manifest_changed = not manifest_path.is_file() or manifest_path.read_bytes() != manifest_bytes
    if files:
        if manifest_changed:
            plan.add("update" if manifest_path.is_file() else "create", manifest_rel)
        else:
            plan.add("unchanged", manifest_rel)

    plan.render("  ")
    if blockers:
        print()
        for b in blockers:
            print(f"  error: {b}")
        print("  nothing was written.")
        sys.exit(1)

    if dry:
        print()
        print("  [dry-run] nothing was written.")
        return
    if not plan.changed and not manifest_changed:
        print()
        print("  nothing to do — this repo is already bootstrapped and current.")
        print("  Next: run `guidefold doctor` to verify the setup.")
        return

    for dest, content, executable in plan.writes:
        _atomic_write_bytes(dest, content, executable)
    if files:
        _atomic_write_bytes(manifest_path, manifest_bytes, False)
    print()
    print("  Next: run `guidefold doctor` to verify the setup.")


# ---------------------------------------------------------------------- doctor

def _doctor_check(name: str, status: str, detail: str, fix: str = None) -> dict:
    return {"name": name, "status": status, "detail": detail, "fix": fix}


def _check_python() -> dict:
    v = sys.version_info
    ok = (v.major, v.minor) >= (3, 10)
    detail = f"Python {v.major}.{v.minor}.{v.micro}"
    return _doctor_check("python-version", "ok" if ok else "warn", detail,
                          None if ok else "upgrade to Python 3.10+ (CI matrix: 3.10, 3.11, 3.12)")


def _check_cli_compiles(root: Path) -> dict:
    cli_path = root / ".agents" / "skills" / "guidefold" / "scripts" / "guidefold"
    if not cli_path.is_file():
        return _doctor_check("cli-installed", "fail", "no .agents/skills/guidefold/scripts/guidefold found",
                              "run `guidefold init` to install the CLI into .agents/skills/guidefold/")
    import py_compile, tempfile
    try:
        with tempfile.TemporaryDirectory() as td:
            py_compile.compile(str(cli_path), cfile=str(Path(td) / "out.pyc"), doraise=True)
        return _doctor_check("cli-compiles", "ok", f"{rel(root, cli_path)} compiles cleanly")
    except py_compile.PyCompileError as e:
        return _doctor_check("cli-compiles", "fail", f"{rel(root, cli_path)} failed to compile: {e.exc_value}",
                              "fix the syntax error, or re-run `guidefold init`")
    except Exception as e:
        return _doctor_check("cli-compiles", "fail", f"could not compile {rel(root, cli_path)}: {e}",
                              "re-run `guidefold init`")


def _check_guidefold_yaml(root: Path):
    """Returns (checks, cfg) — cfg is None if guidefold.yaml is missing/unparseable, so later
    checks that need it (skill layout, registry backend) can degrade to a single "skipped" entry
    instead of crashing."""
    checks = []
    yaml_path = root / "guidefold.yaml"
    if not yaml_path.is_file():
        checks.append(_doctor_check("guidefold-yaml", "fail", "guidefold.yaml not found at repo root",
                                     "run `guidefold init` to create a skeleton"))
        return checks, None
    checks.append(_doctor_check("guidefold-yaml", "ok", "guidefold.yaml found"))
    try:
        import yaml
    except ImportError:
        checks.append(_doctor_check("guidefold-yaml-parses", "fail", "PyYAML not installed",
                                     "pip install pyyaml"))
        return checks, None
    try:
        cfg = yaml.safe_load(yaml_path.read_text())
    except Exception as e:
        checks.append(_doctor_check("guidefold-yaml-parses", "fail", f"guidefold.yaml did not parse: {e}",
                                     "fix the YAML syntax error in guidefold.yaml"))
        return checks, None
    if not isinstance(cfg, dict) or not cfg.get("publisher"):
        checks.append(_doctor_check("guidefold-yaml-parses", "fail",
                                     "guidefold.yaml parsed but is missing a top-level `publisher:`",
                                     "add `publisher: <your-org>` to guidefold.yaml"))
        return checks, None
    checks.append(_doctor_check("guidefold-yaml-parses", "ok", f"publisher={cfg['publisher']}"))
    cfg.setdefault("nodes", {}).setdefault("_root", {"paths": ["**"], "owner": "unknown"})
    bad_nodes = [n for n, spec in cfg["nodes"].items() if not spec.get("paths") or not spec.get("owner")]
    if bad_nodes:
        checks.append(_doctor_check("guidefold-yaml-nodes", "fail",
                                     f"node(s) missing paths/owner: {', '.join(sorted(bad_nodes))}",
                                     "add `paths:` and `owner:` to every node in guidefold.yaml"))
    else:
        checks.append(_doctor_check("guidefold-yaml-nodes", "ok",
                                     f"{len(cfg['nodes'])} node(s), all have paths+owner"))
    empty = []
    for node, spec in cfg["nodes"].items():
        matched = False
        for g in spec.get("paths", []) or []:
            try:
                if next(iter(root.glob(g)), None) is not None:
                    matched = True
                    break
            except Exception:
                pass
        if not matched:
            empty.append(node)
    if empty:
        checks.append(_doctor_check("guidefold-yaml-globs", "warn",
                                     f"node(s) whose path globs match nothing yet: {', '.join(sorted(empty))}",
                                     "check the `paths:` globs, or remove the node until it has code"))
    else:
        checks.append(_doctor_check("guidefold-yaml-globs", "ok", "every node's path globs match at least one path"))
    return checks, cfg


def _check_skill_layout(root: Path, cfg) -> list:
    if cfg is None:
        return [_doctor_check("skill-layout", "warn", "skipped (guidefold.yaml invalid)", None)]
    checks = []
    try:
        skills = list(all_skills(root, cfg))
    except Exception as e:
        checks.append(_doctor_check("skill-layout", "fail", f"error scanning .agents/skills: {e}",
                                     "check every SKILL.md's frontmatter is valid YAML"))
        checks.append(_doctor_check("validate", "warn", "skipped (skill layout scan failed)", None))
        return checks
    if not skills:
        checks.append(_doctor_check("skill-layout", "warn", "no SKILL.md found under any .agents/skills/",
                                     "add at least one skill (fine to ignore for a brand-new repo)"))
    else:
        checks.append(_doctor_check("skill-layout", "ok", f"{len(skills)} skill(s) found"))
    try:
        _, errors = _validate_errors(root, cfg)
    except Exception as e:
        checks.append(_doctor_check("validate", "fail", f"validate crashed: {e}",
                                     "run `guidefold validate` directly for the full traceback"))
        return checks
    if errors:
        checks.append(_doctor_check("validate", "fail", f"{len(errors)} validation error(s), e.g. {errors[0]}",
                                     "run `guidefold validate` for the full list and fix each SKILL.md"))
    else:
        checks.append(_doctor_check("validate", "ok", f"{len(skills)} skill(s), 0 errors"))
    return checks


def _check_hook(root: Path, harness: str) -> dict:
    _tmpl_name, dest_rel = HARNESS_HOOK_FILES[harness]
    dest = root / dest_rel
    if not dest.is_file():
        return _doctor_check(f"hook-{harness}", "warn", f"{dest_rel} not found",
                              f"run `guidefold init --harness {harness}` to install it")
    try:
        cfg_json = json.loads(dest.read_text())
    except Exception as e:
        return _doctor_check(f"hook-{harness}", "fail", f"{dest_rel} is not valid JSON: {e}",
                              f"fix or remove {dest_rel}, then re-run `guidefold init --harness {harness}`")
    if "scripts/guidefold" not in json.dumps(cfg_json):
        return _doctor_check(f"hook-{harness}", "warn", f"{dest_rel} exists but doesn't reference scripts/guidefold",
                              f"re-run `guidefold init --harness {harness}` to add the guidefold hook")
    cli_path = root / ".agents" / "skills" / "guidefold" / "scripts" / "guidefold"
    if not cli_path.is_file():
        return _doctor_check(f"hook-{harness}", "fail", f"{dest_rel} points at scripts/guidefold, which doesn't exist",
                              "run `guidefold init` to install .agents/skills/guidefold/")
    if not os.access(cli_path, os.X_OK):
        return _doctor_check(f"hook-{harness}", "fail", f"{rel(root, cli_path)} exists but isn't executable",
                              f"chmod +x {rel(root, cli_path)}")
    return _doctor_check(f"hook-{harness}", "ok", f"{dest_rel} wired to an executable scripts/guidefold")


def _check_gitignore(root: Path) -> dict:
    dest = root / ".gitignore"
    if not dest.is_file():
        return _doctor_check("gitignore", "fail", ".gitignore not found", "run `guidefold init` to create one")
    if ".guidefold/" not in dest.read_text():
        return _doctor_check("gitignore", "fail", ".gitignore does not exclude .guidefold/",
                              "add `.guidefold/` to .gitignore (ADR-0012)")
    return _doctor_check("gitignore", "ok", ".gitignore excludes .guidefold/")


def _check_github_action(root: Path) -> dict:
    dest = root / ".github" / "workflows" / "skills.yml"
    if not dest.is_file():
        return _doctor_check("github-action", "warn", ".github/workflows/skills.yml not found",
                              "run `guidefold init` to install the CI workflow")
    return _doctor_check("github-action", "ok", ".github/workflows/skills.yml present")


def _gcloud_json(args: list, timeout: int = 5):
    """Run a gcloud command with --format=json, timeout-guarded, never raising. Returns
    (parsed_json_or_None, error_message_or_None)."""
    try:
        out = subprocess.run(["gcloud", *args, "--format=json"], capture_output=True, text=True, timeout=timeout)
    except FileNotFoundError:
        return None, "gcloud not found on PATH"
    except subprocess.TimeoutExpired:
        return None, "gcloud call timed out (network or auth prompt?)"
    except Exception as e:
        return None, f"gcloud call failed: {e}"
    if out.returncode != 0:
        lines = [l for l in (out.stderr or "").strip().splitlines() if l.strip()]
        return None, lines[-1] if lines else f"gcloud exited {out.returncode}"
    try:
        return json.loads(out.stdout or "null"), None
    except json.JSONDecodeError:
        return None, "gcloud returned non-JSON output"


def _check_registry(root: Path, cfg) -> list:
    import shutil
    if cfg is None:
        return [_doctor_check("registry-backend", "warn", "skipped (guidefold.yaml invalid)", None)]
    backend = (cfg.get("registry") or {}).get("backend", "agent-registry")
    if backend == "local":
        try:
            n = len(list(all_skills(root, cfg)))
            return [_doctor_check("registry-backend", "ok", f"local backend: {n} skill(s) readable")]
        except Exception as e:
            return [_doctor_check("registry-backend", "fail", f"local backend tree unreadable: {e}",
                                   "check filesystem permissions under .agents/skills")]
    checks = []
    if shutil.which("gcloud") is None:
        checks.append(_doctor_check("registry-gcloud", "fail", "gcloud not found on PATH",
                                     "install the Google Cloud SDK and ensure gcloud is on PATH"))
        for name in ("registry-adc", "registry-project", "registry-roles"):
            checks.append(_doctor_check(name, "warn", "skipped (gcloud unavailable)", "resolve registry-gcloud first"))
        return checks
    checks.append(_doctor_check("registry-gcloud", "ok", "gcloud found on PATH"))
    accounts, err = _gcloud_json(["auth", "list"])
    active = None
    if err:
        checks.append(_doctor_check("registry-adc", "warn", f"could not verify ADC/login: {err}",
                                     "run `gcloud auth login` and `gcloud auth application-default login`"))
    else:
        active_entries = [x for x in (accounts or []) if x.get("status") == "ACTIVE"]
        if not active_entries:
            checks.append(_doctor_check("registry-adc", "fail", "no active gcloud account",
                                         "run `gcloud auth login` and `gcloud auth application-default login`"))
        else:
            active = active_entries[0].get("account")
            checks.append(_doctor_check("registry-adc", "ok", f"active account: {active}"))
    project = (cfg.get("registry") or {}).get("project")
    if not project:
        checks.append(_doctor_check("registry-project", "fail", "registry.project not set in guidefold.yaml",
                                     "add `registry.project: <gcp-project-id>` to guidefold.yaml"))
        checks.append(_doctor_check("registry-roles", "warn", "skipped (no project configured)",
                                     "set registry.project first"))
        return checks
    _proj, err = _gcloud_json(["projects", "describe", project])
    if err:
        checks.append(_doctor_check("registry-project", "fail", f"project {project}: {err}",
                                     f"verify registry.project: {project} exists and is accessible"))
        checks.append(_doctor_check("registry-roles", "warn", "skipped (project check failed)",
                                     "resolve registry-project first"))
        return checks
    checks.append(_doctor_check("registry-project", "ok", f"project {project} reachable"))
    if not active:
        checks.append(_doctor_check("registry-roles", "warn", "skipped (no active gcloud account)",
                                     "resolve registry-adc first"))
        return checks
    policy, err = _gcloud_json(["projects", "get-iam-policy", project])
    if err:
        checks.append(_doctor_check("registry-roles", "warn", f"could not read IAM policy: {err}",
                                     "verify resourcemanager.projects.getIamPolicy on the project"))
        return checks
    has_role = any(
        b.get("role") == "roles/agentregistry.admin" and any(active in m for m in b.get("members", []))
        for b in (policy or {}).get("bindings", []) or []
    )
    if has_role:
        checks.append(_doctor_check("registry-roles", "ok", f"{active} has roles/agentregistry.admin on {project}"))
    else:
        checks.append(_doctor_check("registry-roles", "fail", f"{active} lacks roles/agentregistry.admin on {project}",
                                     f"grant roles/agentregistry.admin to {active} on {project}"))
    return checks


def _check_index_freshness(root: Path) -> dict:
    candidates = [root / ".guidefold" / "index"]
    try:
        candidates.append(cache_root() / "index")
    except Exception:
        pass
    sha_dirs = []
    for c in candidates:
        if c.is_dir():
            try:
                sha_dirs.extend(d for d in c.iterdir() if d.is_dir())
            except Exception:
                pass
    if not sha_dirs:
        return _doctor_check("index-freshness", "ok", "no index artifact found — nothing to check", None)
    newest = max(d.stat().st_mtime for d in sha_dirs)
    head_ts = None
    try:
        out = subprocess.run(["git", "log", "-1", "--format=%ct"], capture_output=True, text=True, cwd=root, timeout=5)
        if out.returncode == 0 and out.stdout.strip():
            head_ts = int(out.stdout.strip())
    except Exception:
        pass
    if head_ts is None:
        return _doctor_check("index-freshness", "warn", "could not determine HEAD commit time", None)
    if newest < head_ts:
        return _doctor_check("index-freshness", "warn", "index artifact is older than HEAD",
                              "run `guidefold index` to refresh it")
    return _doctor_check("index-freshness", "ok", "index artifact is at least as new as HEAD")


def _measure_local_search_p95(root: Path, cfg, n: int = 20) -> float:
    """E2.6 Deliverable 5: measured local warm p95 over `n` `find`-shaped calls against this
    repo's own Index/Router -- the same `_local_selected` helper `search_with_backend` uses, so
    this number means exactly what the R4b curve was measured against. One untimed warm-up call
    is excluded (first-call JIT/caching cost is not what the R4b threshold characterizes); the
    remaining `n` are timed and the 95th percentile (nearest-rank) is returned in milliseconds."""
    import time
    idx = Index.build(root, cfg)
    router = Router(idx)
    query = "how do I follow this repository's conventions for a common task"
    _local_selected(router, query, "_root", 5)   # warm-up, untimed
    samples = []
    for _ in range(n):
        t0 = time.perf_counter()
        _local_selected(router, query, "_root", 5)
        samples.append((time.perf_counter() - t0) * 1000.0)
    samples.sort()
    rank = min(len(samples) - 1, int(round(0.95 * (len(samples) - 1))))
    return samples[rank]


def _check_search_latency(root: Path, cfg) -> dict:
    """R4b's <300ms guideline decides the doctor's tier recommendation -- no interpolation, just
    the fixed threshold from docs/reports/bakeoff/R4b-lazy-terms-postings-2026-09-05.md."""
    try:
        p95 = _measure_local_search_p95(root, cfg, n=20)
    except Exception as e:
        return _doctor_check("search-local-p95", "warn", f"could not measure local search latency: {e}", None)
    if p95 < 300:
        return _doctor_check("search-local-p95", "ok",
                              f"local warm p95={p95:.1f}ms (n=20) -- T0 (search.backend: local) is fine per R4b")
    return _doctor_check("search-local-p95", "warn",
                          f"local warm p95={p95:.1f}ms (n=20) exceeds the R4b 300ms guideline",
                          "consider search.backend: service (T1) -- see "
                          "docs/reports/bakeoff/R4b-lazy-terms-postings-2026-09-05.md")


def _doctor_http_get(scheme: str, host: str, port: int, path: str, token: str, timeout_s: float = 2.0):
    """Blocking GET with stdlib http.client only -- doctor is a synchronous diagnostic command,
    not the deadline-raced client path, so no threading/abandon dance is needed here. Returns
    (status_or_None, json_body_or_None, error_name_or_None)."""
    import http.client
    conn_cls = http.client.HTTPSConnection if scheme == "https" else http.client.HTTPConnection
    conn = conn_cls(host, port, timeout=timeout_s)
    try:
        headers = {"Accept": "application/json"}
        if token:
            headers["Authorization"] = "Bearer " + token
        conn.request("GET", path or "/", headers=headers)
        resp = conn.getresponse()
        raw = resp.read()
        status = resp.status
        try:
            body = json.loads(raw)
        except Exception:
            body = None
        return status, body, None
    except Exception as e:
        return None, None, type(e).__name__
    finally:
        try:
            conn.close()
        except Exception:
            pass


def _check_search_service(root: Path, cfg) -> dict:
    """Service reachability + contract version, via GET /health/ready (never /v1/search --
    doctor must not spend a search against the service just to check it is up). Snapshot AGE is
    not reported: contract 1.1's /health/ready has a `snapshot` content digest and a repository
    `revision`, but no build timestamp field, so an "age" number here would be invented wire data
    -- the brief's own non-negotiable forbids that. This gap is called out in the PR description
    for the service owner instead."""
    search_cfg = resolve_search_config(cfg, profile="interactive")
    if not search_cfg.get("url"):
        return _doctor_check("search-service", "ok",
                              "no search.url configured -- search.backend: local, nothing to reach", None)
    try:
        scheme, host, port, prefix = _parse_search_url(search_cfg["url"])
    except Exception as e:
        return _doctor_check("search-service", "fail", f"unusable search.url: {e}",
                              "fix search.url in guidefold.yaml or GUIDEFOLD_SEARCH_URL")
    status, body, err = _doctor_http_get(scheme, host, port, prefix + "/health/ready", search_cfg.get("token"))
    if err is not None or status is None:
        return _doctor_check("search-service", "fail", f"{search_cfg['url']} unreachable ({err or 'no response'})",
                              "check the URL/network -- find/hook still fall back to local within deadline_ms")
    if status != 200 or not isinstance(body, dict):
        return _doctor_check("search-service", "fail", f"{search_cfg['url']}/health/ready returned HTTP {status}",
                              "the service is reachable but not ready -- check its own logs")
    versions = body.get("api_schema_versions") or []
    version_ok = "1.1" in versions
    bits = ["reachable", f"contract 1.1 {'supported' if version_ok else 'NOT ADVERTISED'}"]
    if body.get("snapshot"):
        bits.append(f"snapshot={body['snapshot']}")
    revision = (body.get("repository") or {}).get("revision")
    if revision:
        bits.append(f"revision={revision}")
    bits.append("snapshot age: not in the 1.1 wire contract (no build timestamp field) -- unmeasurable "
                "without a service-owner change, not reported here")
    return _doctor_check("search-service", "ok" if version_ok else "warn", ", ".join(bits),
                          None if version_ok else "the service's /health/ready does not list '1.1' in api_schema_versions")


def _check_search_token(cfg) -> dict:
    """Token PRESENCE only -- the value itself is never read into a doctor check's `detail`/`fix`
    string (never logged, per the brief's non-negotiable)."""
    search_cfg = resolve_search_config(cfg, profile="interactive")
    if not search_cfg.get("url"):
        return _doctor_check("search-token", "ok", "no search.url configured -- a token is not needed", None)
    if search_cfg.get("token"):
        return _doctor_check("search-token", "ok", "a bearer token is configured (GUIDEFOLD_TOKEN or token_file)", None)
    return _doctor_check("search-token", "fail",
                          "search.url is configured but no bearer token was found -- every request will 401",
                          "set GUIDEFOLD_TOKEN, or search.token_file in guidefold.yaml, to a file holding the token")


def _check_telemetry_spool(root: Path) -> dict:
    """Read-only spool health summary across every tenant/environment partition -- reuses the
    exact helpers `guidefold telemetry status` itself uses, so the two never disagree."""
    rows = []
    for tenant, env, env_dir in _telemetry_partitions(root):
        health = _read_health(_health_path(env_dir))
        queued = 0
        for f in sorted(env_dir.glob("events-*.jsonl")):
            queued += sum(1 for l in f.read_text(encoding="utf-8").splitlines() if l.strip())
        rows.append({"tenant": tenant, "environment": env, "queued": queued,
                      "dropped": health.get("dropped", 0),
                      "oldest_queued_age_s": _oldest_queued_age_s(env_dir)})
    if not rows:
        return _doctor_check("telemetry-spool", "ok", "spool is empty", None)
    total_queued = sum(r["queued"] for r in rows)
    total_dropped = sum(r["dropped"] for r in rows)
    oldest = max((r["oldest_queued_age_s"] for r in rows if r["oldest_queued_age_s"] is not None), default=None)
    detail = f"{len(rows)} partition(s), {total_queued} event(s) queued, {total_dropped} dropped"
    if oldest is not None:
        detail += f", oldest queued age={oldest}s"
    if total_dropped:
        return _doctor_check("telemetry-spool", "warn", detail, "run `guidefold telemetry flush --url <events endpoint>`")
    return _doctor_check("telemetry-spool", "ok", detail, None)


def cmd_doctor(a):
    root = _target_root()
    checks = [_check_python(), _check_cli_compiles(root)]
    yaml_checks, cfg = _check_guidefold_yaml(root)
    checks.extend(yaml_checks)
    checks.extend(_check_skill_layout(root, cfg))
    for h in ("claude", "copilot", "codex"):
        checks.append(_check_hook(root, h))
    checks.append(_check_gitignore(root))
    checks.append(_check_github_action(root))
    checks.extend(_check_registry(root, cfg))
    checks.append(_check_index_freshness(root))
    if cfg is not None:
        checks.append(_check_search_latency(root, cfg))
        checks.append(_check_search_service(root, cfg))
        checks.append(_check_search_token(cfg))
    checks.append(_check_telemetry_spool(root))
    # Pivot (P10/U5 AC1): hosted-service coordinates, reachability + identity, the installed
    # adapter package, and what each harness can actually be relied on to do. All of these stay
    # `warn` (never `fail`) on a repo that has only run `guidefold init`, so a purely local
    # setup still exits 0.
    checks.append(_check_service_config(root, cfg))
    checks.extend(_check_service_api(root, cfg))
    checks.append(_check_adapter_install(root))
    for h in INSTALL_HARNESSES:
        checks.append(_check_harness_capabilities(root, h))
    ok = not any(c["status"] == "fail" for c in checks)
    if a.json:
        print(json.dumps({"root": str(root), "ok": ok, "checks": checks}, indent=2))
    else:
        for c in checks:
            tag = {"ok": "OK", "warn": "WARN", "fail": "FAIL"}[c["status"]]
            print(f"[{tag}] {c['name']}: {c['detail']}")
            if c["status"] != "ok" and c.get("fix"):
                print(f"       fix: {c['fix']}")
        n_fail = sum(c["status"] == "fail" for c in checks)
        n_warn = sum(c["status"] == "warn" for c in checks)
        print(f"\nguidefold doctor: {len(checks)} checks, {n_fail} failed, {n_warn} warnings")
    sys.exit(0 if ok else 1)


# =========================================================== pivot: hosted management API
# P03/P10 (docs/PIVOT-BACKLOG.md), U1/U5 (docs/PRODUCT-PIVOT.md). Everything below is the CLI
# half of the hosted-service pivot: `scan` (offline manifest of what would be imported),
# `login`/`logout`/`org` (device flow + credentials outside the repo), `import`/`sync`/`status`
# (upload + publish through the management API), `install`/`uninstall` (portable adapter package
# for Claude Code / Copilot CLI) and `proposals` (review exports applied back into git).
#
# Non-negotiables encoded here:
#   * `scan` opens ZERO sockets -- it imports neither urllib nor http.client on its code path,
#     and `tests/test_pivot_cli_scan.py` proves it by making socket.socket raise.
#   * The manifest is canonical JSON sorted by path bytes with no timestamps, so the same tree
#     always produces the same bytes and therefore the same idempotency key (U1.4).
#   * Secrets never reach the manifest, never reach a blob upload, and never reach any printed
#     line: tokens live only in the credentials file (0600, never under the repo).
#   * Limits are explicit errors (`limit_exceeded`, exit 2), never a silent truncation (U1.6).

MANIFEST_FORMAT = "guidefold-import-manifest-v1"
INSTALL_MANIFEST_FORMAT = "guidefold-install-manifest-v1"
INSTALL_MANIFEST_NAME = "INSTALL-MANIFEST.json"

# API-CONTRACT §5.6 `ImportLimits`: the server accepts 100 000 files. The client cap was ten
# times tighter, so a 30 000-file monorepo -- the stated target -- exited 2 before the server
# was ever asked. The server's own `ImportCreated.limits` still wins when it says something
# different; these are only what the CLI enforces before the first request.
SCAN_MAX_FILES = 100_000
SCAN_MAX_BYTES = 100 * 1024 * 1024           # 100 MiB beta package limit (U1 AC6)
SCAN_MAX_FILE_BYTES = 8 * 1024 * 1024        # per-blob limit the API advertises
SCAN_CONTENT_SNIFF_BYTES = 8192

# Hard-coded excludes: dependency/build/VCS directories are never source of record, in any repo.
SCAN_PRUNE_DIRS = (".git", "node_modules", "vendor", "dist", "build", "target", "__pycache__", ".venv")
# `.git` is pruned in every repo and would be pure noise in every manifest's `excluded` list.
SCAN_PRUNE_DIRS_SILENT = (".git",)
SCAN_SECRET_GLOBS = (".env", ".env.*", "*.pem", "*.key", "id_rsa*", "*.p12", "*credentials*.json")
_PRIVATE_KEY_RE = re.compile(rb"-----BEGIN [A-Z0-9 ]*PRIVATE KEY-----")
SCAN_DOC_NAMES = ("AGENTS.md", "CLAUDE.md", "GEMINI.md", "README.md")
SCAN_RESOURCE_DIRS = ("references", "scripts", "assets")
SCAN_KINDS = ("skill", "config", "document", "resource")

# U1 AC2 scope/owner suggestions (see `_scan_suggestions` below): the two conventional skill-dir
# wrappers, and the search order for a repo's CODEOWNERS file. This order deliberately differs
# from `_infer_owner_from_codeowners`'s (root, .github, docs) — that helper answers a narrower
# question (the single whole-repo `*` rule for `init`); this one answers per-path ownership and
# follows GitHub's own documented search order, `.github/` first.
_SKILL_DIR_MARKERS = (".agents/skills/", ".claude/skills/")
_CODEOWNERS_CANDIDATES = (".github/CODEOWNERS", "CODEOWNERS", "docs/CODEOWNERS")
_CODEOWNERS_GLOB_CHARS = re.compile(r"[*?\[]")

BLOB_RETRY_ATTEMPTS = 3
BLOB_RETRY_BACKOFF_S = 0.5
SERVICE_TIMEOUT_S = 30.0
IMPORT_POLL_INTERVAL_S = 2.0

_REPO_ID_RE = re.compile(r"[^A-Za-z0-9_.-]+")


def _canonical_json(value) -> bytes:
    """Byte-stable JSON: sorted keys, no whitespace, no NaN. Same encoder as
    tools/serve_spike/repository.canonical, so a manifest digest computed here and one computed
    by the worker over the same object agree."""
    return json.dumps(value, sort_keys=True, ensure_ascii=False, allow_nan=False,
                      separators=(",", ":")).encode("utf-8")


def _sha256_bytes(data: bytes) -> str:
    import hashlib
    return hashlib.sha256(data).hexdigest()


def _atomic_write_bytes(path: Path, content, executable: bool = False):
    """Write `content` so the destination is either the old file or the whole new one, never a
    truncated middle. `init` and `install` land several files in a row; a failure partway through
    used to leave unparseable JSON that the next run reported as a warning and skipped, so a
    retried CI setup kept a broken install. Temp file in the same directory, fsync, os.replace."""
    if isinstance(content, str):
        content = content.encode("utf-8")
    path.parent.mkdir(parents=True, exist_ok=True)
    tmp = path.parent / (path.name + ".guidefold-tmp")
    try:
        fd = os.open(str(tmp), os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
        try:
            with os.fdopen(fd, "wb") as f:
                f.write(content)
                f.flush()
                os.fsync(f.fileno())
        finally:
            # os.open created the temp at 0o600; restore the destination's own mode when it
            # already exists, so replacing a file never quietly narrows who can read it.
            try:
                mode = path.stat().st_mode & 0o777 if path.exists() else (0o755 if executable else 0o644)
                os.chmod(str(tmp), mode | (0o111 if executable else 0))
            except OSError:
                pass
        os.replace(str(tmp), str(path))
    except BaseException:
        try:
            os.unlink(str(tmp))
        except OSError:
            pass
        raise


def _sha256_file(path: Path) -> str:
    import hashlib
    h = hashlib.sha256()
    with path.open("rb") as f:
        for chunk in iter(lambda: f.read(1 << 20), b""):
            h.update(chunk)
    return h.hexdigest()


def _path_key(relpath: str) -> bytes:
    """Sort key: raw path bytes, so ordering never depends on the locale or on Unicode
    collation. surrogateescape keeps undecodable filenames sortable instead of crashing."""
    return relpath.encode("utf-8", "surrogateescape")


def _sleep(seconds: float):
    """Single indirection for every wall-clock wait in this section (device-flow polling, blob
    retry backoff, import polling) so tests can make them instant without a production knob."""
    import time
    if seconds > 0:
        time.sleep(seconds)


def _die(message: str, code: int = 2):
    sys.stderr.write("guidefold: " + message.rstrip() + "\n")
    sys.exit(code)


# ------------------------------------------------------------------ ignore-file matching

class _IgnorePatterns:
    """A deliberate, documented SUBSET of gitignore syntax -- `name`, `dir/`, `*.ext`, `a/b/c`
    and `!negation` -- used only when the tree is NOT inside git. Inside git the real thing
    (`git ls-files --exclude-standard`) does the work and this class is used only for
    `.guidefoldignore`, which is guidefold's own file and documented to use this same subset.
    Unsupported constructs (`**`, character classes spanning `/`) degrade to fnmatch semantics
    rather than being silently dropped."""

    def __init__(self, lines, base: str = ""):
        self.base = base.strip("/")
        self.rules = []
        for raw in lines:
            line = raw.rstrip("\r\n")
            if not line.strip() or line.lstrip().startswith("#"):
                continue
            line = line.rstrip()
            negate = line.startswith("!")
            if negate:
                line = line[1:]
            if not line:
                continue
            dir_only = line.endswith("/")
            line = line.rstrip("/")
            if not line:
                continue
            anchored = line.startswith("/") or "/" in line
            line = line.lstrip("/")
            if line:
                self.rules.append((negate, line, dir_only, anchored))

    def verdict(self, relpath: str, is_dir: bool):
        """True = ignored, False = explicitly re-included, None = no rule applies."""
        if self.base:
            prefix = self.base + "/"
            if not relpath.startswith(prefix):
                return None
            relpath = relpath[len(prefix):]
        name = relpath.rsplit("/", 1)[-1]
        out = None
        for negate, pat, dir_only, anchored in self.rules:
            if dir_only and not is_dir:
                continue
            if anchored:
                hit = fnmatch.fnmatchcase(relpath, pat)
            else:
                hit = fnmatch.fnmatchcase(name, pat)
            if hit:
                out = not negate
        return out


def _rules_ignore(rulesets, relpath: str, is_dir: bool) -> bool:
    """Apply a stack of `_IgnorePatterns` to one path, honouring gitignore's "a file inside an
    ignored directory stays ignored" rule: an ancestor directory that matches wins, and a later
    negation on the file itself cannot rescue it (same as git)."""
    segs = relpath.split("/")
    for i in range(1, len(segs)):
        ancestor = "/".join(segs[:i])
        verdict = None
        for rules in rulesets:
            v = rules.verdict(ancestor, True)
            if v is not None:
                verdict = v
        if verdict is True:
            return True
    verdict = None
    for rules in rulesets:
        v = rules.verdict(relpath, is_dir)
        if v is not None:
            verdict = v
    return verdict is True


# --------------------------------------------------------------------------- path discovery

def _git_paths(root: Path):
    """(paths, submodule_paths) straight from git, or (None, None) when `root` is not inside a
    git work tree. `git ls-files --cached --others --exclude-standard` is the authority on
    .gitignore so the CLI never has to reimplement it for a real repo."""
    def git(*args, binary=True):
        try:
            return subprocess.run(["git", "-C", str(root), *args], capture_output=True, timeout=120)
        except Exception:
            return None
    probe = git("rev-parse", "--is-inside-work-tree")
    if probe is None or probe.returncode != 0:
        return None, None
    listed = git("ls-files", "-z", "--cached", "--others", "--exclude-standard")
    if listed is None or listed.returncode != 0:
        return None, None
    paths = [p.decode("utf-8", "surrogateescape") for p in listed.stdout.split(b"\0") if p]
    submodules = set()
    staged = git("ls-files", "-z", "--stage")
    if staged is not None and staged.returncode == 0:
        for entry in staged.stdout.split(b"\0"):
            if not entry:
                continue
            head, _tab, name = entry.partition(b"\t")
            if head.startswith(b"160000"):
                submodules.add(name.decode("utf-8", "surrogateescape"))
    return paths, submodules


def _walk_paths(root: Path, record_dir):
    """Fallback enumeration for a tree that is not inside git: os.walk honouring a `.gitignore`
    subset (silently, exactly like git) and pruning the hard-coded dependency/build directories
    (recorded, because they can also be *tracked* directories a user did not expect to skip).
    Symlinked directories whose target escapes `root` are pruned and recorded."""
    paths = []
    root_resolved = root.resolve()
    rulesets = {"": []}
    for dirpath, dirnames, filenames in os.walk(root, topdown=True, followlinks=False):
        here = Path(dirpath)
        rel_dir = "" if here == root else here.relative_to(root).as_posix()
        inherited = list(rulesets.get(rel_dir, []))
        gitignore = here / ".gitignore"
        if gitignore.is_file():
            try:
                inherited.append(_IgnorePatterns(gitignore.read_text(errors="ignore").splitlines(), base=rel_dir))
            except OSError:
                pass
        keep = []
        for name in sorted(dirnames):
            child = f"{rel_dir}/{name}" if rel_dir else name
            if name in SCAN_PRUNE_DIRS:
                if name not in SCAN_PRUNE_DIRS_SILENT:
                    record_dir(child, "ignored_directory")
                continue
            abs_child = here / name
            if abs_child.is_symlink() and _escapes_root(root_resolved, abs_child):
                record_dir(child, "symlink_outside_root")
                continue
            if _rules_ignore(inherited, child, True):
                continue
            rulesets[child] = inherited
            keep.append(name)
        dirnames[:] = keep
        for name in sorted(filenames):
            child = f"{rel_dir}/{name}" if rel_dir else name
            if _rules_ignore(inherited, child, False):
                continue
            paths.append(child)
    return paths


def _escapes_root(root_resolved: Path, abs_path: Path) -> bool:
    try:
        target = abs_path.resolve()
    except OSError:
        return True
    try:
        target.relative_to(root_resolved)
        return False
    except ValueError:
        return True


# ------------------------------------------------------------------------- classification

def _is_secret_name(name: str) -> bool:
    return any(fnmatch.fnmatchcase(name, glob) for glob in SCAN_SECRET_GLOBS)


def _scan_kind(relpath: str, skill_dirs: set):
    """Returns (kind, inside_skill_dir). `kind` is None for a file guidefold does not import;
    such a file is reported as `unsupported_format` only when it sits inside a skill directory
    (where the author plainly meant it to ship), and is otherwise simply not listed."""
    segs = relpath.split("/")
    name = segs[-1]
    inside = False
    skill_dir = None
    for i in range(len(segs) - 1, -1, -1):
        candidate = "/".join(segs[:i])
        if candidate in skill_dirs:
            inside, skill_dir = True, candidate
            break
    if name == "SKILL.md":
        return "skill", inside
    if name in ("guidefold.yaml", ".guidefoldignore"):
        return "config", inside
    if name in SCAN_DOC_NAMES:
        return "document", inside
    if name.endswith(".md"):
        if relpath.startswith(".github/instructions/") or "/.github/instructions/" in "/" + relpath:
            return "document", inside
        if relpath.startswith("docs/adr/") or "/docs/adr/" in "/" + relpath:
            return "document", inside
        if name.endswith(".runbook.md") or "runbooks" in segs[:-1]:
            return "document", inside
    if inside and skill_dir is not None:
        sub = relpath[len(skill_dir) + 1:] if skill_dir else relpath
        head, _, rest = sub.partition("/")
        if rest and head in SCAN_RESOURCE_DIRS:
            return "resource", inside
    return None, inside


class ScanLimitExceeded(Exception):
    def __init__(self, limit: str, value: int, cap: int):
        super().__init__(f"limit_exceeded: {limit}={value} exceeds {cap}")
        self.limit, self.value, self.cap = limit, value, cap


def _tolerant_config(root: Path) -> dict:
    """guidefold.yaml as a plain dict, or {} -- `scan`/`install`/`login` must work on a repo
    whose guidefold.yaml is missing or half-written, unlike load_map() which is a hard dependency
    of the ranking commands."""
    path = root / "guidefold.yaml"
    if not path.is_file():
        return {}
    try:
        import yaml
        cfg = yaml.safe_load(path.read_text(encoding="utf-8"))
    except Exception:
        return {}
    return cfg if isinstance(cfg, dict) else {}


def _scan_aliases(cfg: dict) -> list:
    """`import.aliases: [{from, to}]` -- explicit rename mapping so a moved SKILL.md keeps its
    identity across an import instead of looking like delete+create (U1 AC5)."""
    raw = ((cfg or {}).get("import") or {}).get("aliases") or []
    out = []
    if isinstance(raw, list):
        for item in raw:
            if isinstance(item, dict) and item.get("from") and item.get("to"):
                out.append({"from": str(item["from"]), "to": str(item["to"])})
    out.sort(key=lambda d: (_path_key(d["from"]), _path_key(d["to"])))
    return out


# --------------------------------------------------------------- U1 AC2: scope/owner suggestions
#
# PRODUCT-PIVOT §4 (U1): "guidefold.yaml ma pierwszeństwo w mapowaniu scope. Katalogi i CODEOWNERS
# dostarczają propozycji, jeśli mapy brak. Niepewna hierarchia/owner są widoczne i nie stają się
# samoczynnie polityką." (AC2: ambiguous cases carry a list of reasons.) Everything below is
# strictly advisory: it is computed FROM the scan, never fed back INTO node_for()/urn()/the
# builder. A suggestion existing or not existing never changes `files[]`, `excluded[]` or any
# other manifest field.

def _skill_scope_prefix(skill_dir: str) -> str:
    """Directory chain above the conventional `.agents/skills/<name>` or `.claude/skills/<name>`
    wrapper, e.g. "platforms/forge/pipelines/.agents/skills/foo" -> "platforms/forge/pipelines"
    ("" for a skill directly under the tree's own `.agents/skills/`). A skill directory that
    follows neither convention has no wrapper to strip, so it is returned unchanged — still
    enough to build a raw-path suggestion, just without a name segment to drop."""
    for marker in _SKILL_DIR_MARKERS:
        idx = skill_dir.find(marker)
        if idx != -1 and (idx == 0 or skill_dir[idx - 1] == "/"):
            return skill_dir[:idx].rstrip("/")
    return skill_dir


def _scan_node_hits(cfg: dict, relpath: str) -> dict:
    """{node: longest_matching_glob_len} for every node in `cfg["nodes"]` whose `paths` glob
    matches `relpath` (a skill's directory) — the same test `node_for()` runs, EXCEPT this never
    injects node_for()'s own "_root" default when nothing matches (an empty dict here means
    genuinely uncovered, not "resolved to _root"), and it reports every node tied for the longest
    glob instead of picking node_for()'s dict-iteration-order winner, so a real specificity tie
    is visible instead of silently resolved."""
    hits = {}
    for node, spec in (cfg.get("nodes") or {}).items():
        if not isinstance(spec, dict):
            continue
        for g in spec.get("paths") or []:
            if not isinstance(g, str):
                continue
            if fnmatch.fnmatch(relpath + "/", g) or fnmatch.fnmatch(relpath, g):
                if len(g) > hits.get(node, -1):
                    hits[node] = len(g)
    return hits


def _scan_directory_scope(cfg: dict, skill_dir: str) -> str:
    """Best-effort `suggested_scope` for a skill directory guidefold.yaml does not map on its
    own: dotted-join the directory chain above the skill-dir wrapper and, if any SUFFIX of that
    chain already names a declared node (e.g. "platforms/forge/pipelines" when a node named
    "forge.pipelines" already exists — the convention this repo's own Meridian fixture uses,
    dropping the structural "platforms" wrapper), use that node name. Otherwise falls back to the
    raw "/"-joined directory chain, still something a human can act on. No directories above the
    wrapper at all -> "_root" (nothing to derive)."""
    prefix = _skill_scope_prefix(skill_dir)
    if not prefix:
        return "_root"
    chain = prefix.split("/")
    known_nodes = set((cfg.get("nodes") or {}).keys())
    for k in range(len(chain), 0, -1):
        candidate = ".".join(chain[len(chain) - k:])
        if candidate in known_nodes:
            return candidate
    return prefix


def _codeowners_rules(root: Path):
    """[(pattern, anchored, recursive, owner)] in file order, from the first CODEOWNERS file
    found among `_CODEOWNERS_CANDIDATES`. `recursive` is set for a directory-shaped pattern
    (trailing "/", or no glob character at all) so "apps/frontend" and "apps/frontend/" both own
    every path underneath — the common CODEOWNERS shape; a pattern that DOES contain a glob
    character keeps the same fnmatch-based subset `_IgnorePatterns` already documents for
    `.guidefoldignore` (an anchored `*` can cross "/", unlike real gitignore). One primary owner
    per rule: the first `@org/team` (or bare handle) token, normalised to its last "/"-segment
    the same way `_infer_owner_from_codeowners` already does, so a single- and multi-owner line
    agree. Blank lines, comments and an owner-less pattern are skipped, not fatal."""
    for candidate in _CODEOWNERS_CANDIDATES:
        path = root / candidate
        if path.is_file():
            break
    else:
        return []
    try:
        text = path.read_text(encoding="utf-8", errors="ignore")
    except OSError:
        return []
    rules = []
    for raw in text.splitlines():
        line = raw.split("#", 1)[0].strip()
        if not line:
            continue
        parts = line.split()
        if len(parts) < 2:
            continue
        pattern = parts[0]
        dir_only = pattern.endswith("/")
        pattern = pattern.rstrip("/")
        if not pattern:
            continue
        anchored = pattern.startswith("/") or "/" in pattern
        pattern = pattern.lstrip("/")
        if not pattern:
            continue
        recursive = dir_only or not _CODEOWNERS_GLOB_CHARS.search(pattern)
        owner = parts[1].lstrip("@").rsplit("/", 1)[-1]
        rules.append((pattern, anchored, recursive, owner))
    return rules


def _codeowners_match(rules, relpath: str):
    """(owner, hit_count) for `relpath`, using CODEOWNERS' documented "last matching rule wins"
    precedence. `hit_count` is how many rules matched at all: more than one is normal CODEOWNERS
    usage (a later, narrower rule overriding an earlier, broader one), not an error, but U1 AC2
    still wants that uncertainty visible (`multiple_codeowners_rules`) rather than silently
    resolved."""
    name = relpath.rsplit("/", 1)[-1]
    owner, hits = None, 0
    for pattern, anchored, recursive, rule_owner in rules:
        if recursive:
            hit = relpath == pattern or relpath.startswith(pattern + "/")
        elif anchored:
            hit = fnmatch.fnmatchcase(relpath, pattern)
        else:
            hit = fnmatch.fnmatchcase(name, pattern)
        if hit:
            owner, hits = rule_owner, hits + 1
    return owner, hits


def _scan_suggestions(root: Path, cfg: dict, files: list) -> list:
    """U1 AC2: `{path, suggested_scope, suggested_owner, reasons[], candidates[]?}` for every
    `kind: skill` file whose SCOPE guidefold.yaml does not (or cannot) map on its own — missing
    guidefold.yaml, no node glob covers the skill's directory, or two nodes tie for the most
    specific match. A file whose scope resolves cleanly gets no entry at all, even if its owner
    cannot be guessed from CODEOWNERS — the owner-related reasons only ever supplement a suggestion
    that scope uncertainty already triggered, they never trigger one on their own. Advisory only:
    never consulted by the CLI for the scope/owner it actually uses. Deterministic and sorted by
    path, so two scans of the same tree produce identical bytes."""
    yaml_present = (root / "guidefold.yaml").is_file()
    codeowners_rules = _codeowners_rules(root)
    out = []
    for f in files:
        if f["kind"] != "skill":
            continue
        path = f["path"]
        skill_dir = path[: -len("/SKILL.md")] if path != "SKILL.md" else ""
        reasons = []
        candidates = []
        suggested_scope = None

        if not yaml_present:
            reasons.append("guidefold_yaml_missing")
            suggested_scope = _scan_directory_scope(cfg, skill_dir)
        else:
            hits = _scan_node_hits(cfg, skill_dir)
            if not hits:
                reasons.append("no_node_covers_path")
                suggested_scope = _scan_directory_scope(cfg, skill_dir)
                if _skill_scope_prefix(skill_dir):
                    reasons.append("nested_skill_dir_without_node")
            else:
                best_len = max(hits.values())
                winners = sorted(n for n, ln in hits.items() if ln == best_len)
                if len(winners) > 1:
                    reasons.append("ambiguous_node_match")
                    candidates = winners

        if not reasons:
            continue  # scope resolved cleanly: no suggestion, regardless of CODEOWNERS coverage

        owner, hit_count = _codeowners_match(codeowners_rules, path)
        if hit_count == 0:
            reasons.append("no_codeowners_rule")
        elif hit_count > 1:
            reasons.append("multiple_codeowners_rules")

        entry = {"path": path, "suggested_scope": suggested_scope,
                 "suggested_owner": owner, "reasons": sorted(reasons)}
        if candidates:
            entry["candidates"] = candidates
        out.append(entry)
    out.sort(key=lambda e: _path_key(e["path"]))
    return out


def _git_head_and_dirt(root: Path, selected: set):
    """(commit, dirty). `commit` is HEAD only when every path this manifest lists is clean in
    the work tree -- a manifest that claims a commit it does not actually match would make the
    server's drift detection lie. Anything else (dirty file, no commits, no git) is
    (None, True)."""
    def git(*args):
        try:
            return subprocess.run(["git", "-C", str(root), *args], capture_output=True, timeout=120)
        except Exception:
            return None
    head = git("rev-parse", "HEAD")
    if head is None or head.returncode != 0:
        return None, True
    commit = head.stdout.decode("utf-8", "replace").strip()
    if not re.fullmatch(r"[0-9a-f]{40}", commit or ""):
        return None, True
    prefix_out = git("rev-parse", "--show-prefix")
    prefix = prefix_out.stdout.decode("utf-8", "surrogateescape").strip() if prefix_out and prefix_out.returncode == 0 else ""
    status = git("status", "--porcelain", "-z", "--untracked-files=all")
    if status is None or status.returncode != 0:
        return None, True
    tokens = [t for t in status.stdout.split(b"\0")]
    dirty = set()
    i = 0
    while i < len(tokens):
        entry = tokens[i]
        i += 1
        if len(entry) < 4:
            continue
        # `--porcelain -z` entries are exactly "XY<space><path>" (no quoting, no escaping);
        # partitioning on the first space would mis-parse the common " M path" form, whose
        # first byte is itself a space.
        code, path = entry[:2], entry[3:].decode("utf-8", "surrogateescape")
        dirty.add(path)
        if code[:1] in (b"R", b"C") or code[1:2] in (b"R", b"C"):
            if i < len(tokens) and tokens[i]:
                dirty.add(tokens[i].decode("utf-8", "surrogateescape"))
                i += 1
    scoped = {p[len(prefix):] for p in dirty if p.startswith(prefix)} if prefix else dirty
    if scoped & selected:
        return None, True
    return commit, False


def scan_manifest(root: Path, cfg: dict = None, *, org=None, repo=None, complete=True,
                  publish=True, profile="default"):
    """Build a `guidefold-import-manifest-v1` for `root`. Pure filesystem + git work: no socket
    is opened and neither urllib nor http.client is imported on this path.

    Returns (manifest, blob_paths, stats) where `blob_paths` maps sha256 -> absolute Path so the
    caller can upload exactly the blobs the server asks for and nothing else."""
    root = Path(root).resolve()
    cfg = cfg if cfg is not None else _tolerant_config(root)
    excluded = {}

    def exclude(path, reason):
        excluded.setdefault(path, reason)

    git_paths, submodules = _git_paths(root)
    if git_paths is not None:
        candidates, submodules = git_paths, (submodules or set())
    else:
        candidates, submodules = _walk_paths(root, exclude), set()

    # `.guidefoldignore` is guidefold's own opt-out and is honoured in BOTH modes (git's
    # --exclude-standard knows nothing about it). Unlike .gitignore matches, which are silent
    # because git already treats them as non-files, these are recorded: the author wrote them
    # here explicitly and should see them in the summary.
    gf_rules = []
    for relpath in candidates:
        if relpath.rsplit("/", 1)[-1] == ".guidefoldignore":
            base = relpath[: -len(".guidefoldignore")].rstrip("/")
            try:
                gf_rules.append(_IgnorePatterns((root / relpath).read_text(errors="ignore").splitlines(), base=base))
            except OSError:
                pass

    skill_dirs = set()
    for relpath in candidates:
        if relpath.rsplit("/", 1)[-1] == "SKILL.md":
            skill_dirs.add(relpath[: -len("/SKILL.md")] if "/" in relpath else "")

    root_resolved = root
    files = []
    blob_paths = {}
    total_bytes = 0
    counts = dict.fromkeys(SCAN_KINDS, 0)

    for relpath in sorted(candidates, key=_path_key):
        segs = relpath.split("/")
        if relpath in submodules:
            exclude(relpath, "submodule")
            continue
        pruned_at = next((i for i, s in enumerate(segs[:-1]) if s in SCAN_PRUNE_DIRS), None)
        if pruned_at is not None:
            directory = "/".join(segs[: pruned_at + 1])
            if segs[pruned_at] not in SCAN_PRUNE_DIRS_SILENT:
                exclude(directory, "ignored_directory")
            continue
        if gf_rules and _rules_ignore(gf_rules, relpath, False):
            exclude(relpath, "guidefoldignore")
            continue
        abs_path = root / relpath
        if abs_path.is_symlink() or any((root / "/".join(segs[:i])).is_symlink() for i in range(1, len(segs))):
            if _escapes_root(root_resolved, abs_path):
                exclude(relpath, "symlink_outside_root")
                continue
        if _is_secret_name(segs[-1]):
            exclude(relpath, "secret_pattern")
            continue
        kind, inside_skill = _scan_kind(relpath, skill_dirs)
        if kind == "skill" and not _is_canonical_skill_path(relpath):
            # `all_skills()` — the only discovery path `find`/`load`/`validate`/`materialize`/
            # `doctor`/`report` and the worker's `build_tree.py` ever use — only rglobs
            # `<any>/.agents/skills/<name>/SKILL.md`. A SKILL.md outside that shape can be
            # imported today and never publish (`invalid_snapshot_dimensions`, n_skills:0), a
            # confusing failure three steps later. Say so here instead, at scan time.
            exclude(relpath, "non_canonical_skill_path")
            continue
        if kind is None:
            if inside_skill:
                exclude(relpath, "unsupported_format")
            continue
        try:
            st = abs_path.stat()
        except OSError:
            exclude(relpath, "unreadable")
            continue
        if not os.path.isfile(abs_path):
            continue
        if st.st_size > SCAN_MAX_FILE_BYTES:
            exclude(relpath, "file_too_large")
            continue
        try:
            data = abs_path.read_bytes()
        except OSError:
            exclude(relpath, "unreadable")
            continue
        # One read serves both the digest and the private-key content sniff, so a PEM body
        # hiding under an innocent name never becomes a blob (U1 AC3).
        if _PRIVATE_KEY_RE.search(data[:SCAN_CONTENT_SNIFF_BYTES]):
            exclude(relpath, "secret_pattern")
            continue
        digest = _sha256_bytes(data)
        files.append({"path": relpath, "sha256": digest, "size": len(data), "kind": kind,
                      "mode": "100755" if st.st_mode & 0o111 else "100644"})
        blob_paths.setdefault(digest, abs_path)
        counts[kind] += 1
        total_bytes += len(data)
        if len(files) > SCAN_MAX_FILES:
            raise ScanLimitExceeded("max_files", len(files), SCAN_MAX_FILES)
        if total_bytes > SCAN_MAX_BYTES:
            raise ScanLimitExceeded("max_bytes", total_bytes, SCAN_MAX_BYTES)

    files.sort(key=lambda f: _path_key(f["path"]))
    selected = {f["path"] for f in files}
    commit, dirty = _git_head_and_dirt(root, selected) if git_paths is not None else (None, True)

    manifest = {
        "format": MANIFEST_FORMAT,
        "org": org,
        "repo": repo,
        "commit": commit,
        "complete": bool(complete),
        "dirty": bool(dirty),
        "publish": bool(publish),
        "cli_version": CLI_VERSION,
        "scan_profile": profile,
        "root": ".",
        "files": files,
        "excluded": sorted(({"path": p, "reason": r} for p, r in excluded.items()),
                           key=lambda e: (_path_key(e["path"]), e["reason"])),
        "aliases": _scan_aliases(cfg),
        "limits": {"max_files": SCAN_MAX_FILES, "max_bytes": SCAN_MAX_BYTES},
        "suggestions": _scan_suggestions(root, cfg, files),
    }
    stats = {"counts": counts, "total_bytes": total_bytes, "unique_blobs": len(blob_paths),
             "git": git_paths is not None}
    return manifest, blob_paths, stats


# --------------------------------------------------------------- credentials + service config

def _credentials_path() -> Path:
    env = os.environ.get("GUIDEFOLD_CREDENTIALS")
    if env:
        return Path(env).expanduser()
    xdg = os.environ.get("XDG_CONFIG_HOME")
    base = Path(xdg).expanduser() if xdg else Path.home() / ".config"
    return base / "guidefold" / "credentials.json"


def _credentials_inside(root, path: Path) -> bool:
    """Only a real repository is protected. `_pivot_root()` falls back to the cwd for a plain
    directory, and refusing to write credentials "inside" an arbitrary working directory would
    break `guidefold login` run from anywhere but a monorepo."""
    if root is None:
        return False
    root = Path(root)
    if not ((root / "guidefold.yaml").is_file() or (root / ".git").exists()):
        return False
    try:
        path.resolve().relative_to(Path(root).resolve())
        return True
    except (ValueError, OSError):
        return False


def _load_credentials() -> dict:
    path = _credentials_path()
    try:
        data = json.loads(path.read_text(encoding="utf-8"))
    except Exception:
        return {}
    return data if isinstance(data, dict) else {}


def _save_credentials(creds: dict, root=None):
    """0600, and never under the repo -- a credentials file inside a work tree is one `git add
    .` away from being published (U5 AC2)."""
    path = _credentials_path()
    if _credentials_inside(root, path):
        _die(f"refusing to write credentials inside the repository ({path}). "
             f"Unset GUIDEFOLD_CREDENTIALS or point it outside the repo.", 2)
    path.parent.mkdir(parents=True, exist_ok=True)
    try:
        os.chmod(path.parent, 0o700)
    except OSError:
        pass
    payload = json.dumps(creds, indent=2, sort_keys=True) + "\n"
    # Write a new file and rename over the old one. O_TRUNC on the real path destroyed the
    # whole multi-API store before the new content landed, so a crash mid-write lost every
    # stored token; and O_CREAT does not reset the mode of a file that already exists, so one
    # left at 0644 stayed world-readable until the chmod afterwards. O_EXCL|O_NOFOLLOW means
    # the mode is the one asked for and the target is never a symlink somebody else planted.
    tmp = path.with_name(path.name + f".{os.getpid()}.tmp")
    flags = os.O_WRONLY | os.O_CREAT | os.O_EXCL | getattr(os, "O_NOFOLLOW", 0)
    try:
        fd = os.open(str(tmp), flags, 0o600)
    except FileExistsError:
        os.unlink(str(tmp))
        fd = os.open(str(tmp), flags, 0o600)
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as f:
            f.write(payload)
            f.flush()
            os.fsync(f.fileno())
        os.replace(str(tmp), str(path))
    except BaseException:
        try:
            os.unlink(str(tmp))
        except OSError:
            pass
        raise
    try:
        os.chmod(path, 0o600)
    except OSError:
        pass


def _normalise_api(url):
    """Validate and normalise the management API base URL.

    The value comes from `--api`, GUIDEFOLD_API or the committed `guidefold.yaml`, and the very
    next thing that happens to it is an `Authorization: Bearer …` header. urllib will happily
    open `http://` (the token in cleartext on the wire) and `file://` (`doctor` would then
    "GET /health/ready" out of a local path), so the scheme is checked here, once, exactly as
    the local search backend already checks its own. `http` is allowed only for loopback,
    because that is what `tools/dev/stack.py` and a Compose stack run on."""
    if not url:
        return None
    import urllib.parse
    raw = str(url).strip().rstrip("/")
    if not raw:
        return None
    p = urllib.parse.urlsplit(raw)
    if p.scheme not in ("http", "https") or not p.hostname:
        _die(f"invalid API URL {raw!r}: use https://host[:port] "
             f"(http:// only for 127.0.0.1, ::1 or localhost)", 2)
    if p.scheme == "http" and p.hostname not in ("127.0.0.1", "::1", "localhost"):
        _die(f"refusing to send a bearer token over http:// to {p.hostname}; use https://", 2)
    return raw


# Organisation slugs and repo ids are interpolated into request paths and written into
# guidefold.yaml, so they are validated at the one place every command resolves them.
# The shapes are the server's own (API-CONTRACT §3: `invalid_slug`, `invalid_repo_id`).
_ORG_SLUG_RE = re.compile(r"^[a-z0-9][a-z0-9._-]{0,63}$")
_REPO_ID_ARG_RE = re.compile(r"^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$")


def _validate_identifier(value, kind, pattern):
    if value is None:
        return None
    text = str(value).strip()
    if not text:
        return None
    if not pattern.match(text):
        _die(f"invalid {kind} {text!r}: expected {pattern.pattern}", 2)
    return text


def _default_repo_id(root: Path) -> str:
    name = None
    try:
        out = subprocess.run(["git", "-C", str(root), "config", "--get", "remote.origin.url"],
                             capture_output=True, text=True, timeout=5)
        if out.returncode == 0 and out.stdout.strip():
            name = out.stdout.strip().rstrip("/").rsplit("/", 1)[-1]
            if name.endswith(".git"):
                name = name[:-4]
    except Exception:
        pass
    name = _REPO_ID_RE.sub("-", name or root.name).strip("-.") or "repo"
    return name[:64]


def resolve_service_config(cfg: dict = None, args=None, root: Path = None) -> dict:
    """Precedence: flags > env (GUIDEFOLD_API/ORG/REPO_ID/TOKEN) > guidefold.yaml `service:` >
    credentials file. guidefold.yaml carries only non-secret coordinates; the token is only ever
    read from GUIDEFOLD_TOKEN (CI) or the credentials file."""
    def flag(name):
        return getattr(args, name, None) if args is not None else None

    svc = (cfg or {}).get("service")
    svc = svc if isinstance(svc, dict) else {}
    creds = _load_credentials()
    api = _normalise_api(flag("api") or os.environ.get("GUIDEFOLD_API") or svc.get("api"))
    if not api and len(creds) == 1:
        api = _normalise_api(next(iter(creds)))
    entry = creds.get(api) if api else None
    entry = entry if isinstance(entry, dict) else {}
    env_token = os.environ.get("GUIDEFOLD_TOKEN") or None
    repo = (flag("repo") or os.environ.get("GUIDEFOLD_REPO_ID") or svc.get("repo")
            or (_default_repo_id(root) if root is not None else None))
    org = flag("org") or os.environ.get("GUIDEFOLD_ORG") or svc.get("org") or entry.get("org")
    return {
        "api": api,
        "org": _validate_identifier(org, "organisation", _ORG_SLUG_RE),
        "repo": _validate_identifier(repo, "repo id", _REPO_ID_ARG_RE),
        "token": env_token or entry.get("token"),
        "token_source": "GUIDEFOLD_TOKEN" if env_token else ("credentials" if entry.get("token") else None),
        "user": entry.get("user") or {},
        "orgs": entry.get("orgs") or [],
    }


def _pivot_root(path=None) -> Path:
    """Root for the pivot commands: $GUIDEFOLD_ROOT, else the nearest ancestor of `path` (or
    cwd) that holds guidefold.yaml, else `path`/cwd itself. Unlike repo_root() this never exits:
    `scan` on a plain directory is a legitimate first step before guidefold.yaml exists."""
    env = os.environ.get("GUIDEFOLD_ROOT")
    if env and path is None:
        return Path(env).resolve()
    start = Path(path).resolve() if path else Path.cwd().resolve()
    if start.is_file():
        start = start.parent
    for d in (start, *start.parents):
        if (d / "guidefold.yaml").is_file():
            return d
    return start


# ---------------------------------------------------------------------------- HTTP transport

class ServiceError(Exception):
    """One error type for every management-API call. Carries the wire `code` so callers can
    branch (`authorization_pending`, `blobs_missing`, ...) and a message that NEVER contains a
    token: only the method, the path and the server's own message ever reach it."""

    def __init__(self, status, code, message="", request_id=None, details=None):
        super().__init__(message or code or "service error")
        self.status, self.code, self.message, self.request_id = status, code, message, request_id
        # API-CONTRACT §3 puts machine-readable payload in `details` (`blobs_missing` carries
        # `details.missing`). Dropping it here forced callers to re-parse `message`.
        self.details = details if isinstance(details, dict) else {}

    def __str__(self):
        head = f"HTTP {self.status}" if self.status else "network error"
        bits = [head]
        if self.code and self.code not in (head, "network_error"):
            bits.append(self.code)
        if self.message:
            bits.append(self.message)
        out = " ".join(bits)
        if self.request_id:
            out += f" (request_id={self.request_id})"
        return out


def _service_request(api: str, method: str, path: str, *, token=None, json_body=None, data=None,
                     content_type=None, idempotency_key=None, timeout=SERVICE_TIMEOUT_S):
    """The single HTTP door to the management API. urllib.request only (stdlib), bearer auth,
    optional Idempotency-Key, JSON errors mapped to ServiceError. Imported lazily so the offline
    commands (`scan`, `hook`) never pay for -- or even load -- the HTTP stack."""
    import urllib.error
    import urllib.request

    if not api:
        raise ServiceError(None, "no_api", "no API URL configured")
    url = api.rstrip("/") + path
    headers = {"Accept": "application/json", "User-Agent": f"guidefold-cli/{CLI_VERSION}"}
    body = data
    if json_body is not None:
        body = json.dumps(json_body).encode("utf-8")
        headers["Content-Type"] = "application/json"
    elif content_type:
        headers["Content-Type"] = content_type
    if token:
        headers["Authorization"] = "Bearer " + token
    if idempotency_key:
        headers["Idempotency-Key"] = idempotency_key
    request = urllib.request.Request(url, data=body, method=method, headers=headers)
    try:
        with urllib.request.urlopen(request, timeout=timeout) as resp:
            raw, status, hdrs = resp.read(), resp.status, dict(resp.headers)
    except urllib.error.HTTPError as e:
        raw, status, hdrs = e.read(), e.code, dict(e.headers or {})
    except Exception as e:
        # `from None`: the chained exception's repr can carry the full Request (headers
        # included). Only the method/path/type ever escape.
        raise ServiceError(None, "network_error", f"{method} {path}: {type(e).__name__}") from None
    parsed = None
    if raw:
        try:
            parsed = json.loads(raw)
        except Exception:
            parsed = None
    if status >= 400:
        info = parsed if isinstance(parsed, dict) else {}
        error = info.get("error")
        details = info.get("details")
        if isinstance(error, dict):
            code = error.get("code") or f"http_{status}"
            message = error.get("message") or ""
            if details is None:
                details = error.get("details")
        else:
            code = info.get("code") or (error if isinstance(error, str) else None) or f"http_{status}"
            message = info.get("message") or info.get("detail") or ""
        details = dict(details) if isinstance(details, dict) else {}
        if status == 429 and "retry_after" not in details:
            header = hdrs.get("Retry-After") or hdrs.get("retry-after")
            if header and str(header).strip().isdigit():
                details["retry_after"] = int(str(header).strip())
        raise ServiceError(status, code, message,
                           info.get("request_id") or hdrs.get("X-Request-Id"),
                           details=details)
    return status, parsed, hdrs


def _die_service(verb: str, e, svc: dict = None):
    """Exit on a management-API failure with a code and a hint that match the status.

    Collapsing 401/403/404/409/429 into one exit code makes an expired token indistinguishable
    from a 500 to a CI script, and gives the person at the terminal nothing to do next. Exit 2
    is "your configuration or credentials"; exit 1 is "the server said no to this request".
    """
    api = (svc or {}).get("api") or ""
    hint, code = "", 1
    if e.status == 401:
        hint, code = f"run `guidefold login{(' --api ' + api) if api else ''}` (or set GUIDEFOLD_TOKEN in CI)", 2
    elif e.status == 403:
        hint, code = ("this token or role may not do that — check the organisation and the "
                      "installation scopes"), 2
    elif e.status == 404:
        hint = "check --org/--repo and the identifier in the command"
    elif e.status == 409:
        hint = "the resource changed since you read it — re-read it and retry"
    elif e.status == 429:
        retry = e.details.get("retry_after") if isinstance(e.details, dict) else None
        hint = f"rate limited — retry after {retry}s" if retry else "rate limited — retry later"
    message = f"{verb}: {e}" + (f"\n  {hint}" if hint else "")
    _die(message, code)


def _require_service(svc: dict, *, need_org=True, need_repo=True, need_token=True):
    if not svc.get("api"):
        _die("no API URL configured — pass --api https://…, set GUIDEFOLD_API, or add "
             "`service: {api: …}` to guidefold.yaml", 2)
    if need_token and not svc.get("token"):
        _die("not authenticated — run `guidefold login --api " + svc["api"] +
             "` (or set GUIDEFOLD_TOKEN in CI)", 2)
    if need_org and not svc.get("org"):
        _die("no organisation selected — run `guidefold org use <slug>` or set GUIDEFOLD_ORG", 2)
    if need_repo and not svc.get("repo"):
        _die("no repo id — pass --repo <id> or set GUIDEFOLD_REPO_ID", 2)


def _repo_base(svc: dict) -> str:
    # Validated in resolve_service_config and percent-encoded here, so neither half can
    # rewrite the request path even if a future caller skips the validation.
    import urllib.parse
    return (f"/api/v1/orgs/{urllib.parse.quote(str(svc['org']), safe='')}"
            f"/repos/{urllib.parse.quote(str(svc['repo']), safe='')}")


def _org_base(svc: dict) -> str:
    import urllib.parse
    return "/api/v1/orgs/" + urllib.parse.quote(str(svc["org"]), safe="")


# ------------------------------------------------------------------------------ device login

def _absolute_uri(api: str, uri: str) -> str:
    import urllib.parse
    return urllib.parse.urljoin(api.rstrip("/") + "/", uri or "")


def cmd_login(a):
    root = _pivot_root(None)
    svc = resolve_service_config(_tolerant_config(root), a, root)
    _require_service(svc, need_org=False, need_repo=False, need_token=False)
    api = svc["api"]
    try:
        # API-CONTRACT §4.1: the body is `{harness?}` and §3 makes unknown request fields a
        # `400 invalid_json` (mgmt/context.go calls DisallowUnknownFields), so `client` and
        # `cli_version` would have failed the very first call against a compliant server. The
        # CLI already identifies itself in User-Agent.
        _s, start, _h = _service_request(api, "POST", "/api/v1/auth/device",
                                         json_body={"harness": "cli"})
    except ServiceError as e:
        _die(f"login: could not start the device flow: {e}", 2)
    start = start if isinstance(start, dict) else {}
    device_code = start.get("device_code")
    user_code = start.get("user_code")
    if not device_code or not user_code:
        _die("login: the server did not return device_code/user_code", 2)
    verification = _absolute_uri(api, start.get("verification_uri") or "/")
    interval = start.get("interval")
    # Clamped to at least one second: `interval: 0` from the server would otherwise buy an
    # unthrottled poll loop against /auth/device/token.
    interval = 5 if not isinstance(interval, (int, float)) else max(1, min(int(interval), 60))
    expires_in = start.get("expires_in")
    expires_in = 600 if not isinstance(expires_in, (int, float)) else int(expires_in)

    print(f"guidefold login → {api}")
    print(f"  1. open  {verification}")
    print(f"  2. enter code  {user_code}")
    print(f"  waiting for approval (expires in {expires_in}s, Ctrl-C to abort)…")

    import time
    deadline = time.monotonic() + max(1, expires_in)
    granted = None
    while True:
        if time.monotonic() >= deadline:
            _die("login: the device code expired before it was approved — run `guidefold login` again", 1)
        _sleep(interval)
        try:
            _s, granted, _h = _service_request(api, "POST", "/api/v1/auth/device/token",
                                               json_body={"device_code": device_code}, timeout=15)
        except ServiceError as e:
            if e.code == "authorization_pending":
                continue
            if e.code == "slow_down":
                interval = min(interval + 5, 60)
                continue
            if e.code == "expired_token":
                _die("login: the device code expired before it was approved — run `guidefold login` again", 1)
            if e.code == "access_denied":
                _die("login: the request was denied in the browser — nothing was stored", 1)
            _die(f"login: {e}", 2)
        break

    granted = granted if isinstance(granted, dict) else {}
    token = granted.get("token")
    if not token:
        _die("login: the server approved the device but returned no token", 2)
    orgs = granted.get("orgs") or []
    creds = _load_credentials()
    entry = creds.get(api) if isinstance(creds.get(api), dict) else {}
    entry["token"] = token
    entry["user"] = granted.get("user") or {}
    entry["orgs"] = orgs
    slugs = [o.get("slug") for o in orgs if isinstance(o, dict) and o.get("slug")]
    if entry.get("org") not in slugs:
        entry["org"] = slugs[0] if len(slugs) == 1 else None
    creds[api] = entry
    _save_credentials(creds, root)

    user = entry["user"] or {}
    print(f"  logged in as {user.get('email') or user.get('id') or 'unknown user'}")
    print(f"  credentials: {_credentials_path()} (mode 0600)")
    if slugs:
        current = entry.get("org")
        print("  organisations: " + ", ".join(("* " + s if s == current else "  " + s).strip() for s in slugs))
    if not entry.get("org"):
        print("  next: `guidefold org use <slug>`")
    sys.exit(0)


def cmd_logout(a):
    root = _pivot_root(None)
    svc = resolve_service_config(_tolerant_config(root), a, root)
    creds = _load_credentials()
    if getattr(a, "all", False):
        removed = sorted(creds)
        creds = {}
    else:
        api = svc.get("api")
        if not api or api not in creds:
            print("guidefold logout: nothing stored for this API — nothing to do.")
            sys.exit(0)
        removed = [api]
        creds.pop(api, None)
    _save_credentials(creds, root)
    for api in removed:
        print(f"guidefold logout: cleared credentials for {api}")
    sys.exit(0)


def _org_rows(svc: dict, refresh=True):
    """Membership list: authoritative from GET /api/v1/me, falling back to what login stored so
    `org list` still answers offline (clearly labelled)."""
    if refresh and svc.get("api") and svc.get("token"):
        try:
            _s, me, _h = _service_request(svc["api"], "GET", "/api/v1/me", token=svc["token"], timeout=10)
            if isinstance(me, dict) and isinstance(me.get("orgs"), list):
                return me["orgs"], "api", me
        except ServiceError:
            pass
    return svc.get("orgs") or [], "cache", None


def cmd_org(a):
    root = _pivot_root(None)
    svc = resolve_service_config(_tolerant_config(root), a, root)
    if a.org_cmd == "list":
        _require_service(svc, need_org=False, need_repo=False)
        rows, source, _me = _org_rows(svc)
        if not rows:
            print("guidefold org list: no organisations (run `guidefold login`)")
            sys.exit(0)
        print(f"guidefold org list ({source})")
        for row in rows:
            slug = row.get("slug") or row.get("org_id") or "?"
            marker = "*" if slug == svc.get("org") else " "
            print(f" {marker} {slug:<24} {row.get('name') or '':<28} {row.get('role') or ''}")
        sys.exit(0)
    if a.org_cmd == "use":
        _require_service(svc, need_org=False, need_repo=False)
        rows, _source, _me = _org_rows(svc)
        slugs = [r.get("slug") for r in rows if isinstance(r, dict) and r.get("slug")]
        if slugs and a.slug not in slugs:
            _die(f"org use: {a.slug!r} is not one of your organisations ({', '.join(slugs)})", 1)
        creds = _load_credentials()
        entry = creds.get(svc["api"]) if isinstance(creds.get(svc["api"]), dict) else {}
        entry["org"] = a.slug
        if rows:
            entry["orgs"] = rows
        creds[svc["api"]] = entry
        _save_credentials(creds, root)
        print(f"guidefold org use: current organisation is now {a.slug}")
        sys.exit(0)
    _die("org: expected `list` or `use <slug>`", 2)


# --------------------------------------------------------------------------- scan / import

def _human_bytes(n: int) -> str:
    step = 1024.0
    value = float(n)
    for unit in ("B", "KiB", "MiB", "GiB"):
        if value < step or unit == "GiB":
            return f"{int(value)} {unit}" if unit == "B" else f"{value:.1f} {unit}"
        value /= step
    return f"{n} B"


def _print_scan_summary(root: Path, manifest: dict, stats: dict, digest: str):
    counts = stats["counts"]
    print(f"guidefold scan — root: {root}")
    if manifest["commit"]:
        print(f"  commit:    {manifest['commit']} (clean for every listed file)")
    else:
        why = "working tree has uncommitted changes" if stats["git"] else "not inside a git work tree"
        print(f"  commit:    none — dirty=true ({why})")
    kinds = ", ".join(f"{k} {counts[k]}" for k in SCAN_KINDS if counts[k])
    print(f"  files:     {len(manifest['files'])}" + (f"  ({kinds})" if kinds else ""))
    print(f"  bytes:     {_human_bytes(stats['total_bytes'])} in {stats['unique_blobs']} unique blob(s)")
    print(f"  complete:  {manifest['complete']}   publish: {manifest['publish']}   profile: {manifest['scan_profile']}")
    if manifest["aliases"]:
        print(f"  aliases:   {len(manifest['aliases'])}")
        for alias in manifest["aliases"][:10]:
            print(f"               {alias['from']} → {alias['to']}")
    by_reason = {}
    for entry in manifest["excluded"]:
        by_reason.setdefault(entry["reason"], []).append(entry["path"])
    print(f"  excluded:  {len(manifest['excluded'])}")
    for reason in sorted(by_reason):
        paths = by_reason[reason]
        print(f"    {reason} ({len(paths)})")
        for p in paths[:10]:
            print(f"      {p}")
        if len(paths) > 10:
            print(f"      … {len(paths) - 10} more")
    print(f"  limits:    max_files={manifest['limits']['max_files']} "
          f"max_bytes={manifest['limits']['max_bytes']}")
    suggestions = manifest.get("suggestions") or []
    print(f"  suggestions: {len(suggestions)}  (advisory only — never used by the CLI itself; "
          f"see U1 AC2)")
    for entry in suggestions[:10]:
        print(f"    {entry['path']}")
        print(f"      scope={entry['suggested_scope']}  owner={entry['suggested_owner']}  "
              f"reasons={','.join(entry['reasons'])}")
    if len(suggestions) > 10:
        print(f"    … {len(suggestions) - 10} more")
    print(f"  manifest:  sha256:{digest}")


def _scan_for(a, *, complete=None, publish=True):
    root = _pivot_root(getattr(a, "path", None))
    cfg = _tolerant_config(root)
    svc = resolve_service_config(cfg, a, root)
    if complete is None:
        complete = not getattr(a, "partial", False)
    try:
        manifest, blob_paths, stats = scan_manifest(
            root, cfg, org=svc.get("org"), repo=svc.get("repo"), complete=complete,
            publish=publish, profile=getattr(a, "profile", None) or "default")
    except ScanLimitExceeded as e:
        _die(f"scan: {e} — split the import or narrow the tree; nothing was truncated silently", 2)
    return root, cfg, svc, manifest, blob_paths, stats


def cmd_scan(a):
    root, _cfg, _svc, manifest, _blobs, stats = _scan_for(a)
    payload = _canonical_json(manifest)
    if a.json:
        sys.stdout.write(payload.decode("utf-8") + "\n")
    else:
        _print_scan_summary(root, manifest, stats, _sha256_bytes(payload))
        if getattr(a, "dry_run", False):
            print("  [dry-run] scan never contacts the API; this manifest is exactly what "
                  "`guidefold import` would send.")
    sys.exit(0)


def _ensure_repo(svc: dict, root: Path):
    """Register the repository, idempotently.

    API-CONTRACT §4.2: the route answers 201 when it registered the repository and 200 when it
    already existed, and `created:bool!` in the body is what distinguishes them -- never a 409.
    Reading the body is therefore the only way to report this honestly."""
    _s, body, _h = _service_request(svc["api"], "POST", _org_base(svc) + "/repos",
                                    token=svc["token"],
                                    json_body={"repo_id": svc["repo"], "name": svc["repo"]},
                                    idempotency_key=f"repo:{svc['org']}:{svc['repo']}")
    body = body if isinstance(body, dict) else {}
    return "created" if body.get("created") else "exists"


def _upload_blobs(svc: dict, import_id: str, missing, blob_paths: dict, verbose=True):
    """Upload only the hashes the server asked for. Per-blob retry (≤3) with backoff; a 4xx is
    never retried (it will never become a 2xx). Interrupt-safe by construction: the set of
    missing blobs is always re-read from the server, never remembered locally."""
    uploaded = []
    base = _repo_base(svc)
    for sha in missing:
        path = blob_paths.get(sha)
        if path is None:
            raise ServiceError(None, "blob_not_in_scan",
                               f"the server asked for blob {sha[:12]}… which this scan did not produce")
        data = Path(path).read_bytes()
        for attempt in range(1, BLOB_RETRY_ATTEMPTS + 1):
            try:
                _service_request(svc["api"], "PUT", f"{base}/imports/{import_id}/blobs/{sha}",
                                 token=svc["token"], data=data,
                                 content_type="application/octet-stream", timeout=120)
                uploaded.append(sha)
                break
            except ServiceError as e:
                retryable = e.status is None or e.status >= 500 or e.status == 429
                if not retryable or attempt == BLOB_RETRY_ATTEMPTS:
                    raise ServiceError(e.status, e.code,
                                       f"uploading {sha[:12]}… ({len(data)} B) failed: {e.message or e.code}",
                                       e.request_id, details=e.details) from None
                # A 429 says when to come back; honour it instead of the fixed schedule.
                wait = BLOB_RETRY_BACKOFF_S * (2 ** (attempt - 1))
                retry_after = e.details.get("retry_after")
                if isinstance(retry_after, int) and retry_after > 0:
                    wait = min(retry_after, 60)
                _sleep(wait)
    if verbose and uploaded:
        print(f"  uploaded:  {len(uploaded)} blob(s)")
    return uploaded


def _import_view(svc: dict, import_id: str):
    _s, body, _h = _service_request(svc["api"], "GET", f"{_repo_base(svc)}/imports/{import_id}",
                                    token=svc["token"], timeout=30)
    return body if isinstance(body, dict) else {}


def _print_import_view(view: dict):
    print(f"import {view.get('import_id') or '?'}")
    for key in ("state", "commit", "complete", "manifest_digest", "snapshot_id"):
        if view.get(key) is not None:
            print(f"  {key + ':':<16}{view[key]}")
    counts = view.get("counts") if isinstance(view.get("counts"), dict) else None
    if counts:
        print("  counts:         " + " ".join(f"{k}={v}" for k, v in sorted(counts.items())))
    files = view.get("files")
    if isinstance(files, list) and files:
        buckets = {}
        for f in files:
            buckets.setdefault(f.get("state") or "unknown", []).append(f)
        print("  files:          " + " ".join(f"{k}={len(v)}" for k, v in sorted(buckets.items())))
        for state in sorted(buckets):
            if state in ("accepted",):
                continue
            for f in buckets[state][:20]:
                print(f"    {state:<10} {f.get('path')}" + (f" — {f['reason']}" if f.get("reason") else ""))
    jobs = view.get("jobs")
    if isinstance(jobs, list) and jobs:
        print("  jobs:")
        for job in jobs:
            print(f"    {(job.get('kind') or '?'):<18}{job.get('state') or '?'}"
                  + (f" — {job['error']}" if job.get("error") else ""))
    publication = view.get("publication")
    if isinstance(publication, dict) and publication:
        print("  publication:    " + " ".join(f"{k}={v}" for k, v in sorted(publication.items())))
    elif publication:
        print(f"  publication:    {publication}")
    for key in ("error", "message"):
        if view.get(key):
            print(f"  {key + ':':<16}{view[key]}")


def _wait_for_import(svc: dict, import_id: str, timeout_s=900.0, verbose: bool = True):
    """Poll until the import reaches a terminal state. `verbose=False` keeps stdout clean for
    a caller whose whole output is one JSON document."""
    import time
    deadline = time.monotonic() + timeout_s
    last = None
    while True:
        view = _import_view(svc, import_id)
        state = view.get("state")
        if state != last:
            if verbose:
                print(f"  state:     {state}")
            last = state
        if state in ("ready", "partial", "failed", "cancelled"):
            return view
        if time.monotonic() >= deadline:
            if verbose:
                print("  (still running — re-check with `guidefold status " + import_id + "`)")
            return view
        _sleep(IMPORT_POLL_INTERVAL_S)


def _run_import(a, verb: str, prepared=None, finish: bool = True):
    """Import one tree. `prepared` is a (manifest, blob_paths) pair from a scan the caller
    already did -- `extract` needs the manifest before the network so `--dry-run` can print it
    -- and `finish=False` returns `(svc, import_id)` instead of exiting, so the same flow can
    be one step of a longer command."""
    # Credentials are checked BEFORE the tree walk. Scanning a large monorepo hashes every
    # file, so doing it first meant an unauthenticated import spent minutes before failing on
    # a missing token -- the cheapest check has to be the first one.
    root = _pivot_root(getattr(a, "path", None))
    _require_service(resolve_service_config(_tolerant_config(root), a, root))
    if prepared is not None:
        manifest, blob_paths = prepared
        svc = resolve_service_config(_tolerant_config(root), a, root)
    else:
        root, _cfg, svc, manifest, blob_paths, _stats = _scan_for(
            a, publish=not getattr(a, "no_publish", False))
    payload = _canonical_json(manifest)
    key = _sha256_bytes(payload)
    unique = {f["sha256"] for f in manifest["files"]}

    try:
        repo_state = _ensure_repo(svc, root)
        _s, created, _h = _service_request(
            svc["api"], "POST", f"{_repo_base(svc)}/imports", token=svc["token"],
            json_body={"idempotency_key": key, "manifest": manifest}, idempotency_key=key)
        created = created if isinstance(created, dict) else {}
        import_id = created.get("import_id") or created.get("reused_import_id")
        if not import_id:
            _die(f"{verb}: the server did not return an import_id", 1)
        missing = [s for s in (created.get("missing_blobs") or []) if isinstance(s, str)]
        if not getattr(a, "json", False):
            print(f"guidefold {verb} — root: {root}")
            print(f"  org/repo:  {svc['org']}/{svc['repo']} ({repo_state})")
            print(f"  manifest:  {len(manifest['files'])} file(s), sha256:{key}")
            print(f"  import:    {import_id} ({created.get('state') or 'created'})")
            print(f"  blobs:     {len(unique)} unique, {len(missing)} new, "
                  f"{max(0, len(unique) - len(missing))} reused")
        uploaded = _upload_blobs(svc, import_id, missing, blob_paths,
                                 verbose=not getattr(a, "json", False))
        try:
            _s, finalized, _h = _service_request(
                svc["api"], "POST", f"{_repo_base(svc)}/imports/{import_id}/finalize",
                token=svc["token"], json_body={"idempotency_key": key + ":finalize"},
                idempotency_key=key + ":finalize")
        except ServiceError as e:
            if e.code != "blobs_missing":
                raise
            # The list the server actually sends is `details.missing` (API-CONTRACT §3).
            still = [s for s in (e.details.get("missing") or []) if isinstance(s, str)]
            still = still or [s for s in unique if s not in set(uploaded)]
            uploaded += _upload_blobs(svc, import_id, still, blob_paths,
                                      verbose=not getattr(a, "json", False))
            _s, finalized, _h = _service_request(
                svc["api"], "POST", f"{_repo_base(svc)}/imports/{import_id}/finalize",
                token=svc["token"], json_body={"idempotency_key": key + ":finalize"},
                idempotency_key=key + ":finalize")
    except ServiceError as e:
        _die_service(verb, e, svc)

    finalized = finalized if isinstance(finalized, dict) else {}
    if not finish:
        # The caller owns the rest of the run and prints its own summary.
        return svc, import_id
    view = None
    if getattr(a, "wait", False):
        if not getattr(a, "json", False):
            print("  waiting for the import to finish…")
        try:
            view = _wait_for_import(svc, import_id)
        except ServiceError as e:
            _die_service(verb, e, svc)

    # `new_blobs` is what the SERVER asked this run to upload (`missing_blobs`), not a number
    # the client invented: that is what makes "the second sync uploads 0 new blobs" a real
    # observation. A reused import's finalize response may carry the numbers from its FIRST
    # attempt, so those are reported separately rather than overwriting this run's.
    result = {
        "org": svc["org"], "repo": svc["repo"], "import_id": import_id,
        "manifest_digest": key, "files": len(manifest["files"]),
        "unique_blobs": len(unique),
        "new_blobs": len(missing),
        "reused_blobs": max(0, len(unique) - len(missing)),
        "uploaded_blobs": len(uploaded),
        "state": (view or finalized).get("state") or created.get("state"),
        "commit": manifest["commit"], "dirty": manifest["dirty"],
        "complete": manifest["complete"], "publish": manifest["publish"],
    }
    for wire, local in (("new_blobs", "server_new_blobs"), ("reused_blobs", "server_reused_blobs")):
        if isinstance(finalized.get(wire), int):
            result[local] = finalized[wire]
    if getattr(a, "json", False):
        print(json.dumps(result, indent=2, sort_keys=True))
    else:
        print(f"  new_blobs: {result['new_blobs']}   reused_blobs: {result['reused_blobs']}")
        if "server_new_blobs" in result and result["server_new_blobs"] != result["new_blobs"]:
            print(f"  server totals for this import: new_blobs={result['server_new_blobs']} "
                  f"reused_blobs={result.get('server_reused_blobs')}")
        if view:
            _print_import_view(view)
        else:
            print(f"  state:     {result['state']}")
            print(f"  next:      guidefold status {import_id}")
    sys.exit(0)


def cmd_import(a):
    _run_import(a, "import")


def cmd_sync(a):
    _run_import(a, "sync")


# --------------------------------------------------------------- extract (one-shot)

# `guidefold extract` is the whole loop in one command: scan the repository, import it,
# plan every group, generate proposals for all three kinds, and print what came back.
# It publishes nothing and approves nothing -- the owner still decides on every proposal
# (PRODUCT-PIVOT U2.6). What it removes is the four separate commands between "point this
# at my repo" and "here is what it found".

# Personal skill directories are private content, so they are opt-in per harness and never
# implied by `--all`. `~/.claude/skills` and `~/.codex/skills` are the observed conventions
# (both hold `<name>/SKILL.md`), and each tool's own home variable wins when it is set.
# The Copilot CLI entry is a [zalozenie]: no personal skill directory was verified for it, so
# it is listed here to be overridden rather than guessed at silently. Override any of them
# with `extract.personal_sources` in guidefold.yaml, or `personal_sources` in the credentials
# entry for this API.
PERSONAL_HARNESSES = ("claude", "codex", "copilot")
PERSONAL_DEFAULT_SOURCES = {
    "claude": ("CLAUDE_CONFIG_DIR", "~/.claude", "skills"),
    "codex": ("CODEX_HOME", "~/.codex", "skills"),
    "copilot": ("COPILOT_CONFIG_DIR", "~/.copilot", "skills"),  # [zalozenie]
}
PERSONAL_PREFIX = "_personal"


def _personal_harnesses(raw: str):
    """Parse `--personal claude,codex` / `--personal all` into an ordered harness list."""
    wanted = [p.strip().lower() for p in str(raw or "").split(",") if p.strip()]
    if not wanted or wanted == ["all"]:
        return list(PERSONAL_HARNESSES)
    unknown = [w for w in wanted if w not in PERSONAL_HARNESSES]
    if unknown:
        _die("extract: unknown --personal harness "
             f"{', '.join(sorted(unknown))} - expected {', '.join(PERSONAL_HARNESSES)} or all", 2)
    return [h for h in PERSONAL_HARNESSES if h in wanted]


def _personal_roots(cfg: dict, svc: dict, harnesses):
    """Resolve one directory per requested harness. A configured path wins over the default;
    an absent directory is simply not a source, not an error."""
    configured = ((cfg or {}).get("extract") or {}).get("personal_sources")
    configured = configured if isinstance(configured, dict) else {}
    from_creds = (svc or {}).get("personal_sources")
    if isinstance(from_creds, dict):
        merged = dict(configured)
        merged.update(from_creds)
        configured = merged
    out = []
    for harness in harnesses:
        override = configured.get(harness)
        if isinstance(override, str) and override.strip():
            path = Path(os.path.expanduser(override.strip()))
        else:
            var, home, sub = PERSONAL_DEFAULT_SOURCES[harness]
            base = os.environ.get(var) or home
            path = Path(os.path.expanduser(base)) / sub
        out.append((harness, path))
    return out


def _personal_files(cfg: dict, svc: dict, harnesses):
    """Walk the personal skill directories and return manifest rows plus their blob paths.

    Same rules as `scan`, applied per root: secrets by name and by content are excluded, a
    symlink whose target leaves *its own* root is excluded, oversized and unreadable files are
    excluded, and nothing outside a `<root>/<skill>/` directory is collected at all. Every row
    carries `source: {kind: personal, harness}` and a `_personal/<harness>/...` path, so a
    reader of the manifest can always tell which bytes came from off the repository."""
    files, blobs, excluded, roots = [], {}, [], []
    for harness, root in _personal_roots(cfg, svc, harnesses):
        roots.append({"harness": harness, "path": str(root), "present": root.is_dir()})
        if not root.is_dir():
            continue
        try:
            root_resolved = root.resolve()
        except OSError:
            continue
        for skill_dir in sorted(p for p in root.iterdir() if not p.name.startswith(".")):
            if not skill_dir.is_dir():
                continue
            for abs_path in sorted(skill_dir.rglob("*")):
                rel = abs_path.relative_to(root).as_posix()
                wire = f"{PERSONAL_PREFIX}/{harness}/{rel}"
                if abs_path.is_dir():
                    continue
                segs = rel.split("/")
                if any(s in SCAN_PRUNE_DIRS for s in segs[:-1]):
                    continue
                if abs_path.is_symlink() or any(
                        (root / "/".join(segs[:i])).is_symlink() for i in range(1, len(segs))):
                    if _escapes_root(root_resolved, abs_path):
                        excluded.append({"path": wire, "reason": "symlink_outside_root"})
                        continue
                if _is_secret_name(segs[-1]):
                    excluded.append({"path": wire, "reason": "secret_pattern"})
                    continue
                kind = _personal_kind(segs)
                if kind is None:
                    excluded.append({"path": wire, "reason": "unsupported_format"})
                    continue
                try:
                    st = abs_path.stat()
                    if not os.path.isfile(abs_path):
                        continue
                    if st.st_size > SCAN_MAX_FILE_BYTES:
                        excluded.append({"path": wire, "reason": "file_too_large"})
                        continue
                    data = abs_path.read_bytes()
                except OSError:
                    excluded.append({"path": wire, "reason": "unreadable"})
                    continue
                if _PRIVATE_KEY_RE.search(data[:SCAN_CONTENT_SNIFF_BYTES]):
                    excluded.append({"path": wire, "reason": "secret_pattern"})
                    continue
                digest = _sha256_bytes(data)
                files.append({"path": wire, "sha256": digest, "size": len(data), "kind": kind,
                              "mode": "100755" if st.st_mode & 0o111 else "100644",
                              "source": {"kind": "personal", "harness": harness}})
                blobs.setdefault(digest, abs_path)
    files.sort(key=lambda f: _path_key(f["path"]))
    excluded.sort(key=lambda e: (_path_key(e["path"]), e["reason"]))
    return files, blobs, excluded, roots


def _personal_kind(segs):
    """`<skill>/SKILL.md` is a skill; `<skill>/{references,scripts,assets}/...` is a resource.
    Anything else in a personal directory is not part of a skill package and is not sent."""
    if len(segs) == 2 and segs[1] == "SKILL.md":
        return "skill"
    if len(segs) >= 3 and segs[1] in SCAN_RESOURCE_DIRS:
        return "resource"
    return None


def _merge_personal(manifest: dict, blob_paths: dict, files, blobs, excluded):
    """Fold the personal rows into the scanned manifest, keeping it deterministic."""
    manifest["files"] = sorted(manifest["files"] + files, key=lambda f: _path_key(f["path"]))
    manifest["excluded"] = sorted(manifest["excluded"] + excluded,
                                  key=lambda e: (_path_key(e["path"]), e["reason"]))
    blob_paths.update(blobs)
    return manifest


def _print_extract_preview(root, manifest, roots, files, excluded):
    """--dry-run: exactly what would leave this machine, and nothing opened."""
    print(f"guidefold extract --dry-run - root: {root}")
    print("  [dry-run] nothing was sent; this command opened no socket.")
    print(f"  repository files: {len(manifest['files']) - len(files)}")
    print(f"  publish:   {'yes' if manifest['publish'] else 'no'}"
          + ("" if manifest["publish"] else " (personal content is never published)"))
    for entry in roots:
        state = "found" if entry["present"] else "absent"
        print(f"  personal source ({entry['harness']}): {entry['path']} [{state}]")
    if not roots:
        print("  personal sources: none requested (pass --personal to include them)")
    print(f"  personal files: {len(files)}")
    for f in files:
        print(f"    {f['size']:>9}  sha256:{f['sha256']}  {f['path']}")
    if excluded:
        print(f"  personal excluded: {len(excluded)}")
        for e in excluded[:20]:
            print(f"    {e['reason']:<22} {e['path']}")
        if len(excluded) > 20:
            print(f"    ... {len(excluded) - 20} more")
    print(f"  total files that would be sent: {len(manifest['files'])}")


EXTRACT_KINDS = ("extraction", "enrichment", "consolidation")


def _extract_summary(svc, import_id, plan, proposals, view):
    """What the run produced, from the two reads that already exist: the proposal list and
    the import status. Abstentions come from the jobs, because a run that correctly declined
    to consolidate has done its job and must not look like a run that did nothing."""
    by_kind, consolidations = {}, []
    for p in proposals:
        kind = p.get("kind") or "unknown"
        by_kind[kind] = by_kind.get(kind, 0) + 1
    abstentions, cost, jobs = [], {}, (view or {}).get("jobs") or []
    for job in jobs:
        if not isinstance(job, dict):
            continue
        for a in job.get("abstentions") or []:
            if isinstance(a, dict):
                abstentions.append({"reason": a.get("reason"), "skills": a.get("skills") or [],
                                    "detail": a.get("detail")})
        job_cost = job.get("cost")
        if isinstance(job_cost, dict):
            for key in ("calls", "input_tokens", "output_tokens", "usd_certain", "usd_uncertain"):
                if isinstance(job_cost.get(key), (int, float)):
                    cost[key] = cost.get(key, 0) + job_cost[key]
    return {
        "org": svc["org"], "repo": svc["repo"], "import_id": import_id,
        "profile": (plan or {}).get("profile"),
        "planned_groups": len((plan or {}).get("groups") or []),
        "groups_skipped": (plan or {}).get("groups_skipped") or {},
        "proposals_by_kind": by_kind, "proposals": len(proposals),
        "consolidations": consolidations, "abstentions": abstentions, "cost": cost,
        "state": (view or {}).get("state"),
    }


def _print_extract_summary(summary):
    print(f"guidefold extract - {summary['org']}/{summary['repo']}")
    print(f"  import:    {summary['import_id']} ({summary.get('state') or 'queued'})")
    print(f"  profile:   {summary.get('profile') or 'default'}  "
          f"groups: {summary['planned_groups']}")
    if summary.get("personal_files"):
        print(f"  personal:  {summary['personal_files']} file(s) imported for review; "
              "publish was disabled for this run")
    if summary["proposals_by_kind"]:
        parts = ", ".join(f"{k}={v}" for k, v in sorted(summary["proposals_by_kind"].items()))
        print(f"  proposals: {summary['proposals']} ({parts})")
    else:
        print("  proposals: 0")
    for c in summary["consolidations"]:
        sources = ", ".join(c["source_scopes"]) or "unknown"
        print(f"    shared element in {c['target_scope']}: from {sources}  {c['path']}")
    if summary["abstentions"]:
        print(f"  declined:  {len(summary['abstentions'])}")
        for a in summary["abstentions"][:10]:
            print(f"    {a['reason']:<26} {', '.join(a['skills'])}")
        if len(summary["abstentions"]) > 10:
            print(f"    ... {len(summary['abstentions']) - 10} more")
    if summary["cost"]:
        parts = ", ".join(f"{k}={v}" for k, v in sorted(summary["cost"].items()))
        print(f"  cost:      {parts}")
    else:
        print("  cost:      0 (no model was called)")
    print("  next:      guidefold proposals list")


def _extract_consolidations(svc, proposals):
    """For every consolidation, the scopes it came from and the scope it landed in. The
    source scopes are read from the proposal's own `derived_from` edges, not guessed from
    the target: a shared element that cannot name its sources is exactly the thing U2 AC5
    forbids."""
    out = []
    for p in proposals:
        if p.get("kind") != "consolidation":
            continue
        detail = {}
        try:
            _s, detail, _h = _service_request(
                svc["api"], "GET", f"{_repo_base(svc)}/proposals/{p['proposal_id']}",
                token=svc["token"])
        except ServiceError:
            detail = {}
        detail = detail if isinstance(detail, dict) else {}
        sources = []
        for r in detail.get("relations") or []:
            if isinstance(r, dict) and r.get("type") == "derived_from" and r.get("to"):
                sources.append(str(r["to"]))
        scopes = sorted({s.split(":")[3] for s in sources if s.count(":") >= 4})
        out.append({"proposal_id": p.get("proposal_id"), "path": p.get("path"),
                    "target_scope": p.get("scope") or "_root",
                    "sources": sorted(sources), "source_scopes": scopes})
    return out


def cmd_extract(a):
    root = _pivot_root(getattr(a, "path", None))
    cfg = _tolerant_config(root)
    svc = resolve_service_config(cfg, a, root)
    # `--personal` never publishes. A complete import with `publish: true` enqueues
    # `publish.build`, which would materialise the manifest into the served snapshot -- so a
    # developer's own `~/.claude/skills` would start answering SEARCH for the whole
    # organisation, from one flag, with nobody having reviewed it. Personal content is
    # imported so an owner can look at it and decide; it is not content to serve.
    personal_requested = bool(getattr(a, "personal", None))
    publish = not getattr(a, "no_publish", False) and not personal_requested
    # The scan is offline and runs before anything else, so `--dry-run` can show the exact
    # bytes without a token and without a network stack.
    _root, _cfg, _svc, manifest, blob_paths, _stats = _scan_for(a, publish=publish)
    personal_files, personal_blobs, personal_excluded, roots = [], {}, [], []
    if personal_requested:
        personal_files, personal_blobs, personal_excluded, roots = _personal_files(
            cfg, svc, _personal_harnesses(a.personal))
        _merge_personal(manifest, blob_paths, personal_files, personal_blobs, personal_excluded)

    if getattr(a, "dry_run", False):
        if getattr(a, "json", False):
            print(json.dumps({"root": str(root), "personal_sources": roots,
                              "personal_files": personal_files,
                              "personal_excluded": personal_excluded,
                              "publish": manifest["publish"],
                              "files": len(manifest["files"]),
                              "manifest_digest": _sha256_bytes(_canonical_json(manifest))},
                             indent=2, sort_keys=True))
        else:
            _print_extract_preview(root, manifest, roots, personal_files, personal_excluded)
        sys.exit(0)

    _require_service(svc)
    svc, import_id = _run_import(a, "extract", prepared=(manifest, blob_paths), finish=False)

    try:
        # The profile rides as a query parameter, built separately so the path this call site
        # names stays the contracted one (§4.2) rather than a path-plus-query the contract
        # checker cannot match.
        plan_path = f"{_repo_base(svc)}/imports/{import_id}/plan"
        _s, plan, _h = _service_request(
            svc["api"], "GET", plan_path + "?profile=one_shot", token=svc["token"])
        plan = plan if isinstance(plan, dict) else {}
        key = f"extract:{import_id}"
        _s, started, _h = _service_request(
            svc["api"], "POST", f"{_repo_base(svc)}/imports/{import_id}/proposals:generate",
            token=svc["token"], idempotency_key=key,
            json_body={"idempotency_key": key, "profile": "one_shot",
                       "kinds": list(EXTRACT_KINDS)})
        started = started if isinstance(started, dict) else {}
        plan = started.get("plan") if isinstance(started.get("plan"), dict) else plan
        plan.setdefault("profile", started.get("profile"))
    except ServiceError as e:
        _die_service("extract", e, svc)

    view, proposals = None, []
    if getattr(a, "wait", False):
        try:
            view = _wait_for_import(svc, import_id, verbose=not getattr(a, "json", False))
            _s, listed, _h = _service_request(
                svc["api"], "GET", f"{_repo_base(svc)}/proposals", token=svc["token"])
            listed = listed if isinstance(listed, dict) else {}
            proposals = [p for p in (listed.get("items") or []) if isinstance(p, dict)]
        except ServiceError as e:
            _die_service("extract", e, svc)

    summary = _extract_summary(svc, import_id, plan, proposals, view)
    if proposals:
        try:
            summary["consolidations"] = _extract_consolidations(svc, proposals)
        except ServiceError as e:
            _die_service("extract", e, svc)
    summary["job_ids"] = started.get("job_ids") or []
    summary["personal_files"] = len(personal_files)
    summary["publish"] = manifest["publish"]
    if getattr(a, "json", False):
        print(json.dumps(summary, indent=2, sort_keys=True))
    else:
        _print_extract_summary(summary)
    sys.exit(0)


def cmd_status(a):
    root = _pivot_root(getattr(a, "path", None))
    svc = resolve_service_config(_tolerant_config(root), a, root)
    _require_service(svc)
    try:
        view = _import_view(svc, a.import_id)
    except ServiceError as e:
        _die_service("status", e, svc)
    if getattr(a, "json", False):
        print(json.dumps(view, indent=2, sort_keys=True))
    else:
        _print_import_view(view)
    sys.exit(0)


# ----------------------------------------------------------------------- install / uninstall

# `gemini` has no hook: Gemini CLI reads GEMINI.md/AGENTS.md from disk, which `install` now
# materializes, so the harness is installable even though nothing is wired into a settings file.
INSTALL_HARNESSES = ("claude", "copilot", "gemini")
ADAPTER_DEST_REL = ".agents/skills/guidefold"
COPILOT_INSTRUCTIONS_REL = ".github/copilot-instructions.md"
COPILOT_BLOCK_BEGIN = "<!-- guidefold:begin -->"
COPILOT_BLOCK_END = "<!-- guidefold:end -->"
SERVICE_BLOCK_HEADER = "# guidefold service — written by `guidefold install`; never holds secrets"

COPILOT_INSTRUCTIONS_BODY = """## Guidefold skills

This repository's engineering skills are published through Guidefold. Copilot CLI does not
inject them automatically here, so load them explicitly before acting on an unfamiliar area:

```bash
.agents/skills/guidefold/scripts/guidefold find "<the task in your own words>" --scope <node>
.agents/skills/guidefold/scripts/guidefold load <urn>
```

`find` prints the ranked scope cards for the task; `load` downloads the exact published revision
into the local cache and prints its directory. Run `guidefold doctor` to check the connection,
the installed adapter and the configured org/repo.
"""


def _package_files(src: Path):
    out = []
    for p in sorted(src.rglob("*")):
        if not p.is_file():
            continue
        relpath = p.relative_to(src).as_posix()
        segs = relpath.split("/")
        if relpath == INSTALL_MANIFEST_NAME or "__pycache__" in segs or relpath.endswith(".pyc"):
            continue
        out.append(relpath)
    return out


def _install_manifest_path(root: Path) -> Path:
    return root / ADAPTER_DEST_REL / INSTALL_MANIFEST_NAME


def _read_install_manifest(root: Path) -> dict:
    try:
        data = json.loads(_install_manifest_path(root).read_text(encoding="utf-8"))
    except Exception:
        return {}
    return data if isinstance(data, dict) else {}


# A value that can be written as a YAML plain scalar without changing what the file means.
# Anything else (a space, a `#`, a newline, a quote) is emitted quoted rather than raw: these
# three values are committed to the consumer's guidefold.yaml, and a value that carried a
# newline would otherwise add whatever followed it as a second key for everyone who pulls.
_YAML_PLAIN_RE = re.compile(r"^[A-Za-z0-9][A-Za-z0-9._:/@+-]*$")


def _render_service_block(service: dict) -> str:
    lines = [SERVICE_BLOCK_HEADER, "service:"]
    for key in ("api", "org", "repo"):
        value = service.get(key)
        if value:
            text = str(value)
            lines.append(f"  {key}: " + (text if _YAML_PLAIN_RE.match(text) else json.dumps(text)))
    return "\n".join(lines) + "\n"


def _split_service_block(text: str):
    """(before, after) with any existing top-level `service:` block (plus the managed comment
    line right above it) removed. Comments and every other key stay exactly where they were --
    this is a surgical text edit, never a yaml.dump() round-trip that would reformat the file."""
    lines = text.splitlines(keepends=True)
    start = None
    for i, line in enumerate(lines):
        if re.match(r"^service:\s*(#.*)?$", line.rstrip("\n")):
            start = i
            break
    if start is None:
        return text, ""
    end = start + 1
    while end < len(lines):
        stripped = lines[end].rstrip("\n")
        if stripped and not stripped.startswith((" ", "\t", "#")):
            break
        if stripped.startswith("#") and not stripped.startswith((" ", "\t")):
            # A top-level comment ends the block unless it is our own header.
            break
        end += 1
    head = start
    if head > 0 and lines[head - 1].rstrip("\n") == SERVICE_BLOCK_HEADER:
        head -= 1
    return "".join(lines[:head]), "".join(lines[end:])


def _upsert_service_block(text: str, service: dict) -> str:
    before, after = _split_service_block(text)
    block = _render_service_block(service)
    if before and not before.endswith("\n"):
        before += "\n"
    if before and not before.endswith("\n\n"):
        before += "\n"
    return before + block + after


def _remove_service_block(text: str) -> str:
    before, after = _split_service_block(text)
    return (before.rstrip("\n") + "\n") if before.strip() else after


def _upsert_marked_block(text: str, body: str) -> str:
    block = f"{COPILOT_BLOCK_BEGIN}\n{body.rstrip()}\n{COPILOT_BLOCK_END}\n"
    if COPILOT_BLOCK_BEGIN in text and COPILOT_BLOCK_END in text:
        head, _, rest = text.partition(COPILOT_BLOCK_BEGIN)
        _, _, tail = rest.partition(COPILOT_BLOCK_END)
        return head + block + tail.lstrip("\n")
    prefix = text if not text or text.endswith("\n") else text + "\n"
    if prefix.strip():
        prefix += "\n"
    return prefix + block


def _remove_marked_block(text: str) -> str:
    if COPILOT_BLOCK_BEGIN not in text or COPILOT_BLOCK_END not in text:
        return text
    head, _, rest = text.partition(COPILOT_BLOCK_BEGIN)
    _, _, tail = rest.partition(COPILOT_BLOCK_END)
    return (head.rstrip("\n") + "\n" + tail.lstrip("\n")).lstrip("\n")


def _unmerge_hook_config(existing: dict, template: dict):
    """Exact inverse of _merge_hook_config for the entries this template contributed: removes
    the entries that point at our installed CLI -- including one an older version of the template
    wrote -- and leaves every foreign hook and every foreign top-level key.

    Returns (pruned, changed, only_ours). `only_ours` is True when what is left is nothing but
    the template's own non-hook scalars (e.g. copilot's `"version": 1`), i.e. the file exists
    solely because guidefold created it -- the caller deletes it instead of leaving a stub. A
    file that also holds somebody else's keys keeps them, that scalar included: guessing that a
    shared `version` was ours would be the more destructive mistake."""
    merged = json.loads(json.dumps(existing)) if existing else {}
    changed = False
    hooks = merged.get("hooks")
    for event, entries in ((template.get("hooks") or {}) if isinstance(template.get("hooks"), dict) else {}).items():
        if not isinstance(hooks, dict) or event not in hooks:
            continue
        bucket = hooks[event]
        kept = [e for e in bucket if e not in entries and not _is_guidefold_hook_entry(e)]
        if len(kept) != len(bucket):
            changed = True
        if kept:
            hooks[event] = kept
        else:
            hooks.pop(event)
    if isinstance(hooks, dict) and not hooks and "hooks" in merged:
        merged.pop("hooks")
        changed = True
    only_ours = all(key in template and template[key] == value for key, value in merged.items())
    return merged, changed, only_ours


class _InstallPlan:
    """Records every intended filesystem change so `--dry-run` and the real run print exactly
    the same summary, and so the exit path can say "nothing changed" truthfully."""

    def __init__(self):
        self.rows = []      # (verb, path, note)
        self.writes = []    # (Path, bytes-or-str, mode)

    def add(self, verb, path, note=""):
        self.rows.append((verb, path, note))

    @property
    def changed(self):
        return any(verb not in ("unchanged", "kept") for verb, _p, _n in self.rows)

    def render(self, prefix=""):
        order = {"create": 0, "update": 1, "delete": 2, "kept": 3, "unchanged": 4}
        for verb, path, note in sorted(self.rows, key=lambda r: (order.get(r[0], 9), r[1])):
            sign = {"create": "+", "update": "~", "delete": "-", "kept": "!", "unchanged": "="}.get(verb, " ")
            print(f"{prefix}{sign} {verb:<9} {path}" + (f"   ({note})" if note else ""))


def _plan_file(plan, root: Path, rel_path: str, content: bytes, recorded_sha, executable=False):
    dest = root / rel_path
    digest = _sha256_bytes(content)
    if not dest.exists():
        plan.add("create", rel_path)
        plan.writes.append((dest, content, executable))
        return digest
    try:
        current = dest.read_bytes()
    except OSError:
        plan.add("kept", rel_path, "unreadable")
        return recorded_sha
    current_sha = _sha256_bytes(current)
    if current_sha == digest:
        plan.add("unchanged", rel_path)
        return digest
    if recorded_sha is not None and current_sha == recorded_sha:
        plan.add("update", rel_path)
        plan.writes.append((dest, content, executable))
        return digest
    plan.add("kept", rel_path, "modified locally — not overwritten")
    return current_sha


def cmd_install(a):
    import shutil
    root = _pivot_root(getattr(a, "path", None))
    cfg = _tolerant_config(root)
    svc = resolve_service_config(cfg, a, root)
    harness = a.harness
    dry = getattr(a, "dry_run", False)
    if not TOOL_SKILL_SRC.is_dir():
        _die("install: cannot find the guidefold skill package next to this script", 2)
    dest_dir = root / ADAPTER_DEST_REL
    if dest_dir.resolve() == TOOL_SKILL_SRC.resolve():
        _die("install: this IS the guidefold tool checkout — install into a consumer repo instead", 2)

    manifest = _read_install_manifest(root)
    recorded = manifest.get("files") if isinstance(manifest.get("files"), dict) else {}
    plan = _InstallPlan()
    files = {}

    for rel_path in _package_files(TOOL_SKILL_SRC):
        src = TOOL_SKILL_SRC / rel_path
        target = f"{ADAPTER_DEST_REL}/{rel_path}"
        executable = bool(src.stat().st_mode & 0o111)
        files[target] = _plan_file(plan, root, target, src.read_bytes(), recorded.get(target), executable)

    # Harness wiring.
    hooks = manifest.get("hooks") if isinstance(manifest.get("hooks"), dict) else {}
    hook_writes = []
    tmpl_name, dest_rel = HARNESS_HOOK_FILES[harness]
    tmpl_path = TOOL_SKILL_SRC / "hooks" / tmpl_name
    if tmpl_path.is_file():
        template = json.loads(tmpl_path.read_text(encoding="utf-8"))
        hook_dest = root / dest_rel
        existing = {}
        if hook_dest.is_file():
            try:
                existing = json.loads(hook_dest.read_text(encoding="utf-8"))
            except json.JSONDecodeError:
                plan.add("kept", dest_rel, "not valid JSON — left untouched")
                existing = None
        if existing is not None:
            merged, changed = _merge_hook_config(existing, template)
            if changed:
                plan.add("update" if hook_dest.is_file() else "create", dest_rel, f"{harness} hook")
                hook_writes.append((hook_dest, json.dumps(merged, indent=2) + "\n"))
            else:
                plan.add("unchanged", dest_rel, f"{harness} hook")
            hooks[dest_rel] = tmpl_name
    else:
        plan.add("kept", dest_rel, f"no {tmpl_name} template shipped — skipped")

    copilot_instructions = manifest.get("copilot_instructions", False)
    if harness == "copilot":
        instructions_path = root / COPILOT_INSTRUCTIONS_REL
        current = instructions_path.read_text(encoding="utf-8") if instructions_path.is_file() else ""
        updated = _upsert_marked_block(current, COPILOT_INSTRUCTIONS_BODY)
        if updated != current:
            plan.add("update" if instructions_path.is_file() else "create", COPILOT_INSTRUCTIONS_REL,
                     "explicit find/load section")
            hook_writes.append((instructions_path, updated))
        else:
            plan.add("unchanged", COPILOT_INSTRUCTIONS_REL)
        copilot_instructions = True

    # Non-secret service coordinates in guidefold.yaml.
    wrote_service = manifest.get("guidefold_yaml_service", False)
    service_fields = {k: svc.get(k) for k in ("api", "org", "repo")}
    yaml_path = root / "guidefold.yaml"
    if any(service_fields.values()):
        if not yaml_path.is_file():
            plan.add("kept", "guidefold.yaml", "missing — run `guidefold init` first; service: not written")
        else:
            current = yaml_path.read_text(encoding="utf-8")
            updated = _upsert_service_block(current, service_fields)
            if updated != current:
                plan.add("update", "guidefold.yaml", "service: api/org/repo (no secrets)")
                hook_writes.append((yaml_path, updated))
            else:
                plan.add("unchanged", "guidefold.yaml", "service: already current")
            wrote_service = True

    cli_target = f"{ADAPTER_DEST_REL}/scripts/guidefold"
    package_sha = files.get(cli_target) or _sha256_bytes((TOOL_SKILL_SRC / "scripts" / "guidefold").read_bytes())
    harnesses = sorted(set(manifest.get("harnesses") or []) | {harness})
    new_manifest = {
        "format": INSTALL_MANIFEST_FORMAT,
        "cli_version": CLI_VERSION,
        "package_sha256": package_sha,
        "harnesses": harnesses,
        "files": files,
        "hooks": hooks,
        "guidefold_yaml_service": bool(wrote_service),
        "copilot_instructions": bool(copilot_instructions),
    }
    manifest_bytes = _canonical_json(new_manifest) + b"\n"
    manifest_rel = f"{ADAPTER_DEST_REL}/{INSTALL_MANIFEST_NAME}"
    manifest_changed = (not _install_manifest_path(root).is_file()
                        or _install_manifest_path(root).read_bytes() != manifest_bytes)
    if manifest_changed:
        plan.add("update" if _install_manifest_path(root).is_file() else "create", manifest_rel)
    else:
        plan.add("unchanged", manifest_rel)

    print(f"guidefold install --harness {harness} — target repo: {root}")
    plan.render("  ")
    if not plan.changed and not manifest_changed:
        print("  nothing to do — the adapter is already installed and current.")
        sys.exit(0)
    if dry:
        print("  [dry-run] nothing was written.")
        sys.exit(0)

    for dest, content, executable in plan.writes:
        _atomic_write_bytes(dest, content, executable)
    for dest, text in hook_writes:
        _atomic_write_bytes(dest, text)
    _atomic_write_bytes(_install_manifest_path(root), manifest_bytes)
    print(f"  package sha256: {package_sha}")
    # One-shot delivery (ADR-0035 §8): the hook needs the index for this commit, and every
    # harness that reads files instead of running a hook (Gemini, Codex, Copilot's applyTo)
    # needs the materialized scope cards. Both are generated, gitignored, and idempotent, so
    # `install` does them here instead of asking the developer to remember two more commands.
    # Skipped, with a reason, when there is no guidefold.yaml yet or when asked not to.
    if yaml_path.is_file() and not getattr(a, "no_materialize", False):
        try:
            cfg_full = load_map(root)
            cfg_full.setdefault("registry", {})
            cmd_materialize(argparse.Namespace(check=False), root, cfg_full)
            cmd_index(argparse.Namespace(check=False), root, cfg_full)
        except SystemExit as exc:                      # a failed validate/build is reported, not hidden
            print(f"  materialize/index: {exc}")
    else:
        print("  materialize/index: skipped (" + ("--no-materialize" if yaml_path.is_file() else "no guidefold.yaml yet") + ")")
    print("  next: `guidefold doctor`")
    sys.exit(0)


def cmd_uninstall(a):
    root = _pivot_root(getattr(a, "path", None))
    harness = a.harness
    manifest = _read_install_manifest(root)
    if not manifest:
        print(f"guidefold uninstall --harness {harness}: no {INSTALL_MANIFEST_NAME} — nothing "
              f"guidefold installed here; refusing to delete anything.")
        sys.exit(0)
    dry = getattr(a, "dry_run", False)
    plan = _InstallPlan()
    deletes, writes = [], []

    hooks = manifest.get("hooks") if isinstance(manifest.get("hooks"), dict) else {}
    _tmpl_name, dest_rel = HARNESS_HOOK_FILES[harness]
    if dest_rel in hooks:
        hook_dest = root / dest_rel
        tmpl_path = TOOL_SKILL_SRC / "hooks" / hooks[dest_rel]
        if hook_dest.is_file() and tmpl_path.is_file():
            try:
                existing = json.loads(hook_dest.read_text(encoding="utf-8"))
            except json.JSONDecodeError:
                existing = None
            if existing is None:
                plan.add("kept", dest_rel, "not valid JSON — left untouched")
            else:
                template = json.loads(tmpl_path.read_text(encoding="utf-8"))
                pruned, changed, only_ours = _unmerge_hook_config(existing, template)
                if not changed:
                    plan.add("unchanged", dest_rel)
                elif pruned and not only_ours:
                    plan.add("update", dest_rel, "guidefold hook removed, foreign keys kept")
                    writes.append((hook_dest, json.dumps(pruned, indent=2) + "\n"))
                else:
                    plan.add("delete", dest_rel, "file held only the guidefold hook")
                    deletes.append(hook_dest)

    if harness == "copilot" and manifest.get("copilot_instructions"):
        path = root / COPILOT_INSTRUCTIONS_REL
        if path.is_file():
            current = path.read_text(encoding="utf-8")
            pruned = _remove_marked_block(current)
            if pruned == current:
                plan.add("unchanged", COPILOT_INSTRUCTIONS_REL)
            elif pruned.strip():
                plan.add("update", COPILOT_INSTRUCTIONS_REL, "guidefold section removed")
                writes.append((path, pruned))
            else:
                plan.add("delete", COPILOT_INSTRUCTIONS_REL, "file held only the guidefold section")
                deletes.append(path)

    remaining = [h for h in (manifest.get("harnesses") or []) if h != harness]
    last = not remaining
    if last:
        for rel_path, digest in sorted((manifest.get("files") or {}).items()):
            dest = root / rel_path
            if not dest.exists():
                plan.add("unchanged", rel_path, "already gone")
                continue
            try:
                current = _sha256_bytes(dest.read_bytes())
            except OSError:
                plan.add("kept", rel_path, "unreadable")
                continue
            if current != digest:
                plan.add("kept", rel_path, "modified since install — refusing to delete")
                continue
            plan.add("delete", rel_path)
            deletes.append(dest)
        if manifest.get("guidefold_yaml_service"):
            yaml_path = root / "guidefold.yaml"
            if yaml_path.is_file():
                current = yaml_path.read_text(encoding="utf-8")
                pruned = _remove_service_block(current)
                if pruned != current:
                    plan.add("update", "guidefold.yaml", "service: block removed")
                    writes.append((yaml_path, pruned))
        plan.add("delete", f"{ADAPTER_DEST_REL}/{INSTALL_MANIFEST_NAME}")
        deletes.append(_install_manifest_path(root))
    else:
        plan.add("unchanged", ADAPTER_DEST_REL,
                 f"still installed for {', '.join(remaining)}")

    print(f"guidefold uninstall --harness {harness} — target repo: {root}")
    plan.render("  ")
    if not plan.changed:
        print("  nothing to do.")
        sys.exit(0)
    if dry:
        print("  [dry-run] nothing was removed.")
        sys.exit(0)

    for dest, text in writes:
        dest.write_text(text, encoding="utf-8")
    for dest in deletes:
        try:
            dest.unlink()
        except OSError:
            pass
    # A directory this install created (.claude/, .github/hooks/) should not survive as an
    # empty shell; one that still holds anything else is left exactly as it is.
    for dest in deletes:
        _prune_empty_dirs(root, dest.parent)
    if not last:
        manifest["harnesses"] = remaining
        manifest["hooks"] = {k: v for k, v in hooks.items() if k != dest_rel}
        if harness == "copilot":
            manifest["copilot_instructions"] = False
        _install_manifest_path(root).write_bytes(_canonical_json(manifest) + b"\n")
    else:
        _prune_empty_dirs(root, root / ADAPTER_DEST_REL)
    print("  removed.")
    sys.exit(0)


def _prune_empty_dirs(root: Path, leaf: Path):
    """Remove the directories the install created, deepest first, and then walk up while the
    parents are empty. A directory that still holds a file (e.g. one uninstall refused to delete
    because it was edited) stops the walk, so nothing is lost."""
    if leaf.is_dir():
        for directory in sorted((p for p in leaf.rglob("*") if p.is_dir()),
                                key=lambda p: len(p.parts), reverse=True):
            try:
                directory.rmdir()
            except OSError:
                pass
    current = leaf
    while current != root and current.is_dir():
        try:
            next(current.iterdir())
            return
        except StopIteration:
            parent = current.parent
            try:
                current.rmdir()
            except OSError:
                return
            current = parent
        except OSError:
            return


# --------------------------------------------------------------------------------- proposals

def _git_head_commit(root: Path):
    try:
        out = subprocess.run(["git", "-C", str(root), "rev-parse", "HEAD"],
                             capture_output=True, text=True, timeout=10)
    except Exception:
        return None
    if out.returncode != 0:
        return None
    commit = out.stdout.strip()
    return commit if re.fullmatch(r"[0-9a-f]{40}", commit) else None


def _export_path(root: Path, rel) -> Path:
    """Resolve one export file path inside the work tree, or refuse.

    `path` comes from the server's export document, and `proposals apply --write` turns it into
    a filesystem write in the user's repository. `root / "../../.ssh/authorized_keys"` resolves
    outside the tree and `mkdir(parents=True)` would create the directories to get there, so the
    check has to happen before anything is created: no absolute path, no `..` and no empty
    segment, and the resolved destination must still sit under the resolved root (which also
    catches a symlinked parent)."""
    text = str(rel or "")
    if not text or text.startswith("/") or text.startswith("\\") or ":" in text.split("/")[0][1:2]:
        _die(f"proposals apply: refusing the export path {text!r} (absolute paths are not allowed)", 2)
    parts = text.replace("\\", "/").split("/")
    if any(p in ("", ".", "..") for p in parts):
        _die(f"proposals apply: refusing the export path {text!r} "
             f"(empty, '.' or '..' segments are not allowed)", 2)
    root_real = Path(root).resolve()
    dest = (root_real / text)
    try:
        resolved = dest.resolve()
    except OSError:
        _die(f"proposals apply: refusing the export path {text!r} (it cannot be resolved)", 2)
    if root_real not in resolved.parents:
        _die(f"proposals apply: refusing the export path {text!r} "
             f"(it resolves outside the repository)", 2)
    return dest


def _export_diff(root: Path, files: list) -> str:
    import difflib
    chunks = []
    for entry in files:
        path = entry.get("path")
        content = entry.get("content")
        if path is None or content is None:
            continue
        dest = _export_path(root, path)
        before = dest.read_text(encoding="utf-8", errors="replace").splitlines(keepends=True) if dest.is_file() else []
        after = str(content).splitlines(keepends=True)
        chunks.extend(difflib.unified_diff(
            before, after,
            fromfile=("a/" + path) if before else "/dev/null",
            tofile="b/" + path))
    return "".join(chunks)


def cmd_proposals(a):
    root = _pivot_root(getattr(a, "path", None))
    svc = resolve_service_config(_tolerant_config(root), a, root)
    _require_service(svc)
    base = _repo_base(svc)
    if a.proposals_cmd == "list":
        query = []
        for key in ("state", "kind", "scope"):
            value = getattr(a, key, None)
            if value:
                import urllib.parse
                query.append(f"{key}={urllib.parse.quote(str(value))}")
        path = f"{base}/proposals" + ("?" + "&".join(query) if query else "")
        try:
            _s, body, _h = _service_request(svc["api"], "GET", path, token=svc["token"])
        except ServiceError as e:
            _die_service("proposals list", e, svc)
        items = (body or {}).get("items") if isinstance(body, dict) else body
        items = items if isinstance(items, list) else []
        if getattr(a, "json", False):
            print(json.dumps(items, indent=2, sort_keys=True))
            sys.exit(0)
        if not items:
            print("guidefold proposals: none")
            sys.exit(0)
        print(f"guidefold proposals — {svc['org']}/{svc['repo']}")
        for item in items:
            print(f"  {str(item.get('proposal_id') or item.get('id') or '?'):<38} "
                  f"{str(item.get('state') or ''):<20} {str(item.get('kind') or ''):<16} "
                  f"{item.get('scope') or ''}  {item.get('title') or item.get('path') or ''}")
        sys.exit(0)
    if a.proposals_cmd == "show":
        try:
            _s, body, _h = _service_request(svc["api"], "GET", f"{base}/proposals/{a.proposal_id}",
                                            token=svc["token"])
        except ServiceError as e:
            _die_service("proposals show", e, svc)
        print(json.dumps(body, indent=2, sort_keys=True))
        sys.exit(0)
    if a.proposals_cmd == "apply":
        try:
            _s, export, _h = _service_request(svc["api"], "GET", f"{base}/exports/{a.export_id}",
                                              token=svc["token"])
        except ServiceError as e:
            _die_service("proposals apply", e, svc)
        export = export if isinstance(export, dict) else {}
        files = [f for f in (export.get("files") or []) if isinstance(f, dict) and f.get("path")]
        if not files:
            _die("proposals apply: the export contains no files", 1)
        head = _git_head_commit(root)
        base_commit = export.get("base_commit")
        check = a.base_check if a.base_check is not None else (head is not None)
        if check:
            if head is None:
                print("guidefold proposals apply: warning — not inside a git work tree, "
                      "cannot verify base_commit", file=sys.stderr)
            elif base_commit and base_commit != head:
                _die(f"proposals apply: export base_commit {base_commit[:12]}… != HEAD {head[:12]}… — "
                     f"rebase the export (or re-export) before applying", 1)
        patch = export.get("patch") or _export_diff(root, files)
        sys.stdout.write(patch if patch.endswith("\n") or not patch else patch + "\n")
        if not a.write:
            print(f"\n{len(files)} file(s) would change. Nothing was written — re-run with --write.")
            print("guidefold never runs `git commit` or `git push`; review and commit yourself.")
            sys.exit(0)
        # Everything is validated before anything is written: a half-applied export with the
        # rest refused is worse than a refused export.
        planned = []
        for entry in files:
            dest = _export_path(root, entry["path"])
            content = entry.get("content")
            if content is None:
                # `content or ""` used to truncate an existing file to zero bytes when the
                # server sent no body for it.
                _die(f"proposals apply: the export carries no content for {entry['path']} — "
                     f"nothing was written", 1)
            content = str(content)
            declared = entry.get("sha256")
            if declared:
                actual = _sha256_bytes(content.encode("utf-8"))
                if actual != declared:
                    _die(f"proposals apply: {entry['path']} does not match its declared sha256 "
                         f"({actual[:12]}… != {str(declared)[:12]}…) — nothing was written", 1)
            planned.append((dest, entry["path"], content))
        written = []
        for dest, rel, content in planned:
            dest.parent.mkdir(parents=True, exist_ok=True)
            dest.write_text(content, encoding="utf-8")
            written.append(rel)
        print()
        for path in sorted(written):
            print(f"  wrote {path}")
        print(f"\n{len(written)} file(s) written. Review with `git diff`, then commit yourself — "
              f"guidefold never commits or pushes.")
        sys.exit(0)
    _die("proposals: expected `list`, `show <id>` or `apply <export_id>`", 2)


# ------------------------------------------------------------------------- doctor extensions

def _check_service_config(root: Path, cfg) -> dict:
    svc = resolve_service_config(cfg or {}, None, root)
    if not svc.get("api"):
        return _doctor_check("service-config", "warn",
                             "no hosted API configured (api=none org=none repo=none) — local mode only",
                             "run `guidefold login --api https://…` then `guidefold install --harness claude`")
    detail = f"api={svc['api']} org={svc.get('org') or 'none'} repo={svc.get('repo') or 'none'}"
    missing = [k for k in ("org", "repo") if not svc.get(k)]
    if missing:
        return _doctor_check("service-config", "warn", detail,
                             "run `guidefold org use <slug>` / pass --repo <id> to `guidefold install`")
    return _doctor_check("service-config", "ok", detail)


def _check_service_api(root: Path, cfg) -> list:
    """Reachability (`GET /health/ready`) and identity (`GET /api/v1/me`). The token itself is
    never printed -- only its source, the resolved role and the advertised scopes."""
    svc = resolve_service_config(cfg or {}, None, root)
    if not svc.get("api"):
        return [_doctor_check("service-api", "ok", "no hosted API configured — nothing to reach"),
                _doctor_check("service-identity", "ok", "no hosted API configured — token not needed")]
    checks = []
    try:
        status, body, _h = _service_request(svc["api"], "GET", "/health/ready", timeout=3.0)
        detail = f"{svc['api']}/health/ready → HTTP {status}"
        versions = (body or {}).get("api_schema_versions") if isinstance(body, dict) else None
        if versions:
            detail += f", schema {', '.join(str(v) for v in versions)}"
        checks.append(_doctor_check("service-api", "ok", detail))
    except ServiceError as e:
        checks.append(_doctor_check("service-api", "fail", f"{svc['api']} not ready: {e}",
                                    "check the API URL and the network; local commands keep working"))
        checks.append(_doctor_check("service-identity", "warn", "skipped (API unreachable)"))
        return checks
    if not svc.get("token"):
        checks.append(_doctor_check("service-identity", "warn",
                                    "no token stored (scopes=unknown)",
                                    "run `guidefold login` (or set GUIDEFOLD_TOKEN in CI)"))
        return checks
    try:
        _s, me, _h = _service_request(svc["api"], "GET", "/api/v1/me", token=svc["token"], timeout=5.0)
    except ServiceError as e:
        status = "fail" if e.status in (401, 403) else "warn"
        checks.append(_doctor_check("service-identity", status,
                                    f"GET /api/v1/me failed: {e} (token source: {svc['token_source']})",
                                    "run `guidefold login` again — the stored token may be revoked"))
        return checks
    me = me if isinstance(me, dict) else {}
    user = me.get("user") or {}
    orgs = me.get("orgs") if isinstance(me.get("orgs"), list) else []
    role = next((o.get("role") for o in orgs if o.get("slug") == svc.get("org")), None)
    scopes = me.get("scopes")
    if not isinstance(scopes, list):
        token_info = me.get("token")
        scopes = token_info.get("scopes") if isinstance(token_info, dict) else None
    scopes_text = (", ".join(str(s) for s in scopes) if isinstance(scopes, list) and scopes
                   else "not advertised by /api/v1/me")
    detail = (f"user={user.get('email') or user.get('id') or 'unknown'} "
              f"org={svc.get('org') or 'none'} role={role or 'unknown'} "
              f"scopes={scopes_text} (token source: {svc['token_source']})")
    if svc.get("org") and not role:
        checks.append(_doctor_check("service-identity", "warn", detail,
                                    "the token has no membership in the selected org — run `guidefold org use <slug>`"))
    else:
        checks.append(_doctor_check("service-identity", "ok", detail))
    return checks


def _check_adapter_install(root: Path) -> dict:
    manifest = _read_install_manifest(root)
    if not manifest:
        return _doctor_check("adapter-install", "warn",
                             f"no {ADAPTER_DEST_REL}/{INSTALL_MANIFEST_NAME} — adapter not installed by `guidefold install`",
                             "run `guidefold install --harness claude` (or --harness copilot)")
    files = manifest.get("files") if isinstance(manifest.get("files"), dict) else {}
    missing, modified = [], []
    for rel_path, digest in sorted(files.items()):
        dest = root / rel_path
        if not dest.is_file():
            missing.append(rel_path)
            continue
        try:
            if _sha256_bytes(dest.read_bytes()) != digest:
                modified.append(rel_path)
        except OSError:
            modified.append(rel_path)
    package = manifest.get("package_sha256") or "unknown"
    detail = (f"harnesses={', '.join(manifest.get('harnesses') or []) or 'none'} "
              f"files={len(files)} package_sha256={package[:16]}…")
    if missing or modified:
        return _doctor_check("adapter-install", "warn",
                             detail + f" — {len(missing)} missing, {len(modified)} modified",
                             "re-run `guidefold install --harness <harness>` to restore the package")
    return _doctor_check("adapter-install", "ok", detail + " — all files match the manifest")


def _check_harness_capabilities(root: Path, harness: str) -> dict:
    """What the harness can actually be relied on to do here. `context injection observed` is
    reported only from evidence on disk (a wired hook file), never assumed from the harness's
    name -- Copilot CLI has no such hook, so it stays explicit find/load."""
    _tmpl_name, dest_rel = HARNESS_HOOK_FILES[harness]
    wired = (root / dest_rel).is_file() and "scripts/guidefold" in (
        (root / dest_rel).read_text(errors="ignore") if (root / dest_rel).is_file() else "")
    if harness == "claude":
        caps = ["search", "use", "events", f"hook_context_injection={'true' if wired else 'false'}"]
        status = "ok" if wired else "warn"
        fix = None if wired else "run `guidefold install --harness claude` to wire the hook"
    else:
        caps = ["search", "use", "events", "hook_context_injection=false",
                "explicit_find_load=true"]
        status = "ok"
        fix = None
    return _doctor_check(f"capabilities-{harness}", status,
                         f"{harness}: " + ", ".join(caps), fix)


# ------------------------------------------------------------------------ main
# ------------------------------------------------------------------------------------------
# `guidefold ascend` (ADR-0035): bottom-up knowledge ascent. When a skill changes in a leaf
# scope, an LLM writes or edits ONE abstract skill per ancestor scope -- a *map* ("what lives
# here, what each part is for, who owns it") and/or a *convention* ("what every child does the
# same way") -- and climbs until a level has nothing generic to add or the root is reached.
#
# What makes this SkillPyramid-shaped rather than "ask a model to summarise":
#   * field-aware context: the model sees the target scope's node (owner, path, children), the
#     existing abstract skill there (to EDIT, never duplicate), the CARDS of every skill in every
#     descendant scope (name/description/digest -- the level of detail this repo's own
#     progressive-disclosure evidence shows an agent can act on), and the full body of only the
#     skill(s) that changed;
#   * grounding gates: every claim cites source URNs from that context; a body that names a
#     skill the context does not contain, contains a fenced code block or a numbered procedure,
#     or repeats three consecutive lines of any child body verbatim, is rejected -- the
#     SkillPyramid ablation where ungrounded "scratch" skills scored below a flat library is the
#     failure mode these gates exist to prevent;
#   * digests only: the written file is capped at ASCEND_MAX_FILE_LINES (CLAUDE.md: cards are
#     digests, no procedures);
#   * idempotency without a model call: the parent skill records a fingerprint of the child
#     cards it was derived from; an unchanged fingerprint means no call and no diff;
#   * `guidefold validate` must pass with the new file, or it is reverted.
# It never commits. In CI (templates/ci.yml `ascend`) the result is a PR whose CODEOWNERS are
# the parent scope's owner -- the human gate the contract calls scope_widening_not_approved.
ASCEND_DEFAULT_BASE_URL = "https://openrouter.ai/api/v1"
ASCEND_DEFAULT_MODEL = "anthropic/claude-sonnet-4.5"
ASCEND_API_KEY_ENV = "GUIDEFOLD_ASCEND_API_KEY"
ASCEND_MAX_FILE_LINES = 80
ASCEND_MAX_BODY_LINES = 60
ASCEND_MAX_PROOF_CLAIMS = 8
ASCEND_MAX_PROOF_REFS = 16
ASCEND_MAX_DEPTH = 6
ASCEND_KINDS = ("map", "convention")
ASCEND_MARKER = "guidefold-ascend"

def node_dir(root: Path, cfg: dict, node: str) -> Path:
    """The directory a node's skills live under: the first `paths` glob with its trailing
    `/**` (or `**`) removed; `_root` and `**` are the repository root."""
    if node == "_root":
        return root
    globs = (cfg["nodes"].get(node) or {}).get("paths") or []
    for g in globs:
        base = g[:-3] if g.endswith("/**") else (g[:-2] if g.endswith("**") else g)
        base = base.rstrip("/")
        if base and "*" not in base:
            return root / base
    sys.exit(f"guidefold: cannot derive a directory for node {node} from paths {globs}; "
             f"give it a plain `<dir>/**` glob first")

def _ascend_name(node: str, kind: str) -> str:
    """Deterministic skill name per (scope, kind): `atlas-identity-map`, `root-conventions`.
    The hook relies on this to find a scope's map by URN from the artifact alone."""
    return f"{flat_node(node) or 'root'}-{'map' if kind == 'map' else 'conventions'}"

def _parent_map_urn(cards, child_urn: str):
    """The nearest ascended scope map strictly above `child_urn`'s scope, or None. Pure string
    work over URNs plus a membership test on the artifact's cards -- no frontmatter, no YAML."""
    parts = child_urn.split(":")
    if len(parts) != 5:
        return None
    publisher, node = parts[2], parts[3]
    for anc in ancestors(node)[1:]:
        cand = f"urn:skill:{publisher}:{anc}:{_ascend_name(anc, 'map')}"
        if cand in cards:
            return cand
    return None

def _with_parent_map(idx, top: list, cap: int = 4) -> list:
    """ADR-0035 delivery rule: the nearest ascended map above the best-ranked card rides along,
    ahead of it (ADR-0006: general before specific), in its own slot within `cap`. One map at
    most; never displaces a selected card; never changes ranking."""
    if not top or len(top) >= cap:
        return top
    have = {c["urn"] for c in top}
    for c in top:
        m = _parent_map_urn(idx.cards, c["urn"])
        if m and m not in have:
            card = idx.cards[m]
            return [{"urn": m, "node": card["node"], "name": card["name"],
                     "description": card["description"], "score": 0, "scope_map": True}] + list(top)
    return top

def _ascend_children(cfg: dict, node: str) -> list:
    """Direct child nodes of `node` in dotted order."""
    if node == "_root":
        return sorted(n for n in cfg["nodes"] if n != "_root" and "." not in n)
    prefix = node + "."
    return sorted(n for n in cfg["nodes"] if n.startswith(prefix) and "." not in n[len(prefix):])

def _ascend_skill_records(root: Path, cfg: dict) -> dict:
    """urn -> skill facts plus immutable file hash/line count for proof drafting."""
    out = {}
    for d, node, fm in all_skills(root, cfg):
        md = fm.get("metadata") or {}
        skill_path = d / "SKILL.md"
        raw = skill_path.read_bytes()
        text = raw.decode("utf-8")
        normalized = text.replace("\r\n", "\n").replace("\r", "\n")
        body = normalized.split("\n---\n", 1)[1] if normalized.startswith("---\n") and "\n---\n" in normalized else normalized
        out[urn(cfg, node, d.name)] = {
            "urn": urn(cfg, node, d.name), "node": node, "name": d.name,
            "description": str(fm.get("description") or ""), "digest": str(md.get("digest") or "").strip(),
            "owner": str(md.get("owner") or ""), "path": rel(root, skill_path), "body": body,
            "file_sha256": _sha256_bytes(raw),
            "line_count": len(normalized.splitlines()),
            "status": str(md.get("status") or "active"),
            "negative_triggers": str(md.get("negative_triggers") or ""),
            "generated_by": str(md.get("generated_by") or ""), "kind": str(md.get("ascend_kind") or ""),
            "fingerprint": str(md.get("ascend_fingerprint") or ""),
            "decided": tuple(k.strip() for k in str(md.get("ascend_kinds_decided") or "").split(",") if k.strip()),
            "source_proof": fm.get("source_proof") if isinstance(fm.get("source_proof"), dict) else None,
        }
    return out

def _ascend_card(rec: dict) -> dict:
    card = {"urn": rec["urn"], "scope": rec["node"], "name": rec["name"],
            "description": rec["description"], "digest": rec["digest"], "owner": rec["owner"]}
    proof = rec.get("source_proof")
    if isinstance(proof, dict) and proof.get("verified") is True:
        claims = proof.get("claims") if isinstance(proof.get("claims"), list) else []
        ids = sorted(str(c.get("id")) for c in claims if isinstance(c, dict) and str(c.get("id") or ""))
        if ids:
            card["verified_claims"] = ids
    return card

def _ascend_proof_json(value) -> bytes:
    """Match Go's proofClaimDigest serialization (sorted keys, Python spacing)."""
    return json.dumps(value, sort_keys=True, ensure_ascii=False, allow_nan=False,
                      separators=(", ", ": ")).encode("utf-8")

def _ascend_proof_claim_digest(claim: dict):
    """Compute the stable digest used by production Go for a child claim."""
    if not isinstance(claim, dict) or not str(claim.get("id") or "").strip():
        return None
    status = str(claim.get("status") or "").strip()
    if status not in {"supported", "partial", "uncertain", "unsupported"}:
        return None
    out = {"id": str(claim["id"]), "status": status, "source_refs": [], "claim_refs": []}
    if "text" in claim:
        if not isinstance(claim["text"], str):
            return None
        out["text"] = claim["text"]
    raw_sources = claim.get("source_refs", [])
    if not isinstance(raw_sources, list):
        return None
    for ref in raw_sources:
        if not isinstance(ref, dict):
            return None
        try:
            out["source_refs"].append({
                "path": str(ref["path"]), "sha256": str(ref["sha256"]),
                "line_from": int(ref["line_from"]), "line_to": int(ref["line_to"]),
            })
        except (KeyError, TypeError, ValueError):
            return None
    raw_children = claim.get("claim_refs", [])
    if not isinstance(raw_children, list):
        return None
    for ref in raw_children:
        if not isinstance(ref, dict):
            return None
        try:
            out["claim_refs"].append({
                "skill_id": str(ref["skill_id"]), "revision": str(ref["revision"]),
                "claim_id": str(ref["claim_id"]), "claim_digest": str(ref["claim_digest"]),
                "commitment": str(ref["commitment"]),
            })
        except (KeyError, TypeError, ValueError):
            return None
    return _sha256_bytes(_ascend_proof_json(out))

def _ascend_proof_commitment(proof: dict):
    """Compute the lower-card commitment consumed by Go's recursive verifier."""
    if not isinstance(proof, dict) or not isinstance(proof.get("claims"), list):
        return None
    rows = []
    for claim in proof["claims"]:
        digest = _ascend_proof_claim_digest(claim)
        if digest is None:
            return None
        rows.append({"id": str(claim.get("id") or ""), "digest": digest})
    rows.sort(key=lambda row: row["id"])
    return _sha256_bytes(_ascend_proof_json(rows))

def _ascend_child_claim_ref(records: dict, source: str, claim_id: str):
    """Return a canonical recursive pointer only for a verified child proof."""
    record = records.get(source) or {}
    proof = record.get("source_proof")
    if not isinstance(proof, dict) or proof.get("verified") is not True:
        return None
    claims = proof.get("claims")
    if not isinstance(claims, list):
        return None
    child = next((c for c in claims if isinstance(c, dict) and str(c.get("id")) == claim_id), None)
    if child is None or child.get("status") != "supported":
        return None
    digest = _ascend_proof_claim_digest(child)
    commitment = _ascend_proof_commitment(proof)
    revision = str(proof.get("revision") or "")
    if digest is None or commitment is None or not revision or revision == "pending":
        return None
    return {"skill_id": source, "revision": revision, "claim_id": claim_id,
            "claim_digest": digest, "commitment": commitment}

def _ascend_fingerprint(cards: list, changed_bodies: dict) -> str:
    import hashlib
    payload = json.dumps({"cards": sorted(cards, key=lambda c: c["urn"]),
                          "bodies": {k: hashlib.sha256(v.encode("utf-8")).hexdigest()
                                     for k, v in sorted(changed_bodies.items())}},
                         sort_keys=True, ensure_ascii=False)
    return hashlib.sha256(payload.encode("utf-8")).hexdigest()

def _ascend_http(base_url: str, api_key: str, model: str, messages: list, timeout_s: int = 120) -> str:
    """One OpenAI-compatible chat completion (OpenRouter by default). Returns the assistant
    text. stdlib only. Never logs the key."""
    import urllib.request, urllib.error
    body = json.dumps({"model": model, "messages": messages, "temperature": 0,
                       "response_format": {"type": "json_object"}}).encode("utf-8")
    req = urllib.request.Request(
        base_url.rstrip("/") + "/chat/completions", data=body, method="POST",
        headers={"Authorization": f"Bearer {api_key}", "Content-Type": "application/json",
                 "HTTP-Referer": "https://github.com/wiatrM/guidefold", "X-Title": "guidefold ascend"})
    try:
        with urllib.request.urlopen(req, timeout=timeout_s) as resp:
            data = json.loads(resp.read().decode("utf-8"))
    except urllib.error.HTTPError as exc:
        detail = exc.read().decode("utf-8", errors="replace")[:300]
        sys.exit(f"guidefold ascend: model call failed: HTTP {exc.code} {detail}")
    except (urllib.error.URLError, TimeoutError, OSError) as exc:
        sys.exit(f"guidefold ascend: model call failed: {exc}")
    try:
        return data["choices"][0]["message"]["content"]
    except (KeyError, IndexError, TypeError):
        sys.exit(f"guidefold ascend: unexpected completion shape: {str(data)[:300]}")

def _ascend_parse_json(text: str):
    t = text.strip()
    if t.startswith("```"):
        t = t.split("```", 2)[1]
        t = t[4:] if t.startswith("json") else t
    try:
        return json.loads(t.strip())
    except json.JSONDecodeError:
        return None

_ASCEND_SYSTEM = """You maintain a monorepo's skill hierarchy. Skills are SKILL.md cards that an AI coding \
agent loads by scope. You are asked to write or edit ABSTRACT skills for ONE parent scope, from the \
cards of the skills below it. Two kinds:
- "map": what lives in this scope -- the child scopes and their skills, what each is for, who owns \
it, how they relate. Written for an agent that lands anywhere under this scope and needs to know \
what else exists around it.
- "convention": what EVERY child does the same way -- shared rules, constraints, contracts. Only \
when at least two children genuinely share it.
Hard rules: this is a DIGEST, never a procedure. No numbered steps, no commands, no code blocks, no \
copying of child text. Name only skills, scopes and owners that appear in the context; never invent \
a component. Every claim must cite the source skill URNs it comes from. If the context has nothing \
generic worth stating at this level beyond what the existing abstract skill already says, answer \
no_change with the reason. Keep each body under 60 lines. Answer with ONE JSON object only:
{"results":[{"kind":"map"|"convention","action":"no_change"|"create"|"edit","reason":"...",\
"skill":{"name":"<kebab-case>","description":"<one sentence, no scope prefix>","digest":"<2-3 sentences>",\
"triggers":"<comma-separated phrases an agent might ask>","body":"<markdown>",\
"claims":[{"text":"<one claim from the body>","sources":["urn:skill:..."],\
"child_claims":[{"source":"urn:skill:...","claim_id":"<verified child claim id>"}]}]}}]}
Omit "skill" when action is no_change."""

def _ascend_prompt(cfg: dict, node: str, records: dict, changed: dict, existing: dict) -> str:
    spec = cfg["nodes"].get(node) or {}
    tag = cfg["publisher"] if node == "_root" else node.replace(".", "/")
    children = _ascend_children(cfg, node)
    lines = [f"# Target scope: {node}", f"owner: {spec.get('owner')}", f"description prefix: [{tag}]",
             f"direct child scopes: {', '.join(children) or '(none)'}", ""]
    for kind in ASCEND_KINDS:
        rec = existing.get(kind)
        lines.append(f"## Existing abstract skill ({kind}): " + (rec["urn"] if rec else "none -- you may create one"))
        if rec:
            lines.append(rec["body"].strip())
        lines.append("")
    lines.append("## Skills at this scope (cards)")
    for r in sorted(records.values(), key=lambda r: r["urn"]):
        if r["node"] == node and r["generated_by"] != ASCEND_MARKER:
            lines.append(json.dumps(_ascend_card(r), ensure_ascii=False))
    lines.append("")
    lines.append("## Skills in descendant scopes (cards, grouped by direct child)")
    for child in children:
        lines.append(f"### {child} (owner {(cfg['nodes'].get(child) or {}).get('owner')})")
        for r in sorted(records.values(), key=lambda r: r["urn"]):
            if r["node"] == child or r["node"].startswith(child + "."):
                lines.append(json.dumps(_ascend_card(r), ensure_ascii=False))
        lines.append("")
    lines.append("## Skills that changed (full body)")
    for u, body in sorted(changed.items()):
        lines.append(f"### {u}")
        lines.append(body.strip())
        lines.append("")
    return "\n".join(lines)

def _ascend_gate(cfg: dict, node: str, kind: str, skill: dict, records: dict, existing_urn: str):
    """Grounding / digest-only gates. Returns (ok, reasons)."""
    reasons = []
    body = str(skill.get("body") or "")
    name = str(skill.get("name") or "")
    if not re.fullmatch(r"[a-z0-9][a-z0-9-]{1,63}", name):
        reasons.append("name is not kebab-case")
    if not body.strip():
        reasons.append("empty body")
    if body.count("\n") + 1 > ASCEND_MAX_BODY_LINES:
        reasons.append(f"body over {ASCEND_MAX_BODY_LINES} lines")
    if "```" in body:
        reasons.append("fenced code block: a digest carries no procedures")
    if len(re.findall(r"(?m)^\s*\d+[.)]\s", body)) >= 3:
        reasons.append("numbered steps: a digest carries no procedures")
    known = set(records)
    raw_claims = skill.get("claims")
    claims = raw_claims if isinstance(raw_claims, list) else []
    if raw_claims is not None and not isinstance(raw_claims, list):
        reasons.append("claims must be an array")
    if not claims:
        reasons.append("no claims with sources")
    if len(claims) > ASCEND_MAX_PROOF_CLAIMS:
        reasons.append(f"too many claims for bounded provenance ({ASCEND_MAX_PROOF_CLAIMS} maximum)")
    for c in claims:
        if not isinstance(c, dict):
            reasons.append(f"claim is not an object: {str(c)[:60]}")
            continue
        srcs = c.get("sources") or []
        child_rows = c.get("child_claims") or []
        if not isinstance(srcs, list) or not isinstance(child_rows, list):
            reasons.append(f"claim sources and child_claims must be arrays: {str(c)[:60]}")
            continue
        if not srcs and not child_rows:
            reasons.append(f"claim without sources: {str(c)[:60]}")
        if len(srcs) > ASCEND_MAX_PROOF_REFS or len(child_rows) > ASCEND_MAX_PROOF_REFS:
            reasons.append(f"too many source refs in claim ({ASCEND_MAX_PROOF_REFS} maximum)")
        for s in srcs:
            if not isinstance(s, str) or s not in known or s == existing_urn:
                reasons.append(f"claim cites a source not in context: {s}")
        cited_records = [records[s] for s in srcs if isinstance(s, str) and s in records and s != existing_urn]
        if any(r.get("status") == "deprecated" for r in cited_records):
            reasons.append("claim cites a deprecated source; manual review required")
        for child in child_rows:
            if not isinstance(child, dict):
                reasons.append("child_claims entries must be objects")
                continue
            source = str(child.get("source") or "")
            claim_id = str(child.get("claim_id") or "")
            if not source or source not in known or source == existing_urn or not claim_id:
                reasons.append(f"child claim is not a known lower-card claim: {source}:{claim_id}")
                continue
            pointer = _ascend_child_claim_ref(records, source, claim_id)
            if pointer is None:
                reasons.append(f"child claim is not verified and content-addressed: {source}:{claim_id}")
    for u in re.findall(r"urn:skill:[A-Za-z0-9_.:-]+", body):
        if u not in known or u == existing_urn:
            reasons.append(f"body names an unknown skill: {u}")
    # A digest must not be a copy: no three consecutive non-empty lines of any child body.
    lines = [l.strip() for l in body.splitlines() if l.strip()]
    for rec in records.values():
        if rec["node"] == node or rec["urn"] == existing_urn:
            continue
        child = [l.strip() for l in rec["body"].splitlines() if l.strip()]
        child_set = {tuple(child[i:i + 3]) for i in range(len(child) - 2)}
        for i in range(len(lines) - 2):
            if tuple(lines[i:i + 3]) in child_set:
                reasons.append(f"three lines copied verbatim from {rec['urn']}")
                break
    return (not reasons), reasons

def _ascend_render(cfg: dict, node: str, kind: str, skill: dict, sources: list, fingerprint: str,
                   records: dict = None, decided: tuple = ASCEND_KINDS) -> str:
    spec = cfg["nodes"].get(node) or {}
    tag = cfg["publisher"] if node == "_root" else node.replace(".", "/")
    desc = str(skill.get("description") or "").strip().replace("\n", " ")
    if desc.startswith("["):
        desc = desc.split("]", 1)[1].strip()
    def q(s: str) -> str:
        return json.dumps(str(s), ensure_ascii=False)
    fm = [
        "---",
        f"name: {skill['name']}",
        f"description: {q('[' + tag + '] ' + desc)}",
        "metadata:",
        f"  scope: {node}",
        f"  owner: {spec.get('owner')}",
        "  status: active",
        "  kind: knowledge",
        "  knowledge_layer: abstract",
        f"  ascend_kind: {kind}",
        f"  generated_by: {ASCEND_MARKER}",
        f"  ascend_fingerprint: {fingerprint}",
        f"  ascend_kinds_decided: {q(', '.join(decided))}",
        f"  derived_from: {q(', '.join(sorted(sources)))}",
        f"  triggers: {q(str(skill.get('triggers') or '').strip())}",
        "  digest: >-",
    ]
    for line in str(skill.get("digest") or "").strip().splitlines() or [""]:
        fm.append("    " + line.strip())
    # LLM ascent is a synthesis step, not a source verifier.  Persist a visible, provisional
    # proof record so the generated card can travel through the normal snapshot/import path,
    # while making proof-gated delivery fail closed until an importer or owner supplies exact
    # source line ranges, snapshot/revision and a verified body hash.  `source_urns` is a
    # reviewer aid; the delivery contract only treats `source_refs` as evidence.
    fm.extend([
        "source_proof:",
        "  schema: source-proof-v1",
        "  verified: false",
        "  status: pending_review",
        "  snapshot: pending",
        "  revision: pending",
        f"  skill_id: {q(urn(cfg, node, skill['name']))}",
        f"  scopes: [{q(node)}]",
        "  claims:",
    ])
    claims = skill.get("claims") if isinstance(skill.get("claims"), list) else []
    claim_rows = []
    for i, claim in enumerate(claims, 1):
        if not isinstance(claim, dict):
            continue
        claim_sources = sorted({str(s) for s in (claim.get("sources") or []) if str(s)})
        child_rows = claim.get("child_claims") if isinstance(claim.get("child_claims"), list) else []
        claim_rows.append((f"claim-{i:03d}", str(claim.get("text") or "").strip(), claim_sources, child_rows))
    if not claim_rows:
        fm.append("    []")
    else:
        for claim_id, claim_text, claim_sources, child_rows in claim_rows:
            refs = []
            for source in claim_sources:
                record = (records or {}).get(source) or {}
                if record.get("path") and record.get("file_sha256") and record.get("line_count"):
                    refs.append({"path": record["path"], "sha256": record["file_sha256"],
                                 "line_from": 1, "line_to": record["line_count"]})
            child_refs = []
            for child in child_rows:
                if isinstance(child, dict):
                    pointer = _ascend_child_claim_ref(records, str(child.get("source") or ""),
                                                      str(child.get("claim_id") or ""))
                    if pointer is not None:
                        child_refs.append(pointer)
            fm.extend([
                f"    - id: {q(claim_id)}",
                f"      text: {q(claim_text)}",
                "      status: uncertain",
                f"      source_urns: {json.dumps(claim_sources, ensure_ascii=False)}",
                f"      source_refs: {json.dumps(refs, ensure_ascii=False, sort_keys=True)}",
                f"      claim_refs: {json.dumps(child_refs, ensure_ascii=False, sort_keys=True)}",
            ])
    fm.append("---")
    body = str(skill.get("body") or "").strip()
    text = "\n".join(fm) + "\n" + body + "\n"
    if text.count("\n") > ASCEND_MAX_FILE_LINES:
        # trim the body, never the frontmatter; the gate already bounds the body, so this is a belt
        keep = ASCEND_MAX_FILE_LINES - len(fm) - 1
        text = "\n".join(fm) + "\n" + "\n".join(body.splitlines()[:max(keep, 1)]) + "\n"
    return text

def cmd_ascend(a, root, cfg):
    api_key = os.environ.get(a.api_key_env or ASCEND_API_KEY_ENV, "")
    base_url = a.base_url or os.environ.get("GUIDEFOLD_ASCEND_BASE_URL") or ASCEND_DEFAULT_BASE_URL
    model = a.model or os.environ.get("GUIDEFOLD_ASCEND_MODEL") or ASCEND_DEFAULT_MODEL
    kinds = tuple(ASCEND_KINDS if a.kind == "both" else (a.kind,))
    records = _ascend_skill_records(root, cfg)

    # Which skills changed: explicit paths, or `git diff --name-only <since>` filtered to SKILL.md.
    changed_paths = list(a.changed or [])
    if a.since:
        out = subprocess.run(["git", "diff", "--name-only", a.since, "--", "."],
                             cwd=str(root), capture_output=True, text=True)
        if out.returncode != 0:
            sys.exit(f"guidefold ascend: git diff against {a.since} failed: {out.stderr.strip()}")
        changed_paths += [l.strip() for l in out.stdout.splitlines() if l.strip().endswith("SKILL.md")]
    changed_urns = []
    for p in changed_paths:
        pp = (root / p) if not Path(p).is_absolute() else Path(p)
        d = pp.parent if pp.name == "SKILL.md" else pp
        u = next((r["urn"] for r in records.values() if (root / r["path"]).parent == d.resolve()), None)
        if u is None:
            print(f"guidefold ascend: {p} is not a known skill (deleted or outside .agents/skills) -- skipped")
            continue
        if records[u]["generated_by"] == ASCEND_MARKER:
            continue          # an ascent output never triggers another ascent by itself
        changed_urns.append(u)
    changed_urns = sorted(set(changed_urns))
    if not changed_urns:
        summary = {"status": "nothing_to_ascend", "changed": [], "levels": [], "written": [], "calls": 0}
        print(json.dumps(summary, indent=2) if a.json_out == "-" else "guidefold ascend: no changed skills; nothing to do")
        if a.json_out and a.json_out != "-":
            Path(a.json_out).write_text(json.dumps(summary, indent=2) + "\n", encoding="utf-8")
        return
    if not api_key and not a.dry_run:
        sys.exit(f"guidefold ascend: no API key in ${a.api_key_env or ASCEND_API_KEY_ENV}; use --dry-run to see the plan")

    levels, written, calls = [], [], 0
    # Climb one level at a time. A changed skill seeds only its direct parent scope; a level
    # that writes something seeds the next ancestor with what it wrote; a level that writes
    # nothing ends the climb from there (SkillPyramid's "conservative and evidence-grounded"
    # Analyzer, made explicit). Deltas from several changed skills reaching the same ancestor
    # are merged, so a level is called at most once per run.
    frontier, done = {}, set()
    for u in changed_urns:
        parent = ancestors(records[u]["node"])[1:2]
        if parent:
            frontier.setdefault(parent[0], {})[u] = records[u]["body"]
    while True:
        pending = [n for n in frontier if n not in done]
        if not pending:
            break
        node = max(pending, key=node_depth)           # deepest first, so a parent sees its children's ascent
        done.add(node)
        if len(done) > ASCEND_MAX_DEPTH * max(1, len(changed_urns)):
            break
        changed = frontier[node]
        above = ancestors(node)[1:2]
        children = _ascend_children(cfg, node)
        desc_cards = [_ascend_card(r) for r in records.values()
                      if any(r["node"] == c or r["node"].startswith(c + ".") for c in children)
                      and r["generated_by"] != ASCEND_MARKER]
        existing = {}
        for r in records.values():
            if r["node"] == node and r["generated_by"] == ASCEND_MARKER and r["kind"] in kinds:
                existing[r["kind"]] = r
        fingerprint = _ascend_fingerprint(desc_cards, changed)
        level = {"node": node, "results": []}
        # Idempotency without a model call: an abstract skill written at this scope records the
        # fingerprint of the cards it was derived from and which kinds were decided then. Same
        # fingerprint, same kinds -> same answer, so there is nothing to ask. (A level where the
        # model wrote nothing leaves no file to remember that in; it is asked again next time.)
        if any(r["fingerprint"] == fingerprint and set(kinds) <= set(r["decided"]) for r in existing.values()):
            level["skipped"] = "fingerprint unchanged: nothing below this scope changed since the last ascent"
            levels.append(level)
            continue
        if a.dry_run:
            level["plan"] = {"changed": sorted(changed), "descendant_cards": len(desc_cards),
                             "existing": {k: v["urn"] for k, v in existing.items()}}
            levels.append(level)
            for anc in above:                 # show the whole possible chain; no model decides here
                frontier.setdefault(anc, {}).update(changed)
            continue
        prompt = _ascend_prompt(cfg, node, records, changed, existing)
        messages = [{"role": "system", "content": _ASCEND_SYSTEM}, {"role": "user", "content": prompt}]
        parsed = None
        for _attempt in range(3):
            calls += 1
            parsed = _ascend_parse_json(_ascend_http(base_url, api_key, model, messages))
            if isinstance(parsed, dict) and isinstance(parsed.get("results"), list):
                break
            messages.append({"role": "user", "content": "Answer with the single JSON object described, nothing else."})
        if not (isinstance(parsed, dict) and isinstance(parsed.get("results"), list)):
            level["error"] = "model returned no valid JSON after 3 attempts"
            levels.append(level)
            break
        any_written = False
        for res in parsed["results"]:
            kind = str(res.get("kind") or "")
            action = str(res.get("action") or "")
            item = {"kind": kind, "action": action, "reason": str(res.get("reason") or "")}
            if kind not in kinds or action not in ("no_change", "create", "edit"):
                item["rejected"] = "unknown kind or action"
                level["results"].append(item)
                continue
            if action == "no_change":
                level["results"].append(item)
                continue
            skill = res.get("skill") or {}
            target = existing.get(kind)
            if target and action == "create":
                action = item["action"] = "edit"       # never a duplicate beside the existing one
            # Deterministic name per (scope, kind): the hook finds a scope's map by URN alone,
            # from the artifact, with no frontmatter read (see _with_parent_map).
            skill["name"] = target["name"] if target else _ascend_name(node, kind)
            ok, reasons = _ascend_gate(cfg, node, kind, skill, records, target["urn"] if target else "")
            if not ok:
                item["rejected"] = reasons
                level["results"].append(item)
                continue
            sources = sorted({s for c in skill.get("claims", []) for s in (c.get("sources") or [])})
            text = _ascend_render(cfg, node, kind, skill, sources, fingerprint, records, kinds)
            dest = node_dir(root, cfg, node) / ".agents" / "skills" / skill["name"] / "SKILL.md"
            before = dest.read_text(encoding="utf-8") if dest.exists() else None
            if before == text:
                item["action"] = "no_change"; item["reason"] = "identical to the existing file"
                level["results"].append(item)
                continue
            dest.parent.mkdir(parents=True, exist_ok=True)
            dest.write_text(text, encoding="utf-8")
            _, errors = _validate_errors(root, load_map(root))
            mine = [e for e in errors if str(dest.parent.relative_to(root)) in e]
            if mine:
                if before is None:
                    dest.unlink();
                    try:
                        dest.parent.rmdir()
                    except OSError:
                        pass
                else:
                    dest.write_text(before, encoding="utf-8")
                item["rejected"] = ["validate: " + e for e in mine]
                level["results"].append(item)
                continue
            item["path"] = rel(root, dest)
            item["sources"] = sources
            level["results"].append(item)
            written.append(rel(root, dest))
            any_written = True
            records = _ascend_skill_records(root, cfg)        # the new parent is now a fact
            new_urn = urn(cfg, node, skill["name"])
            for anc in above:
                frontier.setdefault(anc, {})[new_urn] = records[new_urn]["body"]
        levels.append(level)

    summary = {"status": "ok", "model": model, "base_url": base_url, "changed": changed_urns,
               "levels": levels, "written": written, "calls": calls, "dry_run": bool(a.dry_run)}
    if a.summary_md:
        md = ["<!-- guidefold:ascend -->", "### guidefold ascend", "",
              f"Model `{model}`, {calls} call(s). Changed: " + ", ".join(f"`{u}`" for u in changed_urns), ""]
        for lv in levels:
            md.append(f"**{lv['node']}**" + (f" — skipped ({lv['skipped']})" if lv.get("skipped") else ""))
            for r in lv.get("results", []):
                line = f"- {r['kind']}: {r['action']}"
                if r.get("path"):
                    line += f" → `{r['path']}`"
                if r.get("rejected"):
                    line += " — rejected: " + "; ".join(map(str, r["rejected"] if isinstance(r["rejected"], list) else [r["rejected"]]))
                elif r.get("reason"):
                    line += f" — {r['reason']}"
                md.append(line)
            md.append("")
        md.append("Every written file cites its source skills in `metadata.derived_from`; the parent scope's "
                  "owner reviews this PR (contract: scope widening needs the target owner).")
        Path(a.summary_md).write_text("\n".join(md) + "\n", encoding="utf-8")
    if a.json_out == "-":
        print(json.dumps(summary, indent=2))
    else:
        if a.json_out:
            Path(a.json_out).write_text(json.dumps(summary, indent=2) + "\n", encoding="utf-8")
        for lv in levels:
            head = f"{lv['node']}: " + (lv.get("skipped") or lv.get("error") or "")
            print(head.rstrip(": "))
            for r in lv.get("results", []):
                tail = r.get("path") or ("rejected: " + "; ".join(map(str, r["rejected"])) if r.get("rejected") else r.get("reason", ""))
                print(f"  {r['kind']}: {r['action']} {tail}".rstrip())
        print(f"guidefold ascend: {len(written)} file(s) written, {calls} model call(s)")

def main():
    p = argparse.ArgumentParser(prog="guidefold")
    p.add_argument("--backend", choices=["local", "agent-registry"], help="override registry.backend from guidefold.yaml")
    p.add_argument("--project", help="override registry.project from guidefold.yaml")
    sub = p.add_subparsers(dest="cmd", required=True)
    sub.add_parser("where")
    f = sub.add_parser("find"); f.add_argument("task"); f.add_argument("--scope"); f.add_argument("--limit", type=int, default=8)
    f.add_argument("--include-deprecated", action="store_true", help="don't apply the policy filter's deprecated-skill drop")
    f.add_argument("--backend", choices=["local", "service"], dest="search_backend",
                   help="override search.backend for this invocation only (independent of the "
                        "top-level registry --backend above); `service` still needs "
                        "search.url/token configured via guidefold.yaml or GUIDEFOLD_SEARCH_*/"
                        "GUIDEFOLD_TOKEN env vars, or it is treated as a config error and falls "
                        "back to local (E2.6)")
    f.add_argument("--experimental", action="store_true",
                   help="E1.6 shadow mode: write a top-20 retrieval-order telemetry record to "
                        ".guidefold/telemetry/shadow-<date>.jsonl for offline reranker scoring "
                        "(tools/bakeoff/rerank_shadow.py). Never changes the printed result.")
    f.add_argument("--telemetry-raw", action="store_true",
                   help="with --experimental, store the raw query text in the shadow record "
                        "instead of only its SHA-256 hash (default: hash only -- prompts can "
                        "carry proprietary detail)")
    l = sub.add_parser("load"); l.add_argument("urn")
    l.add_argument("--delivery-policy", choices=("legacy", "proof_gated"), default="legacy",
                   help="USE delivery policy; proof_gated requires search.backend: service and "
                        "abstains without complete source proof (default: legacy)")
    va = sub.add_parser("validate")
    va.add_argument("--suggest", action="store_true",
                     help="F5: also print deterministic triggers/negative_triggers suggestions "
                          "for every skill missing one, mined from the SKILL.md body -- never "
                          "written to a file. Default validate output is unaffected.")
    va.add_argument("--json", action="store_true", help="with --suggest, machine-readable output")
    proc = sub.add_parser("procedure", help="S20: verify explicit runbook sections and an optional local verifier")
    proc.add_argument("skill", metavar="SKILL.md", help="path to the procedure SKILL.md inside this repository")
    proc.add_argument("--run", action="store_true", help="run metadata.verifier locally after structural checks")
    proc.add_argument("--json", action="store_true")
    ev = sub.add_parser("eval", help="E7.5: run --queries through the product path and report ranking/injection metrics; optionally gate on a regression vs --baseline")
    ev.add_argument("--queries", required=True, help="golden-format directory or single .yaml/.yml file (tests/golden/README.md schema), or a single .jsonl file of unlabelled {query, node} objects")
    ev.add_argument("--k", type=int, default=4, help="injection cap for completeness@k/all_required@k/distractor_rate@k and Router.select's k (default 4, matching K_CARDS)")
    ev.add_argument("--json", dest="json", default=None, help="also write the full metrics as JSON to this path")
    ev.add_argument("--baseline", default=None, help="compare current metrics to this --write-baseline JSON; prints deltas + paired bootstrap 95%% CI")
    ev.add_argument("--write-baseline", default=None, help="write current metrics (+ per-case detail) as a new baseline JSON to this path")
    ev.add_argument("--gate", action="store_true", help="exit non-zero if hit@1/all_required@k drop, or distractor_rate@k rises, beyond guidefold.yaml eval.gate's margin (default 1.0pp each) vs --baseline")
    rp2 = sub.add_parser("report", help="P12/U7: deterministic pre-merge change report — base ref vs working tree; structure blocks, probable collisions and retrieval examples warn")
    rp2.add_argument("--base", required=True, help="git ref to compare against (e.g. origin/main); extracted with `git archive` into a private temp dir, never the working tree")
    rp2.add_argument("--json", dest="json", default=None, metavar="PATH", help="write the guidefold-change-report-v1 JSON here")
    rp2.add_argument("--markdown", dest="markdown", default=None, metavar="PATH", help="write the PR-comment Markdown here (<=200 lines, carries the sticky-comment marker)")
    rp2.add_argument("--queries", default=None, help="golden-format dir/.yaml or .jsonl, same shapes `eval` accepts; defaults to guidefold.yaml's eval.queries. Omit and the retrieval section is skipped")
    rp2.add_argument("--k", type=int, default=4, help="injection cap for the retrieval example's all_required@k and Router.select's k (default 4)")
    rp2.add_argument("--fail-on", dest="fail_on", choices=("structure", "any", "none"), default="structure",
                     help="structure (default): exit 2 on any error finding — cycle, missing dependency, missing declared resource, invalid card. any: also exit 2 on warnings. none: always exit 0")
    rp2.add_argument("--reproducible", dest="reproducible", action="store_true", default=True,
                     help="omit generated_at so identical input gives byte-identical output (the default, and what CI wants)")
    rp2.add_argument("--no-reproducible", dest="reproducible", action="store_false",
                     help="stamp generated_at into the JSON (breaks byte-identical re-runs on purpose)")
    dr = sub.add_parser("drift"); dr.add_argument("--base", default="origin/main")
    pu = sub.add_parser("publish"); pu.add_argument("--changed", action="store_true"); pu.add_argument("--base", default="HEAD~1"); pu.add_argument("--revision"); pu.add_argument("--only", help="publish only skills whose logical URN contains this substring")
    ix = sub.add_parser("index"); ix.add_argument("--check", action="store_true", help="verify the on-disk artifact matches this sha and the current tree; no writes")
    m = sub.add_parser("materialize"); m.add_argument("--check", action="store_true")
    sub.add_parser("hook")
    sub.add_parser("prewarm")
    i = sub.add_parser("init", help="bootstrap a consumer monorepo: guidefold.yaml skeleton, .agents/skills/guidefold, harness hooks, CI workflow, .gitignore")
    i.add_argument("--publisher", help="override the inferred publisher name")
    i.add_argument("--harness", choices=["claude", "copilot", "codex", "all"], default="all")
    i.add_argument("--dry-run", action="store_true", help="print what would be done; write nothing")
    doc = sub.add_parser("doctor", help="diagnose a configured repo: gcloud/ADC/roles, hook wiring, skill layout, index freshness")
    doc.add_argument("--json", action="store_true")
    tel = sub.add_parser("telemetry", help="local SEARCH/USE telemetry (E6.4/E2.7): spool status, upload, per-skill report")
    telsub = tel.add_subparsers(dest="telemetry_cmd")
    st = telsub.add_parser("status", help="counts, oldest queued age, partitions -- read-only")
    st.add_argument("--json", action="store_true")
    fl = telsub.add_parser("flush", help="POST queued events to --url /v1/events:batch (never called from hook)")
    fl.add_argument("--url", required=True)
    fl.add_argument("--token-file", dest="token_file",
                    help="bearer token file (default: the search.token_file this repo already uses)")
    rp = telsub.add_parser("report", help="per-skill usage report (wraps tools/telemetry/report.py if present)")
    rp.add_argument("--db", help="ledger sqlite path (default: .guidefold/telemetry/ledger.sqlite3)")
    rp.add_argument("--tenant")
    rp.add_argument("--roster-file")
    rp.add_argument("--format", choices=("markdown", "json"), default="markdown")

    # ---- hosted management API (P03/P10, U1/U5). `scan` is offline; every other command here
    # talks to the API through _service_request only.
    def _service_flags(parser):
        parser.add_argument("--api", help="management API base URL (overrides GUIDEFOLD_API and guidefold.yaml service.api)")
        parser.add_argument("--org", help="organisation slug (overrides GUIDEFOLD_ORG and guidefold.yaml service.org)")
        parser.add_argument("--repo", help="repo id (overrides GUIDEFOLD_REPO_ID and guidefold.yaml service.repo)")
        return parser

    sc = sub.add_parser("scan", help="U1: build the import manifest for a tree — no network, ever")
    sc.add_argument("path", nargs="?", help="tree to scan (default: nearest guidefold.yaml above cwd)")
    sc.add_argument("--dry-run", action="store_true", help="explicit no-network run; the manifest printed is exactly what `import` would send")
    sc.add_argument("--json", action="store_true", help="print the canonical manifest instead of the summary")
    sc.add_argument("--partial", action="store_true", help="complete=false — a partial scan can never imply deletions server-side")
    sc.add_argument("--profile", default="default", help="scan profile recorded in the manifest (default: default)")
    _service_flags(sc)

    lg = sub.add_parser("login", help="U5: device-flow login; stores a token outside the repo, 0600")
    _service_flags(lg)
    lo = sub.add_parser("logout", help="forget the stored token for this API")
    lo.add_argument("--all", action="store_true", help="forget every stored API, not just this one")
    _service_flags(lo)
    og = sub.add_parser("org", help="list your organisations or select the current one")
    ogsub = og.add_subparsers(dest="org_cmd")
    ogl = ogsub.add_parser("list"); _service_flags(ogl)
    ogu = ogsub.add_parser("use"); ogu.add_argument("slug"); _service_flags(ogu)

    im = sub.add_parser("import", help="U1: scan, upload the missing blobs and finalize an import")
    im.add_argument("path", nargs="?")
    im.add_argument("--no-publish", action="store_true", help="import without enqueueing publish.build")
    im.add_argument("--partial", action="store_true")
    im.add_argument("--wait", action="store_true", help="poll until ready/partial/failed and print the per-file result")
    im.add_argument("--json", action="store_true")
    im.add_argument("--profile", default="default")
    _service_flags(im)
    sy = sub.add_parser("sync", help="U1: the same call as `import`, reporting the server's new/reused blob split")
    sy.add_argument("path", nargs="?")
    sy.add_argument("--partial", action="store_true")
    sy.add_argument("--wait", action="store_true")
    sy.add_argument("--json", action="store_true")
    sy.add_argument("--profile", default="default")
    _service_flags(sy)
    ex = sub.add_parser("extract", help="P08: scan, import and generate proposals for the whole repository in one call (never publishes)")
    ex.add_argument("path", nargs="?")
    ex.add_argument("--all", action="store_true",
                    help="cover the whole repository -- the default; kept explicit so CI reads as intent")
    ex.add_argument("--personal", default=None, metavar="LIST",
                    help="also send personal skill directories from THIS machine: claude, codex, "
                         "copilot (comma-separated) or all. Off by default, never used in CI, and "
                         "always previewable with --dry-run")
    ex.add_argument("--dry-run", action="store_true",
                    help="print exactly what would leave this machine (path, size, sha256) and exit; opens no socket")
    ex.add_argument("--no-publish", action="store_true", help="import without enqueueing publish.build")
    ex.add_argument("--partial", action="store_true")
    ex.add_argument("--wait", action="store_true",
                    help="poll until the jobs finish and print the summary of what was proposed and what was declined")
    ex.add_argument("--json", action="store_true")
    ex.add_argument("--profile", default="default", help="scan profile (not the generation profile, which is always one_shot)")
    _service_flags(ex)
    stt = sub.add_parser("status", help="show one import's state, per-file result and jobs")
    stt.add_argument("import_id")
    stt.add_argument("--json", action="store_true")
    _service_flags(stt)

    ins = sub.add_parser("install", help="U5: install the portable adapter package + harness wiring (idempotent)")
    ins.add_argument("--harness", choices=list(INSTALL_HARNESSES), required=True)
    ins.add_argument("--dry-run", action="store_true")
    ins.add_argument("--no-materialize", action="store_true",
                     help="skip building the hook index and writing the scope cards after installing")
    _service_flags(ins)
    uns = sub.add_parser("uninstall", help="remove exactly what `install` wrote, and nothing else")
    uns.add_argument("--harness", choices=list(INSTALL_HARNESSES), required=True)
    uns.add_argument("--dry-run", action="store_true")
    _service_flags(uns)

    pr = sub.add_parser("proposals", help="review exports: list, show, and apply one back into git")
    prsub = pr.add_subparsers(dest="proposals_cmd")
    prl = prsub.add_parser("list")
    prl.add_argument("--state"); prl.add_argument("--kind"); prl.add_argument("--scope")
    prl.add_argument("--json", action="store_true"); _service_flags(prl)
    prs = prsub.add_parser("show"); prs.add_argument("proposal_id"); _service_flags(prs)
    pra = prsub.add_parser("apply")
    pra.add_argument("export_id")
    pra.add_argument("--write", action="store_true", help="actually write the files (default: print the diff only)")
    pra.add_argument("--base-check", dest="base_check", action="store_true", default=None,
                     help="require export.base_commit == HEAD (default: on inside a git work tree)")
    pra.add_argument("--no-base-check", dest="base_check", action="store_false")
    _service_flags(pra)

    asc = sub.add_parser("ascend", help="ADR-0035: after a skill changes in a leaf scope, have a model write or "
                                        "edit one abstract skill (map/convention) per ancestor scope, gated on "
                                        "grounding, digest-only and validate; never commits")
    asc.add_argument("--changed", nargs="*", help="SKILL.md paths (or skill dirs) that changed")
    asc.add_argument("--since", help="git ref: take changed SKILL.md paths from `git diff --name-only <ref>`")
    asc.add_argument("--kind", choices=("map", "convention", "both"), default="both")
    asc.add_argument("--dry-run", action="store_true", help="print the climb plan; call no model, write nothing")
    asc.add_argument("--model", help=f"OpenAI-compatible model id (default $GUIDEFOLD_ASCEND_MODEL or {ASCEND_DEFAULT_MODEL})")
    asc.add_argument("--base-url", help=f"OpenAI-compatible endpoint (default $GUIDEFOLD_ASCEND_BASE_URL or {ASCEND_DEFAULT_BASE_URL})")
    asc.add_argument("--api-key-env", default=ASCEND_API_KEY_ENV, help=f"env var holding the key (default {ASCEND_API_KEY_ENV})")
    asc.add_argument("--json", dest="json_out", help="write the run summary JSON here ('-' = stdout)")
    asc.add_argument("--summary-md", help="write a PR-body markdown summary here")

    a = p.parse_args()
    # init/doctor must work on a repo with no guidefold.yaml yet, so they bypass the
    # repo_root()/load_map() setup below (which requires one) — see _target_root().
    if a.cmd == "init":
        cmd_init(a)
        return
    if a.cmd == "doctor":
        cmd_doctor(a)
        return
    # The pivot commands resolve their own root (_pivot_root) and tolerate a missing or
    # half-written guidefold.yaml: `scan` on a plain directory and `login` before the repo is
    # configured at all are both legitimate first steps, so they bypass repo_root()/load_map().
    if a.cmd in ("scan", "login", "logout", "org", "import", "sync", "status",
                 "extract", "install", "uninstall", "proposals"):
        globals()[f"cmd_{a.cmd}"](a)
        return
    root = repo_root()
    if a.cmd == "hook":
        # E1.5: the hook path must import zero PyYAML (provable via `python3 -X importtime`) and
        # must never resolve cwd -> node from the working-tree guidefold.yaml — both of which
        # `load_map` would do. cmd_hook reads only the pre-built artifact's own nodes.json.
        cmd_hook(a, root)
        return
    cfg = load_map(root)
    cfg.setdefault("registry", {})
    if a.backend:
        cfg["registry"]["backend"] = a.backend
    if a.project:
        cfg["registry"]["project"] = a.project
    globals()[f"cmd_{a.cmd}"](a, root, cfg)

if __name__ == "__main__":
    main()
