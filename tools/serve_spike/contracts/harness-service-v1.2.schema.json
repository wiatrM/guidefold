                        },
                        "layer": {
                          "description": "The Wiedza axis of PRODUCT-PIVOT paragraph 2: how abstract an instruction is. Null means no owner has classified this skill yet. It is not the source layer (org/platform/team) and never follows from directory depth.",
                          "oneOf": [
                            {
                              "type": "null"
                            },
                            {
                              "enum": [
                                "atomic",
                                "task",
                                "abstract"
                              ]
                            }
                          ]
                        }
                      }
                    }
                  },
                  "layer": {
                    "description": "The Wiedza axis of PRODUCT-PIVOT paragraph 2: how abstract an instruction is. Null means no owner has classified this skill yet. It is not the source layer (org/platform/team) and never follows from directory depth.",
                    "oneOf": [
