{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:guidefold:harness-service:1.2",
  "title": "Guidefold harness service contract 1.2 (superset of 1.1)",
  "description": "Additive superset of harness-service-v1.1. Requests may declare schema_version \"1.2\" and add the optional top-level field search_snapshot; responses may additionally carry closure, resources and family. Nothing in 1.1 changes meaning, and a 1.1 request is validated by the 1.1 document.",
  "oneOf": [
    {
      "$ref": "#/$defs/search_request"
    },
    {
      "$ref": "#/$defs/use_request"
    }
  ],
  "$defs": {
    "search_request": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": "1.2"
        },
        "request_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9_][A-Za-z0-9_.:-]{0,127}$"
        },
        "session_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9_][A-Za-z0-9_.:-]{0,127}$"
        },
        "task_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9_][A-Za-z0-9_.:-]{0,127}$"
        },
        "query_source": {
          "enum": [
            "user",
            "agent",
            "adapter"
          ]
        },
        "harness": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9_][A-Za-z0-9_.:-]{0,127}$"
            },
            "version": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9_][A-Za-z0-9_.:-]{0,127}$"
            },
            "adapter_version": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9_][A-Za-z0-9_.:-]{0,127}$"
            }
          },
          "required": [
            "name"
          ],
          "additionalProperties": false
        },
        "workspace": {
          "type": "object",
          "properties": {
            "repo_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9_][A-Za-z0-9_.:-]{0,127}$"
            },
            "revision": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9_][A-Za-z0-9_.:-]{0,127}$"
            },
            "cwd": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1024,
              "pattern": "^(?:\\.|(?!\\.{1,2}(?:/|$))[^/\\\\:\\x00-\\x1f]+(?:/(?!\\.{1,2}(?:/|$))[^/\\\\:\\x00-\\x1f]+)*)$"
            },
            "target_paths": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "path": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 1024,
                    "pattern": "^(?:\\.|(?!\\.{1,2}(?:/|$))[^/\\\\:\\x00-\\x1f]+(?:/(?!\\.{1,2}(?:/|$))[^/\\\\:\\x00-\\x1f]+)*)$"
                  },
                  "source": {
                    "enum": [
                      "user_explicit",
                      "edited",
                      "inferred"
                    ]
                  }
                },
                "required": [
                  "path",
                  "source"
                ],
                "additionalProperties": false
              },
              "maxItems": 32
            }
          },
          "required": [
            "repo_id"
          ],
          "additionalProperties": false,
          "anyOf": [
            {
              "required": [
                "cwd"
              ]
            },
            {
              "required": [
                "target_paths"
              ],
              "properties": {
                "target_paths": {
                  "minItems": 1
                }
              }
            }
          ]
        },
        "intent": {
          "type": "object",
          "properties": {
            "action": {
              "enum": [
                "implement",
                "debug",
                "review",
                "test",
                "migrate",
                "deploy",
                "document",
                "explore"
              ]
            },
            "goal": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2048,
              "pattern": "\\S"
            },
            "source": {
              "enum": [
                "user",
                "agent",
                "adapter"
              ]
            }
          },
          "required": [
            "action"
          ],
          "additionalProperties": false
        },
        "stack": {
          "type": "object",
          "properties": {
            "languages": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128,
                "pattern": "\\S"
              },
              "maxItems": 16
            },
            "technologies": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128,
                "pattern": "\\S"
              },
              "maxItems": 16
            },
            "source": {
              "enum": [
                "manifest",
                "user",
                "inferred"
              ]
            },
            "manifest_revision": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9_][A-Za-z0-9_.:-]{0,127}$"
            }
          },
          "required": [],
          "additionalProperties": false
        },
        "constraints": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "\\S"
          },
          "maxItems": 16
        },
        "capabilities": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "\\S"
          },
          "maxItems": 16
        },
        "loaded_skills": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "skill_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 512,
                "pattern": "\\S"
              },
              "revision": {
                "type": "string",
                "minLength": 1,
                "maxLength": 512,
                "pattern": "\\S"
              },
              "state": {
                "enum": [
                  "hydrated",
                  "exposed",
                  "unknown"
                ]
              }
            },
            "required": [
              "skill_id",
              "revision",
              "state"
            ],
            "additionalProperties": false
          },
          "maxItems": 32
        },
        "budget": {
          "type": "object",
          "properties": {
            "max_cards": {
              "type": "integer",
              "minimum": 0,
              "maximum": 4
            },
            "max_bytes": {
              "type": "integer",
              "minimum": 0,
              "maximum": 262144
            },
            "remaining_skill_tokens": {
              "type": "integer",
              "minimum": 0,
              "maximum": 65536
            }
          },
          "required": [],
          "additionalProperties": false
        },
        "deadline_ms": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5000
        },
        "query": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "pattern": "\\S"
        },
        "node": {
          "type": "string"
        },
        "profile": {
          "enum": [
            "hook",
            "interactive"
          ]
        },
        "search_snapshot": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "description": "The snapshot SEARCH answered from. A head that has moved since produces 409 snapshot_changed."
        }
      },
      "required": [
        "schema_version",
        "query"
      ],
      "additionalProperties": false,
      "not": {
        "required": [
          "workspace",
          "node"
        ]
      }
    },
