    "search_response": {
      "type": "object",
      "required": [
        "schema_version",
        "request_id",
        "search_id",
        "cards",
        "ranked",
        "context",
        "card_context",
        "composition"
      ],
      "properties": {
        "schema_version": {
          "enum": [
            "1.1",
            "1.2"
          ]
        },
        "request_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9_][A-Za-z0-9_.:-]{0,127}$"
        },
        "context": {
          "type": "object",
          "required": [
            "resolved_scopes",
            "scope_source",
            "scope_map_revision",
            "used_fields",
            "unused_fields",
            "warnings",
            "scope_is_authorization"
          ],
          "properties": {
            "resolved_scopes": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128,
                "pattern": "\\S"
              },
              "maxItems": 4,
              "minItems": 1
            },
            "scope_source": {
              "enum": [
                "cwd",
                "target_paths",
                "node"
              ]
            },
            "scope_is_authorization": {
              "const": false
            },
            "unused_fields": {
              "type": "array",
              "items": {
                "type": "object"
              },
              "maxItems": 16
            },
            "warnings": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "maxItems": 64
            }
          }
        },
        "snapshot": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "\\S"
        },
        "cards": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "skill_id",
              "urn",
              "revision",
              "name",
              "description"
            ],
            "properties": {
              "skill_id": {
                "type": "string"
              },
              "urn": {
                "type": "string"
              },
              "revision": {
                "type": "string"
              },
              "name": {
                "type": "string"
              },
              "description": {
                "type": "string"
              },
              "family": {
                "type": "object",
                "description": "Additive 1.2 discovery metadata: where this card sits on the knowledge pyramid, derived from the approved `refines` edges. Depth is one hop and `children` is capped at 8, so a family points at the neighbours and never claims the list is complete. It carries no ranking meaning: `ranked` and `cards` are byte-identical with and without it, and a 1.1 response never has it.",
                "required": [
                  "parent",
                  "children",
                  "layer"
                ],
                "properties": {
                  "parent": {
                    "oneOf": [
                      {
                        "type": "null"
                      },
                      {
                        "type": "object",
                        "required": [
                          "skill_id",
                          "revision",
                          "layer"
                        ],
                        "properties": {
                          "skill_id": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 512,
                            "pattern": "\\S"
                          },
                          "revision": {
                            "type": "string",
                            "maxLength": 512
                          },
                          "layer": {
                            "description": "The Wiedza axis of PRODUCT-PIVOT paragraph 2: how abstract an instruction is. Null means no owner has classified this skill yet. It is not the source layer (org/platform/team) and never follows from directory depth.",
                            "oneOf": [
                              {
                                "type": "null"
                              },
                              {
                                "enum": [
                                  "atomic",
                                  "task",
                                  "abstract"
                                ]
                              }
                            ]
                          }
                        }
                      }
                    ]
                  },
                  "children": {
                    "type": "array",
                    "maxItems": 8,
                    "items": {
                      "type": "object",
                      "required": [
                        "skill_id",
                        "revision",
                        "scope",
                        "layer"
                      ],
                      "properties": {
                        "skill_id": {
