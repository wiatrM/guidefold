        "schema_version",
        "request_id",
        "search_id",
        "cards",
        "ranked",
        "context",
        "card_context",
        "composition"
      ],
      "properties": {
        "schema_version": {
          "const": "1.1"
        },
        "request_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9_][A-Za-z0-9_.:-]{0,127}$"
        },
        "context": {
          "type": "object",
          "required": [
            "resolved_scopes",
            "scope_source",
            "scope_map_revision",
            "used_fields",
            "unused_fields",
            "warnings",
            "scope_is_authorization"
          ],
          "properties": {
            "resolved_scopes": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128,
                "pattern": "\\S"
              },
              "maxItems": 4,
