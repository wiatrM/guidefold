@startuml c4-deployment
!include <C4/C4_Deployment>
!pragma layout smetana
AddElementTag("planned", $bgColor="#f1f1f1", $fontColor="#555555", $borderColor="#9a9a9a", $borderStyle=DashedLine(), $legendText="zaplanowane (T2)")
AddElementTag("wip", $bgColor="#fbe3d4", $fontColor="#5a2a00", $borderColor="#ff6a28", $legendText="w budowie")
AddNodeTag("planned", $bgColor="#f7f7f7", $fontColor="#555555", $borderColor="#9a9a9a", $borderStyle=DashedLine(), $legendText="węzeł zaplanowany (T2)")
title Wdrożenie — trzy tiery na jednym kontrakcie; ten sam klient, inne miejsce liczenia

Deployment_Node(laptop, "Laptop developera", "każdy tier") {
  Deployment_Node(h, "Harness agenta", "Claude Code / Copilot / Codex / Gemini") {
    Container(cli, "guidefold CLI", "1 plik", "search.backend: local | service")
  }
  ContainerDb(idx, "Artefakt indeksu", "z CI, mmap", "T0: p95 113 ms @ 500 · 188 @ 2 000 · 262 @ 4 000 · 320 @ 6 006 skilli → próg T0 ≈ 5 300")
}
Deployment_Node(t1, "T1 — departament: 1 VM (2–4 vCPU) + Postgres", "do ≈ 10 000 skilli, jeden region") {
  Container(api1, "API SEARCH/USE", "sparse-only, snapshot w RAM", "zmierzone: c1 54 · c4 128 · świeży 121 · burst-4 173 ms — 200/200")
  Container(sh1, "Worker encodera (shadow)", "GPU opcjonalnie", "tylko log; hybryda c4 444 ms → batching", $tags="wip")
  ContainerDb(pg1, "Postgres", "ledger, rewizje", "", $tags="planned")
}
Deployment_Node(t2, "T2 — organizacja: region HA + GPU", "cały katalog, tysiące developerów; ≈ 2–3,5 k USD/mies. infrastruktury", $tags="planned") {
  Deployment_Node(cpu, "2 × węzeł CPU (HA)", "", $tags="planned") {
    Container(api2, "API SEARCH/USE", "sparse + dense dopuszczony per tenant", "", $tags="planned")
  }
  Deployment_Node(gpu, "2 × L4 24 GB (HA)", "", $tags="planned") {
    Container(enc, "Worker encodera + kompozytor", "batching; fine-tune co tydzień", "", $tags="planned")
  }
  ContainerDb(pg2, "Postgres HA", "ledger · rollups", "", $tags="planned")
  ContainerDb(cdn, "GCS / CDN", "ciała, snapshoty", "", $tags="planned")
}

Rel(cli, idx, "T0: mmap, bez sieci")
Rel(cli, api1, "T1: HTTPS, deadline + lokalny fallback")
Rel(cli, api2, "T2: HTTPS")
Rel(api1, sh1, "w cieniu")
Rel(api2, enc, "shadow → bramki → dopuszczony")
Rel(cdn, api2, "snapshot → atomic swap")
SHOW_LEGEND()
@enduml
