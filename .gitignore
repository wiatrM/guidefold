
# Python
__pycache__/
*.py[cod]
.pytest_cache/
.venv/
venv/
*.egg-info/
dist/
build/
.coverage
htmlcov/
.ruff_cache/
.mypy_cache/

# Editors / OS
.idea/
.vscode/
*.swp
.DS_Store
Thumbs.db
desktop.ini
*:Zone.Identifier

# Secrets / local config
.env
.env.*
*.pem
*.json.key

# generated guidefold artifacts (ADR-0012) — cards, index, cache, telemetry
.guidefold/

# node / prototypes
node_modules/
dist/
.vite/

# local-only, never published (competitive briefs, decks, partner material)
private/

# tools/bakeoff (E1.3 model bake-off harness, tier 2 / torch-based, never shipped in the hook):
# never commit downloaded weights, embedding caches, or the binary distillation build outputs.
# The bare `build/` rule above would also swallow tools/bakeoff/build/ wholesale, so re-include
# that tree and its small words.json manifest (the one build output that IS meant to be
# committed -- see tools/bakeoff/README.md), then re-exclude just the binaries inside it.
tools/bakeoff/.bakeoff-cache/
tools/eval/.skillret-cache/
tools/eval/.skillretbench-r1-cache/
tools/expand/.bakeoff-cache/
!tools/bakeoff/build/
!tools/bakeoff/build/**/
!tools/bakeoff/build/**/words.json
tools/bakeoff/build/**/words.bin
tools/bakeoff/build/**/vectors.i8
tools/bakeoff/build/**/teacher.f16

# local experiment corpora — real skills used for scale measurement, never committed
# (103 MB at 2111 skills; the repo ships a measured *profile*, not the corpus — see ADR-0021)
experiment/
